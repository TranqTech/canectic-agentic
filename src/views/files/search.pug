extends ../layouts/user

block content
  .container-fluid.main-wrapper
    if !currentuser
      - loginMode = 'guard'
      - loginRedirect = currentPath
      include ../partials/users/login.pug
    else
      .row
        .col-12
          br
          br
      .row
        .col-1.d-none.d-lg-block
        .col-12.col-lg-10
          //- Breadcrumb
          nav(aria-label='breadcrumb')
            ol.breadcrumb
              li.breadcrumb-item
                a(href='/files') Files
              li.breadcrumb-item.active(aria-current='page') Search

          .card
            .card-header.bg-darkblue.text-white
              h2
                i.bi.bi-search
                |  File Search
            .card-body
              form(action='/files/search' method='GET')
                .row
                  .col-md-8.offset-md-2
                    .input-group.mb-3
                      input.form-control(
                        type='text'
                        name='q'
                        value=query
                        placeholder='Search by filename, description, or content...'
                        autofocus
                      )
                      button.btn.btn-success(type='submit')
                        i.bi.bi-search
                        |  Search

              if query && query.length > 0
                if results && results.length > 0
                  p.text-muted
                    = totalResults + ' result(s) for "'
                    strong= query
                    | '"'
                  .table-responsive
                    table.table.table-hover
                      thead
                        tr
                          th Filename
                          th.d-none.d-md-table-cell Area
                          th.d-none.d-md-table-cell Size
                          th.d-none.d-md-table-cell Description
                          th.d-none.d-md-table-cell Downloads
                      tbody
                        each file in results
                          tr(data-file-uuid=file.uuid style='cursor:pointer')
                            td
                              i.bi.bi-file-earmark.me-1
                              strong= file.filename
                              //- Phone: the details under the name, the columns md and up.
                              .small.d-md-none
                                if file._areaShortcode
                                  div
                                    if file._groupName
                                      span.text-muted= file._groupName + ' / '
                                    a(href='/files/area/' + file._areaShortcode)= file._areaName || file._areaShortcode
                                if file.short_desc
                                  .text-muted= file.short_desc
                                div= formatBytes(file.file_size || 0)
                            td.d-none.d-md-table-cell
                              if file._groupName
                                span.text-muted= file._groupName + ' / '
                              if file._areaShortcode
                                a(href='/files/area/' + file._areaShortcode)= file._areaName || file._areaShortcode
                            td.text-nowrap.d-none.d-md-table-cell= formatBytes(file.file_size || 0)
                            td.d-none.d-md-table-cell= file.short_desc || ''
                            td.text-center.d-none.d-md-table-cell= file.download_count || 0
                else
                  .text-center.py-4
                    h5.text-muted No results found for "#{query}"

  include partials/_fileInfoModal
