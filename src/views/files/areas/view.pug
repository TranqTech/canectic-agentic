extends ../../layouts/user

block content
  .container-fluid.main-wrapper
    if !currentuser
      - loginMode = 'guard'
      - loginRedirect = currentPath
      include ../../partials/users/login.pug
    else if !sufficientAccess
      .row
        .col-12
          br
          br
      .row
        .col-1.d-none.d-lg-block
        .col-12.col-lg-10
          .card
            .card-header.bg-darkblue.text-white
              h2
                i.bi.bi-lock
                |  Access Denied
            .card-body
              .text-center.py-4
                h5.text-muted You do not have sufficient access to view this file area.
                a.btn.btn-outline-light.mt-3(href='/files') Back to Files
    else
      .row
        .col-12
          br
          br
      .row
        .col-1.d-none.d-lg-block
        .col-12.col-lg-10
          //- Breadcrumb
          nav(aria-label='breadcrumb')
            ol.breadcrumb
              li.breadcrumb-item
                a(href='/files') Files
              if fileGroup
                li.breadcrumb-item
                  a(href=`/files/group/${fileGroup.shortcode}`)= fileGroup.name
              li.breadcrumb-item.active(aria-current='page')
                if fileArea
                  = fileArea.name
                else
                  | File Area

          .card
            .card-header.bg-darkblue.text-white
              .row.align-items-center.gy-2
                .col-12.col-md-8
                  h2.mb-0
                    i.bi.bi-files
                    |
                    if fileArea
                      = fileArea.name
                    else
                      | File Area
                .col-12.col-md-4
                  .d-flex.flex-wrap.gap-2.justify-content-md-end
                    if newCount && newCount > 0
                      .btn-group.btn-group-sm
                        a.btn.btn-outline-light(href='/files/area/' + fileArea.shortcode class=(newOnly ? '' : 'active')) All
                        a.btn.btn-outline-light(href='/files/area/' + fileArea.shortcode + '?new=1' class=(newOnly ? 'active' : ''))
                          | New
                          span.badge.bg-info.ms-1= newCount
                    else if newOnly
                      a.btn.btn-sm.btn-outline-light(href='/files/area/' + fileArea.shortcode) All
                    if fileGroup
                      a.btn.btn-sm.btn-outline-light(href=`/files/group/${fileGroup.shortcode}`)
                        i.bi.bi-arrow-left
                        |  Group
                    if canUpload
                      a.btn.btn-sm.btn-success(href='/files/area/' + fileArea.shortcode + '/upload')
                        i.bi.bi-upload
                        |  Upload
            .card-body
              if uploaded
                .alert.alert-success.alert-dismissible.fade.show
                  i.bi.bi-check-circle.me-1
                  | File uploaded successfully: #{uploaded}
                  button.btn-close(type='button' data-bs-dismiss='alert')
              if error
                .alert.alert-danger.alert-dismissible.fade.show
                  i.bi.bi-exclamation-triangle.me-1
                  | #{error}
                  button.btn-close(type='button' data-bs-dismiss='alert')
              if fileArea && fileArea.description
                p.text-muted= fileArea.description
              if filelist && filelist.length > 0
                .table-responsive
                  table#fileTable.table.table-hover
                    //- On a phone only the Filename column shows (so sorting and
                    //- the filter still work); description, size and date sit
                    //- under the name. The rest are md and up.
                    thead
                      tr
                        th(scope='col') Filename
                        th.text-center.d-none.d-md-table-cell(scope='col') Size
                        th.d-none.d-md-table-cell(scope='col') Date
                        th.d-none.d-md-table-cell(scope='col') Description
                        th.text-center.d-none.d-md-table-cell(scope='col') Downloads
                    tbody
                      for file of filelist
                        //- New = arrived since the start of the previous visit
                        //- (src/utils/newSince.js); nothing clears it mid-visit.
                        - var isNew = newSinceMs !== undefined && file.upload_date && new Date(file.upload_date).getTime() > newSinceMs
                        tr(data-file-uuid=file.uuid data-is-new=(isNew ? 'true' : 'false') style='cursor:pointer')
                          td
                            i.bi.bi-file-earmark.me-1
                            strong= file.filename
                            if isNew
                              span.badge.bg-info.ms-2 NEW
                            .small.d-md-none
                              if file.short_desc
                                .text-muted= file.short_desc
                              div
                                span= formatBytes(file.file_size || 0)
                                if file.upload_date
                                  |  · 
                                  +ts(file.upload_date, 'date')
                          td.text-center.text-nowrap.d-none.d-md-table-cell= formatBytes(file.file_size || 0)
                          td.text-nowrap.d-none.d-md-table-cell(data-order=timestampMs(file.upload_date) || 0)
                            if file.upload_date
                              +ts(file.upload_date, 'date')
                            else
                              span.text-muted —
                          td.d-none.d-md-table-cell= file.short_desc || ''
                          td.text-center.d-none.d-md-table-cell= file.download_count || 0
                .text-muted.small.mt-2
                  if newOnly
                    | Showing #{filelist.length} of #{newCount} new since your last visit, newest first
                  else
                    | Showing #{filelist.length} of #{totalFiles} files
              else
                .text-center.py-4
                  if newOnly
                    h5.text-muted No new files in this area
                    a.btn.btn-sm.btn-outline-secondary.mt-2(href='/files/area/' + fileArea.shortcode) Show all files
                  else
                    h5.text-muted No files in this area

  include ../partials/_fileInfoModal

  script.
    document.addEventListener('DOMContentLoaded', function() {
      // Initialize DataTables if available and more than a few rows
      if (typeof jQuery !== 'undefined' && jQuery.fn.DataTable) {
        var table = document.getElementById('fileTable');
        if (table && table.querySelectorAll('tbody tr').length > 5) {
          jQuery('#fileTable').DataTable({
            paging: false,
            searching: true,
            info: false,
            order: [],
            language: {
              search: 'Filter:'
            }
          });
        }
      }
    });
