extends ../../layouts/user

block content
  .container-fluid.main-wrapper
    if !currentuser
      - loginMode = 'guard'
      - loginRedirect = currentPath
      include ../../partials/users/login.pug
    else
      .row
        .col-12
          br
          br
      .row
        .col-1.d-none.d-lg-block
        .col-12.col-lg-10
          .card
            .card-header.bg-darkblue.text-white
              .row.align-items-center.gy-2
                .col-12.col-md-8
                  h2.mb-0
                    i.bi.bi-folder2-open
                    |
                    if fileGroup
                      = fileGroup.name
                    else
                      | File Group
                .col-12.col-md-4
                  .text-md-end
                    a.btn.btn-sm.btn-outline-light(href='/files')
                      i.bi.bi-arrow-left
                      |  Groups
            .card-body
              if !fileGroup
                .text-center.py-4
                  h5.text-muted Group not found
              else
                if fileGroup.description
                  p.text-muted= fileGroup.description
                if arealist && arealist.length > 0
                  //- On a phone each area is one cell plus a counts column
                  //- (.list-counts), as on the message group page; the other
                  //- columns and the header row are md and up.
                  table#areaTable.table.table-hover
                    thead.list-head
                      tr
                        th(scope='col') Area
                        th(scope='col') Description
                        th.text-center(scope='col') Files
                        th.text-center(scope='col') Size
                        th(scope='col') Latest
                        th.text-center(scope='col') New
                    tbody
                      for area of arealist
                        tr.clickable-row(data-href=`/files/area/${area.shortcode}`)
                          td
                            strong= area.name
                            if area.canUpload
                              |
                              i.bi.bi-upload.text-success(title='Upload available')
                            .small.d-md-none
                              if area.description
                                .text-muted= area.description
                              if area.last_upload
                                div
                                  span.fg-yellow= DateTime.fromMillis(Date.parse(area.last_upload)).toFormat('MMM dd, yyyy')
                                  if area.last_filename
                                    |  
                                    span.fg-green= area.last_filename
                          td.list-counts.d-md-none
                            .text-nowrap(title='Files')
                              i.bi.bi-files.me-1
                              = area.file_count || 0
                            if area.new_count && area.new_count > 0
                              span.badge.bg-info.mt-1(title='New')= area.new_count
                          td.d-none.d-md-table-cell= area.description
                          td.text-center.d-none.d-md-table-cell= area.file_count || 0
                          td.text-center.d-none.d-md-table-cell= formatBytes(area.total_bytes || 0)
                          td.d-none.d-md-table-cell
                            if area.last_upload
                              .small
                                - var ldate = Date.parse(area.last_upload)
                                - var ld = DateTime.fromMillis(ldate)
                                span.fg-yellow= ld.toFormat('MMM dd, yyyy')
                                if area.last_filename
                                  br
                                  span.fg-green= area.last_filename
                            else
                              span.text-muted —
                          td.text-center.d-none.d-md-table-cell
                            if area.new_count && area.new_count > 0
                              span.badge.bg-info= area.new_count
                            else
                              span.text-muted —
                else
                  .text-center.py-4
                    h5.text-muted No file areas in this group

  script.
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.clickable-row').forEach(function(row) {
        row.style.cursor = 'pointer';
        row.addEventListener('click', function() {
          var href = this.getAttribute('data-href');
          if (href) window.location.href = href;
        });
      });
    });
