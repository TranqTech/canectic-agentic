extends ../layouts/user
block content
	.container-fluid.main-wrapper
		if !ismobile
			br
			br

		.row
			.col-lg-10.offset-lg-1.col-12
				h2.mb-4 Door Games

				if !currentuser
					.alert.alert-info You must be logged in to play door games.
						a.ms-2(href='/users/login?redirect=/doors') Log in

				//- Collection cards
				if collections && collections.length > 0
					.row
						each col in collections
							.col-md-4.col-sm-6.mb-4
								a.card.h-100.text-decoration-none.text-reset(href='/doors/collection/' + col.slug style='cursor:pointer')
									.card-img-top.text-center.p-3.d-flex.align-items-center.justify-content-center(style='background:#1a1a2e; min-height:160px')
										if col.icon_url
											img(src=col.icon_url style='max-height:140px; max-width:100%; object-fit:contain')
										else
											i.bi.bi-controller(style='font-size:5rem; color:#888')
									.card-body
										h5.card-title.mb-1= col.name
										if col.description
											.card-text.text-muted.small.mb-1!= col.description
										span.badge.bg-info= (doorCounts && doorCounts[col.id]) ? doorCounts[col.id] + ' games' : 'Empty'
									.card-footer
										.btn.btn-primary.btn-sm.w-100
											| Browse Collection

				//- Flat door list fallback (no collections configured)
				else if doors && doors.length > 0
					.row
						each door in doors
							.col-md-4.col-sm-6.mb-3
								.card.h-100
									.card-body
										h5.card-title= door.name
										if door.description
											.card-text.small(style=themeTextColour ? 'color: ' + themeTextColour : '')!= door.description
									.card-footer.d-flex.justify-content-between
										if currentuser
											a.btn.btn-primary.btn-sm(href='/doors/play/' + door.slug)
												i.bi.bi-play-fill.me-1
												| Play
										else
											button.btn.btn-secondary.btn-sm(disabled) Login to Play
				else
					.text-center.text-muted
						h5 No door games available
						p Check back later!
