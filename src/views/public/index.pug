extends ../layouts/user

block content
  .container-fluid.main-wrapper
    .row
      .col-12
        br
        br
    .row
      .col-1
      .col-10
        h1.mb-4= title

        if announcements && announcements.length > 0
          each ann in announcements
            .card.mb-3
              .card-header.bg-darkblue.text-white
                if ann.pinned
                  span.badge.bg-warning.me-2 Pinned
                = ann.title
              .card-body(style=themeTextColour ? 'color: ' + themeTextColour : '')
                if ann.body_html
                  != ann.body_html
                else if ann.body_text
                  p= ann.body_text
              .card-footer.text-muted
                small
                  | Posted by #{ann.author_name || 'System'}
                  if ann.created_at
                    |  on #{new Date(ann.created_at).toLocaleDateString()}
        else
          .card
            .card-header.bg-darkblue.text-white
              | Welcome
            .card-body
              p Welcome to #{title}. There are no announcements at this time.

        include ../partials/wall
