extends ../layouts/user

block content
  .container-fluid.main-wrapper
    .row
      .col-12
        br
    .row
      //- Side columns from lg up only; on a phone they took a third of the width.
      .col-2.d-none.d-lg-block
      .col-12.col-lg-8
        h1.mb-4= title

        //- blocks: the sysop's layout for this visitor (/admin/webhome),
        //- already rendered, each with its label and icon
        if !blocks || blocks.length === 0
          .card
            .card-header.bg-darkblue.text-white
              | Welcome
            .card-body
              p Welcome to #{title}. There are no announcements at this time.
        else if display === 'stacked'
          each b in blocks
            .home-block.mb-3(data-block=b.name)!= b.html
        else
          ul.nav.nav-tabs.mb-3(role='tablist')
            each b, i in blocks
              li.nav-item(role='presentation')
                button.nav-link(
                  id='home-tab-' + i
                  class=i === 0 ? 'active' : ''
                  data-bs-toggle='tab'
                  data-bs-target='#home-pane-' + i
                  type='button'
                  role='tab'
                  aria-controls='home-pane-' + i
                  aria-selected=i === 0 ? 'true' : 'false'
                )
                  if b.icon
                    i.bi.me-1(class='bi-' + b.icon)
                  = b.label
          .tab-content
            each b, i in blocks
              .tab-pane.fade.home-block(
                id='home-pane-' + i
                class=i === 0 ? 'show active' : ''
                role='tabpanel'
                aria-labelledby='home-tab-' + i
                data-block=b.name
              )!= b.html

  script.
    // The Wall block's post box, as the call flow page wires it
    (function() {
      var form = document.getElementById('cf-wall-form');
      if (!form) return;
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var input = document.getElementById('cf-wall-input');
        var text = (input ? input.value : '').trim();
        if (!text) return;
        fetch('/callflow/wall', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: 'message=' + encodeURIComponent(text)
        }).then(function() { location.reload(); });
      });
    })();
