extends ../layouts/public

block content
  .container-fluid.main-wrapper
    h1= title
    p Welcome to #{title}
    .card
      .card-header.bg-darkblue
        .h2
          |Text Samples
      .card-body.bg-black
        p.h5.fg-green N Green
        p.h5.fg-brightgreen B Green
        p.h5.fg-blue N Blue
        p.h5.fg-brightblue B Blue
        p.h5.fg-cyan N Cyan
        p.h5.fg-brightcyan B Cyan
        p.h5.fg-yellow N Yellow
        p.h5.fg-brightyellow B Yellow
        p.h5.fg-magenta N Magenta
        p.h5.fg-brightmagenta B Magenta
        p.h5.fg-red N Red
        p.h5.fg-brightred B Red        
        p.h5.fg-grey N Grey
        p.h5.fg-brightgrey B Grey
        p.h5.fg-white White