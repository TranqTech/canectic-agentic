//- Who's Online card partial
//- Expects: onlineUsers (array of { nodenum, username, activity, connection })
//- Colours match the terminal whosonline.js handler

.card
  .card-header.bg-primary.text-white
    h5.mb-0
      i.bi.bi-people-fill.me-2
      span.fg-brightgreen Who's Online
      if onlineUsers && onlineUsers.length > 0
        span.badge.bg-info.ms-2= onlineUsers.length
  .card-body.p-0
    if onlineUsers && onlineUsers.length > 0
      .table-responsive
        table.table.table-sm.mb-0
          thead
            tr
              th: span.fg-brightyellow Node
              th: span.fg-brightyellow Username
              th: span.fg-brightyellow Activity
              th: span.fg-brightyellow Connection
          tbody
            each entry in onlineUsers
              tr
                td
                  if entry.nodenum
                    span.fg-brightcyan= entry.nodenum
                  else
                    span.text-muted -
                td
                  strong.fg-brightmagenta= entry.username || 'Unknown'
                td
                  span.fg-cyan= entry.activity || 'Idle'
                td
                  if entry.connection === 'Web'
                    span.badge.bg-success
                      i.bi.bi-globe.me-1
                      | Web
                  else if entry.connection === 'Terminal'
                    span.badge.bg-info
                      i.bi.bi-terminal.me-1
                      | Terminal
                  else
                    span.badge.bg-secondary= entry.connection || 'Unknown'
    else
      .text-center.text-muted.py-4
        span.fg-brightgreen Nobody currently online
