//- Flash message partial — include in any view that needs user feedback
//- Expects res.locals.flash to be an array of { type, text } objects
//- type: 'danger', 'warning', 'success', 'info'
if flash && flash.length > 0
  each msg in flash
    .alert.alert-dismissible.fade.show.mb-2.flash-shake(
      class=`alert-${msg.type || 'info'}`
      role='alert'
    )
      if msg.type === 'danger'
        i.bi.bi-exclamation-triangle-fill.me-2
      else if msg.type === 'warning'
        i.bi.bi-exclamation-circle-fill.me-2
      else if msg.type === 'success'
        i.bi.bi-check-circle-fill.me-2
      else
        i.bi.bi-info-circle-fill.me-2
      = msg.text
      button.btn-close(type='button' data-bs-dismiss='alert' aria-label='Close')
  style.
    @keyframes flashShake {
      0%, 100% { transform: translateX(0); }
      15% { transform: translateX(-6px); }
      30% { transform: translateX(5px); }
      45% { transform: translateX(-4px); }
      60% { transform: translateX(3px); }
      75% { transform: translateX(-2px); }
    }
    .flash-shake {
      animation: flashShake 0.5s ease-in-out;
    }
  script.
    (function() {
      var alerts = document.querySelectorAll('.flash-shake');
      for (var i = 0; i < alerts.length; i++) {
        (function(el) {
          setTimeout(function() {
            var bsAlert = bootstrap.Alert.getOrCreateInstance(el);
            if (bsAlert) bsAlert.close();
          }, 10000);
        })(alerts[i]);
      }
    })();
