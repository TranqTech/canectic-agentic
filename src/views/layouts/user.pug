doctype html
html
  head
    title= title
    //link(rel='icon' href=faviconlink type='image/x-icon') 
    link(rel='stylesheet', href='/css/darkly/bootstrap.css')
    link(rel='stylesheet', href='/css/bootstrap-icons.css')
    link(rel='stylesheet', href='/css/styles.css')
    link(rel='stylesheet', href='/css/dataTables.bootstrap5.min.css')
    link(rel='stylesheet', href='/css/Datatables.custom.css')
    //- Sysop-managed custom CSS -- loaded last so it wins the cascade.
    //- Never overwritten by the update script.
    link(rel='stylesheet', href='/css/custom.css')
    script(src='/js/bootstrap.bundle.js')
    script(src='/js/console.parsers.js')
    script(src='/js/jquery-3.7.0.js')
    script(src='/js/jquery.dataTables.min.js')
    script(src='/js/tinymce/tinymce.min.js')
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
  body
    include ../includes/user-nav.pug
    div(style='padding-top: 70px')
      if callflowPending && !callflowForce
        #callflow-resume-bar.text-center.py-3.mb-0(style='background: #375a7f; border-bottom: 2px solid #2c4a66;')
          h5.text-white.mb-2
            i.bi.bi-stars.me-2
            | Welcome back! There's new activity on the board.
          .d-flex.justify-content-center.gap-3
            a.btn.btn-success.btn-lg(href='/callflow')
              i.bi.bi-arrow-right-circle.me-2
              | See What's New
            button.btn.btn-outline-light(type='button' onclick='dismissCallflow()')
              | Dismiss
        script.
          sessionStorage.removeItem('wall_posted');
          function dismissCallflow() {
            document.getElementById('callflow-resume-bar').style.display = 'none';
            fetch('/callflow/complete', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'return_url=' + encodeURIComponent(location.pathname) });
          }
      block content
    if currentuser
      include ../partials/chatOverlay
      script.
        (function() {
          var wsProto = location.protocol === 'https:' ? 'wss:' : 'ws:';
          var ws = null;
          var reconnectDelay = 5000;
          var chatState = { chatId: null, minimised: false, unread: 0, role: null, mode: null };

          var reconnectAttempts = 0;
          var maxReconnectDelay = 60000;
          var heartbeatTimer = null;

          function connect() {
            try {
              ws = new WebSocket(wsProto + '//' + location.host + '/ws/presence');
              ws.onopen = function() {
                reconnectAttempts = 0;
                if (heartbeatTimer) clearInterval(heartbeatTimer);
                heartbeatTimer = setInterval(function() {
                  if (ws && ws.readyState === WebSocket.OPEN) {
                    ws.send(JSON.stringify({ type: 'heartbeat' }));
                  }
                }, 60000);
              };
              ws.onmessage = function(ev) {
                try { var msg = JSON.parse(ev.data); handlePresenceMsg(msg); } catch(_) {}
              };
              ws.onclose = function(ev) {
                if (heartbeatTimer) { clearInterval(heartbeatTimer); heartbeatTimer = null; }
                // 4001 = session expired or invalid
                if (ev.code === 4001) {
                  if (!document.hidden) {
                    window.location.href = '/users/login';
                  } else {
                    window._sessionExpired = true;
                  }
                  return;
                }
                // Only reconnect if tab is visible. Background tabs defer to visibilitychange.
                if (document.hidden) {
                  window._needsReconnect = true;
                  return;
                }
                reconnectAttempts++;
                var delay = Math.min(reconnectDelay * Math.pow(2, reconnectAttempts - 1), maxReconnectDelay);
                setTimeout(connect, delay);
              };
            } catch (_) {
              if (document.hidden) {
                window._needsReconnect = true;
                return;
              }
              reconnectAttempts++;
              var delay = Math.min(reconnectDelay * Math.pow(2, reconnectAttempts - 1), maxReconnectDelay);
              setTimeout(connect, delay);
            }
          }

          function handlePresenceMsg(msg) {
            if (msg.type === 'chat_start') {
              chatState.chatId = msg.chatId;
              chatState.unread = 0;
              chatState.mode = msg.mode || 'sysop';
              chatState.role = msg.targetName ? 'initiator' : 'target';
              var peer = msg.peerName || msg.targetName || 'Chat';
              document.getElementById('web-chat-title').textContent = 'Chat - ' + peer;
              document.getElementById('web-chat-messages').innerHTML = '';
              updateCloseButton();
              addSystemMsg(peer + ' started a chat');
              showOverlay();
              playNotify();
            }
            if (msg.type === 'chat_restore') {
              chatState.chatId = msg.chatId;
              chatState.unread = 0;
              chatState.mode = msg.mode || 'sysop';
              chatState.role = msg.role || 'target';
              var peer = msg.peerName || 'Chat';
              document.getElementById('web-chat-title').textContent = 'Chat - ' + peer;
              var box = document.getElementById('web-chat-messages');
              box.innerHTML = '';
              updateCloseButton();
              for (var i = 0; i < msg.messages.length; i++) {
                addChatMsg(msg.messages[i].from, msg.messages[i].name, msg.messages[i].text);
              }
              showOverlay();
            }
            if (msg.type === 'chat_msg' && msg.chatId === chatState.chatId) {
              addChatMsg(msg.from, msg.name, msg.text);
              if (chatState.minimised) {
                chatState.unread++;
                updateBadge();
              }
              playNotify();
            }
            if (msg.type === 'chat_typing' && msg.chatId === chatState.chatId) {
              var el = document.getElementById('web-chat-typing');
              if (msg.text) { el.textContent = 'typing...'; }
              else { el.textContent = ''; }
            }
            if (msg.type === 'chat_end' && msg.chatId === chatState.chatId) {
              addSystemMsg(msg.reason || 'Chat ended');
              chatState.chatId = null;
              setTimeout(hideOverlay, 3000);
            }
            if (msg.type === 'chat_error') {
              if (chatState.chatId) {
                addSystemMsg('Error: ' + (msg.error || 'unknown'));
              } else {
                alert('Chat: ' + (msg.error || 'unknown error'));
              }
            }
            // Notifications
            if (msg.type === 'notification_count') {
              updateNotifBadge(msg.count);
            }
            if (msg.type === 'notification') {
              addNotifToDropdown(msg);
              // Initial replay items (sent on connect to populate the dropdown)
              // are already accounted for in the preceding notification_count
              // message. Only increment for genuinely new pushes to avoid
              // doubling the badge.
              if (!msg.initial) {
                notifUnread++;
                updateNotifBadge(notifUnread);
              }
            }
          }

          function addChatMsg(from, name, text) {
            var box = document.getElementById('web-chat-messages');
            var div = document.createElement('div');
            div.className = 'web-chat-msg web-chat-msg-' + from;
            div.innerHTML = '<span class="web-chat-msg-name">[' + esc(name) + ']</span> ' + esc(text);
            box.appendChild(div);
            box.scrollTop = box.scrollHeight;
          }

          function addSystemMsg(text) {
            var box = document.getElementById('web-chat-messages');
            var div = document.createElement('div');
            div.className = 'web-chat-msg-system';
            div.textContent = text;
            box.appendChild(div);
            box.scrollTop = box.scrollHeight;
          }

          function updateCloseButton() {
            var btn = document.getElementById('web-chat-close');
            if (!btn) return;
            // Telegram: both parties can close. Sysop chat: only initiator (sysop) can close.
            var canClose = (chatState.mode === 'telegram') || (chatState.role === 'initiator');
            if (canClose) {
              btn.classList.remove('web-chat-sysop-only');
            } else {
              btn.classList.add('web-chat-sysop-only');
            }
          }

          function showOverlay() {
            document.getElementById('web-chat-overlay').classList.remove('web-chat-hidden');
            document.getElementById('web-chat-badge').classList.add('web-chat-hidden');
            chatState.minimised = false;
            chatState.unread = 0;
          }

          function hideOverlay() {
            document.getElementById('web-chat-overlay').classList.add('web-chat-hidden');
            document.getElementById('web-chat-badge').classList.add('web-chat-hidden');
          }

          function minimiseOverlay() {
            document.getElementById('web-chat-overlay').classList.add('web-chat-hidden');
            document.getElementById('web-chat-badge').classList.remove('web-chat-hidden');
            chatState.minimised = true;
            updateBadge();
          }

          function updateBadge() {
            var el = document.getElementById('web-chat-badge-count');
            if (chatState.unread > 0) {
              el.textContent = chatState.unread;
              el.style.display = 'flex';
            } else {
              el.style.display = 'none';
            }
          }

          function sendChat(text) {
            if (!text || !chatState.chatId || !ws || ws.readyState !== WebSocket.OPEN) return;
            ws.send(JSON.stringify({ type: 'chat_msg', chatId: chatState.chatId, text: text }));
            addChatMsg('self', 'You', text);
          }

          function endChat() {
            if (!chatState.chatId || !ws || ws.readyState !== WebSocket.OPEN) return;
            ws.send(JSON.stringify({ type: 'chat_end', chatId: chatState.chatId }));
          }

          var typingTimer = null;
          function sendTyping(text) {
            if (!chatState.chatId || !ws || ws.readyState !== WebSocket.OPEN) return;
            clearTimeout(typingTimer);
            ws.send(JSON.stringify({ type: 'chat_typing', chatId: chatState.chatId, text: text }));
            typingTimer = setTimeout(function() {
              if (ws && ws.readyState === WebSocket.OPEN) {
                ws.send(JSON.stringify({ type: 'chat_typing', chatId: chatState.chatId, text: '' }));
              }
            }, 3000);
          }

          function playNotify() {
            try { var a = new Audio('/sounds/chat-notify.mp3'); a.volume = 0.3; a.play().catch(function(){}); } catch(_) {}
          }

          function esc(s) { var d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

          // Wire up UI events after DOM ready
          document.addEventListener('DOMContentLoaded', function() {
            var input = document.getElementById('web-chat-input');
            if (!input) return;

            document.getElementById('web-chat-send').addEventListener('click', function() {
              var text = input.value.trim();
              if (text) { sendChat(text); input.value = ''; }
            });

            input.addEventListener('keydown', function(e) {
              if (e.key === 'Enter') {
                var text = input.value.trim();
                if (text) { sendChat(text); input.value = ''; }
              }
            });

            input.addEventListener('input', function() {
              sendTyping(input.value);
            });

            document.getElementById('web-chat-minimise').addEventListener('click', minimiseOverlay);
            document.getElementById('web-chat-close').addEventListener('click', endChat);
            document.getElementById('web-chat-badge').addEventListener('click', showOverlay);
          });

          // --- Notification helpers ---
          var notifUnread = 0;

          function updateNotifBadge(count) {
            notifUnread = count;
            var badge = document.getElementById('notif-badge');
            if (!badge) return;
            if (count > 0) {
              badge.textContent = count > 99 ? '99+' : count;
              badge.style.display = '';
            } else {
              badge.style.display = 'none';
            }
          }

          function addNotifToDropdown(msg) {
            var list = document.getElementById('notif-list');
            if (!list) return;
            var placeholder = list.querySelector('.text-muted');
            if (placeholder) list.innerHTML = '';

            var div = document.createElement('div');
            div.className = 'notif-item notif-unread notif-severity-' + (msg.severity || 'info');
            div.setAttribute('data-id', msg.id);
            div.innerHTML = '<div class="notif-title"><i class="bi bi-' + esc(msg.icon || 'info-circle') + ' me-1"></i>' + esc(msg.title) + '</div>' +
              (msg.body ? '<div class="notif-body">' + esc(msg.body).substring(0, 80) + '</div>' : '') +
              '<div class="notif-time">Just now</div>';
            div.addEventListener('click', function() {
              if (ws && ws.readyState === WebSocket.OPEN) {
                ws.send(JSON.stringify({ type: 'notification_read', id: msg.id }));
              }
              div.classList.remove('notif-unread');
              if (msg.link) window.location.href = msg.link;
            });
            list.insertBefore(div, list.firstChild);
            while (list.children.length > 10) list.removeChild(list.lastChild);
          }

          document.addEventListener('DOMContentLoaded', function() {
            var markAllBtn = document.getElementById('notif-mark-all');
            if (markAllBtn) {
              markAllBtn.addEventListener('click', function() {
                if (ws && ws.readyState === WebSocket.OPEN) {
                  ws.send(JSON.stringify({ type: 'notification_read_all' }));
                }
                document.querySelectorAll('.notif-unread').forEach(function(el) { el.classList.remove('notif-unread'); });
                updateNotifBadge(0);
              });
            }
          });

          // Expose for chat initiation from other page scripts
          window._webChat = {
            initiate: function(targetUserId, mode) {
              if (ws && ws.readyState === WebSocket.OPEN) {
                ws.send(JSON.stringify({ type: 'chat_initiate', targetUserId: targetUserId, mode: mode || 'sysop' }));
              }
            },
            telegram: function(targetUserId) {
              this.initiate(targetUserId, 'telegram');
            }
          };

          // Reconnect when background tab returns to foreground (if socket died)
          document.addEventListener('visibilitychange', function() {
            if (document.hidden) return;
            if (window._sessionExpired) {
              window.location.href = '/users/login';
              return;
            }
            if (window._needsReconnect || !ws || ws.readyState !== WebSocket.OPEN) {
              window._needsReconnect = false;
              reconnectAttempts = 0;
              connect();
            }
          });

          connect();
        })();
