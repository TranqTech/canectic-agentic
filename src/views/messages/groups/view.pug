extends ../../layouts/user

block content
  .container-fluid.main-wrapper
    if !currentuser
      - loginMode = 'guard'
      - loginRedirect = currentPath
      include ../../partials/users/login.pug
    else
      .row
        .col-12
          br
          br
      .row
        .col-1.d-none.d-lg-block
        .col-12.col-lg-10
          .card
            .card-header.bg-darkblue.text-white
              .row.align-items-center.gy-2
                .col-12.col-md-8
                  h2.mb-0
                    i.bi.bi-folder2-open
                    |  
                    = msgGroup.name
                .col-12.col-md-4
                  .text-md-end
                    a.btn.btn-sm.btn-outline-light(href='/messages')
                      i.bi.bi-arrow-left
                      |  Groups
            .card-body
              if msgGroup.description
                p.text-muted= msgGroup.description
              if arealist && arealist.length > 0
                //- On a phone each area is one cell plus a counts column
                //- (.list-counts); the other columns and the header row are md
                //- and up. Same shape as the threads list.
                table#areaTable.table.table-hover
                  thead.list-head
                    tr
                      th(scope='col') Area
                      th(scope='col') Description
                      th.text-center(scope='col') Messages
                      th.text-center(scope='col') Unread
                      th(scope='col') Last Post
                  tbody
                    for area of arealist
                      tr.clickable-row(data-href=`/messages/area/${area.shortcode}`)
                        td
                          strong= area.name
                          .small.d-md-none
                            if area.description
                              .text-muted= area.description
                            if area.last_message
                              div
                                span.fg-yellow= DateTime.fromMillis(Date.parse(area.last_message)).toFormat('MMM dd, yyyy')
                                |  by 
                                span.fg-green= area.last_from || '—'
                        td.list-counts.d-md-none
                          .text-nowrap(title='Messages')
                            i.bi.bi-chat-left.me-1
                            = area.msg_count || 0
                          if area.unread_count && area.unread_count > 0
                            span.badge.bg-info.mt-1(title='Unread')= area.unread_count
                        td.d-none.d-md-table-cell= area.description
                        td.text-center.d-none.d-md-table-cell= area.msg_count || 0
                        td.text-center.d-none.d-md-table-cell
                          if area.unread_count && area.unread_count > 0
                            span.badge.bg-info= area.unread_count
                          else
                            span.text-muted —
                        td.d-none.d-md-table-cell
                          if area.last_message
                            .small
                              - var ldate = Date.parse(area.last_message)
                              - var ld = DateTime.fromMillis(ldate)
                              span.fg-yellow= ld.toFormat('MMM dd, yyyy')
                              |  by 
                              span.fg-green= area.last_from || '—'
                          else
                            span.text-muted —
              else
                .text-center.py-4
                  h5.text-muted No message areas in this group

  script.
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.clickable-row').forEach(function(row) {
        row.style.cursor = 'pointer';
        row.addEventListener('click', function() {
          var href = this.getAttribute('data-href');
          if (href) window.location.href = href;
        });
      });
    });
