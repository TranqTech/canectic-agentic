extends ../layouts/user

block content
  .container-fluid.main-wrapper
    if !currentuser
      - loginMode = 'guard'
      - loginRedirect = currentPath
      include ../partials/users/login.pug
    else
      .row
        .col-12
          br
          br
      .row
        .col-1
        .col-10
          .card
            .card-header.bg-darkblue.text-white
              .d-flex.justify-content-between.align-items-center
                .d-flex.align-items-center
                  h2.mb-0.me-3
                    i.bi.bi-chat-dots.me-2
                    | Message Areas
                  .btn-group.btn-group-md
                    button.btn.btn-outline-light.view-toggle.active(data-view='subscribed') Subscribed
                    button.btn.btn-outline-light.view-toggle(data-view='all') All
                .d-flex.align-items-center
                  button#areaSort.btn.btn-sm.btn-outline-light.me-2(
                    type='button'
                    title='Toggle between the sysop ordering and most recently active first'
                  )
                    i.bi.bi-sort-down.me-1
                    span#areaSortLabel Default order
                  .input-group.input-group-sm.me-2(style='width:220px')
                    span.input-group-text
                      i.bi.bi-search
                    input#areaSearch.form-control(type='text' placeholder='Search areas...')
                  button.btn.btn-sm.btn-outline-light(data-bs-toggle='modal' data-bs-target='#helpModal' title='Help')
                    i.bi.bi-question-circle
            .card-body
              if groupedAreas && groupedAreas.length > 0
                each entry in groupedAreas
                  .group-section.mb-3(data-group=entry.group.shortcode)
                    h5.text-info.mb-2
                      i.bi.bi-folder2-open.me-1
                      = entry.group.name
                      if entry.group.description
                        small.text-muted.ms-2= entry.group.description
                    table.table.table-sm.table-hover.mb-0.area-table
                      tbody
                        each area, areaIndex in entry.areas
                          tr.area-row(
                            data-subscribed=(area.subscribed ? 'true' : 'false')
                            data-name=area.name.toLowerCase()
                            data-desc=(area.description || '').toLowerCase()
                            data-shortcode=area.shortcode
                            data-order=areaIndex
                            data-last-message=(area.last_message ? new Date(area.last_message).getTime() : 0)
                          )
                            td(style='width:30px')
                              button.btn.btn-sm.sub-toggle(
                                data-shortcode=area.shortcode
                                title=(area.subscribed ? 'Unsubscribe' : 'Subscribe')
                                class=(area.subscribed ? 'btn-success' : 'btn-outline-secondary')
                              )
                                i.bi(class=(area.subscribed ? 'bi-check-circle-fill' : 'bi-circle'))
                            td
                              a.text-decoration-none(href='/messages/area/' + area.shortcode)
                                strong= area.name
                            td= area.description || ''
                            td.text-center(style='width:80px')= area.msg_count || 0
                            td.text-center(style='width:80px')
                              if area.unread_count && area.unread_count > 0
                                span.badge.bg-info= area.unread_count
                            td(style='width:200px')
                              if area.last_message
                                .small
                                  //- "Mar 15" while recent, "Mar 2021" once old.
                                  //- A bare day made a 2021 echo look as fresh as
                                  //- last week's. Exact value is in the tooltip.
                                  div(title=formatListDateFull(area.last_message) || '')
                                    span.fg-yellow= formatListDate(area.last_message)
                                  div
                                    span.fg-green= area.last_from || ''
              else
                .text-center.py-4
                  h5.text-muted No message areas available

    //- Help Modal
    .modal.fade#helpModal(tabindex='-1')
      .modal-dialog
        .modal-content
          .modal-header
            h5.modal-title Message Areas
            button.btn-close(type='button' data-bs-dismiss='modal')
          .modal-body
            h6 Subscribing
            p Click the #[span.badge.bg-success #[i.bi.bi-check-circle-fill]] button next to an area to subscribe or unsubscribe. Subscribed areas are included in new message scans and the web call flow.
            h6 Views
            p
              strong Subscribed
              |  shows only your subscribed areas.
              strong  All
              |  shows every area you have access to, so you can discover and subscribe to new ones.
            h6 Search
            p Use the search box to quickly filter areas by name, description, or shortcode. The filter works across all groups.
            h6 Sorting
            p The sort button switches between the sysop's ordering and most recently active first. Areas are sorted within their group, and areas that have never carried a message sort last. Your choice is remembered in this browser.
            h6 Reading Messages
            p Click an area name to open it and browse threads. Unread counts are shown as badges.
          .modal-footer
            button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Close

    script(type='module' src='/js/messageAreas.js')
    script.
      document.addEventListener('DOMContentLoaded', function() {
        var currentView = 'subscribed';

        // ---- Sort -------------------------------------------------------
        // Two orders: the sysop's (whatever the server sent, preserved in
        // data-order) and most recently active first. Sorting happens inside
        // each group rather than across the whole page, so the grouping still
        // means something.
        //
        // Client side because the rows are all here already: a round trip to
        // reorder a list the browser is holding would be slower and would lose
        // the current search and view toggle.
        var SORT_KEY = 'canectic.messageAreas.sort';
        var sortMode = 'default';
        try {
          var saved = localStorage.getItem(SORT_KEY);
          if (saved === 'recent' || saved === 'default') sortMode = saved;
        } catch (e) { /* private window, or site data blocked */ }

        var sortBtn = document.getElementById('areaSort');
        var sortLabel = document.getElementById('areaSortLabel');

        function applySort() {
          // Comparator lives in /js/messageAreas.js so it can be tested.
          // If it failed to load, leave the rows in the server order rather
          // than throwing: a sort control is not worth breaking the page over.
          var sorter = window.CanecticAreaSort;
          if (sorter && typeof sorter.applyAreaSort === 'function') {
            sorter.applyAreaSort(document, sortMode);
          }

          if (sortLabel) sortLabel.textContent = (sortMode === 'recent') ? 'Recently active' : 'Default order';
          if (sortBtn) sortBtn.classList.toggle('active', sortMode === 'recent');
        }

        if (sortBtn) {
          sortBtn.addEventListener('click', function() {
            sortMode = (sortMode === 'recent') ? 'default' : 'recent';
            try { localStorage.setItem(SORT_KEY, sortMode); } catch (e) { /* not fatal */ }
            applySort();
          });
        }

        applySort();

        // View toggle
        document.querySelectorAll('.view-toggle').forEach(function(btn) {
          btn.addEventListener('click', function() {
            document.querySelectorAll('.view-toggle').forEach(function(b) { b.classList.remove('active'); });
            btn.classList.add('active');
            currentView = btn.dataset.view;
            filterAreas();
          });
        });

        // Search
        var searchInput = document.getElementById('areaSearch');
        if (searchInput) {
          searchInput.addEventListener('input', function() { filterAreas(); });
        }

        function filterAreas() {
          var query = (searchInput ? searchInput.value : '').toLowerCase().trim();
          document.querySelectorAll('.area-row').forEach(function(row) {
            var isSubscribed = row.dataset.subscribed === 'true';
            var matchesView = currentView === 'all' || isSubscribed;
            var matchesSearch = !query || row.dataset.name.includes(query) || row.dataset.desc.includes(query) || row.dataset.shortcode.toLowerCase().includes(query);
            row.style.display = (matchesView && matchesSearch) ? '' : 'none';
          });
          // Hide group sections where all rows are hidden
          document.querySelectorAll('.group-section').forEach(function(section) {
            var visibleRows = section.querySelectorAll('.area-row[style=""], .area-row:not([style])');
            var hasVisible = false;
            section.querySelectorAll('.area-row').forEach(function(r) {
              if (r.style.display !== 'none') hasVisible = true;
            });
            section.style.display = hasVisible ? '' : 'none';
          });
        }

        // Subscribe/unsubscribe toggle
        document.querySelectorAll('.sub-toggle').forEach(function(btn) {
          btn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            var shortcode = btn.dataset.shortcode;
            fetch('/messages/area/' + shortcode + '/subscribe', { method: 'POST' })
              .then(function(r) { return r.json(); })
              .then(function(data) {
                var row = btn.closest('.area-row');
                row.dataset.subscribed = data.subscribed ? 'true' : 'false';
                btn.className = 'btn btn-sm sub-toggle ' + (data.subscribed ? 'btn-success' : 'btn-outline-secondary');
                btn.title = data.subscribed ? 'Unsubscribe' : 'Subscribe';
                var icon = btn.querySelector('i');
                icon.className = 'bi ' + (data.subscribed ? 'bi-check-circle-fill' : 'bi-circle');
                filterAreas();
              });
          });
        });

        // Initial filter
        filterAreas();
      });
