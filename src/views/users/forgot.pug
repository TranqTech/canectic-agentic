extends ../layouts/user
block content
	.container-fluid.main-wrapper
		if !ismobile
			br
			br
			br
			br

		.row
			- var colClass = ismobile ? 'col-12' : 'col-6 offset-3'
			div(class=colClass)
				.card
					.card-header.text-white.bg-dark
						.h3 Forgot Password
					.card-body
						if message
							.alert.alert-success= message
						if error
							.alert.alert-danger= error

						if !message
							p.text-muted Enter your username and a password reset code will be sent to the email or netmail address on file.
							form(action='/users/forgot' method='POST')
								.mb-3
									label.form-label(for='fp_username') Username
									input.form-control(
										type='text'
										id='fp_username'
										name='username'
										required
										autofocus
									)
								.d-flex.justify-content-between.align-items-center
									a(href='/users/login') Back to Login
									button.btn.btn-primary(type='submit') Send Reset Code

						if message
							.mt-3
								a.btn.btn-outline-primary(href='/users/login') Back to Login
