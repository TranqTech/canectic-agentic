extends ../layouts/user
block content
	-var _user = user || {}
	.container-fluid.main-wrapper
		if !ismobile
			br
			br

		.row
			- var colClass = ismobile ? 'col-12' : 'col-8 offset-2'
			div(class=colClass)
				.card
					.card-header.text-white.bg-dark
						.d-flex.justify-content-between.align-items-center
							.h3.mb-0 My Profile
							span.badge.bg-secondary= 'User #' + (_user.usernumber || '')
					.card-body
						if message
							.alert.alert-success= message
						if error
							.alert.alert-danger= error

						.row
							//- Left column: Account info (read-only)
							.col-md-5
								h5.text-muted Account
								table.table.table-sm.table-dark.mb-4
									tbody
										tr
											td.text-muted(style="width:40%") Username
											td= _user.username
										tr
											td.text-muted Security Level
											td= _user.security
										tr
											td.text-muted Member Since
											td
												if _user.created_at
													= new Date(_user.created_at).toLocaleDateString()
												else
													| -
										tr
											td.text-muted Last Login
											td
												if _user.lastlogon
													= new Date(_user.lastlogon).toLocaleDateString()
												else
													| -
										tr
											td.text-muted Total Logins
											td= _user.logoncount || 0
										tr
											td.text-muted Email / Netmail
											td
												= _user.mailaddress || '-'
												if _user.mailaddress
													if _user.mailverified
														span.badge.bg-success.ms-2 Verified
													else
														span.badge.bg-warning.text-dark.ms-2 Unverified

								.d-grid.gap-2
									a.btn.btn-outline-info(href='/users/verify')
										i.bi.bi-envelope-check.me-1
										| Verify / Change Address
									a.btn.btn-outline-warning(href='#' data-bs-toggle='collapse' data-bs-target='#changePasswordSection')
										i.bi.bi-key.me-1
										| Change Password

							//- Right column: Editable fields
							.col-md-7
								h5.text-muted Edit Profile
								form(action='/users/profile' method='POST')
									.mb-3
										label.form-label Username
										.input-group
											input.form-control(
												type='text'
												name='username'
												value=_user.username
												minlength='3'
											)
										if !canChangeUsername && usernameNextChange
											.form-text.text-warning
												i.bi.bi-clock.me-1
												| Next change allowed: #{new Date(usernameNextChange).toLocaleDateString()}
										else
											.form-text Username changes are limited to once every #{cooldownDays || 90} days
									.row
										.col-6
											.mb-3
												label.form-label First Name
												input.form-control(
													type='text'
													name='firstname'
													value=_user.firstname || ''
												)
										.col-6
											.mb-3
												label.form-label Last Name
												input.form-control(
													type='text'
													name='lastname'
													value=_user.lastname || ''
												)
									.mb-3
										label.form-label Location
										input.form-control(
											type='text'
											name='location'
											value=_user.location || ''
											placeholder='City, State/Country'
										)
									.mb-3
										label.form-label Gender
										select.form-select(name='gender')
											option(value='' disabled selected=(!_user.gender)) -- Select --
											option(value='Male' selected=(_user.gender === 'Male')) Male
											option(value='Female' selected=(_user.gender === 'Female')) Female
											option(value='Other' selected=(_user.gender === 'Other')) Other
											option(value='Undisclosed' selected=(_user.gender === 'Undisclosed')) Prefer not to say
									.text-end
										button.btn.btn-success(type='submit')
											i.bi.bi-check-lg.me-1
											| Save Changes

				//- Collapsible password change section
				#changePasswordSection.collapse.mt-3
					.card
						.card-header.text-white.bg-dark
							.h5.mb-0 Change Password
						.card-body
							form(action='/users/profile/password' method='POST')
								.row
									.col-md-6.offset-md-3
										.mb-3
											label.form-label Current Password
											input.form-control(type='password' name='current_password' required autocomplete='current-password')
										.mb-3
											label.form-label New Password
											input.form-control(type='password' name='new_password' required autocomplete='new-password')
											.form-text Minimum #{pwmin || 12} characters
										.mb-3
											label.form-label Confirm New Password
											input.form-control(type='password' name='confirm_password' required autocomplete='new-password')
										.text-end
											button.btn.btn-warning(type='submit')
												i.bi.bi-key.me-1
												| Change Password

				//- Log out all other sessions
				.card.mt-3
					.card-body
						h6 Other Sessions
						small.text-muted Log out all other browsers and devices. Requires your password.
						form.mt-2(action='/users/profile/logout-all' method='POST')
							.row.align-items-end
								.col-md-5
									label.form-label Password
									input.form-control.form-control-sm(type='password' name='password' required autocomplete='current-password')
								.col-md-4.mt-2
									button.btn.btn-outline-danger.btn-sm(type='submit')
										i.bi.bi-box-arrow-right.me-1
										| Log Out All Other Sessions

				//- API tokens section
				.card.mt-3
					.card-header.text-white.bg-dark
						.d-flex.justify-content-between.align-items-center
							span
								i.bi.bi-key.me-2
								| API Tokens
							button.btn.btn-sm.btn-success(data-bs-toggle='modal' data-bs-target='#newApiTokenModal')
								i.bi.bi-plus-circle.me-1
								| New Token
					.card-body
						if newApiTokenValue
							.alert.alert-success
								.fw-bold
									i.bi.bi-check-circle.me-2
									| Token created -- copy it now:
								code.d-block.mt-2.p-2.bg-dark.text-light.rounded.user-select-all(style='word-break:break-all')= newApiTokenValue
								br
								small.text-muted This value will not be shown again. Store it somewhere safe.

						p.text-muted.small
							| API tokens authorise external clients (QWK readers, scripts, automation) to access
							| #[code /api/v1] endpoints on your behalf. Tokens are shown exactly once at creation
							| and must be stored by the client. Revoke a token to immediately stop it from working.

						if apiTokenList && apiTokenList.length > 0
							table.table.table-sm
								thead
									tr
										th Label
										th Scope
										th Last Used
										th Created
										th Status
										th(style='width:100px')
								tbody
									each t in apiTokenList
										tr(class=!t.active ? 'table-secondary' : '')
											td= t.label
											td
												span.badge.bg-info= apiScopeLabels[t.scope] || t.scope
											td
												if t.last_used_at
													small= new Date(t.last_used_at).toLocaleDateString()
												else
													small.text-muted never
											td
												small= new Date(t.created_at).toLocaleDateString()
											td
												if t.active
													span.badge.bg-success Active
												else
													span.badge.bg-secondary Revoked
											td
												if t.active
													form.d-inline(action='/users/profile/api-tokens/' + t.id + '/revoke' method='POST')
														button.btn.btn-sm.btn-warning(type='submit' title='Revoke' onclick='return confirm("Revoke this token?")')
															i.bi.bi-slash-circle
												form.d-inline(action='/users/profile/api-tokens/' + t.id + '/delete' method='POST')
													button.btn.btn-sm.btn-danger.ms-1(type='submit' title='Delete' onclick='return confirm("Permanently delete this token?")')
														i.bi.bi-trash
						else
							p.text-muted.small No tokens yet.

				//- New API Token Modal
				#newApiTokenModal.modal.fade(tabindex='-1')
					.modal-dialog.modal-dialog-centered
						.modal-content
							.modal-header.bg-dark.text-white
								h5.modal-title Create API Token
								button.btn-close.btn-close-white(type='button' data-bs-dismiss='modal')
							.modal-body
								form(action='/users/profile/api-tokens/new' method='POST')
									label.form-label Label
									input.form-control.mb-2(type='text' name='label' required placeholder='iPhone QWK reader')
									small.text-muted.d-block.mb-3 Something descriptive so you can identify this token later.

									label.form-label Scope
									select.form-select.mb-3(name='scope')
										each s in apiTokenScopes
											option(value=s)= apiScopeLabels[s] || s

									.alert.alert-warning.small
										i.bi.bi-exclamation-triangle.me-2
										| The token value will be shown exactly once after creation. Copy it immediately.

									.text-end
										button.btn.btn-secondary.me-2(type='button' data-bs-dismiss='modal') Cancel
										input.btn.btn-success(type='submit' value='Create Token')
