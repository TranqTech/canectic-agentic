extends ../layouts/user

block content
  .container.mt-4
    if !currentuser
      .alert.alert-warning Please log in to access QWK mail transfer.
    else
      h3 QWK Mail Transfer
      include ../partials/flash

      .row.mt-3
        .col-md-6
          .card.mb-3
            .card-header
              h5.mb-0 Download QWK Packet
            .card-body
              p Download a packet of new messages for offline reading.
              table.table.table-sm.mb-3
                tbody
                  tr
                    td BBS ID
                    td: strong= bbsId
                  tr
                    td Subscribed Areas
                    td= subscribedCount
                  tr
                    td New Messages
                    td
                      if newMessageCount > 0
                        span.badge.bg-success= newMessageCount
                      else
                        span.text-muted 0
                  tr
                    td Unread PMs
                    td
                      if unreadPMCount > 0
                        span.badge.bg-info= unreadPMCount
                      else
                        span.text-muted 0
                  tr
                    td Queued downloads
                    td
                      if queuedFiles > 0
                        span.badge.bg-warning.text-dark= queuedFiles
                      else
                        span.text-muted 0
              //- A packet can carry files (queued downloads, the new-files list)
              //- as well as messages, so the button stays usable.
              if newMessageCount > 0 || unreadPMCount > 0 || queuedFiles > 0
                a.btn.btn-primary(href='/qwk/download') Download QWK Packet
              else
                a.btn.btn-outline-secondary(href='/qwk/download') Download QWK Packet

        .col-md-6
          .card.mb-3
            .card-header
              h5.mb-0 Upload REP Packet
            .card-body
              p Upload a reply packet from your QWK reader to post messages.
              form(method='POST' action='/qwk/upload' enctype='multipart/form-data')
                .mb-3
                  label.form-label(for='repfile') Select .rep file:
                  input.form-control(type='file' id='repfile' name='repfile' accept='.rep' required)
                button.btn.btn-success(type='submit') Upload REP Packet

          .card.mb-3
            .card-header
              h5.mb-0 Packet Settings
            .card-body
              form(method='POST' action='/qwk/settings')
                .form-check
                  input(type='hidden' name='qwk_files' value='false')
                  input.form-check-input#qwk_files(type='checkbox' name='qwk_files' value='true' checked=qwkFiles)
                  label.form-check-label(for='qwk_files') Include a list of new files (NEWFILES.DAT)
                .form-check.mb-2
                  input(type='hidden' name='qwk_attach' value='false')
                  input.form-check-input#qwk_attach(type='checkbox' name='qwk_attach' value='true' checked=qwkAttach)
                  label.form-check-label(for='qwk_attach') Include private mail attachments
                p.small.text-muted
                  | Files you queue for download also come in your next packet. From your QWK reader, send a
                  | message to SBBS with the subject FILES ON, FILES OFF, ATTACH ON, ATTACH OFF, or
                  | FREQ followed by a file name to ask for a file.
                button.btn.btn-outline-primary(type='submit') Save Settings
