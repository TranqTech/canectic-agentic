- var activenav = activelink || ""
nav.navbar.navbar-expand-lg.bg-primary.fixed-top(data-bs-theme='dark')
  .container-fluid
    a.navbar-brand(href='/')= boardname || 'BBS Admin'
    button.navbar-toggler(type='button' data-bs-toggle='collapse' data-bs-target='#adminNavbar' aria-controls='adminNavbar' aria-expanded='false' aria-label='Toggle navigation')
      span.navbar-toggler-icon
    #adminNavbar.collapse.navbar-collapse
      ul.navbar-nav.me-auto

        //- Dashboard
        li.nav-item
          a.nav-link(
            href='/admin'
            class=activenav === 'dashboard' ? 'active' : ''
          )
            | Dashboard
            if activenav === 'dashboard'
              span.visually-hidden  (current)

        //- Messages
        li.nav-item.dropdown
          a.nav-link.dropdown-toggle(
            data-bs-toggle='dropdown'
            href='#'
            role='button'
            aria-haspopup='true'
            aria-expanded='false'
            class=(activenav === 'msgGroups' || activenav === 'msgAreas') ? 'active' : ''
          )
            | Messages
            if activenav === 'msgGroups' || activenav === 'msgAreas'
              span.visually-hidden  (current)
          .dropdown-menu
            a.dropdown-item(href='/admin/msgGroups') Message Groups
            a.dropdown-item(href='/admin/msgAreas') Message Areas

        //- Files
        li.nav-item.dropdown
          a.nav-link.dropdown-toggle(
            data-bs-toggle='dropdown'
            href='#'
            role='button'
            aria-haspopup='true'
            aria-expanded='false'
            class=(activenav === 'fileGroups' || activenav === 'fileAreas') ? 'active' : ''
          )
            | Files
            if activenav === 'fileGroups' || activenav === 'fileAreas'
              span.visually-hidden  (current)
          .dropdown-menu
            a.dropdown-item(href='/admin/fileGroups') File Groups
            a.dropdown-item(href='/admin/fileAreas') File Areas

        //- Networking
        li.nav-item.dropdown
          a.nav-link.dropdown-toggle(
            data-bs-toggle='dropdown'
            href='#'
            role='button'
            aria-haspopup='true'
            aria-expanded='false'
            class=(activenav === 'networks' || activenav === 'peers' || activenav === 'nodelists') ? 'active' : ''
          )
            | Networking
            if activenav === 'networks' || activenav === 'peers' || activenav === 'nodelists'
              span.visually-hidden  (current)
          .dropdown-menu
            a.dropdown-item(href='/admin/networks') Networks
            a.dropdown-item(href='/admin/peers') Linked Nodes
            a.dropdown-item(href='/admin/nodelists') Nodelists
            .dropdown-divider
            a.dropdown-item(href='/admin/echolists') Echolists
            a.dropdown-item(href='/admin/filebones') Filebones
            a.dropdown-item(href='/admin/freq') File Requests (FREQ)
            a.dropdown-item(href='/admin/wildcards') Inbound Wildcards
            .dropdown-divider
            a.dropdown-item(href='/admin/migrations') Migrations

        //- Content
        li.nav-item.dropdown
          a.nav-link.dropdown-toggle(
            data-bs-toggle='dropdown'
            href='#'
            role='button'
            aria-haspopup='true'
            aria-expanded='false'
            class=(activenav === 'announcements' || activenav === 'wall' || activenav === 'bulletins' || activenav === 'newsfiles' || activenav === 'seasonalart') ? 'active' : ''
          )
            | Content
            if activenav === 'announcements' || activenav === 'wall' || activenav === 'bulletins'
              span.visually-hidden  (current)
          .dropdown-menu
            a.dropdown-item(href='/admin/announcements') Announcements
            a.dropdown-item(href='/admin/bulletins') Bulletins
            a.dropdown-item(href='/admin/newsfiles') News Files
            a.dropdown-item(href='/admin/seasonal-art') Seasonal Art
            a.dropdown-item(href='/admin/wall') Wall Messages

        //- Doors
        li.nav-item.dropdown
          a.nav-link.dropdown-toggle(
            data-bs-toggle='dropdown'
            href='#'
            role='button'
            aria-haspopup='true'
            aria-expanded='false'
            class=activenav === 'doors' ? 'active' : ''
          )
            | Doors
            if activenav === 'doors'
              span.visually-hidden  (current)
          .dropdown-menu
            a.dropdown-item(href='/admin/doors') Door Games
            a.dropdown-item(href='/admin/doorCollections') Door Collections

        //- Users
        li.nav-item
          a.nav-link(
            href='/admin/users'
            class=activenav === 'users' ? 'active' : ''
          )
            | Users
            if activenav === 'users'
              span.visually-hidden  (current)

        //- Menus & Themes
        li.nav-item.dropdown
          a.nav-link.dropdown-toggle(
            data-bs-toggle='dropdown'
            href='#'
            role='button'
            aria-haspopup='true'
            aria-expanded='false'
            class=(activenav === 'menus' || activenav === 'themes') ? 'active' : ''
          )
            | Menus
            if activenav === 'menus' || activenav === 'themes'
              span.visually-hidden  (current)
          .dropdown-menu
            a.dropdown-item(href='/admin/menus') Menu Editor
            a.dropdown-item(href='/admin/themes') Themes

        //- Node Spy
        li.nav-item
          a.nav-link(
            href='/admin/nodespy'
            class=activenav === 'nodespy' ? 'active' : ''
          )
            i.bi.bi-eye.me-1
            | Nodes
            if activenav === 'nodespy'
              span.visually-hidden  (current)

        //- Timed Events
        li.nav-item
          a.nav-link(
            href='/admin/timed-events'
            class=activenav === 'timed-events' ? 'active' : ''
          )
            i.bi.bi-clock-history.me-1
            | Events
            if activenav === 'timed-events'
              span.visually-hidden  (current)

        //- System Logs
        li.nav-item
          a.nav-link(
            href='/adminlogs'
            class=activenav === 'logs' ? 'active' : ''
          )
            i.bi.bi-terminal.me-1
            | Logs
            if activenav === 'logs'
              span.visually-hidden  (current)

      //- Right side — mail link + user dropdown or login
      ul.navbar-nav.ms-auto
        if currentuser
          li.nav-item
            a.nav-link(href='/pm/inbox')
              i.bi.bi-envelope
              |  Mail
              if pmUnreadCount && pmUnreadCount > 0
                span.badge.bg-info.ms-1= pmUnreadCount
          include ../partials/notificationBell
          li.nav-item.dropdown
            a.nav-link.dropdown-toggle(
              data-bs-toggle='dropdown'
              href='#'
              role='button'
              aria-haspopup='true'
              aria-expanded='false'
            )= currentuser.username
            .dropdown-menu.dropdown-menu-end
              a.dropdown-item(href='/users/logout') Logout
        else
          li.nav-item
            a.nav-link(href='/users/login') Login