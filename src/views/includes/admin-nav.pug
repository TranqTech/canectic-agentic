- var activenav = activelink || ""
nav.navbar.navbar-expand-lg.bg-primary.fixed-top(data-bs-theme='dark')
  .container-fluid
    a.navbar-brand(href='/')= boardname || 'BBS Admin'
    button.navbar-toggler(type='button' data-bs-toggle='collapse' data-bs-target='#adminNavbar' aria-controls='adminNavbar' aria-expanded='false' aria-label='Toggle navigation')
      span.navbar-toggler-icon
    #adminNavbar.collapse.navbar-collapse
      ul.navbar-nav.me-auto

        //- Dashboard
        li.nav-item
          a.nav-link(
            href='/admin'
            class=activenav === 'dashboard' ? 'active' : ''
          )
            | Dashboard
            if activenav === 'dashboard'
              span.visually-hidden  (current)

        //- Announcements
        li.nav-item
          a.nav-link(
            href='/admin/announcements'
            class=activenav === 'announcements' ? 'active' : ''
          )
            | Announcements
            if activenav === 'announcements'
              span.visually-hidden  (current)

        //- Messages
        li.nav-item.dropdown
          a.nav-link.dropdown-toggle(
            data-bs-toggle='dropdown'
            href='#'
            role='button'
            aria-haspopup='true'
            aria-expanded='false'
            class=(activenav === 'msgGroups' || activenav === 'msgAreas') ? 'active' : ''
          )
            | Messages
            if activenav === 'msgGroups' || activenav === 'msgAreas'
              span.visually-hidden  (current)
          .dropdown-menu
            a.dropdown-item(href='/admin/msgGroups') Message Groups
            a.dropdown-item(href='/admin/msgAreas') Message Areas
            .dropdown-divider
            a.dropdown-item(href='/admin/networks') Networks
            a.dropdown-item(href='/admin/nodelists') Nodelists

        //- Doors
        li.nav-item.dropdown
          a.nav-link.dropdown-toggle(
            data-bs-toggle='dropdown'
            href='#'
            role='button'
            aria-haspopup='true'
            aria-expanded='false'
            class=activenav === 'doors' ? 'active' : ''
          )
            | Doors
            if activenav === 'doors'
              span.visually-hidden  (current)
          .dropdown-menu
            a.dropdown-item(href='/admin/doors') Door Config
            a.dropdown-item(href='/admin/doorCollections') Door Collections

        //- Files
        li.nav-item.dropdown
          a.nav-link.dropdown-toggle(
            data-bs-toggle='dropdown'
            href='#'
            role='button'
            aria-haspopup='true'
            aria-expanded='false'
            class=(activenav === 'fileGroups' || activenav === 'fileAreas') ? 'active' : ''
          )
            | Files
            if activenav === 'fileGroups' || activenav === 'fileAreas'
              span.visually-hidden  (current)
          .dropdown-menu
            a.dropdown-item(href='/admin/fileGroups') File Groups
            a.dropdown-item(href='/admin/fileAreas') File Areas

        //- Users
        li.nav-item
          a.nav-link(
            href='/admin/users'
            class=activenav === 'users' ? 'active' : ''
          )
            | Users
            if activenav === 'users'
              span.visually-hidden  (current)

        //- Menus & Themes
        li.nav-item.dropdown
          a.nav-link.dropdown-toggle(
            data-bs-toggle='dropdown'
            href='#'
            role='button'
            aria-haspopup='true'
            aria-expanded='false'
            class=(activenav === 'menus' || activenav === 'themes') ? 'active' : ''
          )
            | Menus
            if activenav === 'menus' || activenav === 'themes'
              span.visually-hidden  (current)
          .dropdown-menu
            a.dropdown-item(href='/admin/menus') Menu Editor
            a.dropdown-item(href='/admin/themes') Themes

        //- Config
        li.nav-item
          a.nav-link(
            href='/admin/config'
            class=activenav === 'config' ? 'active' : ''
          )
            i.bi.bi-gear.me-1
            | Config
            if activenav === 'config'
              span.visually-hidden  (current)

        //- System Logs
        li.nav-item
          a.nav-link(
            href='/adminlogs'
            class=activenav === 'logs' ? 'active' : ''
          )
            i.bi.bi-terminal.me-1
            | Logs
            if activenav === 'logs'
              span.visually-hidden  (current)

      //- Right side — mail link + user dropdown or login
      ul.navbar-nav.ms-auto
        if currentuser
          li.nav-item
            a.nav-link(href='/pm/inbox')
              i.bi.bi-envelope
              |  Mail
              if pmUnreadCount && pmUnreadCount > 0
                span.badge.bg-info.ms-1= pmUnreadCount
          li.nav-item.dropdown
            a.nav-link.dropdown-toggle(
              data-bs-toggle='dropdown'
              href='#'
              role='button'
              aria-haspopup='true'
              aria-expanded='false'
            )= currentuser.username
            .dropdown-menu.dropdown-menu-end
              a.dropdown-item(href='/users/logout') Logout
        else
          li.nav-item
            a.nav-link(href='/users/login') Login