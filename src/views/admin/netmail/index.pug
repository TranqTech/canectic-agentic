extends ../../layouts/admin

block content  
  .container-fluid.main-wrapper
    if !ismobile
      .row
        .col-12
          br
          br
      .row
        .col-3
        .col-6              
          .card.bg-light.border-primary
            .card-header.bg-darkblue.text-white
              .row
                .col-8
                  h2= title
                .col-4
                  .text-end
                    a.button.btn.btn-lg.btn-info(href='/admin')
                      |Exit
            .card-body
              if errormessages && errormessages.length > 0
                ul.text-danger
                  for error of errormessages
                    li.text-danger
                      =error
                br

              
              .row
                .col-8
                  #nmtabs.nav.nav-pills(role='tablist')
                    button#nav-inbound-tab.nav-link.active(data-bs-toggle='tab' data-bs-target='#nav-inbound' type='button' role='tab' aria-controls='nav-inbound' aria-selected='true') Inbound

                    button#nav-outbound-tab.nav-link(data-bs-toggle='tab' data-bs-target='#nav-outbound' type='button' role='tab' aria-controls='nav-outbound' aria-selected='false') Outbound
                .col-4
                  .text-end
                    button.btn.btn-lg.btn-success(data-bs-toggle='modal' data-bs-target=`#newNetmailModal`)
                      |Send Netmail
              #nmtabs.tab-content
                #nav-inbound.tab-pane.fade.show.active(role='tabpanel' aria-labelledby='inbound-tab')
                  if inboundlist && inboundlist.length > 0
                    br
                    table#InboundNetmail.table.table-hover
                          thead
                            tr
                              th(scope='col') Date
                              th(scope='col') To
                              th(scope='col') From
                              //th(scope='col') Remote
                              th(scope='col') Subject
                            tbody
                              for msg of inboundlist
                                tr(data-bs-msgid=msg.uuid)
                                  td
                                    - var e1date = Date.parse(msg.system_time)
                                    - var edate = DateTime.fromMillis(e1date)
                                    = edate.toFormat('MMMM dd, yyyy - HH:mm')
                                  td
                                    =msg.to_user
                                  td
                                    =msg.from_user
                                    |@
                                    =msg.source
                                  //- td
                                  //-   =msg.Source
                                  td
                                    =msg.subject
                  else
                    center
                      br
                      h4
                        |No messages found!
                #nav-outbound.tab-pane.fade(role='tabpanel' aria-labelledby='outbound-tab')
                  if outboundlist && outboundlist.length > 0
                    br
                    table#OutboundNetmail.table.table-hover
                          thead
                            tr
                              th(scope='col') Date
                              th(scope='col') From
                              th(scope='col') To
                              th(scope='col') Subject
                            tbody
                              for msg of outboundlist
                                tr(data-bs-msgid=msg.uuid)
                                  td
                                    - var e1date = Date.parse(msg.system_time)
                                    - var edate = DateTime.fromMillis(e1date)
                                    = edate.toFormat('MMMM dd, yyyy - HH:mm')
                                  td
                                    =msg.from_user
                                  td
                                    =msg.to_user
                                    |@
                                    =msg.destination
                                  //- td
                                  //-   =msg.Source
                                  td
                                    =msg.subject
                  else
                    center
                      br
                      h4
                        |No messages found!

      #newNetmailModal.modal.fade(tabindex='-1' aria-labelledby='' aria-hidden='true')
        .modal-dialog.modal-dialog-centered.modal-lg
          .modal-content
            .modal-header.bg-dark.text-white
              h3.modal-title
                  |New Netmail
              button.btn.btn-lg.btn-close(data-bs-dismiss="modal")
            .modal-body.bg-light
              form(action=`/admin/netmail/new` method="POST" class="form-registration")
                .row
                  .col-1
                  .col-5
                    label(for="ToUser") To User:
                    input(
                      type="text"
                      id="ToUser"
                      name="ToUser"
                      class="form-control"
                      required
                    )
                  .col-5
                    label(for="Destination") Node Address:
                    input(
                      type="text"
                      id="Destination"
                      name="Destination"
                      class="form-control"
                      required
                    )                    
                .row
                  .col-1
                  .col-10
                    br
                    label(for="Subject") Subject:
                    input(
                      type="text"
                      id="Subject"
                      name="Subject"
                      class="form-control"
                      required
                    )
                    br
                    label(for="Message") Message Body:
                    textarea(
                      type="text"
                      id="Message"
                      rows=15
                      name="Message"
                      class="form-control"
                      required
                    )
                    br
                .row
                  .col-1
                  .col-10
                    br
                    .text-end
                      input(
                        type="submit"
                        value="Submit"
                        class="btn btn-lg btn-success btn-block"
                        )

  script.
    
    document.addEventListener('DOMContentLoaded', function() {
      const intable = document.getElementById('InboundNetmail');
      const outtable = document.getElementById('OutboundNetmail');
      // Add click event listener to inbound table rows
      if (intable) {
        // Add click event to all tbody rows
        const rows = intable.querySelectorAll('tbody tr');
        
        rows.forEach(row => {
          // Add pointer cursor to indicate clickable rows
          row.style.cursor = 'pointer';
          
          row.addEventListener('click', function() {
            const msgid = this.getAttribute('data-bs-msgid');
            
            if (msgid) {
              // Navigate to the msgGroup page
              window.location.href = `/admin/netmail/in/${msgid}`;
            }
          });
        });
      }
      // Add click event listener to outbound table rows
      if (outtable) {
        // Add click event to all tbody rows
        const rows = outtable.querySelectorAll('tbody tr');
        
        rows.forEach(row => {
          // Add pointer cursor to indicate clickable rows
          row.style.cursor = 'pointer';
          
          row.addEventListener('click', function() {
            const msgid = this.getAttribute('data-bs-msgid');
            
            if (msgid) {
              // Navigate to the msgGroup page
              window.location.href = `/admin/netmail/out/${msgid}`;
            }
          });
        });
      }
    });