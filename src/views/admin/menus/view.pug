extends ../../layouts/admin

block content
  .container-fluid.main-wrapper
    if !currentuser
      - loginMode = 'guard'
      - loginRedirect = currentPath
      include ../../partials/users/login.pug
    else if !sufficientAccess
      include ../../partials/status/unauthorized.pug
    else
      if !ismobile
        .row
          .col-12
            br
            br
        .row
          .col-1
          .col-8
            if !menu
              .card
                .card-header.bg-darkblue.text-white
                  h2 Menu Not Found
                .card-body
                  a.btn.btn-info(href='/admin/menus') Back to Menus
            else
              //- Menu Properties Card
              .card.mb-3
                .card-header.bg-darkblue.text-white
                  .row
                    .col-8
                      h2
                        | Menu: 
                        = menu.name
                    .col-4
                      .text-end
                        a.button.btn.btn-sm.btn-info(href='/admin/menus')
                          | Back
                .card-body
                  .row
                    .col-4
                      h5
                        | Title: 
                        span.text-info= menu.title
                      h6
                        | Type: 
                        span.badge.bg-secondary= menu.menu_type || 'Hotkey'
                      h6
                        | Display Entries:
                        if menu.display_entries === 'auto'
                          span.badge.bg-success Auto
                        else if menu.display_entries === 'art'
                          span.badge.bg-info Art Defined
                        else
                          span.badge.bg-secondary Off
                      h6
                        | Layout: #{menu.max_columns || 3} cols, gap #{menu.col_gap || 2}, #{menu.fill_order || 'columns'}-first
                        if menu.center_vertical
                          |  (centred)
                    .col-4
                      if menu.display_file
                        h6
                          | Display File: 
                          span.text-muted= menu.display_file
                        h6
                          | File Type: 
                          span.text-muted= menu.display_file_type || '(misc)'
                      else
                        h6.text-muted No display file
                    .col-4
                      h6
                        | Margins: T=#{menu.margin_top} B=#{menu.margin_bottom} L=#{menu.margin_left} R=#{menu.margin_right}
                      h6 Colours:
                      .small
                        if menu.title_clr !== null && menu.title_clr !== undefined
                          - var tc = (ansiColors || []).find(c => c.value === menu.title_clr)
                          | Title: 
                          if tc
                            span(style='color:' + tc.hex)= tc.label
                          |  
                        if menu.prompt_clr !== null && menu.prompt_clr !== undefined
                          - var pc = (ansiColors || []).find(c => c.value === menu.prompt_clr)
                          | Prompt: 
                          if pc
                            span(style='color:' + pc.hex)= pc.label
                          |  
                        if menu.input_clr !== null && menu.input_clr !== undefined
                          - var ic = (ansiColors || []).find(c => c.value === menu.input_clr)
                          | Input: 
                          if ic
                            span(style='color:' + ic.hex)= ic.label
                          |  
                        if menu.hotkey_clr !== null && menu.hotkey_clr !== undefined
                          - var hc = (ansiColors || []).find(c => c.value === menu.hotkey_clr)
                          | Hotkey: 
                          if hc
                            span(style='color:' + hc.hex)= hc.label
                          |  
                        if menu.error_clr !== null && menu.error_clr !== undefined
                          - var ec = (ansiColors || []).find(c => c.value === menu.error_clr)
                          | Error:
                          if ec
                            span(style='color:' + ec.hex)= ec.label
                          |
                        if menu.menu_prompt_clr !== null && menu.menu_prompt_clr !== undefined
                          - var mpc = (ansiColors || []).find(c => c.value === menu.menu_prompt_clr)
                          | Menu Prompt:
                          if mpc
                            span(style='color:' + mpc.hex)= mpc.label
                          |
                        if menu.featured_clr !== null && menu.featured_clr !== undefined
                          - var fc = (ansiColors || []).find(c => c.value === menu.featured_clr)
                          | Featured:
                          if fc
                            span(style='color:' + fc.hex)= fc.label
                        if menu.title_clr === null && menu.prompt_clr === null && menu.input_clr === null && menu.hotkey_clr === null && menu.error_clr === null && menu.menu_prompt_clr === null && menu.featured_clr === null
                          span.text-muted (using theme defaults)

              //- Entries Card
              .card
                .card-header.bg-darkblue.text-white
                  .row
                    .col-8
                      h4 Menu Entries
                    .col-4
                      .text-end
                        button#saveEntryOrderBtn.btn.btn-sm.btn-warning.me-2(style='display:none' title='Save reordered entry positions')
                          i.bi.bi-arrow-down-up
                          |  Save Order
                        button.btn.btn-sm.btn-success(data-bs-toggle='modal' data-bs-target='#newEntryModal')
                          | Add Entry
                .card-body
                  if entries && entries.length > 0
                    table#entryTable.table.table-hover.table-sm
                      thead
                        tr
                          th(scope='col' style='width:30px')
                          th(scope='col' style='width:50px') #
                          th(scope='col' style='width:60px') Hotkey
                          th(scope='col') Display Text
                          th(scope='col') Command
                          th(scope='col') Argument
                          th(scope='col' style='width:80px') Security
                          th(scope='col' style='width:60px') FG
                          th(scope='col' style='width:60px') BG
                          th(scope='col' style='width:120px') Actions
                      tbody#sortableEntries
                        for entry in entries
                          tr.entry-row(
                            data-id=entry.id
                            data-sort=entry.sort_order
                            data-hotkey=entry.hotkey
                            data-display=entry.display
                            data-command_name=entry.command_name
                            data-command_arg=entry.command_arg
                            data-fg_clr=(entry.fg_clr !== null && entry.fg_clr !== undefined ? entry.fg_clr : '')
                            data-bg_clr=(entry.bg_clr !== null && entry.bg_clr !== undefined ? entry.bg_clr : '')
                            data-featured=(entry.featured ? 'true' : 'false')
                            data-min_security=(entry.min_security !== null && entry.min_security !== undefined ? entry.min_security : '')
                            data-required_flags=JSON.stringify(entry.required_flags || [])
                            data-prohibited_flags=JSON.stringify(entry.prohibited_flags || [])
                          )
                            td.drag-handle(style='cursor:grab; text-align:center; color:#888')
                              i.bi.bi-grip-vertical
                            td.text-muted= entry.sort_order
                            td
                              if entry.hotkey
                                span.badge.bg-warning.text-dark= entry.hotkey
                            td
                              if entry.featured
                                i.bi.bi-star-fill.text-warning.me-1(title='Featured')
                              if entry.display
                                = entry.display
                              else
                                span.text-muted.fst-italic (hidden)
                            td
                              span.badge.bg-primary= entry.command_name
                            td
                              if entry.command_arg
                                small.text-muted= entry.command_arg
                              else
                                | —
                            td.text-center
                              if entry.min_security !== null && entry.min_security !== undefined
                                = entry.min_security
                              else
                                | —
                            td.text-center
                              if entry.fg_clr !== null && entry.fg_clr !== undefined
                                - var fgMatch = (ansiColors || []).find(c => c.value === entry.fg_clr)
                                if fgMatch
                                  span(style='color:' + fgMatch.hex + '; font-weight:bold')= fgMatch.label
                              else
                                span.text-muted Theme
                            td.text-center
                              if entry.bg_clr !== null && entry.bg_clr !== undefined
                                - var bgMatch = (ansiColors || []).find(c => c.value === entry.bg_clr)
                                if bgMatch
                                  span.px-2.rounded(style='background:' + bgMatch.hex + '; color:' + (entry.bg_clr > 6 ? '#000' : '#fff'))= bgMatch.label
                              else
                                span.text-muted Theme
                            td
                              button.btn.btn-xs.btn-outline-warning.me-1.edit-entry-btn(type='button' title='Edit')
                                i.bi.bi-pencil
                              form.d-inline(action='/admin/menus/' + menu.id + '/entries/' + entry.id + '/delete' method='POST')
                                button.btn.btn-xs.btn-outline-danger(type='submit' title='Delete' onclick="return confirm('Delete this entry?')")
                                  i.bi.bi-trash
                  else
                    center
                      .h5.text-muted No entries yet
                      p Add entries to build this menu

          //- Sidebar
          .col-2
            .row
              .col-12
                .card.bg-light
                  .card-header.bg-darkblue.text-white
                    .h6 Quick Actions
                  .card-body.bg-dark
                    .d-grid.gap-1
                      a.btn.btn-danger(href='/admin/menus')
                        | Exit
                      if menu
                        br
                        h6.text-white.mb-1 Menu:
                        button.btn.btn-warning.w-100(data-bs-toggle='modal' data-bs-target='#editMenuModal')
                          | Edit Menu
                        button.btn.btn-danger.w-100.mt-1(data-bs-toggle='modal' data-bs-target='#deleteMenuModal')
                          | Delete Menu
                        br
                        h6.text-white.mb-1 Entries:
                        button.btn.btn-success.w-100(data-bs-toggle='modal' data-bs-target='#newEntryModal')
                          | Add Entry

    if menu
      //- Edit Menu Modal
      #editMenuModal.modal.fade(tabindex='-1' aria-hidden='true')
        .modal-dialog.modal-dialog-centered.modal-lg
          .modal-content
            .modal-header.bg-dark.text-white
              h3.modal-title Edit Menu
              button.btn.btn-lg.btn-close.btn-close-white(data-bs-dismiss='modal')
            .modal-body
              form(action='/admin/menus/' + menu.id + '/update' method='POST')
                ul.nav.nav-tabs.mb-3(role='tablist')
                  li.nav-item(role='presentation')
                    button.nav-link.active(data-bs-toggle='tab' data-bs-target='#emConfigPane' type='button' role='tab') Configuration
                  li.nav-item(role='presentation')
                    button.nav-link(data-bs-toggle='tab' data-bs-target='#emLayoutPane' type='button' role='tab') Layout
                  li.nav-item(role='presentation')
                    button.nav-link(data-bs-toggle='tab' data-bs-target='#emColourPane' type='button' role='tab') Colours
                .tab-content
                  #emConfigPane.tab-pane.fade.show.active(role='tabpanel')
                    .row
                      .col-1
                      .col-10
                        label.form-label Menu Identifier:
                        input.form-control(type='text' name='name' value=menu.name required pattern='[a-z0-9_-]+')
                        .form-text Lowercase letters, numbers, hyphens, and underscores only.
                        br
                        label.form-label Display Title Text:
                        input.form-control(type='text' name='title' value=menu.title)
                    br
                    .row
                      .col-1
                      .col-3
                        label.form-label Menu Type:
                        select.form-control(name='menu_type')
                          for mt in menuTypes
                            option(value=mt selected=(menu.menu_type === mt))= mt
                      .col-3
                        label.form-label Display Title:
                        select.form-control(name='display_title')
                          option(value='true' selected=(menu.display_title !== false)) Yes
                          option(value='false' selected=(menu.display_title === false)) No
                      .col-4
                        label.form-label Display Entries:
                        select.form-control(name='display_entries')
                          option(value='auto' selected=(menu.display_entries === 'auto')) Auto
                          option(value='off' selected=(menu.display_entries === 'off')) Off
                          option(value='art' selected=(menu.display_entries === 'art')) Art Defined
                    br
                    .row
                      .col-1
                      .col-5
                        label.form-label Display File Name:
                        input.form-control(type='text' name='display_file' value=menu.display_file || '' placeholder='e.g. mainmenu')
                        .form-text Art filename only -- no path or extension.
                      .col-5
                        label.form-label Display File Type:
                        select.form-control(name='display_file_type')
                          option(value='' selected=(!menu.display_file_type || menu.display_file_type === '')) -- None --
                          option(value='Screen' selected=(menu.display_file_type === 'Screen')) Screen (full-screen art)
                          option(value='Header' selected=(menu.display_file_type === 'Header')) Header (header art)

                  #emLayoutPane.tab-pane.fade(role='tabpanel')
                    h6 Entry Region Margins
                    .form-text.mb-3 Rows/columns reserved around the entry display area. Margins are best-effort and will relax if needed to fit all entries.
                    .row
                      .col-3
                        label.form-label Top:
                        input.form-control(type='number' name='margin_top' value=(menu.margin_top !== null && menu.margin_top !== undefined ? menu.margin_top : 3) min='0')
                      .col-3
                        label.form-label Bottom:
                        input.form-control(type='number' name='margin_bottom' value=(menu.margin_bottom !== null && menu.margin_bottom !== undefined ? menu.margin_bottom : 3) min='0')
                      .col-3
                        label.form-label Left:
                        input.form-control(type='number' name='margin_left' value=(menu.margin_left !== null && menu.margin_left !== undefined ? menu.margin_left : 2) min='0')
                      .col-3
                        label.form-label Right:
                        input.form-control(type='number' name='margin_right' value=(menu.margin_right !== null && menu.margin_right !== undefined ? menu.margin_right : 2) min='0')
                    hr
                    h6 Column Layout
                    .row
                      .col-3
                        label.form-label Max Columns:
                        input.form-control(type='number' name='max_columns' value=(menu.max_columns || 3) min='1' max='10')
                      .col-3
                        label.form-label Col Gap:
                        input.form-control(type='number' name='col_gap' value=(menu.col_gap || 2) min='0')
                      .col-3
                        label.form-label Fill Order:
                        select.form-control(name='fill_order')
                          option(value='columns' selected=(menu.fill_order !== 'rows')) Columns
                          option(value='rows' selected=(menu.fill_order === 'rows')) Rows
                      .col-3
                        label.form-label Centre Vertical:
                        select.form-control(name='center_vertical')
                          option(value='false' selected=!menu.center_vertical) No
                          option(value='true' selected=menu.center_vertical) Yes

                  #emColourPane.tab-pane.fade(role='tabpanel')
                    .d-flex.justify-content-between.align-items-center.mb-3
                      .form-text Leave as "Theme Default" to inherit from the active terminal theme.
                      button.btn.btn-sm.btn-outline-secondary.reset-colours-btn(type='button') Reset All to Theme
                    .row
                      .col-6
                        label.form-label Title Colour:
                        select.form-control.bg-dark.color-select(name='title_clr')
                          option(value='' selected=(menu.title_clr === null || menu.title_clr === undefined)) -- Theme Default --
                          for clr in ansiColors
                            option(value=clr.value selected=(menu.title_clr === clr.value) style='color:' + clr.hex)= clr.label
                      .col-6
                        label.form-label Prompt Colour:
                        select.form-control.bg-dark.color-select(name='prompt_clr')
                          option(value='' selected=(menu.prompt_clr === null || menu.prompt_clr === undefined)) -- Theme Default --
                          for clr in ansiColors
                            option(value=clr.value selected=(menu.prompt_clr === clr.value) style='color:' + clr.hex)= clr.label
                    .row.mt-2
                      .col-6
                        label.form-label Input Colour:
                        select.form-control.bg-dark.color-select(name='input_clr')
                          option(value='' selected=(menu.input_clr === null || menu.input_clr === undefined)) -- Theme Default --
                          for clr in ansiColors
                            option(value=clr.value selected=(menu.input_clr === clr.value) style='color:' + clr.hex)= clr.label
                      .col-6
                        label.form-label Hotkey Colour:
                        select.form-control.bg-dark.color-select(name='hotkey_clr')
                          option(value='' selected=(menu.hotkey_clr === null || menu.hotkey_clr === undefined)) -- Theme Default --
                          for clr in ansiColors
                            option(value=clr.value selected=(menu.hotkey_clr === clr.value) style='color:' + clr.hex)= clr.label
                    .row.mt-2
                      .col-6
                        label.form-label Error Colour:
                        select.form-control.bg-dark.color-select(name='error_clr')
                          option(value='' selected=(menu.error_clr === null || menu.error_clr === undefined)) -- Theme Default --
                          for clr in ansiColors
                            option(value=clr.value selected=(menu.error_clr === clr.value) style='color:' + clr.hex)= clr.label
                      .col-6
                        label.form-label Menu Prompt Colour:
                        select.form-control.bg-dark.color-select(name='menu_prompt_clr')
                          option(value='' selected=(menu.menu_prompt_clr === null || menu.menu_prompt_clr === undefined)) -- Theme Default --
                          for clr in ansiColors
                            option(value=clr.value selected=(menu.menu_prompt_clr === clr.value) style='color:' + clr.hex)= clr.label
                    .row.mt-2
                      .col-6
                        label.form-label Featured Colour:
                        select.form-control.bg-dark.color-select(name='featured_clr')
                          option(value='' selected=(menu.featured_clr === null || menu.featured_clr === undefined)) -- Theme Default --
                          for clr in ansiColors
                            option(value=clr.value selected=(menu.featured_clr === clr.value) style='color:' + clr.hex)= clr.label

                .row.mt-3
                  .col-12
                    .text-end
                      input.btn.btn-lg.btn-success(type='submit' value='Save Changes')

      //- Delete Menu Modal
      #deleteMenuModal.modal.fade(tabindex='-1' aria-hidden='true')
        .modal-dialog.modal-dialog-centered
          .modal-content
            .modal-header.bg-danger.text-white
              h3.modal-title Delete Menu
              button.btn.btn-lg.btn-close.btn-close-white(data-bs-dismiss='modal')
            .modal-body
              p
                | Are you sure you want to delete menu 
                strong= menu.name
                | ? This will also delete all menu entries.
              form(action='/admin/menus/' + menu.id + '/delete' method='POST')
                .text-end
                  button.btn.btn-secondary.me-2(type='button' data-bs-dismiss='modal') Cancel
                  input.btn.btn-danger(type='submit' value='Delete Menu')

      //- New Entry Modal
      #newEntryModal.modal.fade(tabindex='-1' aria-hidden='true')
        .modal-dialog.modal-dialog-centered.modal-lg
          .modal-content
            .modal-header.bg-dark.text-white
              h3.modal-title Add Menu Entry
              button.btn.btn-lg.btn-close.btn-close-white(data-bs-dismiss='modal')
            .modal-body
              form(action='/admin/menus/' + menu.id + '/entries/new' method='POST')
                .row
                  .col-1
                  .col-5
                    label.form-label Hotkey (1–4 chars):
                    input.form-control(type='text' name='hotkey' maxlength='4' placeholder='e.g. M, Q, 1, ?')
                  .col-5
                    label.form-label Display Text:
                    input.form-control(type='text' name='display' placeholder='e.g. M) Messages — leave blank for hidden hotkey')
                br
                .row
                  .col-1
                  .col-5
                    label.form-label Command:
                    select#ne_command.form-control.cmd-select(name='command_name')
                      for cmd in availCommands
                        option(value=cmd.name)= cmd.label
                  .col-5.arg-wrapper(style='display:none')
                    label.form-label.arg-label Argument:
                    select.form-control.arg-select(name='command_arg')
                      option(value='') -- Select --
                br
                .row
                  .col-1
                  .col-2
                    label.form-label Sort Order:
                    input.form-control(type='number' name='sort_order' value='0')
                  .col-2
                    label.form-label Min Security:
                    input.form-control(type='number' name='min_security' min='0' max='255' placeholder='any')
                  .col-2
                    label.form-label Featured:
                    select.form-control(name='featured')
                      option(value='false' selected) No
                      option(value='true') Yes
                  .col-2
                    label.form-label FG Colour:
                    select.form-control.bg-dark.color-select(name='fg_clr')
                      option(value='' selected) Theme
                      for clr in ansiColors
                        option(value=clr.value style='color:' + clr.hex)= clr.label
                  .col-2
                    label.form-label BG Colour:
                    select.form-control.bg-dark.color-select(name='bg_clr')
                      option(value='' selected) Theme
                      for clr in ansiColors
                        option(value=clr.value style='color:' + clr.hex)= clr.label
                br
                .row
                  .col-1
                  .col-5
                    label.form-label Required Flags:
                    select.form-control(name='required_flags' multiple size='4')
                      for perm in availablePermissions
                        option(value=perm)= perm
                    .form-text User must have ALL selected flags
                  .col-5
                    label.form-label Prohibited Flags:
                    select.form-control(name='prohibited_flags' multiple size='4')
                      for restr in availableRestrictions
                        option(value=restr)= restr
                    .form-text User must have NONE of these
                br
                .row
                  .col-1
                  .col-10
                    .text-end
                      input.btn.btn-lg.btn-success(type='submit' value='Add Entry')

      //- Edit Entry Modal
      #editEntryModal.modal.fade(tabindex='-1' aria-hidden='true')
        .modal-dialog.modal-dialog-centered.modal-lg
          .modal-content
            .modal-header.bg-dark.text-white
              h3.modal-title Edit Entry
              button.btn.btn-lg.btn-close.btn-close-white(data-bs-dismiss='modal')
            .modal-body
              form#editEntryForm(method='POST')
                .row
                  .col-1
                  .col-5
                    label.form-label Hotkey:
                    input#ee_hotkey.form-control(type='text' name='hotkey' maxlength='4')
                  .col-5
                    label.form-label Display Text:
                    input#ee_display.form-control(type='text' name='display')
                br
                .row
                  .col-1
                  .col-5
                    label.form-label Command:
                    select#ee_command.form-control.cmd-select(name='command_name')
                      for cmd in availCommands
                        option(value=cmd.name)= cmd.label
                  .col-5.arg-wrapper(style='display:none')
                    label.form-label.arg-label Argument:
                    select#ee_arg.form-control.arg-select(name='command_arg')
                      option(value='') -- Select --
                br
                .row
                  .col-1
                  .col-2
                    label.form-label Sort Order:
                    input#ee_sort.form-control(type='number' name='sort_order' value='0')
                  .col-2
                    label.form-label Min Security:
                    input#ee_security.form-control(type='number' name='min_security' min='0' max='255' placeholder='any')
                  .col-2
                    label.form-label Featured:
                    select#ee_featured.form-control(name='featured')
                      option(value='false') No
                      option(value='true') Yes
                  .col-2
                    label.form-label FG Colour:
                    select#ee_fg.form-control.bg-dark.color-select(name='fg_clr')
                      option(value='') Theme
                      for clr in ansiColors
                        option(value=clr.value style='color:' + clr.hex)= clr.label
                  .col-2
                    label.form-label BG Colour:
                    select#ee_bg.form-control.bg-dark.color-select(name='bg_clr')
                      option(value='') Theme
                      for clr in ansiColors
                        option(value=clr.value style='color:' + clr.hex)= clr.label
                br
                .row
                  .col-1
                  .col-5
                    label.form-label Required Flags:
                    select#ee_required.form-control(name='required_flags' multiple size='4')
                      for perm in availablePermissions
                        option(value=perm)= perm
                  .col-5
                    label.form-label Prohibited Flags:
                    select#ee_prohibited.form-control(name='prohibited_flags' multiple size='4')
                      for restr in availableRestrictions
                        option(value=restr)= restr
                br
                .row
                  .col-1
                  .col-10
                    .text-end
                      input.btn.btn-lg.btn-success(type='submit' value='Save Changes')

  script.
    document.addEventListener('DOMContentLoaded', function() {
      var menuId = !{menu ? menu.id : 'null'};

      // --- Command argument data ---
      var argData = {
        loadMenu: !{JSON.stringify((allMenus || []).filter(function(m) { return m.name !== menu.name; }).map(function(m) { return { value: m.name, label: (m.title || m.name) + ' (' + m.name + ')' }; }))},
        runXtrn: !{JSON.stringify((allDoors || []).map(function(d) { return { value: d.slug, label: d.name + ' (' + d.slug + ')' }; }))}
      };

      // Show/hide argument select and populate options based on selected command
      function syncArgField(cmdSel) {
        var wrapper = cmdSel.closest('.row').querySelector('.arg-wrapper');
        var argSel = wrapper.querySelector('.arg-select');
        var label = wrapper.querySelector('.arg-label');
        var cmd = cmdSel.value;
        var items = argData[cmd];

        if (!items) {
          wrapper.style.display = 'none';
          argSel.value = '';
          return;
        }

        // Set label
        if (cmd === 'loadMenu') label.textContent = 'Menu:';
        else if (cmd === 'runXtrn') label.textContent = 'Door:';
        else label.textContent = 'Argument:';

        // Populate options (preserve current value if possible)
        var curVal = argSel.value;
        argSel.innerHTML = '<option value="">-- Select --</option>';
        for (var i = 0; i < items.length; i++) {
          var opt = document.createElement('option');
          opt.value = items[i].value;
          opt.textContent = items[i].label;
          if (items[i].value === curVal) opt.selected = true;
          argSel.appendChild(opt);
        }

        wrapper.style.display = '';
      }

      // Bind command selects
      document.querySelectorAll('.cmd-select').forEach(function(sel) {
        syncArgField(sel);
        sel.addEventListener('change', function() { syncArgField(this); });
      });

      // --- Color select sync ---
      // Browsers don't show option inline styles in the closed select.
      // Copy the selected option's color onto the select element itself.
      function syncSelectColor(sel) {
        var opt = sel.options[sel.selectedIndex];
        sel.style.color = opt && opt.style.color ? opt.style.color : 'var(--bs-secondary-color)';
      }
      document.querySelectorAll('.color-select').forEach(function(sel) {
        syncSelectColor(sel);
        sel.addEventListener('change', function() { syncSelectColor(this); });
      });

      // Reset all colour selects in the parent tab pane to Theme Default
      document.querySelectorAll('.reset-colours-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var pane = this.closest('.tab-pane');
          if (!pane) return;
          pane.querySelectorAll('.color-select').forEach(function(sel) {
            sel.value = '';
            syncSelectColor(sel);
          });
        });
      });

      // --- Drag and drop reorder for entries ---
      var entryTbody = document.getElementById('sortableEntries');
      var saveEntryBtn = document.getElementById('saveEntryOrderBtn');
      var entryDragRow = null;
      var entryOrderChanged = false;

      if (entryTbody) {
        entryTbody.addEventListener('dragstart', function(e) {
          var tr = e.target.closest('tr');
          if (!tr) return;
          entryDragRow = tr;
          tr.style.opacity = '0.4';
          e.dataTransfer.effectAllowed = 'move';
        });

        entryTbody.addEventListener('dragend', function(e) {
          var tr = e.target.closest('tr');
          if (tr) tr.style.opacity = '';
          entryDragRow = null;
          entryTbody.querySelectorAll('tr').forEach(function(r) {
            r.style.borderTop = '';
            r.style.borderBottom = '';
          });
        });

        entryTbody.addEventListener('dragover', function(e) {
          e.preventDefault();
          e.dataTransfer.dropEffect = 'move';
          var tr = e.target.closest('tr');
          if (!tr || tr === entryDragRow) return;
          entryTbody.querySelectorAll('tr').forEach(function(r) {
            r.style.borderTop = '';
            r.style.borderBottom = '';
          });
          var rect = tr.getBoundingClientRect();
          var mid = rect.top + rect.height / 2;
          if (e.clientY < mid) {
            tr.style.borderTop = '2px solid #f0ad4e';
          } else {
            tr.style.borderBottom = '2px solid #f0ad4e';
          }
        });

        entryTbody.addEventListener('drop', function(e) {
          e.preventDefault();
          var tr = e.target.closest('tr');
          if (!tr || !entryDragRow || tr === entryDragRow) return;
          var rect = tr.getBoundingClientRect();
          var mid = rect.top + rect.height / 2;
          if (e.clientY < mid) {
            entryTbody.insertBefore(entryDragRow, tr);
          } else {
            entryTbody.insertBefore(entryDragRow, tr.nextSibling);
          }
          entryOrderChanged = true;
          saveEntryBtn.style.display = 'inline-block';
          entryTbody.querySelectorAll('tr').forEach(function(r) {
            r.style.borderTop = '';
            r.style.borderBottom = '';
          });
        });

        entryTbody.querySelectorAll('tr').forEach(function(tr) {
          tr.setAttribute('draggable', 'true');
        });
      }

      if (saveEntryBtn && menuId) {
        saveEntryBtn.addEventListener('click', function() {
          if (!entryOrderChanged) return;
          var rows = entryTbody.querySelectorAll('tr');
          var ids = [];
          rows.forEach(function(r) { ids.push(parseInt(r.dataset.id)); });
          saveEntryBtn.disabled = true;
          saveEntryBtn.textContent = 'Saving...';
          fetch('/admin/menus/' + menuId + '/entries/reorder', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ ids: ids })
          }).then(function(resp) {
            return resp.json();
          }).then(function(data) {
            if (data.status) {
              saveEntryBtn.style.display = 'none';
              entryOrderChanged = false;
              // Update the sort order numbers in the table
              rows.forEach(function(r, idx) {
                r.querySelector('td:nth-child(2)').textContent = (idx + 1) * 10;
              });
            }
          }).finally(function() {
            saveEntryBtn.disabled = false;
            saveEntryBtn.innerHTML = '<i class="bi bi-arrow-down-up"></i> Save Order';
          });
        });
      }

      // Edit entry buttons
      document.querySelectorAll('.edit-entry-btn').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.stopPropagation();
          var row = this.closest('tr');
          var d   = row.dataset;

          document.getElementById('editEntryForm').action = '/admin/menus/' + menuId + '/entries/' + d.id + '/update';
          document.getElementById('ee_hotkey').value      = d.hotkey || '';
          document.getElementById('ee_display').value     = d.display || '';
          var eeCmdSel = document.getElementById('ee_command');
          eeCmdSel.value = d.command_name || '';
          syncArgField(eeCmdSel);
          var eeArgSel = document.getElementById('ee_arg');
          if (eeArgSel) eeArgSel.value = d.command_arg || '';
          document.getElementById('ee_sort').value        = d.sort || '0';
          document.getElementById('ee_security').value    = d.min_security || '';
          document.getElementById('ee_featured').value    = d.featured || 'false';

          var fgSel = document.getElementById('ee_fg');
          var bgSel = document.getElementById('ee_bg');
          fgSel.value = d.fg_clr;
          bgSel.value = d.bg_clr;
          syncSelectColor(fgSel);
          syncSelectColor(bgSel);

          // Set required flags
          var reqFlags = [];
          try { reqFlags = JSON.parse(d.required_flags || '[]'); } catch(_) {}
          var reqSelect = document.getElementById('ee_required');
          for (var i = 0; i < reqSelect.options.length; i++) {
            reqSelect.options[i].selected = reqFlags.includes(reqSelect.options[i].value);
          }

          // Set prohibited flags
          var prohFlags = [];
          try { prohFlags = JSON.parse(d.prohibited_flags || '[]'); } catch(_) {}
          var prohSelect = document.getElementById('ee_prohibited');
          for (var i = 0; i < prohSelect.options.length; i++) {
            prohSelect.options[i].selected = prohFlags.includes(prohSelect.options[i].value);
          }

          var modal = new bootstrap.Modal(document.getElementById('editEntryModal'));
          modal.show();
        });
      });
    });
