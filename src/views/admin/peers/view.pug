      // Build file area checkbox list filtered to a specific network_id
      function buildFileAreaCheckboxes(fieldsetId, checkClass, nameAttr, idPrefix, networkId, checkedIds) {
        const fieldset = document.getElementById(fieldsetId);
        fieldset.innerHTML = '';
        const netId      = parseInt(networkId);
        const checkedSet = new Set(checkedIds.map(id => parseInt(id)));
        let anyShown = false;
