extends ../../layouts/admin

block content
  .container-fluid.main-wrapper
    if !currentuser
      - loginMode = 'guard'
      - loginRedirect = currentPath
      include ../../partials/users/login.pug
    else if !sufficientAccess
      include ../../partials/status/unauthorized.pug
    else
      if !ismobile
        .row
          .col-12
            br
            br
        .row
          .col-2
          .col-8
            if !peer
              .card
                .card-header.bg-darkblue.text-white
                  .row
                    .col-8
                      h2= title
                    .col-4
                      .text-end
                        a.button.btn.btn-lg.btn-info(href='/admin/peers')
                          | Exit
                .card-body
                  br
                  h3 Data Not Found!
                  br
            else
              // ---- Peer info card ----
              .card
                .card-header.bg-darkblue.text-white
                  .row
                    .col-8
                      h2= title
                        |  — 
                        = peer.name
                    .col-4
                      .text-end
                        a.button.btn.btn-lg.btn-info(href='/admin/peers')
                          | Exit
                .card-body
                  if errormessages && errormessages.length > 0
                    ul.text-danger
                      for error of errormessages
                        li.text-danger= error
                    br

                  .row
                    .col-6
                      .card
                        .card-header
                          .row
                            .col-8
                              h5 Peer Details
                            .col-4
                              .text-end
                                button.btn.btn-sm.btn-warning(data-bs-toggle='modal' data-bs-target='#editPeerModal')
                                  | Edit
                        .card-body
                          table.table
                            tr
                              td
                                h6 Name:
                              td= peer.name
                            tr
                              td
                                h6 Sysop:
                              td= peer.sysop_name || '—'
                            tr
                              td
                                h6 Contact:
                              td= peer.contact || '—'
                            tr
                              td
                                h6 Notes:
                              td= peer.notes || '—'
                            tr
                              td
                                h6 Status:
                              td
                                if peer.active
                                  span.badge.bg-success Active
                                else
                                  span.badge.bg-secondary Inactive
                    .col-6
                      .card
                        .card-header
                          .row
                            .col-8
                              h5 Connections
                            .col-4
                              .text-end
                                button.btn.btn-sm.btn-success(data-bs-toggle='modal' data-bs-target='#newConnectionModal')
                                  | Add
                        .card-body
                          if connections && connections.length > 0
                            table#connTable.table.table-hover
                              thead
                                tr
                                  th(scope='col') Network
                                  th(scope='col') Type
                                  th(scope='col') Status
                              tbody
                                for conn of connections
                                  - var _cd = conn.connection_data || {}
                                  tr(
                                    data-bs-uuid=conn.uuid
                                    data-bs-network-uuid=conn.network_uuid
                                    data-bs-networkname=(conn.network_name || '')
                                    data-bs-conntype=conn.connection_type
                                    data-bs-active=(conn.active ? 'true' : 'false')
                                    data-bs-pollenabled=(conn.poll_enabled ? 'true' : 'false')
                                    data-bs-cd=JSON.stringify(_cd)
                                    data-bs-networkid=conn.network_id
                                    data-bs-sysaddrid=(conn.system_address_id || '')
                                    style='cursor:pointer'
                                  )
                                    td= conn.network_name || conn.network_id
                                    td
                                      span.badge.bg-secondary= conn.connection_type
                                    td
                                      if conn.active
                                        span.badge.bg-success Active
                                      else
                                        span.badge.bg-secondary Inactive
                                      if conn.poll_enabled
                                        |
                                        span.badge.bg-info Poll
                          else
                            center
                              h6 No Connections

              // ---- Per-connection detail cards ----
              if connections && connections.length > 0
                for conn in connections
                  - var cd = conn.connection_data || {}
                  br
                  .card
                    .card-header.bg-dark.text-white
                      .row
                        .col-8
                          h5
                            | Connection — 
                            = conn.network_name || ('Network ' + conn.network_id)
                            |  
                            span.badge.bg-secondary= conn.connection_type
                        .col-4
                          .text-end
                            button.btn.btn-sm.btn-warning(
                              data-bs-toggle='modal'
                              data-bs-target='#editConnModal'
                              data-bs-uuid=conn.uuid
                              data-bs-networkname=(conn.network_name || '')
                              data-bs-conntype=conn.connection_type
                              data-bs-active=(conn.active ? 'true' : 'false')
                              data-bs-pollenabled=(conn.poll_enabled ? 'true' : 'false')
                              data-bs-cd=JSON.stringify(cd)
                              data-bs-networkid=conn.network_id
                              data-bs-sysaddrid=(conn.system_address_id || '')
                            )
                              | Edit
                            |  
                            if conn.connection_type === 'NNTP'
                              form(method='POST' action=`/admin/connection/${conn.uuid}/resetnntpidx` style='display:inline')
                                button.btn.btn-sm.btn-secondary(type='submit' title='Reset outbound index — rescan all areas on next toss') Reset Idx
                              |  
                            if conn.connection_type === 'QWK'
                              form(method='POST' action=`/admin/connection/${conn.uuid}/resetqwkidx` style='display:inline')
                                button.btn.btn-sm.btn-secondary(type='submit' title='Reset outbound index — rescan all areas on next toss') Reset Idx
                              |  
                            button.btn.btn-sm.btn-danger(
                              data-bs-toggle='modal'
                              data-bs-target='#removeConnModal'
                              data-bs-uuid=conn.uuid
                              data-bs-networkname=(conn.network_name || conn.network_id)
                            )
                              | Remove
                    .card-body
                      .row
                        // Connection data fields — vary by type
                        .col-4
                          table.table.table-sm
                            if conn.connection_type === 'FTN'
                              tr
                                td
                                  small Address:
                                td= cd.address || '—'
                              tr
                                td
                                  small Status:
                                td= cd.status || 'NORMAL'
                              tr
                                td
                                  small Session PW:
                                td= cd.session_password ? '••••' : '—'
                              tr
                                td
                                  small Packet PW:
                                td= cd.packet_password ? '••••' : '—'
                              if cd.remote_host
                                tr
                                  td
                                    small Mailer Host:
                                  td= cd.remote_host + ':' + (cd.remote_port || 24554)
                              tr
                                td
                                  small Direct:
                                td= cd.direct !== false ? 'Yes' : 'No'
                              if !cd.direct && cd.route_to
                                tr
                                  td
                                    small Route To:
                                  td= cd.route_to
                            else if conn.connection_type === 'NNTP'
                              tr
                                td
                                  small Host:
                                td= cd.host || '—'
                              tr
                                td
                                  small Port:
                                td= cd.port || '—'
                              tr
                                td
                                  small TLS:
                                td= cd.use_tls ? 'Yes' : 'No'
                              tr
                                td
                                  small Username:
                                td= cd.username || '—'
                            else if conn.connection_type === 'QWK'
                              tr
                                td
                                  small Remote QWK ID:
                                td= cd.remote_qwk_id || '—'
                              tr
                                td
                                  small Host:
                                td= cd.host || '—'
                              tr
                                td
                                  small Port:
                                td= cd.port || '—'
                              tr
                                td
                                  small Transport:
                                td= cd.transport || 'ftp'
                              tr
                                td
                                  small Username:
                                td= cd.username || '—'
                              tr
                                td
                                  small Inbox:
                                td= cd.remote_inbox !== undefined && cd.remote_inbox !== '' ? cd.remote_inbox : '(server default)'
                              tr
                                td
                                  small Outbox:
                                td= cd.remote_outbox !== undefined && cd.remote_outbox !== '' ? cd.remote_outbox : '(server default)'
                            else
                              tr
                                td
                                  small.text-muted Local connection — no transport settings
                        // Allowed areas
                        .col-4
                          .card
                            .card-header
                              .row
                                .col-7
                                  h6 Allowed (AreaFix)
                                .col-5
                                  .text-end
                                    button.btn.btn-xs.btn-sm.btn-success(
                                      data-bs-toggle='modal'
                                      data-bs-target='#setAllowedModal'
                                      data-bs-connuuid=conn.uuid
                                      data-bs-connname=(conn.network_name || conn.network_id)
                                      data-bs-networkid=conn.network_id
                                    )
                                      | Edit
                            .card-body
                              - var connSubIds = new Set((conn.subscriptions || []).map(s => s.area_id))
                              - var anyAllowed = false
                              if grouplist && grouplist.length > 0
                                for group of grouplist
                                  if group.areas && group.areas.length > 0
                                    //- Filter to areas this connection subscribes to + allowed, deduplicate by area_id
                                    - var seen = new Set()
                                    - var allowedAreas = []
                                    each area in group.areas
                                      - var aid = parseInt(area.id)
                                      if !seen.has(aid) && connSubIds.has(aid)
                                        - seen.add(aid)
                                        - var sub = conn.subscriptions.find(s => s.area_id === aid)
                                        if sub && sub.allowed
                                          - allowedAreas.push(area)
                                    if allowedAreas.length > 0
                                      - anyAllowed = true
                                      h6.text-info= group.name
                                      ul
                                        for area of allowedAreas
                                          li.text-success= area.name
                              if !anyAllowed
                                p.text-muted None
                        // Enabled areas
                        .col-4
                          .card
                            .card-header
                              .row
                                .col-7
                                  h6 Enabled (Toss)
                                .col-5
                                  .text-end
                                    button.btn.btn-xs.btn-sm.btn-success(
                                      data-bs-toggle='modal'
                                      data-bs-target='#setEnabledModal'
                                      data-bs-connuuid=conn.uuid
                                      data-bs-connname=(conn.network_name || conn.network_id)
                                      data-bs-networkid=conn.network_id
                                    )
                                      | Edit
                            .card-body
                              - var anyEnabled = false
                              if grouplist && grouplist.length > 0
                                for group of grouplist
                                  if group.areas && group.areas.length > 0
                                    //- Filter to areas this connection subscribes to + enabled, deduplicate by area_id
                                    - var seen = new Set()
                                    - var enabledAreas = []
                                    each area in group.areas
                                      - var aid = parseInt(area.id)
                                      if !seen.has(aid) && connSubIds.has(aid)
                                        - seen.add(aid)
                                        - var sub = conn.subscriptions.find(s => s.area_id === aid)
                                        if sub && sub.enabled
                                          - enabledAreas.push(area)
                                    if enabledAreas.length > 0
                                      - anyEnabled = true
                                      h6.text-info= group.name
                                      ul
                                        for area of enabledAreas
                                          li.text-success= area.name
                              if !anyEnabled
                                p.text-muted None
                      // File area subscriptions row
                      .row.mt-3
                        .col-4
                        // Allowed file areas
                        .col-4
                          .card
                            .card-header
                              .row
                                .col-7
                                  h6 Allowed File Areas
                                .col-5
                                  .text-end
                                    button.btn.btn-xs.btn-sm.btn-success(
                                      data-bs-toggle='modal'
                                      data-bs-target='#setFileAllowedModal'
                                      data-bs-connuuid=conn.uuid
                                      data-bs-connname=(conn.network_name || conn.network_id)
                                      data-bs-networkid=conn.network_id
                                    )
                                      | Edit
                            .card-body
                              - var fileSubIds = new Set((conn.fileSubscriptions || []).map(s => s.file_area_id))
                              - var anyFileAllowed = false
                              if fileGrouplist && fileGrouplist.length > 0
                                for fgroup of fileGrouplist
                                  if fgroup.areas && fgroup.areas.length > 0
                                    - var seen = new Set()
                                    - var allowedFileAreas = []
                                    each farea in fgroup.areas
                                      - var faid = parseInt(farea.id)
                                      if !seen.has(faid) && fileSubIds.has(faid)
                                        - seen.add(faid)
                                        - var fsub = conn.fileSubscriptions.find(s => s.file_area_id === faid)
                                        if fsub && fsub.allowed
                                          - allowedFileAreas.push(farea)
                                    if allowedFileAreas.length > 0
                                      - anyFileAllowed = true
                                      h6.text-info= fgroup.name
                                      ul
                                        for farea of allowedFileAreas
                                          li.text-success= farea.name
                              if !anyFileAllowed
                                p.text-muted None
                        // Enabled file areas
                        .col-4
                          .card
                            .card-header
                              .row
                                .col-7
                                  h6 Enabled File Areas
                                .col-5
                                  .text-end
                                    button.btn.btn-xs.btn-sm.btn-success(
                                      data-bs-toggle='modal'
                                      data-bs-target='#setFileEnabledModal'
                                      data-bs-connuuid=conn.uuid
                                      data-bs-connname=(conn.network_name || conn.network_id)
                                      data-bs-networkid=conn.network_id
                                    )
                                      | Edit
                            .card-body
                              - var anyFileEnabled = false
                              if fileGrouplist && fileGrouplist.length > 0
                                for fgroup of fileGrouplist
                                  if fgroup.areas && fgroup.areas.length > 0
                                    - var seen = new Set()
                                    - var enabledFileAreas = []
                                    each farea in fgroup.areas
                                      - var faid = parseInt(farea.id)
                                      if !seen.has(faid) && fileSubIds.has(faid)
                                        - seen.add(faid)
                                        - var fsub = conn.fileSubscriptions.find(s => s.file_area_id === faid)
                                        if fsub && fsub.enabled
                                          - enabledFileAreas.push(farea)
                                    if enabledFileAreas.length > 0
                                      - anyFileEnabled = true
                                      h6.text-info= fgroup.name
                                      ul
                                        for farea of enabledFileAreas
                                          li.text-success= farea.name
                              if !anyFileEnabled
                                p.text-muted None

              // -------------------------------------------------------
              // Modals
              // -------------------------------------------------------

              // Edit Peer Modal
              #editPeerModal.modal.fade(tabindex='-1' aria-hidden='true')
                .modal-dialog.modal-dialog-centered.modal-lg
                  .modal-content
                    .modal-header.bg-dark.text-white
                      h3.modal-title Edit Peer
                      button.btn.btn-lg.btn-close(data-bs-dismiss='modal')
                    .modal-body
                      form(action=`/admin/peer/${peer.uuid}/update` method='POST' class='form-registration')
                        .row
                          .col-1
                          .col-5
                            label(for='ep_name') System Name:
                            input(
                              type='text'
                              id='ep_name'
                              name='name'
                              class='form-control'
                              tabindex='1'
                              value=peer.name
                              required
                            )
                            br
                            label(for='ep_sysop') Sysop Name:
                            input(
                              type='text'
                              id='ep_sysop'
                              name='sysop_name'
                              class='form-control'
                              tabindex='2'
                              value=peer.sysop_name || ''
                            )
                            br
                            label(for='ep_contact') Contact:
                            input(
                              type='text'
                              id='ep_contact'
                              name='contact'
                              class='form-control'
                              tabindex='3'
                              value=peer.contact || ''
                            )
                          .col-5
                            label(for='ep_notes') Notes:
                            textarea#ep_notes.form-control(
                              name='notes'
                              rows='4'
                              tabindex='4'
                            )= peer.notes || ''
                            br
                            label(for='ep_active') Status:
                            select#ep_active(name='active' tabindex='5').form-select
                              option(value='true' selected=(peer.active === true)) Active
                              option(value='false' selected=(peer.active !== true)) Inactive
                        .row
                          .col-1
                          .col-10
                            br
                            .text-end
                              input(
                                type='submit'
                                value='Save Changes'
                                class='btn btn-lg btn-warning btn-block'
                                tabindex='6'
                              )

              // New Connection Modal
              #newConnectionModal.modal.fade(tabindex='-1' aria-hidden='true')
                .modal-dialog.modal-dialog-centered.modal-xl
                  .modal-content
                    .modal-header.bg-dark.text-white
                      h3.modal-title Add Connection
                      button.btn.btn-lg.btn-close(data-bs-dismiss='modal')
                    .modal-body
                      form(action=`/admin/peer/${peer.uuid}/newconnection` method='POST' class='form-registration')
                        .row
                          .col-1
                          .col-5
                            label(for='nc_network') Network:
                            select#nc_network(name='network_id' tabindex='1').form-select
                              if networklist && networklist.length > 0
                                for net of networklist
                                  option(value=net.id data-bs-type=net.network_type)
                                    = net.name
                                    |  (
                                    = net.domain
                                    |)
                              else
                                option(value='' disabled) No networks available
                            br
                            label(for='nc_type') Connection Type:
                            select#nc_type(name='connection_type' tabindex='2').form-select
                              option(value='FTN') FTN
                              option(value='NNTP') NNTP
                              option(value='QWK') QWK
                              option(value='LOCAL') LOCAL
                            br
                            label(for='nc_system_address') System Address:
                            select#nc_system_address(name='system_address_id' tabindex='3').form-select
                              option(value='') — Use network default —
                            small.form-text.text-muted Populated from selected network. Leave blank to use network default.
                            br
                            // FTN identity fields — left column (shown/hidden by showConnFields)
                            #nc_left_ftn
                              label(for='nc_ftn_address') FTN Address:
                                |  
                                span(
                                  data-bs-toggle='tooltip'
                                  data-bs-placement='right'
                                  title='Format: zone:net/node or zone:net/node.point — e.g. 1:234/567 or 1:234/567.1'
                                )
                                  i.bi.bi-info-circle.text-muted
                              input(
                                type='text'
                                id='nc_ftn_address'
                                name='ftn_address'
                                class='form-control'
                                tabindex='3'
                                placeholder='1:123/456'
                              )
                              br
                              label(for='nc_ftn_status') FTN Status:
                              select#nc_ftn_status(name='ftn_status' tabindex='4').form-select
                                option(value='NORMAL' selected) Normal
                                option(value='CRASH') Crash
                                option(value='HOLD') Hold
                              br
                              label(for='nc_ftn_routing_rules') Routing Rules:
                                |  
                                span(
                                  data-bs-toggle='tooltip'
                                  data-bs-placement='right'
                                  title='Comma-separated wildcards. * matches any segment. Examples: 1:* (all of zone 1), 2:234/* (all nodes in net 234), 3:512/100 (exact node)'
                                )
                                  i.bi.bi-info-circle.text-muted
                              input(
                                type='text'
                                id='nc_ftn_routing_rules'
                                name='ftn_routing_rules'
                                class='form-control'
                                tabindex='5'
                                placeholder='1:*, 2:234/*, 3:512/100'
                              )
                              small.form-text.text-muted Comma-separated. Route matching addresses through this connection.
                              br
                              label(for='nc_ftn_direct') Direct Connection:
                              select#nc_ftn_direct(name='ftn_direct' tabindex='6').form-select
                                option(value='Yes' selected) Yes — packets addressed directly to this node
                                option(value='No') No — route via another address
                              br
                              #nc_ftn_route_to_wrap(style='display:none')
                                label(for='nc_ftn_route_to') Route To Address:
                                input(
                                  type='text'
                                  id='nc_ftn_route_to'
                                  name='ftn_route_to'
                                  class='form-control'
                                  placeholder='1:123/0'
                                )
                                small.form-text.text-muted Packet destination when not direct.
                                br
                              label(for='nc_ftn_remote_host') Mailer Host:
                                |  
                                span(data-bs-toggle='tooltip' data-bs-placement='right' title='Hostname or IP for outbound binkp connections. Leave blank if this peer calls us.')
                                  i.bi.bi-info-circle.text-muted
                              input(
                                type='text'
                                id='nc_ftn_remote_host'
                                name='ftn_remote_host'
                                class='form-control'
                                placeholder='bbs.example.com'
                              )
                              br
                              label(for='nc_ftn_remote_port') Mailer Port:
                              input(
                                type='number'
                                id='nc_ftn_remote_port'
                                name='ftn_remote_port'
                                class='form-control'
                                value='24554'
                                min=1
                                max=65535
                              )
                              br
                          .col-5
                            label(for='nc_active') Status:
                            select#nc_active(name='active' tabindex='6').form-select
                              option(value='true' selected) Active
                              option(value='false') Inactive
                            br
                            label(for='nc_poll_enabled') Polling:
                            select#nc_poll_enabled(name='poll_enabled' tabindex='7').form-select
                              option(value='false' selected) Poll Disabled
                              option(value='true') Poll Enabled
                            br
                            label(for='nc_poll_interval') Poll Interval (minutes):
                            input#nc_poll_interval(type='number' name='poll_interval_minutes' class='form-control' min='1' max='10080' tabindex='8' value='60')
                            small.form-text.text-muted FTN: mailer poll. QWK/NNTP: pull/push cycle.
                            br
                            // FTN password fields — right column
                            #nc_fields_ftn
                              label(for='nc_ftn_sessionpw') Session Password:
                              input(
                                type='text'
                                id='nc_ftn_sessionpw'
                                name='ftn_session_password'
                                class='form-control'
                                tabindex='7'
                              )
                              br
                              label(for='nc_ftn_packetpw') Packet Password:
                              input(
                                type='text'
                                id='nc_ftn_packetpw'
                                name='ftn_packet_password'
                                class='form-control'
                                tabindex='8'
                              )
                              br
                              label(for='nc_ftn_ticpw') Tic Password:
                              input(
                                type='text'
                                id='nc_ftn_ticpw'
                                name='ftn_tic_password'
                                class='form-control'
                                tabindex='9'
                              )
                              br
                              label(for='nc_ftn_areafixpw') AreaFix Password:
                              input(
                                type='text'
                                id='nc_ftn_areafixpw'
                                name='ftn_areafix_password'
                                class='form-control'
                                tabindex='10'
                              )
                            // NNTP fields
                            #nc_fields_nntp(style='display:none')
                              label(for='nc_nntp_host') Host:
                              input(
                                type='text'
                                id='nc_nntp_host'
                                name='nntp_host'
                                class='form-control'
                                tabindex='7'
                              )
                              br
                              label(for='nc_nntp_port') Port:
                              input(
                                type='number'
                                id='nc_nntp_port'
                                name='nntp_port'
                                class='form-control'
                                tabindex='8'
                                value=119
                              )
                              br
                              label(for='nc_nntp_tls') Use TLS:
                              select#nc_nntp_tls(name='nntp_use_tls' tabindex='9').form-select
                                option(value='false' selected) No
                                option(value='true') Yes
                              br
                              label(for='nc_nntp_username') Username:
                              input(
                                type='text'
                                id='nc_nntp_username'
                                name='nntp_username'
                                class='form-control'
                                tabindex='10'
                              )
                              br
                              label(for='nc_nntp_password') Password:
                              input(
                                type='password'
                                id='nc_nntp_password'
                                name='nntp_password'
                                class='form-control'
                                tabindex='11'
                              )
                            // QWK fields
                            #nc_fields_qwk(style='display:none')
                              label(for='nc_qwk_remote_qwk_id') Remote QWK ID:
                              input(
                                type='text'
                                id='nc_qwk_remote_qwk_id'
                                name='qwk_remote_qwk_id'
                                class='form-control'
                                tabindex='7'
                                placeholder='VERT'
                              )
                              small.form-text.text-muted#nc_qwk_id_help
                                | The remote system's QWK BBS ID.
                              br
