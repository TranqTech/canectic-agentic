          const filtered = (group.areas || []).filter(a => a.network_id === netId);
          if (filtered.length === 0) return;
          anyShown = true;
          const h = document.createElement('h6');
          h.className = 'text-info';
          h.textContent = group.name + ':';
          fieldset.appendChild(h);
          filtered.forEach(area => {
            const wrap = document.createElement('div');
            wrap.className = 'form-check';
            const cb = document.createElement('input');
            cb.className = 'form-check-input ' + checkClass;
            cb.id = idPrefix + '-' + area.id;
            cb.type = 'checkbox';
            cb.name = nameAttr;
            cb.value = area.id;
            cb.checked = checkedSet.has(parseInt(area.id));
            const lbl = document.createElement('label');
            lbl.setAttribute('for', cb.id);
            lbl.textContent = area.name;
            wrap.appendChild(cb);
            wrap.appendChild(lbl);
            fieldset.appendChild(wrap);
          });
          fieldset.appendChild(document.createElement('br'));
        });
        if (!anyShown) {
