  script.
    function populateSystemAddressSelect(selectEl, networkId, selectedId) {
      const addresses = networkAddressMap[networkId] || [];
      selectEl.innerHTML = '<option value="">— Use network default —</option>';
      addresses.forEach(addr => {
        const opt = document.createElement('option');
        opt.value = addr.id;
        opt.textContent = addr.address + (addr.is_default ? ' (default)' : '') + (!addr.active ? ' [inactive]' : '');
        if (selectedId && parseInt(selectedId) === parseInt(addr.id)) opt.selected = true;
        selectEl.appendChild(opt);
      });
    }

    function showConnFields(type) {
      ['ftn','nntp','qwk','local'].forEach(t => {
        const el = document.getElementById('nc_fields_' + t);
        if (el) el.style.display = (t === type.toLowerCase()) ? '' : 'none';
      });
      const leftFtn = document.getElementById('nc_left_ftn');
      if (leftFtn) leftFtn.style.display = (type.toLowerCase() === 'ftn') ? '' : 'none';
      // Default poll_enabled based on type
      const pollSel = document.getElementById('nc_poll_enabled');
      if (pollSel) {
        var ltype = type.toLowerCase();
        pollSel.value = (ltype === 'nntp' || ltype === 'qwk') ? 'true' : 'false';
      }
    }

    function showEditConnFields(type) {
      ['ftn','nntp','qwk','local'].forEach(t => {
        const el = document.getElementById('ec_fields_' + t);
        if (el) el.style.display = (t === type.toLowerCase()) ? '' : 'none';
      });
      const leftFtn = document.getElementById('ec_left_ftn');
      if (leftFtn) leftFtn.style.display = (type.toLowerCase() === 'ftn') ? '' : 'none';
    }

    document.addEventListener('DOMContentLoaded', function() {

      // Toggle QWK client fields based on transport selection
      function toggleQwkClientFields(prefix) {
        var sel = document.getElementById(prefix + '_qwk_transport');
        if (!sel) return;
        var isHub = (sel.value === 'hub');
        var clientDiv = document.getElementById(prefix + '_qwk_client_fields');
        if (clientDiv) clientDiv.style.display = isHub ? 'none' : '';
        // Hub transport disables polling by default
        var pollSel = document.getElementById(prefix + '_poll_enabled');
        if (pollSel && isHub) pollSel.value = 'false';
      }

      // New connection QWK transport change
      var ncQwkTransport = document.getElementById('nc_qwk_transport');
      if (ncQwkTransport) {
        ncQwkTransport.addEventListener('change', function() { toggleQwkClientFields('nc'); });
        toggleQwkClientFields('nc');
      }

      // Edit connection QWK transport change
      var ecQwkTransport = document.getElementById('ec_qwk_transport');
      if (ecQwkTransport) {
        ecQwkTransport.addEventListener('change', function() { toggleQwkClientFields('ec'); });
      }

      // Toggle route_to field visibility based on direct selection
      function toggleFtnRouteField(prefix) {
        var sel  = document.getElementById(prefix + '_ftn_direct');
        var wrap = document.getElementById(prefix + '_ftn_route_to_wrap');
        if (sel && wrap) {
          wrap.style.display = sel.value === 'No' ? '' : 'none';
        }
      }

      // FTN direct select change events
      var ncFtnDirect = document.getElementById('nc_ftn_direct');
      if (ncFtnDirect) {
        ncFtnDirect.addEventListener('change', function() { toggleFtnRouteField('nc'); });
      }
      var ecFtnDirect = document.getElementById('ec_ftn_direct');
      if (ecFtnDirect) {
        ecFtnDirect.addEventListener('change', function() { toggleFtnRouteField('ec'); });
      }

      // New connection type switcher
      const ncType = document.getElementById('nc_type');
      if (ncType) {
        ncType.addEventListener('change', function() { showConnFields(this.value); });
        showConnFields(ncType.value);
      }

      // New connection network switcher — repopulate system address select
      const ncNetwork = document.getElementById('nc_network');
      const ncSysAddr = document.getElementById('nc_system_address');
      if (ncNetwork && ncSysAddr) {
        const repopulateNcAddr = () => populateSystemAddressSelect(ncSysAddr, ncNetwork.value, null);
        ncNetwork.addEventListener('change', repopulateNcAddr);
        repopulateNcAddr();
      }

      // Initialise Bootstrap tooltips
      document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => {
        new bootstrap.Tooltip(el, { trigger: 'hover focus' });
      });

      // Connection table row click — navigate to network view
      const connTable = document.getElementById('connTable');
      if (connTable) {
        connTable.querySelectorAll('tbody tr').forEach(row => {
          row.addEventListener('click', function() {
            const networkUuid = this.dataset.bsNetworkUuid;
            if (networkUuid) window.location.href = `/admin/network/${networkUuid}`;
          });
        });
      }

      // Edit connection modal — populate from data attributes
      document.querySelectorAll('[data-bs-target="#editConnModal"]').forEach(btn => {
        btn.addEventListener('click', function() {
          const d   = this.dataset;
          const cd  = JSON.parse(d.bsCd || '{}');
          const type = d.bsConntype || 'FTN';

          document.getElementById('editConnTitle').textContent = d.bsNetworkname || '';
          document.getElementById('editConnForm').action = `/admin/connection/${d.bsUuid}/update`;
          document.getElementById('ec_active').value = d.bsActive === 'true' ? 'true' : 'false';
          document.getElementById('ec_poll_enabled').value = d.bsPollenabled === 'true' ? 'true' : 'false';
          document.getElementById('ec_poll_interval').value = cd.poll_interval || cd.pull_interval || cd.poll_interval_minutes || cd.pull_interval_minutes || 60;

          const ecSysAddr = document.getElementById('ec_system_address');
          if (ecSysAddr) populateSystemAddressSelect(ecSysAddr, d.bsNetworkid, d.bsSysaddrid || null);

          showEditConnFields(type);

          if (type === 'FTN') {
            document.getElementById('ec_ftn_address').value         = cd.address || '';
            document.getElementById('ec_ftn_status').value          = cd.status || 'NORMAL';
            document.getElementById('ec_ftn_routing_rules').value   = (cd.routing_rules || []).join(', ');
            document.getElementById('ec_ftn_sessionpw').value       = cd.session_password || '';
            document.getElementById('ec_ftn_packetpw').value        = cd.packet_password || '';
            document.getElementById('ec_ftn_ticpw').value           = cd.tic_password || '';
            document.getElementById('ec_ftn_areafixpw').value       = cd.areafix_password || '';
            document.getElementById('ec_ftn_direct').value          = cd.direct === false ? 'No' : 'Yes';
            document.getElementById('ec_ftn_route_to').value        = cd.route_to || '';
            document.getElementById('ec_ftn_remote_host').value     = cd.remote_host || '';
            document.getElementById('ec_ftn_remote_port').value     = cd.remote_port || 24554;
            toggleFtnRouteField('ec');
          } else if (type === 'NNTP') {
            document.getElementById('ec_nntp_host').value     = cd.host || '';
            document.getElementById('ec_nntp_port').value     = cd.port || 119;
            document.getElementById('ec_nntp_tls').value      = cd.use_tls ? 'true' : 'false';
            document.getElementById('ec_nntp_username').value = cd.username || '';
            document.getElementById('ec_nntp_password').value = cd.password || '';
          } else if (type === 'QWK') {
            document.getElementById('ec_qwk_remote_qwk_id').value  = cd.remote_qwk_id || '';
            document.getElementById('ec_qwk_host').value           = cd.host || '';
            document.getElementById('ec_qwk_port').value           = cd.port || 21;
            document.getElementById('ec_qwk_transport').value      = cd.transport || 'ftp';
            document.getElementById('ec_qwk_username').value       = cd.username || '';
            document.getElementById('ec_qwk_password').value       = cd.password || '';
            document.getElementById('ec_qwk_remote_inbox').value   = cd.remote_inbox ?? '/';
            document.getElementById('ec_qwk_remote_outbox').value  = cd.remote_outbox ?? '/';
            toggleQwkClientFields('ec');
          }
        });
      });

      // Remove connection modal — populate from data attributes
      document.querySelectorAll('[data-bs-target="#removeConnModal"]').forEach(btn => {
        btn.addEventListener('click', function() {
          const d = this.dataset;
          document.getElementById('removeConnName').textContent = d.bsNetworkname || '';
          document.getElementById('removeConnForm').action = `/admin/connection/${d.bsUuid}/remove`;
        });
      });

      // Build checkbox list filtered to a specific network_id
      function buildAreaCheckboxes(fieldsetId, checkClass, nameAttr, idPrefix, networkId, checkedIds) {
        const fieldset = document.getElementById(fieldsetId);
        fieldset.innerHTML = '';
        const netId      = parseInt(networkId);
        const checkedSet = new Set(checkedIds.map(id => parseInt(id)));
        let anyShown = false;
        grouplistData.forEach(group => {
          const filtered = (group.areas || []).filter(a => a.network_id === netId);
          if (filtered.length === 0) return;
          anyShown = true;
          const h = document.createElement('h6');
          h.className = 'text-info';
          h.textContent = group.name + ':';
          fieldset.appendChild(h);
          filtered.forEach(area => {
            const wrap = document.createElement('div');
            wrap.className = 'form-check';
            const cb = document.createElement('input');
            cb.className = 'form-check-input ' + checkClass;
            cb.id = idPrefix + '-' + area.id;
            cb.type = 'checkbox';
            cb.name = nameAttr;
            cb.value = area.id;
            cb.checked = checkedSet.has(parseInt(area.id));
