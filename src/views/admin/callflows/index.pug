extends ../../layouts/admin
block content
  .container-fluid
    br
    br
    .row
      .col-lg-10.offset-lg-1.col-12
        h2.mb-4
          i.bi.bi-diagram-2.me-2
          | Call Flows &amp; Pools
        include ../../partials/flash

        //- Call Flows
        .card.mb-4
          .card-header.bg-primary
            .d-flex.justify-content-between.align-items-center
              h5.mb-0 Call Flows
              button.btn.btn-sm.btn-success(data-bs-toggle='modal' data-bs-target='#addFlowModal')
                i.bi.bi-plus-circle.me-1
                | Add Flow
          .card-body
            if flows && flows.length > 0
              each flow in flows
                - var isWeb = flow.kind === 'web'
                .card.mb-3
                  .card-header.bg-dark.d-flex.justify-content-between.align-items-center
                    div
                      strong= flow.title || flow.name
                      |
                      code.ms-2= flow.name
                      if isWeb
                        span.badge.bg-primary.ms-2 Web
                      if flow.is_system
                        span.badge.bg-secondary.ms-2 System
                      if !flow.active && !isWeb
                        span.badge.bg-danger.ms-2 Inactive
                    div
                      button.btn.btn-sm.btn-primary.me-1.edit-flow-btn(
                        data-bs-toggle='modal' data-bs-target='#editFlowModal'
                        data-id=flow.id
                        data-name=flow.name
                        data-title=flow.title || ''
                        data-description=flow.description || ''
                        data-active=(flow.active ? 'true' : 'false')
                        data-system=(flow.is_system ? 'true' : 'false')
                        data-kind=(isWeb ? 'web' : 'terminal')
                      )
                        i.bi.bi-pencil
                      if !flow.is_system
                        form.d-inline(method='POST' action='/admin/callflows/' + flow.id + '/delete')
                          button.btn.btn-sm.btn-danger(type='submit' onclick='return confirm("Delete this flow?")')
                            i.bi.bi-trash
                  .card-body
                    - var stages = Array.isArray(flow.stages) ? flow.stages : (typeof flow.stages === 'string' ? JSON.parse(flow.stages) : [])
                    if isWeb
                      p.small.text-muted.mb-2
                        | What web users see after logging in, one stage at a time; a stage with nothing to show is skipped. Changes take effect at once.
                        |  The web call flow is currently
                        strong= callflowEnabled ? ' on' : ' off'
                        | ; switch it with
                        code.ms-1 callflow_enabled
                        |  on the Configuration page.
                    .stage-list(data-flow-id=flow.id data-kind=(isWeb ? 'web' : 'terminal'))
                      if isWeb
                        each stg, idx in stages
                          - var wName = typeof stg === 'string' ? stg : (stg.stage || '')
                          - var wEntry = webCatalogEntry(wName)
                          - var wOpts = (typeof stg === 'object' && stg.options) ? stg.options : {}
                          - var wDesc = describeWebOptions(wEntry, wOpts)
                          .badge.bg-info.text-dark.me-1.mb-1.stage-badge.p-2(
                            draggable='true'
                            data-stage=wName
                            data-options=JSON.stringify(wOpts)
                            data-idx=idx
                            title=(wEntry ? wEntry.hint : 'Unknown stage')
                            style='cursor:grab;font-size:0.85rem'
                          )
                            span.me-1= (idx + 1) + '.'
                            = wEntry ? wEntry.label : wName
                            if wDesc
                              small.ms-1.text-muted (#{wDesc})
                            |
                            if wEntry && wEntry.options.length > 0
                              span.edit-stage-options.ms-1(style='cursor:pointer;opacity:0.6' title='Settings' data-bs-toggle='modal' data-bs-target='#stageOptionsModal')
                                i.bi.bi-gear-fill(style='font-size:0.7rem')
                            span.remove-stage.ms-1(style='cursor:pointer;opacity:0.6' title='Remove') &times;
                      else
                        each stg, idx in stages
                          - var stageName = typeof stg === 'string' ? stg : (stg.stage || '')
                          - var stageArg = typeof stg === 'object' && stg.arg ? stg.arg : ''
                          - var stageLabel = availableStages.find(function(s) { return s.name === stageName; })
                          .badge.bg-info.text-dark.me-1.mb-1.stage-badge.p-2(
                            draggable='true'
                            data-stage=stageName
                            data-arg=stageArg
                            data-idx=idx
                            style='cursor:grab;font-size:0.85rem'
                          )
                            span.me-1= (idx + 1) + '.'
                            = stageLabel ? stageLabel.label : stageName
                            if stageArg
                              small.ms-1.text-muted.stage-arg-display (#{stageArg})
                            else if stageLabel && stageLabel.needsArg
                              small.ms-1.text-warning.stage-arg-display (no arg)
                            |
                            span.edit-stage-arg.ms-1(style='cursor:pointer;opacity:0.6' title='Edit argument')
                              i.bi.bi-pencil-fill(style='font-size:0.7rem')
                            span.remove-stage(style='cursor:pointer;opacity:0.6' title='Remove') &times;
                    .mt-2
                      .input-group.input-group-sm(style='max-width:400px')
                        select.form-select.form-select-sm.add-stage-select
                          option(value='') + Add Stage...
                          if isWeb
                            //- A web stage appears once, so offer only those not in the flow
                            - var inFlow = stages.map(function(x) { return typeof x === 'string' ? x : x.stage; })
                            each w in webStages
                              if inFlow.indexOf(w.name) === -1
                                option(value=w.name title=w.hint)= w.label
                          else
                            each s in availableStages
                              option(value=s.name data-needsarg=s.needsArg || false)= s.label
                        input.form-control.form-control-sm.add-stage-arg(type='text' placeholder='arg' style='display:none;max-width:150px')
                        button.btn.btn-sm.btn-success.add-stage-btn(type='button') Add
            else
              p.text-muted No call flows configured.

        //- Call Pools
        .card.mb-4
          .card-header.bg-secondary
            .d-flex.justify-content-between.align-items-center
              h5.mb-0 Call Pools
              button.btn.btn-sm.btn-success(data-bs-toggle='modal' data-bs-target='#addPoolModal')
                i.bi.bi-plus-circle.me-1
                | Add Pool
          .card-body
            if pools && pools.length > 0
              table.table.table-sm.table-hover.mb-0
                thead
                  tr
                    th Pool Name
                    th Flow
                    th WebSocket Paths
                    th Status
                    th(style='width:100px')
                tbody
                  each pool in pools
                    - var wsPaths = Array.isArray(pool.ws_paths) ? pool.ws_paths : (typeof pool.ws_paths === 'string' ? JSON.parse(pool.ws_paths) : [])
                    tr
                      td
                        strong= pool.name
                        if pool.is_system
                          span.badge.bg-secondary.ms-2 System
                        if pool.description
                          br
                          small.text-muted= pool.description
                      td: code= pool.flow_name
                      td
                        each wp in wsPaths
                          code.me-1= wp
                      td
                        if pool.active
                          span.badge.bg-success Active
                        else
                          span.badge.bg-danger Inactive
                      td
                        button.btn.btn-sm.btn-primary.me-1(
                          data-bs-toggle='modal' data-bs-target='#editPoolModal'
                          data-id=pool.id
                          data-name=pool.name
                          data-flowname=pool.flow_name
                          data-wspaths=JSON.stringify(wsPaths)
                          data-description=pool.description || ''
                          data-active=(pool.active ? 'true' : 'false')
                          data-system=(pool.is_system ? 'true' : 'false')
                        )
                          i.bi.bi-pencil
                        if !pool.is_system
                          form.d-inline(method='POST' action='/admin/callpools/' + pool.id + '/delete')
                            button.btn.btn-sm.btn-danger(type='submit' onclick='return confirm("Delete this pool?")')
                              i.bi.bi-trash
            else
              p.text-muted No call pools configured.

        .alert.alert-info
          i.bi.bi-info-circle.me-2
          | Changes to terminal call flows and pools take effect on the next gateway restart. The web call flow changes at once.

    //- Add Flow Modal
    .modal.fade#addFlowModal(tabindex='-1')
      .modal-dialog
        .modal-content
          .modal-header
            h5.modal-title Add Call Flow
            button.btn-close(type='button' data-bs-dismiss='modal')
          form(method='POST' action='/admin/callflows/new')
            .modal-body
              .mb-3
                label.form-label Name (slug)
                input.form-control(name='name' required placeholder='e.g. CustomLogin')
              .mb-3
                label.form-label Title
                input.form-control(name='title' placeholder='Display title')
              .mb-3
                label.form-label Description
                input.form-control(name='description')
              .mb-3
                label.form-label Initial Stages (JSON)
                textarea.form-control(name='stages' rows='4' placeholder='[{"stage":"negotiate"},{"stage":"logon"},{"stage":"menu"},{"stage":"goodbye"}]')
                .form-text Add stages after creation using the drag-and-drop editor.
              .form-check
                input.form-check-input(type='checkbox' name='active' id='addFlowActive' checked value='true')
                label.form-check-label(for='addFlowActive') Active
            .modal-footer
              button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cancel
              button.btn.btn-success(type='submit') Add

    //- Edit Flow Modal
    .modal.fade#editFlowModal(tabindex='-1')
      .modal-dialog
        .modal-content
          .modal-header
            h5.modal-title Edit Call Flow
            button.btn-close(type='button' data-bs-dismiss='modal')
          form#editFlowForm(method='POST')
            .modal-body
              .mb-3
                label.form-label Title
                input.form-control(name='title' id='efTitle')
              .mb-3
                label.form-label Description
                input.form-control(name='description' id='efDescription')
              .form-check.mb-3#efActiveWrap
                input.form-check-input(type='checkbox' name='active' id='efActive' value='true')
                label.form-check-label(for='efActive') Active
              #efSystemNote.alert.alert-warning(style='display:none')
                i.bi.bi-lock.me-1
                | System flow: name cannot be changed. Edit stages using the inline editor.
            .modal-footer
              button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cancel
              button.btn.btn-primary(type='submit') Save

    //- Add Pool Modal
    .modal.fade#addPoolModal(tabindex='-1')
      .modal-dialog
        .modal-content
          .modal-header
            h5.modal-title Add Call Pool
            button.btn-close(type='button' data-bs-dismiss='modal')
          form(method='POST' action='/admin/callpools/new')
            .modal-body
              .mb-3
                label.form-label Pool Name
                input.form-control(name='name' required placeholder='e.g. CustomPool')
              .mb-3
                label.form-label Call Flow
                select.form-select(name='flow_name' required)
                  each flow in flows
                    if flow.kind !== 'web'
                      option(value=flow.name)= (flow.title || flow.name) + ' (' + flow.name + ')'
              .mb-3
                label.form-label WebSocket Paths (comma-separated)
                input.form-control(name='ws_paths' placeholder='/ws/custom, /ws/alt')
              .mb-3
                label.form-label Description
                input.form-control(name='description')
              .form-check
                input.form-check-input(type='checkbox' name='active' id='addPoolActive' checked value='true')
                label.form-check-label(for='addPoolActive') Active
            .modal-footer
              button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cancel
              button.btn.btn-success(type='submit') Add

    //- Edit Pool Modal
    .modal.fade#editPoolModal(tabindex='-1')
      .modal-dialog
        .modal-content
          .modal-header
            h5.modal-title Edit Call Pool
            button.btn-close(type='button' data-bs-dismiss='modal')
          form#editPoolForm(method='POST')
            .modal-body
              .mb-3
                label.form-label Call Flow
                select.form-select(name='flow_name' id='epFlowName')
                  each flow in flows
                    if flow.kind !== 'web'
                      option(value=flow.name)= (flow.title || flow.name) + ' (' + flow.name + ')'
                .form-text Pools run terminal flows only; the web call flow is not a pool's to use.
              .mb-3
                label.form-label WebSocket Paths (comma-separated)
                input.form-control(name='ws_paths' id='epWsPaths')
              .mb-3
                label.form-label Description
                input.form-control(name='description' id='epDescription')
              .form-check
                input.form-check-input(type='checkbox' name='active' id='epActive' value='true')
                label.form-check-label(for='epActive') Active
            .modal-footer
              button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cancel
              button.btn.btn-primary(type='submit') Save

    //- Web stage settings modal: fields built from the stage's definition
    .modal.fade#stageOptionsModal(tabindex='-1')
      .modal-dialog
        .modal-content
          .modal-header
            h5.modal-title#soTitle Stage settings
            button.btn-close(type='button' data-bs-dismiss='modal')
          .modal-body
            p.small.text-muted#soHint
            #soFields
          .modal-footer
            button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cancel
            button.btn.btn-primary#soSave(type='button') Save

    script#webStageCatalog(type='application/json')!= JSON.stringify(webStages).replace(/</g, '\\u003c')

    script.
      // Edit Flow modal
      var editFlowModal = document.getElementById('editFlowModal');
      if (editFlowModal) {
        editFlowModal.addEventListener('show.bs.modal', function(e) {
          var btn = e.relatedTarget;
          if (!btn) return;
          document.getElementById('editFlowForm').action = '/admin/callflows/' + btn.getAttribute('data-id') + '/update';
          document.getElementById('efTitle').value = btn.getAttribute('data-title') || '';
          document.getElementById('efDescription').value = btn.getAttribute('data-description') || '';
          document.getElementById('efActive').checked = btn.getAttribute('data-active') === 'true';
          document.getElementById('efSystemNote').style.display = btn.getAttribute('data-system') === 'true' ? '' : 'none';
          // The web flow is always on; callflow_enabled switches it
          document.getElementById('efActiveWrap').style.display = btn.getAttribute('data-kind') === 'web' ? 'none' : '';
        });
      }

      // Edit Pool modal
      var editPoolModal = document.getElementById('editPoolModal');
      if (editPoolModal) {
        editPoolModal.addEventListener('show.bs.modal', function(e) {
          var btn = e.relatedTarget;
          if (!btn) return;
          document.getElementById('editPoolForm').action = '/admin/callpools/' + btn.getAttribute('data-id') + '/update';
          document.getElementById('epFlowName').value = btn.getAttribute('data-flowname') || '';
          var wsPaths = [];
          try { wsPaths = JSON.parse(btn.getAttribute('data-wspaths') || '[]'); } catch(_) {}
          document.getElementById('epWsPaths').value = wsPaths.join(', ');
          document.getElementById('epDescription').value = btn.getAttribute('data-description') || '';
          document.getElementById('epActive').checked = btn.getAttribute('data-active') === 'true';
        });
      }

      // Stage management — add/remove/reorder stages inline
      document.querySelectorAll('.add-stage-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var wrapper = btn.closest('.mt-2');
          var sel = wrapper.querySelector('.add-stage-select');
          var argInput = wrapper.querySelector('.add-stage-arg');
          var stageName = sel.value;
          if (!stageName) return;

          var stageArg = argInput.style.display !== 'none' ? argInput.value.trim() : '';
          var flowId = btn.closest('.card-body').querySelector('.stage-list').dataset.flowId;

          // Collect current stages
          var stageList = btn.closest('.card-body').querySelector('.stage-list');
          var stages = collectStages(stageList);
          // Web stages take settings, not an argument
          var newStage = (stageArg && stageList.dataset.kind !== 'web') ? { stage: stageName, arg: stageArg } : { stage: stageName };
          stages.push(newStage);

          saveStages(flowId, stages, stageList);
          sel.value = '';
          argInput.value = '';
          argInput.style.display = 'none';
        });
      });

      // Show/hide arg input based on stage selection
      document.querySelectorAll('.add-stage-select').forEach(function(sel) {
        sel.addEventListener('change', function() {
          var argInput = sel.closest('.input-group').querySelector('.add-stage-arg');
          var opt = sel.options[sel.selectedIndex];
          if (opt && opt.dataset.needsarg === 'true') {
            argInput.style.display = '';
          } else {
            argInput.style.display = 'none';
            argInput.value = '';
          }
        });
      });

      // Remove stage
      document.addEventListener('click', function(e) {
        if (e.target.classList.contains('remove-stage')) {
          var badge = e.target.closest('.stage-badge');
          var stageList = badge.closest('.stage-list');
          var flowId = stageList.dataset.flowId;
          badge.remove();
          var stages = collectStages(stageList);
          saveStages(flowId, stages, stageList);
        }
      });

      // Edit stage argument
      document.addEventListener('click', function(e) {
        var editBtn = e.target.closest('.edit-stage-arg');
        if (!editBtn) return;
        var badge = editBtn.closest('.stage-badge');
        var currentArg = badge.dataset.arg || '';
        var stageName = badge.dataset.stage;
        var newArg = window.prompt('Argument for ' + stageName + ':', currentArg);
        if (newArg === null) return; // cancelled
        badge.dataset.arg = newArg.trim();
        // Update display text
        var argDisplay = badge.querySelector('.stage-arg-display');
        if (argDisplay) {
          argDisplay.textContent = newArg.trim() ? '(' + newArg.trim() + ')' : '(no arg)';
          argDisplay.className = newArg.trim() ? 'ms-1 text-muted stage-arg-display' : 'ms-1 text-warning stage-arg-display';
        } else if (newArg.trim()) {
          var small = document.createElement('small');
          small.className = 'ms-1 text-muted stage-arg-display';
          small.textContent = '(' + newArg.trim() + ')';
          editBtn.parentElement.insertBefore(small, editBtn);
        }
        // Save
        var stageList = badge.closest('.stage-list');
        var flowId = stageList.dataset.flowId;
        var stages = collectStages(stageList);
        saveStages(flowId, stages, stageList);
      });

      // Drag-to-reorder stages
      var dragBadge = null;
      document.addEventListener('dragstart', function(e) {
        if (e.target.classList.contains('stage-badge')) {
          dragBadge = e.target;
          e.dataTransfer.effectAllowed = 'move';
        }
      });
      document.addEventListener('dragover', function(e) {
        if (!dragBadge) return;
        var target = e.target.closest('.stage-badge');
        if (target && target !== dragBadge && target.parentElement === dragBadge.parentElement) {
          e.preventDefault();
          var rect = target.getBoundingClientRect();
          var mid = rect.left + rect.width / 2;
          if (e.clientX < mid) {
            target.parentElement.insertBefore(dragBadge, target);
          } else {
            target.parentElement.insertBefore(dragBadge, target.nextSibling);
          }
        }
      });
      document.addEventListener('dragend', function() {
        if (!dragBadge) return;
        var stageList = dragBadge.closest('.stage-list');
        var flowId = stageList.dataset.flowId;
        dragBadge = null;
        var stages = collectStages(stageList);
        saveStages(flowId, stages, stageList);
      });

      function collectStages(stageList) {
        var badges = stageList.querySelectorAll('.stage-badge');
        var isWeb = stageList.dataset.kind === 'web';
        var stages = [];
        badges.forEach(function(b) {
          var s = { stage: b.dataset.stage };
          if (isWeb) {
            var opts = {};
            try { opts = JSON.parse(b.dataset.options || '{}'); } catch (_) {}
            if (opts && Object.keys(opts).length > 0) s.options = opts;
          } else if (b.dataset.arg) {
            s.arg = b.dataset.arg;
          }
          stages.push(s);
        });
        return stages;
      }

      // A refused save (a stage of the wrong kind, a bad setting) is said,
      // then the page reloads to show what is actually stored
      function saveStages(flowId, stages, stageList) {
        fetch('/admin/callflows/' + flowId + '/stages', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ stages: stages })
        }).then(function(r) {
          return r.json().catch(function() { return { status: r.ok, errormessages: [] }; });
        }).then(function(result) {
          if (!result.status) {
            alert('Not saved:\n' + ((result.errormessages || []).join('\n') || 'unknown error'));
          }
          location.reload();
        }).catch(function(err) {
          alert('Not saved: ' + err.message);
          location.reload();
        });
      }

      // Web stage settings
      var webCatalog = [];
      try { webCatalog = JSON.parse(document.getElementById('webStageCatalog').textContent); } catch (_) {}
      var optionsBadge = null;

      var stageOptionsModal = document.getElementById('stageOptionsModal');
      stageOptionsModal.addEventListener('show.bs.modal', function(e) {
        optionsBadge = e.relatedTarget ? e.relatedTarget.closest('.stage-badge') : null;
        var fields = document.getElementById('soFields');
        fields.innerHTML = '';
        if (!optionsBadge) return;
        var entry = webCatalog.find(function(w) { return w.name === optionsBadge.dataset.stage; });
        if (!entry) return;
        var current = {};
        try { current = JSON.parse(optionsBadge.dataset.options || '{}'); } catch (_) {}
        document.getElementById('soTitle').textContent = entry.label + ' settings';
        document.getElementById('soHint').textContent = entry.hint || '';
        entry.options.forEach(function(def) {
          var value = Object.prototype.hasOwnProperty.call(current, def.key) ? current[def.key] : def.default;
          var wrap = document.createElement('div');
          wrap.className = 'mb-3';
          var label = document.createElement('label');
          label.className = 'form-label';
          label.textContent = def.label;
          wrap.appendChild(label);
          var input;
          if (def.type === 'select') {
            input = document.createElement('select');
            input.className = 'form-select';
            def.choices.forEach(function(c) {
              var o = document.createElement('option');
              o.value = c.value;
              o.textContent = c.label;
              if (c.value === value) o.selected = true;
              input.appendChild(o);
            });
          } else {
            input = document.createElement('input');
            input.type = 'number';
            input.className = 'form-control';
            input.min = def.min;
            input.max = def.max;
            input.step = 1;
            input.value = value;
            var help = document.createElement('div');
            help.className = 'form-text';
            help.textContent = def.min + ' to ' + def.max + ', default ' + def.default;
            wrap.appendChild(input);
            wrap.appendChild(help);
          }
          input.dataset.key = def.key;
          input.dataset.type = def.type;
          input.dataset.default = String(def.default);
          if (!input.parentNode) wrap.appendChild(input);
          fields.appendChild(wrap);
        });
      });

      document.getElementById('soSave').addEventListener('click', function() {
        if (!optionsBadge) return;
        // Only what differs from the default is stored, so a later change of
        // default reaches every stage the sysop never touched
        var opts = {};
        document.querySelectorAll('#soFields [data-key]').forEach(function(input) {
          var v = input.dataset.type === 'number' ? parseInt(input.value, 10) : input.value;
          if (String(v) !== input.dataset.default) opts[input.dataset.key] = input.dataset.type === 'number' && isNaN(v) ? input.value : v;
        });
        optionsBadge.dataset.options = JSON.stringify(opts);
        var stageList = optionsBadge.closest('.stage-list');
        bootstrap.Modal.getInstance(stageOptionsModal).hide();
        saveStages(stageList.dataset.flowId, collectStages(stageList), stageList);
      });
