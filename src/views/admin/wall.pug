extends ../layouts/admin
block content
  .container-fluid
    br
    br
    .row
      .col-lg-10.offset-lg-1.col-12
        h2.mb-4
          i.bi.bi-chat-square-text.me-2
          | Wall Messages

        if messages && messages.length > 0
          .table-responsive
            table.table.table-sm.table-hover
              thead
                tr
                  th Username
                  th Message
                  th Date
                  th(style='width: 80px')
              tbody
                each msg in messages
                  tr
                    td.fg-brightcyan= msg.username
                    td= msg.message
                    td.text-muted
                      small= msg.created_at ? new Date(msg.created_at).toLocaleString() : ''
                    td
                      form(method='POST' action='/admin/wall/delete/' + msg.uuid style='display:inline')
                        button.btn.btn-outline-danger.btn-sm(type='submit' title='Delete' onclick='return confirm("Delete this message?")')
                          i.bi.bi-trash
        else
          .text-center.text-muted.py-5
            i.bi.bi-chat-square-text(style='font-size: 3rem; color: #555')
            h5.mt-3 No wall messages
