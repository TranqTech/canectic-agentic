extends ../../layouts/admin

block content
  .container-fluid.main-wrapper
    if !currentuser
      - loginMode = 'guard'
      - loginRedirect = currentPath
      include ../../partials/users/login.pug
    else if !sufficientAccess
      include ../../partials/status/unauthorized.pug
    else
      if !ismobile
        .row
          .col-12
            br
            br
        .row
          .col-1
          .col-10
            .card
              .card-header.bg-darkblue.text-white
                .row
                  .col-8
                    h2= title
                  .col-4
                    .text-end
                      button#saveOrderBtn.btn.btn-sm.btn-warning.me-2(style='display:none')
                        i.bi.bi-arrow-down-up
                        |  Save Order
                      a.button.btn.btn-sm.btn-info.me-2(href='/admin')
                        | Exit
                      button.btn.btn-sm.btn-success(data-bs-toggle='modal' data-bs-target='#newCollectionModal')
                        | New Collection
              .card-body
                if collections && collections.length > 0
                  table#collectionsTable.table.table-hover
                    thead
                      tr
                        th(style='width:30px')
                        th(style='width:60px') Icon
                        th Name
                        th Slug
                        th Doors
                        th Status
                        th(style='width:140px') Actions
                    tbody#sortableCollections
                      for col in collections
                        tr(data-id=col.id)
                          td.drag-handle(style='cursor:grab; text-align:center; color:#888')
                            i.bi.bi-grip-vertical
                          td
                            if col.icon_url
                              img(src=col.icon_url style='max-height:32px; max-width:32px')
                            else
                              i.bi.bi-controller.text-muted(style='font-size:1.5rem')
                          td
                            a(href='/admin/doorCollections/' + col.id)= col.name
                          td.text-muted= col.slug
                          td
                            span.badge.bg-info= doorCounts[col.id] || 0
                          td
                            if col.active
                              span.badge.bg-success Active
                            else
                              span.badge.bg-danger Inactive
                          td
                            a.btn.btn-xs.btn-outline-primary.me-1(href='/admin/doorCollections/' + col.id title='Manage')
                              i.bi.bi-folder-symlink
                            button.btn.btn-xs.btn-outline-warning.me-1.edit-col-btn(
                              type='button' title='Edit'
                              data-id=col.id
                              data-name=col.name
                              data-slug=col.slug
                              data-description=col.description || ''
                              data-icon_url=col.icon_url || ''
                              data-sort_order=col.sort_order || 0
                              data-active=(col.active ? 'true' : 'false')
                            )
                              i.bi.bi-pencil
                            form.d-inline(action='/admin/doorCollections/delete/' + col.id method='POST')
                              button.btn.btn-xs.btn-outline-danger(type='submit' title='Delete' onclick="return confirm('Delete this collection and all its entries?')")
                                i.bi.bi-trash
                else
                  center
                    .h4 No Door Collections
                    p.text-muted Create collections to organize your door games.

    //- New Collection Modal
    #newCollectionModal.modal.fade(tabindex='-1' aria-hidden='true')
      .modal-dialog.modal-dialog-centered.modal-lg
        .modal-content
          .modal-header.bg-dark.text-white
            h3.modal-title New Collection
            button.btn.btn-lg.btn-close.btn-close-white(data-bs-dismiss='modal')
          .modal-body
            form#newColForm(action='/admin/doorCollections/new' method='POST')
              label.form-label Name:
              input.form-control.mb-2(type='text' name='name' required placeholder='e.g. Action Games')
              label.form-label Slug:
              input.form-control.mb-2(type='text' name='slug' required placeholder='e.g. action-games')
              label.form-label Description:
              textarea#nc_description.form-control.mb-2(name='description' rows='4')
              small.form-text.text-muted.d-block.mb-2 Rich text with ANSI colour palette. Plain text still works — use colour for highlights/labels.
              label.form-label Icon URL (PNG/SVG):
              input.form-control.mb-2(type='text' name='icon_url' placeholder='/images/doors/action.png')
              .row
                .col-6
                  label.form-label Sort Order:
                  input.form-control.mb-2(type='number' name='sort_order' value='0')
                .col-6
                  .form-check.mt-4
                    input.form-check-input(type='checkbox' name='active' value='true' checked id='newActive')
                    label.form-check-label(for='newActive') Active
              .text-end
                input.btn.btn-success(type='submit' value='Create Collection')

    //- Edit Collection Modal
    #editCollectionModal.modal.fade(tabindex='-1' aria-hidden='true')
      .modal-dialog.modal-dialog-centered.modal-lg
        .modal-content
          .modal-header.bg-dark.text-white
            h3.modal-title Edit Collection
            button.btn.btn-lg.btn-close.btn-close-white(data-bs-dismiss='modal')
          .modal-body
            form#editColForm(method='POST')
              label.form-label Name:
              input#ec_name.form-control.mb-2(type='text' name='name' required)
              label.form-label Description:
              textarea#ec_description.form-control.mb-2(name='description' rows='4')
              label.form-label Icon URL (PNG/SVG):
              input#ec_icon_url.form-control.mb-2(type='text' name='icon_url')
              .row
                .col-6
                  label.form-label Sort Order:
                  input#ec_sort_order.form-control.mb-2(type='number' name='sort_order')
                .col-6
                  .form-check.mt-4
                    input#ec_active.form-check-input(type='checkbox' name='active' value='true')
                    label.form-check-label(for='ec_active') Active
              .text-end
                input.btn.btn-success(type='submit' value='Save Changes')

  script.
    document.addEventListener('DOMContentLoaded', function() {
      // ---- TinyMCE shared config ----
      // Matches the ANSI palette used on the doors admin so descriptions
      // coloured here look consistent with the rest of the sysop UI.
      var ansiColorMap = [
        '010101', 'Theme Default',
        'AA0000', 'Red',
        '00AA00', 'Green',
        'AA5500', 'Yellow (dark)',
        '0000AA', 'Blue',
        'AA00AA', 'Magenta',
        '00AAAA', 'Cyan',
        'AAAAAA', 'White (grey)',
        '000000', 'Black',
        'FF5555', 'Bright Red',
        '55FF55', 'Bright Green',
        'FFFF55', 'Bright Yellow',
        '5555FF', 'Bright Blue',
        'FF55FF', 'Bright Magenta',
        '55FFFF', 'Bright Cyan',
        'FFFFFF', 'Bright White',
        '555555', 'Bright Black'
      ];
      var mceBase = {
        license_key: 'gpl',
        menubar: false,
        plugins: 'lists link autolink',
        toolbar: 'bold italic underline strikethrough | forecolor backcolor | bullist numlist | link | removeformat',
        skin: 'oxide-dark',
        content_css: 'dark',
        content_style: 'span[style*="color: #010101"], span[style*="color: rgb(1, 1, 1)"] { color: inherit !important; }',
        color_map: ansiColorMap,
        color_cols: 9,
        custom_colors: false,
        branding: false,
        promotion: false,
        setup: function(editor) {
          editor.on('change', function() { editor.save(); });
        }
      };

      // Lazy-init TinyMCE when the modal is shown -- initialising on a
      // hidden textarea produces an invisible editor.
      var mceInited = {};
      function lazyMceOnModal(modalId, selector, height) {
        var modalEl = document.getElementById(modalId);
        if (!modalEl) return;
        modalEl.addEventListener('shown.bs.modal', function() {
          if (!mceInited[selector]) {
            tinymce.init(Object.assign({}, mceBase, { selector: selector, height: height }));
            mceInited[selector] = true;
          } else {
            // Re-sync editor contents from the textarea (for edit modal,
            // which populates the textarea before show).
            var ed = tinymce.get(selector.replace('#', ''));
            if (ed) ed.setContent(document.querySelector(selector).value || '');
          }
        });
        modalEl.addEventListener('hide.bs.modal', function() {
          var ed = tinymce.get(selector.replace('#', ''));
          if (ed) ed.save();
        });
      }
      lazyMceOnModal('newCollectionModal',  '#nc_description', 260);
      lazyMceOnModal('editCollectionModal', '#ec_description', 260);

      // Sync editor contents to the textarea before submit
      function syncBeforeSubmit(formId, editorId) {
        var form = document.getElementById(formId);
        if (!form) return;
        form.addEventListener('submit', function() {
          var ed = tinymce.get(editorId);
          if (ed) ed.save();
        });
      }
      syncBeforeSubmit('newColForm',  'nc_description');
      syncBeforeSubmit('editColForm', 'ec_description');

      // Edit modal population
      var editModal = new bootstrap.Modal(document.getElementById('editCollectionModal'));
      document.querySelectorAll('.edit-col-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var d = this.dataset;
          document.getElementById('editColForm').action = '/admin/doorCollections/update/' + d.id;
          document.getElementById('ec_name').value = d.name;
          document.getElementById('ec_description').value = d.description;
          document.getElementById('ec_icon_url').value = d.icon_url;
          document.getElementById('ec_sort_order').value = d.sort_order;
          document.getElementById('ec_active').checked = d.active === 'true';
          editModal.show();
        });
      });

      // ---- Drag-to-reorder collections ----
      var tbody = document.getElementById('sortableCollections');
      var saveBtn = document.getElementById('saveOrderBtn');
      var dragRow = null;
      var orderChanged = false;

      if (tbody) {
        tbody.addEventListener('dragstart', function(e) {
          var tr = e.target.closest('tr');
          if (!tr) return;
          dragRow = tr;
          tr.style.opacity = '0.4';
          e.dataTransfer.effectAllowed = 'move';
        });
        tbody.addEventListener('dragend', function(e) {
          var tr = e.target.closest('tr');
          if (tr) tr.style.opacity = '';
          dragRow = null;
          tbody.querySelectorAll('tr').forEach(function(r) { r.style.borderTop = ''; r.style.borderBottom = ''; });
        });
        tbody.addEventListener('dragover', function(e) {
          e.preventDefault();
          e.dataTransfer.dropEffect = 'move';
          var tr = e.target.closest('tr');
          if (!tr || tr === dragRow) return;
          tbody.querySelectorAll('tr').forEach(function(r) { r.style.borderTop = ''; r.style.borderBottom = ''; });
          var rect = tr.getBoundingClientRect();
          if (e.clientY < rect.top + rect.height / 2) {
            tr.style.borderTop = '2px solid #f0ad4e';
          } else {
            tr.style.borderBottom = '2px solid #f0ad4e';
          }
        });
        tbody.addEventListener('drop', function(e) {
          e.preventDefault();
          var tr = e.target.closest('tr');
          if (!tr || !dragRow || tr === dragRow) return;
          var rect = tr.getBoundingClientRect();
          if (e.clientY < rect.top + rect.height / 2) {
            tbody.insertBefore(dragRow, tr);
          } else {
            tbody.insertBefore(dragRow, tr.nextSibling);
          }
          orderChanged = true;
          if (saveBtn) saveBtn.style.display = 'inline-block';
          tbody.querySelectorAll('tr').forEach(function(r) { r.style.borderTop = ''; r.style.borderBottom = ''; });
        });
        tbody.querySelectorAll('tr').forEach(function(tr) { tr.setAttribute('draggable', 'true'); });
      }

      if (saveBtn) {
        saveBtn.addEventListener('click', function() {
          if (!orderChanged) return;
          var ids = [];
          tbody.querySelectorAll('tr').forEach(function(r) { ids.push(parseInt(r.dataset.id)); });
          saveBtn.disabled = true;
          saveBtn.textContent = 'Saving...';
          fetch('/admin/doorCollections/reorder', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ ids: ids })
          }).then(function(r) { return r.json(); }).then(function(d) {
            if (d.status) { saveBtn.style.display = 'none'; orderChanged = false; }
          }).finally(function() {
            saveBtn.disabled = false;
            saveBtn.innerHTML = '<i class="bi bi-arrow-down-up"></i> Save Order';
          });
        });
      }
    });
