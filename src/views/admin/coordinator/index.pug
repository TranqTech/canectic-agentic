extends ../../layouts/admin
block content
  .container-fluid
    br
    br
    .row
      .col-lg-10.offset-lg-1.col-12
        .d-flex.justify-content-between.align-items-center.mb-3
          h2
            i.bi.bi-diagram-3.me-2
            | Network Coordinator
            if network
              small.text-muted.ms-2= network.name
          div
            button.btn.btn-sm.btn-success.me-1(data-bs-toggle='modal' data-bs-target='#addSegmentModal' data-parent='' data-parentrole='')
              i.bi.bi-plus-circle.me-1
              | Add Segment
            form.d-inline(method='POST' action='/admin/coordinator/' + network.id + '/compile')
              button.btn.btn-sm.btn-info.me-1(type='submit' title='Compile full nodelist from all segments and stubs')
                i.bi.bi-layers.me-1
                | Compile
            a.btn.btn-sm.btn-outline-info.me-1(href='/admin/coordinator/' + network.id + '/compiled/download' title='Download compiled nodelist')
              i.bi.bi-download
            a.btn.btn-sm.btn-outline-light.ms-1(href='/admin/network/' + network.uuid)
              i.bi.bi-arrow-left.me-1
              | Network

        if tree && tree.length > 0
          each seg in tree
            +segmentNode(seg, 0)
        else
          .card
            .card-body
              p.text-muted No coordinator segments defined. Create a segment to start managing nodes for this network.

  //- Recursive segment tree mixin
  mixin segmentNode(seg, indent)
    - var indentPx = indent * 32
    .card.mb-2(style='margin-left: ' + indentPx + 'px')
      .card-header.d-flex.justify-content-between.align-items-center(class=seg.source === 'external' ? 'bg-secondary' : 'bg-darkblue text-white')
        div
          strong= seg.name
          span.badge.bg-primary.ms-2= seg.role
          if seg.source === 'external'
            span.badge.bg-warning.text-dark.ms-2 External
          else
            span.badge.bg-success.ms-2 Internal
          code.ms-2= seg.zone + ':' + (seg.region ? 'R' + seg.region : seg.net) + (seg.hub_node ? '/' + seg.hub_node : '')
          if !seg.active
            span.badge.bg-danger.ms-2 Inactive
        div
          if seg.source === 'internal'
            a.btn.btn-sm.btn-outline-light.me-1(href='/admin/coordinator/segment/' + seg.id + '/nodes')
              i.bi.bi-people.me-1
              | Nodes
              if seg._stats && seg._stats.active_count > 0
                span.badge.bg-info.ms-1= seg._stats.active_count
            a.btn.btn-sm.btn-outline-info.me-1(href='/admin/coordinator/segment/' + seg.id + '/stub' target='_blank' title='Preview stub')
              i.bi.bi-eye
            a.btn.btn-sm.btn-outline-success.me-1(href='/admin/coordinator/segment/' + seg.id + '/stub/download' title='Download stub')
              i.bi.bi-download
            form.d-inline(method='POST' action='/admin/coordinator/segment/' + seg.id + '/generate')
              button.btn.btn-sm.btn-warning.me-1(type='submit' title='Generate and distribute now')
                i.bi.bi-send
          else
            a.btn.btn-sm.btn-outline-light.me-1(href='/admin/coordinator/segment/' + seg.id + '/stub' target='_blank' title='View received stub')
              i.bi.bi-eye
              |  View Stub
          //- Add Child button
          button.btn.btn-sm.btn-outline-success.me-1.add-child-btn(
            data-bs-toggle='modal' data-bs-target='#addSegmentModal'
            data-parent=seg.id
            data-parentrole=seg.role
            data-parentzone=seg.zone
            data-parentregion=seg.region || 0
            data-parentnet=seg.net || 0
            title='Add child segment'
          )
            i.bi.bi-plus-circle.me-1
            | Child
          button.btn.btn-sm.btn-outline-warning.me-1.edit-seg-btn(
            data-bs-toggle='modal' data-bs-target='#editSegmentModal'
            data-id=seg.id
            data-name=seg.name
            data-role=seg.role
            data-source=seg.source || 'internal'
            data-zone=seg.zone
            data-region=seg.region || 0
            data-net=seg.net || 0
            data-hubnode=seg.hub_node || 0
            data-upstream=seg.upstream_address || ''
            data-upstreamconn=seg.upstream_connection_id || ''
            data-stubfilename=seg.stub_filename || ''
            data-stubfilearea=seg.stub_file_area || ''
            data-distribution=seg.distribution_method || 'manual'
            data-schedule=seg.schedule || 'manual'
            data-description=seg.description || ''
            data-active=(seg.active ? 'true' : 'false')
          )
            i.bi.bi-pencil
          form.d-inline(method='POST' action='/admin/coordinator/segments/' + seg.id + '/delete')
            button.btn.btn-sm.btn-outline-danger(type='submit' onclick='return confirm("Delete this segment? It must have no children.")')
              i.bi.bi-trash
      .card-body.py-2
        .row
          .col-4
            if seg.description
              p.mb-1.text-muted= seg.description
            if seg.upstream_address
              p.mb-1
                strong Upstream:
                |
                code= seg.upstream_address
            if seg.source === 'external' && seg.stub_file_area
              p.mb-1
                strong Stub area:
                |
                code= seg.stub_file_area
          .col-4
            if seg.source === 'internal'
              p.mb-1
                strong Distribution:
                |  #{seg.distribution_method || 'manual'}
              p.mb-1
                strong Schedule:
                |  #{seg.schedule || 'manual'}
              if seg.stub_filename
                p.mb-1
                  strong Stub filename:
                  |
                  code= seg.stub_filename
          .col-4
            if seg._stats && seg.source === 'internal'
              p.mb-1
                span.badge.bg-info.me-1= seg._stats.total + ' total'
                span.badge.bg-success.me-1= seg._stats.active_count + ' active'
                if seg._stats.hub_count > 0
                  span.badge.bg-primary.me-1= seg._stats.hub_count + ' hub(s)'
                if seg._stats.down_count > 0
                  span.badge.bg-danger.me-1= seg._stats.down_count + ' down'
            if seg.last_generated_at
              p.mb-1.small.text-muted Last generated: #{new Date(seg.last_generated_at).toLocaleString()}

    //- Recurse into children
    if seg.children && seg.children.length > 0
      each child in seg.children
        +segmentNode(child, indent + 1)

  .row
    .col-lg-10.offset-lg-1.col-12

      //- Add Segment Modal (also used for Add Child)
      .modal.fade#addSegmentModal(tabindex='-1')
        .modal-dialog.modal-lg
          .modal-content
            .modal-header
              h5.modal-title#addSegTitle Add Segment
              button.btn-close(type='button' data-bs-dismiss='modal')
            form(method='POST' action='/admin/coordinator/' + network.id + '/segments/new')
              input(type='hidden' name='parent_segment_id' id='addParentId' value='')
              .modal-body
                .row
                  .col-6
                    .mb-3
                      label.form-label Name
                      input.form-control(name='name' required placeholder='e.g. Net 134')
                    .mb-3
                      label.form-label Role
                      select.form-select(name='role' id='addRole')
                        each r in validRoles
                          option(value=r)= roleLabels[r] || r
                    .mb-3
                      label.form-label Source
                      select.form-select(name='source' id='addSource')
                        option(value='internal') Internal (managed by me)
                        option(value='external') External (received stubs)
                    .mb-3
                      label.form-label Zone
                      input.form-control(type='number' name='zone' id='addZone' value='1' required)
                    .mb-3
                      label.form-label Region
                      input.form-control(type='number' name='region' id='addRegion' value='0')
                    .mb-3
                      label.form-label Net
                      input.form-control(type='number' name='net' id='addNet' placeholder='134')
                  .col-6
                    .mb-3
                      label.form-label Upstream Address
                      input.form-control(name='upstream_address' placeholder='1:1/21')
                    .mb-3
                      label.form-label Stub Filename
                      input.form-control(name='stub_filename' placeholder='NET134')
                    .mb-3#addStubFileAreaGroup
                      label.form-label Stub File Area
                      select.form-select(name='stub_file_area')
                        option(value='') None (use network default)
                        each fa in allFileAreas
                          option(value=fa.shortcode)= fa.name + ' [' + fa.shortcode + ']'
                      .form-text For external segments: file area where received stubs arrive
                    .mb-3#addDistGroup
                      label.form-label Distribution
                      select.form-select(name='distribution_method')
                        each dm in distributionMethods
                          option(value=dm)= dm
                    .mb-3#addScheduleGroup
                      label.form-label Schedule
                      input.form-control(name='schedule' value='manual' placeholder='manual or 0 6 * * 3')
                      .form-text
                        | "manual" = on demand only. Or use a cron pattern: e.g.
                        code.ms-1 0 6 * * 3
                        |  = Wednesday 6 AM
                .mb-3
                  label.form-label Description
                  input.form-control(name='description')
                .form-check
                  input.form-check-input(type='checkbox' name='active' id='addSegActive' checked value='true')
                  label.form-check-label(for='addSegActive') Active
              .modal-footer
                button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cancel
                button.btn.btn-success(type='submit') Add

      //- Edit Segment Modal
      .modal.fade#editSegmentModal(tabindex='-1')
        .modal-dialog.modal-lg
          .modal-content
            .modal-header
              h5.modal-title Edit Segment
              button.btn-close(type='button' data-bs-dismiss='modal')
            form#editSegForm(method='POST')
              .modal-body
                .row
                  .col-6
                    .mb-3
                      label.form-label Name
                      input.form-control(name='name' id='esName' required)
                    .mb-3
                      label.form-label Role
                      select.form-select(name='role' id='esRole')
                        each r in validRoles
                          option(value=r)= roleLabels[r] || r
                    .mb-3
                      label.form-label Source
                      select.form-select(name='source' id='esSource')
                        option(value='internal') Internal (managed by me)
                        option(value='external') External (received stubs)
                    .mb-3
                      label.form-label Zone
                      input.form-control(type='number' name='zone' id='esZone')
                    .mb-3
                      label.form-label Region
                      input.form-control(type='number' name='region' id='esRegion')
                    .mb-3
                      label.form-label Net
                      input.form-control(type='number' name='net' id='esNet')
                    .mb-3
                      label.form-label Hub Node
                      input.form-control(type='number' name='hub_node' id='esHubNode')
                  .col-6
                    .mb-3
                      label.form-label Upstream Address
                      input.form-control(name='upstream_address' id='esUpstream')
                    .mb-3
                      label.form-label Stub Filename
                      input.form-control(name='stub_filename' id='esStubFilename')
                    .mb-3#esStubFileAreaGroup
                      label.form-label Stub File Area
                      select.form-select(name='stub_file_area' id='esStubFileArea')
                        option(value='') None (use network default)
                        each fa in allFileAreas
                          option(value=fa.shortcode)= fa.name + ' [' + fa.shortcode + ']'
                    .mb-3#esDistGroup
                      label.form-label Distribution
                      select.form-select(name='distribution_method' id='esDistribution')
                        each dm in distributionMethods
                          option(value=dm)= dm
                    .mb-3#esScheduleGroup
                      label.form-label Schedule
                      input.form-control(name='schedule' id='esSchedule' placeholder='manual or cron pattern')
                .mb-3
                  label.form-label Description
                  input.form-control(name='description' id='esDescription')
                .form-check
                  input.form-check-input(type='checkbox' name='active' id='esActive' value='true')
                  label.form-check-label(for='esActive') Active
              .modal-footer
                button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cancel
                button.btn.btn-primary(type='submit') Save

  script.
    //- Valid roles for this network (from server)
    var networkRoles = !{JSON.stringify(validRoles)};
    var roleLabels = !{JSON.stringify(roleLabels)};

    //- Role hierarchy: given a parent role, which child roles are valid?
    function getChildRoles(parentRole) {
      if (!parentRole) return networkRoles.length > 0 ? [networkRoles[0]] : [];
      var idx = networkRoles.indexOf(parentRole);
      if (idx < 0 || idx >= networkRoles.length - 1) return [];
      return networkRoles.slice(idx + 1);
    }

    //- Update role dropdown to only show valid options
    function filterRoles(selectEl, allowedRoles) {
      var current = selectEl.value;
      selectEl.innerHTML = '';
      allowedRoles.forEach(function(r) {
        var opt = document.createElement('option');
        opt.value = r;
        opt.textContent = roleLabels[r] || r;
        if (r === current) opt.selected = true;
        selectEl.appendChild(opt);
      });
      if (!allowedRoles.includes(current) && allowedRoles.length > 0) {
        selectEl.value = allowedRoles[0];
      }
    }

    //- Toggle source-dependent fields
    function toggleSourceFields(source, distGroup, schedGroup, stubAreaGroup) {
      if (source === 'external') {
        if (distGroup) distGroup.style.display = 'none';
        if (schedGroup) schedGroup.style.display = 'none';
        if (stubAreaGroup) stubAreaGroup.style.display = '';
      } else {
        if (distGroup) distGroup.style.display = '';
        if (schedGroup) schedGroup.style.display = '';
        if (stubAreaGroup) stubAreaGroup.style.display = 'none';
      }
    }

    //- Add Segment modal: context-aware from parent
    var addModal = document.getElementById('addSegmentModal');
    if (addModal) {
      addModal.addEventListener('show.bs.modal', function(e) {
        var btn = e.relatedTarget;
        if (!btn) return;
        var parentId = btn.dataset.parent || '';
        var parentRole = btn.dataset.parentrole || '';
        document.getElementById('addParentId').value = parentId;

        var titleEl = document.getElementById('addSegTitle');
        var roleSelect = document.getElementById('addRole');

        if (parentId) {
          titleEl.textContent = 'Add Child Segment';
          var allowed = getChildRoles(parentRole);
          filterRoles(roleSelect, allowed);
          // Pre-fill zone from parent
          if (btn.dataset.parentzone) document.getElementById('addZone').value = btn.dataset.parentzone;
          if (btn.dataset.parentregion) document.getElementById('addRegion').value = btn.dataset.parentregion;
          if (btn.dataset.parentnet) document.getElementById('addNet').value = btn.dataset.parentnet;
        } else {
          titleEl.textContent = 'Add Segment';
          filterRoles(roleSelect, networkRoles);
        }

        // Toggle source fields
        var addSource = document.getElementById('addSource');
        toggleSourceFields(addSource.value,
          document.getElementById('addDistGroup'),
          document.getElementById('addScheduleGroup'),
          document.getElementById('addStubFileAreaGroup'));
      });

      // Source change toggles fields
      var addSource = document.getElementById('addSource');
      if (addSource) {
        addSource.addEventListener('change', function() {
          toggleSourceFields(this.value,
            document.getElementById('addDistGroup'),
            document.getElementById('addScheduleGroup'),
            document.getElementById('addStubFileAreaGroup'));
        });
      }
    }

    //- Edit Segment modal
    var editModal = document.getElementById('editSegmentModal');
    if (editModal) {
      editModal.addEventListener('show.bs.modal', function(e) {
        var btn = e.relatedTarget;
        if (!btn) return;
        document.getElementById('editSegForm').action = '/admin/coordinator/segments/' + btn.dataset.id + '/update';
        document.getElementById('esName').value = btn.dataset.name || '';
        document.getElementById('esRole').value = btn.dataset.role || 'NC';
        document.getElementById('esSource').value = btn.dataset.source || 'internal';
        document.getElementById('esZone').value = btn.dataset.zone || '1';
        document.getElementById('esRegion').value = btn.dataset.region || '0';
        document.getElementById('esNet').value = btn.dataset.net || '';
        document.getElementById('esHubNode').value = btn.dataset.hubnode || '0';
        document.getElementById('esUpstream').value = btn.dataset.upstream || '';
        document.getElementById('esStubFilename').value = btn.dataset.stubfilename || '';
        document.getElementById('esStubFileArea').value = btn.dataset.stubfilearea || '';
        document.getElementById('esDistribution').value = btn.dataset.distribution || 'manual';
        document.getElementById('esSchedule').value = btn.dataset.schedule || 'manual';
        document.getElementById('esDescription').value = btn.dataset.description || '';
        document.getElementById('esActive').checked = btn.dataset.active === 'true';

        toggleSourceFields(btn.dataset.source || 'internal',
          document.getElementById('esDistGroup'),
          document.getElementById('esScheduleGroup'),
          document.getElementById('esStubFileAreaGroup'));
      });

      // Source change toggles fields
      var esSource = document.getElementById('esSource');
      if (esSource) {
        esSource.addEventListener('change', function() {
          toggleSourceFields(this.value,
            document.getElementById('esDistGroup'),
            document.getElementById('esScheduleGroup'),
            document.getElementById('esStubFileAreaGroup'));
        });
      }
    }
