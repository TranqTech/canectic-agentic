extends ../../layouts/admin
block content
  .container-fluid
    br
    br
    .row
      .col-lg-10.offset-lg-1.col-12
        - var segId = segment ? segment.id : null
        - var baseUrl = segId ? '/admin/coordinator/segment/' + segId : '/admin/coordinator/' + network.id
        .d-flex.justify-content-between.align-items-center.mb-3
          h2
            i.bi.bi-diagram-3.me-2
            | Managed Nodes
            if segment
              small.text-muted.ms-2= segment.name
              span.badge.bg-primary.ms-2= segment.role
            else if network
              small.text-muted.ms-2= network.name
          .d-flex
            a.btn.btn-sm.btn-outline-light.me-2(href='/admin/coordinator/' + network.id)
              i.bi.bi-arrow-left.me-1
              | Segments
            a.btn.btn-sm.btn-outline-info.me-2(href=baseUrl + '/stub' target='_blank' title='Preview stub')
              i.bi.bi-eye.me-1
              | Preview
            a.btn.btn-sm.btn-outline-success.me-2(href=baseUrl + '/stub/download' title='Download stub file')
              i.bi.bi-download.me-1
              | Download Stub
            button.btn.btn-sm.btn-success(data-bs-toggle='modal' data-bs-target='#addNodeModal')
              i.bi.bi-plus-circle.me-1
              | Add Node

        //- Stats bar
        if stats
          .row.mb-3
            .col
              .d-flex.gap-3
                span.badge.bg-info.p-2= stats.total + ' total'
                span.badge.bg-success.p-2= stats.active_count + ' active'
                span.badge.bg-primary.p-2= stats.hub_count + ' hub(s)'
                if stats.down_count > 0
                  span.badge.bg-danger.p-2= stats.down_count + ' down'
                if stats.hold_count > 0
                  span.badge.bg-warning.text-dark.p-2= stats.hold_count + ' hold'

        //- Node table
        .card
          .card-body
            if nodes && nodes.length > 0
              table#nodeTable.table.table-sm.table-hover.mb-0
                thead
                  tr
                    th Address
                    th Keyword
                    th System Name
                    th Location
                    th Sysop
                    th Hostname
                    th Flags
                    th Status
                    th(style='width:100px')
                tbody
                  each node in nodes
                    - var flags = Array.isArray(node.flags) ? node.flags : (typeof node.flags === 'string' ? JSON.parse(node.flags || '[]') : [])
                    tr(class=(node.keyword === 'Down' ? 'table-danger' : node.keyword === 'Hold' ? 'table-warning' : node.keyword === 'Hub' || node.keyword === 'Host' ? 'table-info' : ''))
                      td
                        code= node.zone + ':' + node.net + '/' + node.node
                      td
                        if node.keyword
                          span.badge(class=node.keyword === 'Hub' || node.keyword === 'Host' ? 'bg-primary' : node.keyword === 'Down' ? 'bg-danger' : node.keyword === 'Hold' ? 'bg-warning text-dark' : 'bg-secondary')= node.keyword
                      td= node.system_name
                      td= node.location
                      td= node.sysop_name
                      td
                        if node.hostname
                          small.text-muted= node.hostname
                          if node.binkp_port && node.binkp_port !== 24554
                            small.text-muted= ':' + node.binkp_port
                      td
                        each f in flags
                          span.badge.bg-dark.me-1= f
                      td
                        if node.active
                          span.badge.bg-success Active
                        else
                          span.badge.bg-secondary Inactive
                      td
                        button.btn.btn-sm.btn-primary.me-1.edit-node-btn(
                          data-bs-toggle='modal' data-bs-target='#editNodeModal'
                          data-id=node.id
                          data-zone=node.zone
                          data-region=node.region
                          data-net=node.net
                          data-node=node.node
                          data-keyword=node.keyword || ''
                          data-hubnode=node.hub_node || 0
                          data-systemname=node.system_name
                          data-location=node.location
                          data-sysopname=node.sysop_name
                          data-phone=node.phone || '-Unpublished-'
                          data-baud=node.baud || 300
                          data-hostname=node.hostname || ''
                          data-binkpport=node.binkp_port || ''
                          data-telnetport=node.telnet_port || ''
                          data-flags=JSON.stringify(flags)
                          data-notes=node.notes || ''
                          data-active=(node.active ? 'true' : 'false')
                        )
                          i.bi.bi-pencil
                        form.d-inline(method='POST' action='/admin/coordinator/nodes/' + node.id + '/delete')
                          button.btn.btn-sm.btn-danger(type='submit' onclick='return confirm("Remove this node?")')
                            i.bi.bi-trash
            else
              p.text-muted No managed nodes. Add nodes to build your network segment.

    //- Reusable flag checkbox mixin grouped by category
    mixin flagCheckboxes(prefix, cssClass)
      each cat in validCategories
        - var catFlags = flagsGrouped[cat] || []
        if catFlags.length > 0
          h6.text-muted.mb-2.mt-3= categoryLabels[cat] || cat
          each fd in catFlags
            .d-flex.align-items-center.mb-2
              .form-check
                input.form-check-input(type='checkbox' class=cssClass id=prefix + 'Flag_' + fd.code value=fd.code data-bs-toggle='tooltip' data-bs-placement='top' title=fd.description data-hasarg=fd.has_argument ? 'true' : 'false')
                label.form-check-label.me-2(for=prefix + 'Flag_' + fd.code)
                  strong= fd.code
                  if fd.description
                    small.text-muted.ms-2= fd.description
              if fd.has_argument
                input.form-control.form-control-sm.flag-arg-input(
                  type='text'
                  id=prefix + 'FlagArg_' + fd.code
                  placeholder=fd.argument_hint || 'value'
                  style='width: 150px; display: none;'
                  data-flagcode=fd.code
                )
      hr.mt-3
      input.form-control(name='flags' id=prefix + 'FlagsField' placeholder='Additional custom flags (comma-separated)')
      .form-text Any flags not listed above can be added here

    //- Add Node Modal
    .modal.fade#addNodeModal(tabindex='-1')
      .modal-dialog.modal-lg
        .modal-content
          .modal-header
            h5.modal-title Add Node
            button.btn-close(type='button' data-bs-dismiss='modal')
          form(method='POST' action=baseUrl + '/nodes/new')
            .modal-body
              ul.nav.nav-tabs.mb-3(role='tablist')
                li.nav-item(role='presentation')
                  button.nav-link.active#addIdentityTab(data-bs-toggle='tab' data-bs-target='#addIdentityPane' type='button' role='tab' aria-selected='true')
                    i.bi.bi-card-heading.me-1
                    | Identity
                li.nav-item(role='presentation')
                  button.nav-link#addConnTab(data-bs-toggle='tab' data-bs-target='#addConnPane' type='button' role='tab' aria-selected='false')
                    i.bi.bi-wifi.me-1
                    | Connectivity
                li.nav-item(role='presentation')
                  button.nav-link#addFlagsTab(data-bs-toggle='tab' data-bs-target='#addFlagsPane' type='button' role='tab' aria-selected='false')
                    i.bi.bi-flag.me-1
                    | Flags

              .tab-content
                //- Tab 1: Identity (Address + System Info)
                #addIdentityPane.tab-pane.fade.show.active(role='tabpanel')
                  h6.text-muted.mb-3 Address
                  .row
                    .col-3
                      .mb-3
                        label.form-label Zone
                        if segment
                          input.form-control(type='number' name='zone' value=segment.zone readonly)
                        else
                          input.form-control(type='number' name='zone' value='1' required)
                    .col-3
                      .mb-3
                        label.form-label Net
                        if segment && (segment.role === 'NC' || segment.role === 'Hub')
                          input.form-control(type='number' name='net' value=segment.net readonly)
                        else
                          input.form-control(type='number' name='net' required)
                    .col-3
                      .mb-3
                        label.form-label Node
                        input.form-control(type='number' name='node' required autofocus)
                    .col-3
                      .mb-3
                        label.form-label Keyword
                        select.form-select(name='keyword' id='addKeyword')
                          each kw in validKeywords
                            option(value=kw)= kw || '(normal)'

                  if hubNodes && hubNodes.length > 0
                    .mb-3
                      label.form-label Hub Routing
                      select.form-select(name='hub_node' id='addHubNode')
                        option(value='0') Direct (no hub)
                        each h in hubNodes
                          option(value=h.node)= h.system_name + ' (' + h.zone + ':' + h.net + '/' + h.node + ')'
                      .form-text Route this node through a hub
                  else
                    input(type='hidden' name='hub_node' value='0')

                  hr.my-3

                  h6.text-muted.mb-3 System Information
                  .row
                    .col-4
                      .mb-3
                        label.form-label System Name
                        input.form-control(name='system_name' required)
                    .col-4
                      .mb-3
                        label.form-label Location
                        input.form-control(name='location' placeholder='City, Province')
                    .col-4
                      .mb-3
                        label.form-label Sysop Name
                        input.form-control(name='sysop_name' required)

                  .form-check.mt-2
                    input.form-check-input(type='checkbox' name='active' id='addActive' checked value='true')
                    label.form-check-label(for='addActive') Active

                //- Tab 2: Connectivity (Network + Legacy)
                #addConnPane.tab-pane.fade(role='tabpanel')
                  h6.text-muted.mb-3 Network
                  .row
                    .col-4
                      .mb-3
                        label.form-label Hostname / IP
                        input.form-control(name='hostname' id='addHostname' placeholder='bbs.example.com')
                    .col-4
                      .mb-3
                        label.form-label Binkp Port
                        input.form-control(type='number' name='binkp_port' id='addBinkpPort' placeholder='24554')
                    .col-4
                      .mb-3
                        label.form-label Telnet Port
                        input.form-control(type='number' name='telnet_port' placeholder='23')

                  hr.my-3

                  h6.text-muted.mb-3 Legacy
                  .row
                    .col-6
                      .mb-3
                        label.form-label Phone
                        input.form-control(name='phone' value='-Unpublished-')
                    .col-6
                      .mb-3
                        label.form-label Baud
                        input.form-control(type='number' name='baud' value='300')
                  .mb-3
                    label.form-label Notes (internal)
                    textarea.form-control(name='notes' rows='2')

                //- Tab 3: Flags
                #addFlagsPane.tab-pane.fade(role='tabpanel')
                  +flagCheckboxes('add', 'flag-check')

            .modal-footer
              button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cancel
              button.btn.btn-success(type='submit') Add Node

    //- Edit Node Modal
    .modal.fade#editNodeModal(tabindex='-1')
      .modal-dialog.modal-lg
        .modal-content
          .modal-header
            h5.modal-title Edit Node
            button.btn-close(type='button' data-bs-dismiss='modal')
          form#editNodeForm(method='POST')
            .modal-body
              ul.nav.nav-tabs.mb-3(role='tablist')
                li.nav-item(role='presentation')
                  button.nav-link.active#editIdentityTab(data-bs-toggle='tab' data-bs-target='#editIdentityPane' type='button' role='tab' aria-selected='true')
                    i.bi.bi-card-heading.me-1
                    | Identity
                li.nav-item(role='presentation')
                  button.nav-link#editConnTab(data-bs-toggle='tab' data-bs-target='#editConnPane' type='button' role='tab' aria-selected='false')
                    i.bi.bi-wifi.me-1
                    | Connectivity
                li.nav-item(role='presentation')
                  button.nav-link#editFlagsTab(data-bs-toggle='tab' data-bs-target='#editFlagsPane' type='button' role='tab' aria-selected='false')
                    i.bi.bi-flag.me-1
                    | Flags

              .tab-content
                //- Tab 1: Identity
                #editIdentityPane.tab-pane.fade.show.active(role='tabpanel')
                  h6.text-muted.mb-3 Address
                  .row
                    .col-3
                      .mb-3
                        label.form-label Zone
                        input.form-control(type='number' name='zone' id='enZone' required)
                    .col-3
                      .mb-3
                        label.form-label Net
                        input.form-control(type='number' name='net' id='enNet' required)
                    .col-3
                      .mb-3
                        label.form-label Node
                        input.form-control(type='number' name='node' id='enNode' required)
                    .col-3
                      .mb-3
                        label.form-label Keyword
                        select.form-select(name='keyword' id='enKeyword')
                          each kw in validKeywords
                            option(value=kw)= kw || '(normal)'

                  if hubNodes && hubNodes.length > 0
                    .mb-3
                      label.form-label Hub Routing
                      select.form-select(name='hub_node' id='enHubNode')
                        option(value='0') Direct (no hub)
                        each h in hubNodes
                          option(value=h.node)= h.system_name + ' (' + h.zone + ':' + h.net + '/' + h.node + ')'
                  else
                    input(type='hidden' name='hub_node' id='enHubNode' value='0')

                  hr.my-3

                  h6.text-muted.mb-3 System Information
                  .row
                    .col-4
                      .mb-3
                        label.form-label System Name
                        input.form-control(name='system_name' id='enSystemName' required)
                    .col-4
                      .mb-3
                        label.form-label Location
                        input.form-control(name='location' id='enLocation')
                    .col-4
                      .mb-3
                        label.form-label Sysop Name
                        input.form-control(name='sysop_name' id='enSysopName' required)

                  .form-check.mt-2
                    input.form-check-input(type='checkbox' name='active' id='enActive' value='true')
                    label.form-check-label(for='enActive') Active

                //- Tab 2: Connectivity + Legacy
                #editConnPane.tab-pane.fade(role='tabpanel')
                  h6.text-muted.mb-3 Network
                  .row
                    .col-4
                      .mb-3
                        label.form-label Hostname / IP
                        input.form-control(name='hostname' id='enHostname')
                    .col-4
                      .mb-3
                        label.form-label Binkp Port
                        input.form-control(type='number' name='binkp_port' id='enBinkpPort')
                    .col-4
                      .mb-3
                        label.form-label Telnet Port
                        input.form-control(type='number' name='telnet_port' id='enTelnetPort')

                  hr.my-3

                  h6.text-muted.mb-3 Legacy
                  .row
                    .col-6
                      .mb-3
                        label.form-label Phone
                        input.form-control(name='phone' id='enPhone')
                    .col-6
                      .mb-3
                        label.form-label Baud
                        input.form-control(type='number' name='baud' id='enBaud')
                  .mb-3
                    label.form-label Notes
                    textarea.form-control(name='notes' id='enNotes' rows='2')

                //- Tab 3: Flags
                #editFlagsPane.tab-pane.fade(role='tabpanel')
                  +flagCheckboxes('en', 'edit-flag-check')

            .modal-footer
              button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cancel
              button.btn.btn-primary(type='submit') Save

  script.
    //- Flag definitions from DB (for JS logic)
    //- Flatten grouped flags for JS logic
    - var allFlagDefs = []; validCategories.forEach(function(c) { (flagsGrouped[c] || []).forEach(function(fd) { allFlagDefs.push(fd); }); });
    var flagDefs = !{JSON.stringify(allFlagDefs.map(function(fd) { return { code: fd.code, has_argument: fd.has_argument }; }))};
    var knownCodes = flagDefs.map(function(fd) { return fd.code; });

    //- Show/hide argument input when flag checkbox toggled
    function setupArgToggles(prefix) {
      flagDefs.forEach(function(fd) {
        if (!fd.has_argument) return;
        var cb = document.getElementById(prefix + 'Flag_' + fd.code);
        var argInput = document.getElementById(prefix + 'FlagArg_' + fd.code);
        if (!cb || !argInput) return;
        function toggle() { argInput.style.display = cb.checked ? '' : 'none'; }
        cb.addEventListener('change', toggle);
        toggle();
      });
    }

    //- Build flags value from checkboxes + arg inputs + extra text
    function collectFlags(prefix) {
      var parts = [];
      flagDefs.forEach(function(fd) {
        var cb = document.getElementById(prefix + 'Flag_' + fd.code);
        if (!cb || !cb.checked) return;
        if (fd.has_argument) {
          var argInput = document.getElementById(prefix + 'FlagArg_' + fd.code);
          var argVal = argInput ? argInput.value.trim() : '';
          parts.push(argVal ? fd.code + ':' + argVal : fd.code);
        } else {
          parts.push(fd.code);
        }
      });
      // Add extra text flags
      var extraField = document.getElementById(prefix + 'FlagsField');
      if (extraField && extraField.value.trim()) {
        var extras = extraField.value.split(',').map(function(f) { return f.trim(); }).filter(function(f) {
          return f && !knownCodes.includes(f.split(':')[0]);
        });
        parts = parts.concat(extras);
      }
      return parts;
    }

    //- Sync checkboxes -> hidden flags field on change
    function syncFlagCheckboxes(prefix) {
      var flagsField = document.getElementById(prefix + 'FlagsField');
      function update() { flagsField.value = collectFlags(prefix).join(', '); }
      document.querySelectorAll('#' + prefix + 'FlagsPane input').forEach(function(el) {
        el.addEventListener('change', update);
        el.addEventListener('input', update);
      });
    }

    //- Set checkboxes and arg inputs from a flags array (e.g. ['CM', 'IBN:24555', 'INA:bbs.example.com'])
    function setFlagsFromArray(prefix, flagsArray) {
      // Clear all checkboxes and arg inputs
      flagDefs.forEach(function(fd) {
        var cb = document.getElementById(prefix + 'Flag_' + fd.code);
        if (cb) cb.checked = false;
        if (fd.has_argument) {
          var argInput = document.getElementById(prefix + 'FlagArg_' + fd.code);
          if (argInput) { argInput.value = ''; argInput.style.display = 'none'; }
        }
      });

      var extras = [];
      flagsArray.forEach(function(f) {
        var parts = f.split(':');
        var code = parts[0];
        var arg = parts.slice(1).join(':');
        var cb = document.getElementById(prefix + 'Flag_' + code);
        if (cb) {
          cb.checked = true;
          if (arg) {
            var argInput = document.getElementById(prefix + 'FlagArg_' + code);
            if (argInput) { argInput.value = arg; argInput.style.display = ''; }
          } else {
            // Show arg input if checked (even without value)
            var argInput = document.getElementById(prefix + 'FlagArg_' + code);
            if (argInput) argInput.style.display = '';
          }
        } else {
          extras.push(f);
        }
      });

      var extraField = document.getElementById(prefix + 'FlagsField');
      if (extraField) extraField.value = extras.join(', ');
    }

    document.addEventListener('DOMContentLoaded', function() {
      if (typeof jQuery !== 'undefined' && jQuery.fn.DataTable) {
        jQuery('#nodeTable').DataTable({ paging: false, order: [] });
      }

      // Initialize Bootstrap tooltips
      var tooltipEls = document.querySelectorAll('[data-bs-toggle="tooltip"]');
      tooltipEls.forEach(function(el) { new bootstrap.Tooltip(el); });

      // Setup argument toggles and sync for both modals
      setupArgToggles('add');
      setupArgToggles('en');
      syncFlagCheckboxes('add');
      syncFlagCheckboxes('en');

      // Edit modal population
      var editModal = document.getElementById('editNodeModal');
      if (editModal) {
        editModal.addEventListener('show.bs.modal', function(e) {
          var btn = e.relatedTarget;
          if (!btn) return;
          document.getElementById('editNodeForm').action = '/admin/coordinator/nodes/' + btn.dataset.id + '/update';
          document.getElementById('enZone').value = btn.dataset.zone || '1';
          document.getElementById('enNet').value = btn.dataset.net || '';
          document.getElementById('enNode').value = btn.dataset.node || '';
          document.getElementById('enKeyword').value = btn.dataset.keyword || '';
          document.getElementById('enHubNode').value = btn.dataset.hubnode || '0';
          document.getElementById('enSystemName').value = btn.dataset.systemname || '';
          document.getElementById('enLocation').value = btn.dataset.location || '';
          document.getElementById('enSysopName').value = btn.dataset.sysopname || '';
          document.getElementById('enPhone').value = btn.dataset.phone || '-Unpublished-';
          document.getElementById('enBaud').value = btn.dataset.baud || '300';
          document.getElementById('enHostname').value = btn.dataset.hostname || '';
          document.getElementById('enBinkpPort').value = btn.dataset.binkpport || '';
          document.getElementById('enTelnetPort').value = btn.dataset.telnetport || '';
          document.getElementById('enNotes').value = btn.dataset.notes || '';
          document.getElementById('enActive').checked = btn.dataset.active === 'true';

          // Flags: set checkboxes, arg inputs, and extra text from stored flags
          var flags = [];
          try { flags = JSON.parse(btn.dataset.flags || '[]'); } catch(_) {}
          setFlagsFromArray('en', flags);

          // Reset to Identity tab
          var identityTab = document.getElementById('editIdentityTab');
          if (identityTab) bootstrap.Tab.getOrCreateInstance(identityTab).show();
        });
      }
    });
