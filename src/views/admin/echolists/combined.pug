extends ../../layouts/admin

block content
  .container-fluid.main-wrapper
    if !currentuser
      - loginMode = 'guard'
      - loginRedirect = currentPath
      include ../../partials/users/login.pug
    else if !sufficientAccess
      include ../../partials/status/unauthorized.pug
    else
      if !ismobile
        .row
          .col-12
            br
            br
        .row
          .col-1
          .col-10
            if !network
              .card
                .card-header.bg-darkblue.text-white
                  h2= title
                .card-body
                  h3 Network Not Found
            else
              nav(aria-label='breadcrumb')
                ol.breadcrumb
                  li.breadcrumb-item
                    a(href='/admin') Admin
                  li.breadcrumb-item
                    a(href='/admin/networks') Networks
                  li.breadcrumb-item
                    a(href='/admin/network/' + network.uuid)= network.name
                  li.breadcrumb-item
                    a(href='/admin/echolist/' + network.id) Echolists
                  li.breadcrumb-item.active Combined View

              include ../../partials/flash

              //- Stats
              - var carried = echolistAreas.filter(function(a) { return a.local_area_id; }).length
              - var notCarried = echolistAreas.length - carried
              .row.mb-3
                .col-3
                  .card.text-center
                    .card-body.p-2
                      .h4.mb-0= echolistAreas.length
                      small.text-muted Echolist Areas
                .col-3
                  .card.text-center
                    .card-body.p-2
                      .h4.mb-0.text-success= carried
                      small.text-muted Locally Carried
                .col-3
                  .card.text-center
                    .card-body.p-2
                      .h4.mb-0.text-info= notCarried
                      small.text-muted Available
                .col-3
                  .card.text-center
                    .card-body.p-2
                      .h4.mb-0.text-warning= orphanedAreas.length
                      small.text-muted Orphaned

              //- Echolist areas
              .card.mb-3
                .card-header.bg-darkblue.text-white
                  .d-flex.justify-content-between.align-items-center
                    h5.mb-0
                      i.bi.bi-list-ul.me-2
                      | Echolist Areas
                      small.text-muted.ms-2 (deduplicated across all echolists)
                    a.btn.btn-sm.btn-info(href='/admin/echolist/' + network.id) Back to Echolists
                .card-body
                  if echolistAreas.length === 0
                    p.text-muted No echolist areas found. Import an echolist first.
                  else
                    table#echolistTable.table.table-hover.table-sm
                      thead
                        tr
                          th Areatag
                          th Description
                          th Source
                          th Status
                      tbody
                        each area in echolistAreas
                          tr
                            td
                              code= area.areatag
                            td= area.description || ''
                            td
                              - var names = Array.isArray(area.echolist_names) ? area.echolist_names : []
                              each name in names
                                span.badge.bg-secondary.me-1= name
                            td
                              if area.local_area_id
                                span.badge.bg-success Carried
                              else
                                button.btn.btn-sm.btn-outline-primary.subscribe-btn(
                                  type='button'
                                  data-areatag=area.areatag
                                  data-description=area.description || ''
                                )
                                  i.bi.bi-plus-lg.me-1
                                  | Subscribe

              //- Orphaned areas
              .card.mb-3
                .card-header.bg-dark
                  h5.mb-0
                    i.bi.bi-exclamation-triangle.me-2.text-warning
                    | Orphaned Areas
                    small.text-muted.ms-2 Mapped to this network but not in any echolist
                .card-body
                  if orphanedAreas.length === 0
                    p.text-muted.mb-0 All network areas are covered by at least one echolist.
                  else
                    table#orphanedTable.table.table-hover.table-sm
                      thead
                        tr
                          th Areatag
                          th Local Area
                          th Shortcode
                          th
                      tbody
                        each oa in orphanedAreas
                          tr
                            td
                              code= oa.areatag
                            td= oa.area_name || ''
                            td
                              code= oa.shortcode || ''
                            td.text-end
                              button.btn.btn-sm.btn-outline-danger.unmap-btn(
                                type='button'
                                data-area-id=oa.area_id
                                data-areatag=oa.areatag
                                data-shortcode=oa.shortcode || ''
                                data-area-name=oa.area_name || ''
                              )
                                i.bi.bi-x-lg.me-1
                                | Unmap

          .col-1

      //- Subscribe Modal
      if network
        #subscribeModal.modal.fade(tabindex='-1')
          .modal-dialog.modal-lg
            .modal-content
              form#subscribeForm(method='POST' action='/admin/echolist/' + network.id + '/combined/subscribe')
                input(type='hidden' name='areatag' id='subAreatag')
                input(type='hidden' name='action' id='subAction' value='create')
                .modal-header
                  h5.modal-title Subscribe: #[code#subAreatagDisplay]
                  button.btn-close(type='button' data-bs-dismiss='modal')
                .modal-body
                  ul.nav.nav-tabs.mb-3#subTabs
                    li.nav-item
                      a.nav-link.active(data-bs-toggle='tab' href='#tabCreate') Create New Area
                    li.nav-item
                      a.nav-link(data-bs-toggle='tab' href='#tabMap') Map Existing Area
                  .tab-content
                    #tabCreate.tab-pane.fade.show.active
                      .row
                        .col-6
                          .mb-3
                            label.form-label Name
                            input#subName.form-control(type='text' name='name')
                          .mb-3
                            label.form-label Shortcode
                            input#subShortcode.form-control(type='text' name='shortcode')
                        .col-6
                          .mb-3
                            label.form-label Description
                            input#subDescription.form-control(type='text' name='description')
                          .mb-3
                            label.form-label Message Group
                            select#subGroup.form-select(name='group_shortcode')
                              option(value='') -- Select --
                              each g in groups
                                option(value=g.shortcode)= g.name
                      .row
                        .col-6
                          label.form-label Read Security
                          input#subReadSec.form-control(type='number' name='read_security' min=0 max=255 value=50)
                        .col-6
                          label.form-label Post Security
                          input#subPostSec.form-control(type='number' name='post_security' min=0 max=255 value=50)

                      .form-check.mt-3
                        input#subAllowPeers.form-check-input(type='checkbox' name='allow_peers' value='true' checked)
                        label.form-check-label(for='subAllowPeers') Allow for all network peers
                      .form-check
                        input#subEnablePeers.form-check-input(type='checkbox' name='enable_peers' value='true')
                        label.form-check-label(for='subEnablePeers') Enable for all network peers

                    #tabMap.tab-pane.fade
                      .mb-3
                        label.form-label Map to Existing Area
                        select#subMapArea.form-select(name='area_id')
                          option(value='') -- Select an area --
                          each a in unmappedAreas
                            option(value=a.id)= a.name + ' (' + a.shortcode + ')'
                      .form-check.mt-3
                        input#subMapAllowPeers.form-check-input(type='checkbox' name='allow_peers' value='true' checked)
                        label.form-check-label(for='subMapAllowPeers') Allow for all network peers
                      .form-check
                        input#subMapEnablePeers.form-check-input(type='checkbox' name='enable_peers' value='true')
                        label.form-check-label(for='subMapEnablePeers') Enable for all network peers
                .modal-footer
                  button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cancel
                  button.btn.btn-success(type='submit')
                    i.bi.bi-plus-lg.me-1
                    | Subscribe

        //- Unmap Modal
        #unmapModal.modal.fade(tabindex='-1')
          .modal-dialog
            .modal-content
              form(method='POST' action='/admin/echolist/' + network.id + '/combined/unmap')
                input(type='hidden' name='area_id' id='unmapAreaId')
                input(type='hidden' name='shortcode' id='unmapShortcode')
                .modal-header.bg-dark
                  h5.modal-title Unmap: #[code#unmapAreatagDisplay]
                  button.btn-close(type='button' data-bs-dismiss='modal')
                .modal-body
                  p
                    | Remove the network mapping for #[strong#unmapAreaName].
                    |  The area and its messages will be kept by default.
                  .alert.alert-warning
                    i.bi.bi-exclamation-triangle.me-1
                    | This area is not in any echolist for this network. Unmapping will stop it being exchanged with peers.
                  .form-check
                    input#unmapDelete.form-check-input(type='checkbox' name='delete_area' value='true')
                    label.form-check-label(for='unmapDelete') Also delete the area (messages will be kept)
                .modal-footer
                  button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cancel
                  button.btn.btn-danger(type='submit')
                    i.bi.bi-x-lg.me-1
                    | Unmap

  if network
    script.
      document.addEventListener('DOMContentLoaded', function() {
        // DataTables
        if (typeof jQuery !== 'undefined' && jQuery.fn.DataTable) {
          jQuery('#echolistTable').DataTable({ pageLength: 50, order: [[0, 'asc']] });
          if (document.querySelectorAll('#orphanedTable tbody tr').length > 0) {
            jQuery('#orphanedTable').DataTable({ pageLength: 25, order: [[0, 'asc']] });
          }
        }

        // Subscribe modal
        var subModal = document.getElementById('subscribeModal');
        if (subModal) {
          document.querySelectorAll('.subscribe-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
              var tag = btn.dataset.areatag;
              var desc = btn.dataset.description;
              document.getElementById('subAreatag').value = tag;
              document.getElementById('subAreatagDisplay').textContent = tag;
              document.getElementById('subName').value = tag;
              document.getElementById('subDescription').value = desc;
              document.getElementById('subShortcode').value = tag.toUpperCase().replace(/[^A-Z0-9]/g, '_').substring(0, 64);
              document.getElementById('subAction').value = 'create';
              new bootstrap.Modal(subModal).show();
            });
          });

          // Switch action field based on active tab
          subModal.querySelectorAll('[data-bs-toggle="tab"]').forEach(function(tab) {
            tab.addEventListener('shown.bs.tab', function(e) {
              document.getElementById('subAction').value =
                e.target.getAttribute('href') === '#tabMap' ? 'map' : 'create';
            });
          });

          // Auto-populate security from group defaults
          document.getElementById('subGroup').addEventListener('change', function() {
            var sc = this.value;
            if (!sc) return;
            fetch('/admin/msgGroup/' + sc + '/defaults')
              .then(function(r) { return r.json(); })
              .then(function(data) {
                document.getElementById('subReadSec').value = data.read_security || 50;
                document.getElementById('subPostSec').value = data.post_security || 50;
              });
          });
        }

        // Unmap modal
        var unmapModal = document.getElementById('unmapModal');
        if (unmapModal) {
          document.querySelectorAll('.unmap-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
              document.getElementById('unmapAreaId').value = btn.dataset.areaId;
              document.getElementById('unmapShortcode').value = btn.dataset.shortcode;
              document.getElementById('unmapAreatagDisplay').textContent = btn.dataset.areatag;
              document.getElementById('unmapAreaName').textContent = btn.dataset.areaName || btn.dataset.areatag;
              document.getElementById('unmapDelete').checked = false;
              new bootstrap.Modal(unmapModal).show();
            });
          });
        }
      });
