extends ../../layouts/admin

block content
  .container-fluid.main-wrapper(style='overflow:hidden')
    if !currentuser
      - loginMode = 'guard'
      - loginRedirect = currentPath
      include ../../partials/users/login.pug
    else if !sufficientAccess
      include ../../partials/status/unauthorized.pug
    else
      if !ismobile
        .row.mt-2
          .col-lg-10.offset-lg-1.col-12
            if !network
              .card
                .card-header.bg-darkblue.text-white
                  h2= title
                .card-body
                  h3 Network Not Found
            else
              include ../../partials/flash

              - var carriedAreas = echolistAreas.filter(function(a) { return a.local_area_id; })
              - var availableAreas = echolistAreas.filter(function(a) { return !a.local_area_id; })

              .card
                .card-header.bg-darkblue.text-white
                  .d-flex.justify-content-between.align-items-center
                    nav(aria-label='breadcrumb')
                      ol.breadcrumb.mb-0
                        li.breadcrumb-item
                          a.text-white(href='/admin') Admin
                        li.breadcrumb-item
                          a.text-white(href='/admin/network/' + network.uuid)= network.name
                        li.breadcrumb-item
                          a.text-white(href='/admin/echolist/' + network.id) Echolists
                        li.breadcrumb-item.active.text-light Combined
                    a.btn.btn-sm.btn-info(href='/admin/echolists') All Echolists

                ul.nav.nav-tabs.px-3.pt-2(role='tablist')
                  li.nav-item(role='presentation')
                    button.nav-link.active(data-bs-toggle='tab' data-bs-target='#tabAll' type='button' role='tab')
                      | All
                      span.badge.bg-secondary.ms-1= echolistAreas.length
                  li.nav-item(role='presentation')
                    button.nav-link(data-bs-toggle='tab' data-bs-target='#tabCarried' type='button' role='tab')
                      | Carried
                      span.badge.bg-success.ms-1= carriedAreas.length
                  li.nav-item(role='presentation')
                    button.nav-link(data-bs-toggle='tab' data-bs-target='#tabAvailable' type='button' role='tab')
                      | Available
                      span.badge.bg-info.ms-1= availableAreas.length
                  li.nav-item(role='presentation')
                    button.nav-link(data-bs-toggle='tab' data-bs-target='#tabOrphaned' type='button' role='tab')
                      | Orphaned
                      span.badge.bg-warning.ms-1= orphanedAreas.length

                mixin areaRow(area, showSubscribe, showUnmap)
                  tr
                    td
                      code= area.areatag
                    td= area.description || ''
                    td
                      - var names = Array.isArray(area.echolist_names) ? area.echolist_names : []
                      each name in names
                        span.badge.bg-secondary.me-1= name
                    td
                      if area.local_area_id
                        span.badge.bg-success Carried
                      else
                        span.badge.bg-info Available
                    td.text-end
                      if showSubscribe && !area.local_area_id
                        button.btn.btn-sm.btn-outline-primary.subscribe-btn(type='button' style='min-width:120px' data-areatag=area.areatag data-description=area.description || '')
                          i.bi.bi-plus-circle.me-1
                          | Subscribe
                      if showUnmap && area.local_area_id
                        button.btn.btn-sm.btn-outline-danger.unmap-btn(type='button' style='min-width:120px' data-area-id=area.network_area_id || area.local_area_id data-areatag=area.areatag data-shortcode=area.local_shortcode || '' data-area-name=area.local_area_name || area.areatag)
                          i.bi.bi-dash-circle.me-1
                          | Unsubscribe

                .tab-content
                  //- All
                  #tabAll.tab-pane.fade.show.active(role='tabpanel')
                    .card-body.vh-75
                      if echolistAreas.length === 0
                        p.text-muted No echolist areas found. Import an echolist first.
                      else
                        table#echolistTable.table.table-hover.table-sm
                          thead
                            tr
                              th Areatag
                              th Description
                              th Source
                              th Status
                              th
                          tbody
                            each area in echolistAreas
                              +areaRow(area, true, true)

                  //- Carried
                  #tabCarried.tab-pane.fade(role='tabpanel')
                    .card-body.vh-75
                      if carriedAreas.length === 0
                        p.text-muted No locally carried areas.
                      else
                        table.table.table-hover.table-sm
                          thead
                            tr
                              th Areatag
                              th Description
                              th Source
                              th Status
                              th
                          tbody
                            each area in carriedAreas
                              +areaRow(area, false, true)

                  //- Available
                  #tabAvailable.tab-pane.fade(role='tabpanel')
                    .card-body.vh-75
                      if availableAreas.length === 0
                        p.text-muted All echolist areas are locally carried.
                      else
                        table.table.table-hover.table-sm
                          thead
                            tr
                              th Areatag
                              th Description
                              th Source
                              th Status
                              th
                          tbody
                            each area in availableAreas
                              +areaRow(area, true, false)

                  //- Orphaned
                  #tabOrphaned.tab-pane.fade(role='tabpanel')
                    .card-body.vh-75
                      if orphanedAreas.length === 0
                        p.text-muted All network areas are covered by at least one echolist.
                      else
                        p.text-muted.small Mapped to this network but not in any echolist.
                        table.table.table-hover.table-sm
                          thead
                            tr
                              th Areatag
                              th Local Area
                              th Shortcode
                              th Status
                              th
                          tbody
                            each oa in orphanedAreas
                              tr
                                td
                                  code= oa.areatag
                                td= oa.area_name || ''
                                td
                                  code= oa.shortcode || ''
                                td
                                  span.badge.bg-warning Orphaned
                                td.text-end
                                  button.btn.btn-sm.btn-outline-danger.unmap-btn(type='button' style='min-width:120px' data-area-id=oa.area_id data-areatag=oa.areatag data-shortcode=oa.shortcode || '' data-area-name=oa.area_name || '')
                                    i.bi.bi-x-circle.me-1
                                    | Unmap

      //- Subscribe Modal
      if network
        #subscribeModal.modal.fade(tabindex='-1')
          .modal-dialog.modal-lg
            .modal-content
              form#subscribeForm(method='POST' action='/admin/echolist/' + network.id + '/combined/subscribe')
                input(type='hidden' name='areatag' id='subAreatag')
                input(type='hidden' name='action' id='subAction' value='create')
                .modal-header
                  h5.modal-title Subscribe: #[code#subAreatagDisplay]
                  button.btn-close(type='button' data-bs-dismiss='modal')
                .modal-body
                  ul.nav.nav-tabs.mb-3#subTabs
                    li.nav-item
                      a.nav-link.active(data-bs-toggle='tab' href='#tabCreate') Create New Area
                    li.nav-item
                      a.nav-link(data-bs-toggle='tab' href='#tabMap') Map Existing Area
                  .tab-content
                    #tabCreate.tab-pane.fade.show.active
                      .row
                        .col-6
                          .mb-3
                            label.form-label Name
                            input#subName.form-control(type='text' name='name')
                          .mb-3
                            label.form-label Shortcode
                            input#subShortcode.form-control(type='text' name='shortcode')
                        .col-6
                          .mb-3
                            label.form-label Description
                            input#subDescription.form-control(type='text' name='description')
                          .mb-3
                            label.form-label Message Group
                            select#subGroup.form-select(name='group_shortcode')
                              option(value='') -- Select --
                              each g in groups
                                option(value=g.shortcode)= g.name
                      .row
                        .col-6
                          label.form-label Read Security
                          input#subReadSec.form-control(type='number' name='read_security' min=0 max=255 value=defaultReadSecurity)
                        .col-6
                          label.form-label Post Security
                          input#subPostSec.form-control(type='number' name='post_security' min=0 max=255 value=defaultPostSecurity)
                      .row.mt-2
                        .col-6
                          #sub_read_perm_inputs
                          #sub_read_rest_inputs
                          label.small Read Perm Flags:
                          .border.rounded.p-2.mb-2.bg-light#sub_read_perm_badges(style='min-height:2rem')
                          .input-group.input-group-sm.mb-2
                            select#sub_read_perm_select.form-control
                            button.btn.btn-sm.btn-success#sub_read_perm_add(type='button') Add
                          label.small Read Restrict Flags:
                          .border.rounded.p-2.mb-2.bg-light#sub_read_rest_badges(style='min-height:2rem')
                          .input-group.input-group-sm
                            select#sub_read_rest_select.form-control
                            button.btn.btn-sm.btn-danger#sub_read_rest_add(type='button') Add
                        .col-6
                          #sub_post_perm_inputs
                          #sub_post_rest_inputs
                          label.small Post Perm Flags:
                          .border.rounded.p-2.mb-2.bg-light#sub_post_perm_badges(style='min-height:2rem')
                          .input-group.input-group-sm.mb-2
                            select#sub_post_perm_select.form-control
                            button.btn.btn-sm.btn-success#sub_post_perm_add(type='button') Add
                          label.small Post Restrict Flags:
                          .border.rounded.p-2.mb-2.bg-light#sub_post_rest_badges(style='min-height:2rem')
                          .input-group.input-group-sm
                            select#sub_post_rest_select.form-control
                            button.btn.btn-sm.btn-danger#sub_post_rest_add(type='button') Add

                      .form-check.mt-3
                        input#subAllowPeers.form-check-input(type='checkbox' name='allow_peers' value='true' checked)
                        label.form-check-label(for='subAllowPeers') Allow for all network peers
                      .form-check
                        input#subEnablePeers.form-check-input(type='checkbox' name='enable_peers' value='true')
                        label.form-check-label(for='subEnablePeers') Enable for all network peers

                    #tabMap.tab-pane.fade
                      .mb-3
                        label.form-label Map to Existing Area
                        select#subMapArea.form-select(name='area_id')
                          option(value='') -- Select an area --
                          each a in unmappedAreas
                            option(value=a.id)= a.name + ' (' + a.shortcode + ')'
                      .form-check.mt-3
                        input#subMapAllowPeers.form-check-input(type='checkbox' name='allow_peers' value='true' checked)
                        label.form-check-label(for='subMapAllowPeers') Allow for all network peers
                      .form-check
                        input#subMapEnablePeers.form-check-input(type='checkbox' name='enable_peers' value='true')
                        label.form-check-label(for='subMapEnablePeers') Enable for all network peers
                .modal-footer
                  button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cancel
                  button.btn.btn-success(type='submit')
                    i.bi.bi-plus-lg.me-1
                    | Subscribe

        //- Unmap Modal
        #unmapModal.modal.fade(tabindex='-1')
          .modal-dialog
            .modal-content
              form(method='POST' action='/admin/echolist/' + network.id + '/combined/unmap')
                input(type='hidden' name='area_id' id='unmapAreaId')
                input(type='hidden' name='shortcode' id='unmapShortcode')
                .modal-header.bg-dark
                  h5.modal-title Unmap: #[code#unmapAreatagDisplay]
                  button.btn-close(type='button' data-bs-dismiss='modal')
                .modal-body
                  p
                    | Remove the network mapping for #[strong#unmapAreaName].
                    |  The area and its messages will be kept by default.
                  .alert.alert-warning
                    i.bi.bi-exclamation-triangle.me-1
                    | This area is not in any echolist for this network. Unmapping will stop it being exchanged with peers.
                  .form-check
                    input#unmapDelete.form-check-input(type='checkbox' name='delete_area' value='true')
                    label.form-check-label(for='unmapDelete') Also delete the area
                  .form-check.ms-4#unmapTablesRow(style='display:none')
                    input#unmapDeleteTables.form-check-input(type='checkbox' name='delete_tables' value='true')
                    label.form-check-label.text-danger(for='unmapDeleteTables') Also delete message tables and all messages (cannot be undone)
                .modal-footer
                  button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cancel
                  button.btn.btn-danger(type='submit')
                    i.bi.bi-x-lg.me-1
                    | Unmap

  if network
    script.
      document.addEventListener('DOMContentLoaded', function() {
        // DataTables on the All tab only (other tabs are pre-filtered)
        if (typeof jQuery !== 'undefined' && jQuery.fn.DataTable) {
          jQuery('#echolistTable').DataTable({ paging: false, order: [[0, 'asc']] });
        }

        // Subscribe modal
        var subModal = document.getElementById('subscribeModal');
        if (subModal) {
          document.querySelectorAll('.subscribe-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
              var tag = btn.dataset.areatag;
              var desc = btn.dataset.description;
              document.getElementById('subAreatag').value = tag;
              document.getElementById('subAreatagDisplay').textContent = tag;
              document.getElementById('subName').value = tag;
              document.getElementById('subDescription').value = desc;
              document.getElementById('subShortcode').value = tag.toUpperCase().replace(/[^A-Z0-9]/g, '_').substring(0, 64);
              document.getElementById('subAction').value = 'create';
              new bootstrap.Modal(subModal).show();
            });
          });

          // Switch action field based on active tab
          subModal.querySelectorAll('[data-bs-toggle="tab"]').forEach(function(tab) {
            tab.addEventListener('shown.bs.tab', function(e) {
              document.getElementById('subAction').value =
                e.target.getAttribute('href') === '#tabMap' ? 'map' : 'create';
            });
          });

          // --- Flag management ---
          var allPerms  = !{JSON.stringify(availablePermissions)};
          var allRestrs = !{JSON.stringify(availableRestrictions)};

          function renderFlags(prefix, inputName, activeFlags, allFlags, badgeClass) {
            var badgeEl  = document.getElementById(prefix + '_badges');
            var inputEl  = document.getElementById(prefix + '_inputs');
            var selectEl = document.getElementById(prefix + '_select');
            var addBtn   = document.getElementById(prefix + '_add');
            badgeEl.innerHTML = '';
            activeFlags.forEach(function(flag) {
              var span = document.createElement('span');
              span.className = 'badge ' + badgeClass + ' me-1 mb-1';
              span.style.cursor = 'pointer';
              span.title = 'Click to remove';
              span.textContent = flag + ' x';
              span.addEventListener('click', function() {
                renderFlags(prefix, inputName, activeFlags.filter(function(f) { return f !== flag; }), allFlags, badgeClass);
              });
              badgeEl.appendChild(span);
            });
            inputEl.innerHTML = '';
            activeFlags.forEach(function(flag) {
              var inp = document.createElement('input');
              inp.type = 'hidden'; inp.name = inputName; inp.value = flag;
              inputEl.appendChild(inp);
            });
            selectEl.innerHTML = '';
            var available = allFlags.filter(function(f) { return !activeFlags.includes(f); });
            if (available.length === 0) {
              var opt = document.createElement('option');
              opt.value = ''; opt.textContent = '-- none --'; opt.disabled = true;
              selectEl.appendChild(opt); selectEl.disabled = true; addBtn.disabled = true;
            } else {
              selectEl.disabled = false; addBtn.disabled = false;
              available.forEach(function(flag) {
                var opt = document.createElement('option');
                opt.value = flag; opt.textContent = flag;
                selectEl.appendChild(opt);
              });
            }
          }

          function wireAddBtn(prefix, inputName, allFlags, badgeClass) {
            document.getElementById(prefix + '_add').addEventListener('click', function() {
              var sel = document.getElementById(prefix + '_select');
              if (!sel.value) return;
              var current = Array.from(document.querySelectorAll('#' + prefix + '_inputs input')).map(function(i) { return i.value; });
              if (!current.includes(sel.value)) {
                current.push(sel.value);
                renderFlags(prefix, inputName, current, allFlags, badgeClass);
              }
            });
          }

          wireAddBtn('sub_read_perm', 'read_perm_flags', allPerms, 'bg-success');
          wireAddBtn('sub_read_rest', 'read_rest_flags', allRestrs, 'bg-danger');
          wireAddBtn('sub_post_perm', 'post_perm_flags', allPerms, 'bg-success');
          wireAddBtn('sub_post_rest', 'post_rest_flags', allRestrs, 'bg-danger');

          // Initial render (empty flags)
          renderFlags('sub_read_perm', 'read_perm_flags', [], allPerms, 'bg-success');
          renderFlags('sub_read_rest', 'read_rest_flags', [], allRestrs, 'bg-danger');
          renderFlags('sub_post_perm', 'post_perm_flags', [], allPerms, 'bg-success');
          renderFlags('sub_post_rest', 'post_rest_flags', [], allRestrs, 'bg-danger');

          // Auto-populate security and flags from group defaults
          document.getElementById('subGroup').addEventListener('change', function() {
            var sc = this.value;
            if (!sc) {
              document.getElementById('subReadSec').value = !{defaultReadSecurity};
              document.getElementById('subPostSec').value = !{defaultPostSecurity};
              renderFlags('sub_read_perm', 'read_perm_flags', [], allPerms, 'bg-success');
              renderFlags('sub_read_rest', 'read_rest_flags', [], allRestrs, 'bg-danger');
              renderFlags('sub_post_perm', 'post_perm_flags', [], allPerms, 'bg-success');
              renderFlags('sub_post_rest', 'post_rest_flags', [], allRestrs, 'bg-danger');
              return;
            }
            fetch('/admin/msgGroup/' + sc + '/defaults')
              .then(function(r) { return r.json(); })
              .then(function(data) {
                document.getElementById('subReadSec').value = data.read_security || !{defaultReadSecurity};
                document.getElementById('subPostSec').value = data.post_security || !{defaultPostSecurity};
                var parseF = function(v) { try { return Array.isArray(v) ? v : JSON.parse(v || '[]'); } catch(e) { return []; } };
                renderFlags('sub_read_perm', 'read_perm_flags', parseF(data.read_perm_flags), allPerms, 'bg-success');
                renderFlags('sub_read_rest', 'read_rest_flags', parseF(data.read_rest_flags), allRestrs, 'bg-danger');
                renderFlags('sub_post_perm', 'post_perm_flags', parseF(data.post_perm_flags), allPerms, 'bg-success');
                renderFlags('sub_post_rest', 'post_rest_flags', parseF(data.post_rest_flags), allRestrs, 'bg-danger');
              });
          });
        }

        // Unmap modal
        var unmapModal = document.getElementById('unmapModal');
        if (unmapModal) {
          document.querySelectorAll('.unmap-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
              document.getElementById('unmapAreaId').value = btn.dataset.areaId;
              document.getElementById('unmapShortcode').value = btn.dataset.shortcode;
              document.getElementById('unmapAreatagDisplay').textContent = btn.dataset.areatag;
              document.getElementById('unmapAreaName').textContent = btn.dataset.areaName || btn.dataset.areatag;
              document.getElementById('unmapDelete').checked = false;
              document.getElementById('unmapDeleteTables').checked = false;
              document.getElementById('unmapTablesRow').style.display = 'none';
              new bootstrap.Modal(unmapModal).show();
            });
          });

          // Show/hide delete tables checkbox when delete area is toggled
          document.getElementById('unmapDelete').addEventListener('change', function() {
            document.getElementById('unmapTablesRow').style.display = this.checked ? '' : 'none';
            if (!this.checked) document.getElementById('unmapDeleteTables').checked = false;
          });
        }
      });
