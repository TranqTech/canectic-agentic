extends ../../layouts/admin

block content  
  .container-fluid.main-wrapper
    if !ismobile
      .row
        .col-12
          br
          br
      .row
        .col-2
        .col-8 
          if !node
            .card
              .card-header.bg-darkblue.text-white
                .row
                  .col-8
                    h2= title
                  .col-4
                    .text-end
                      a.button.btn.btn-lg.btn-info(href='/admin/nodes')
                        |Exit
              .card-body
                br
                h3
                  |Data Not Found!
                br
          else
            .card      
              .card-header.bg-darkblue.text-white
                .row
                  .col-8
                    h2= title
                      | 
                      |- 
                      =node.name
                  .col-4
                    .text-end
                      a.button.btn.btn-lg.btn-info(href='/admin/nodes')
                        |Exit
              .card-body
                if errormessages && errormessages.length > 0
                  ul.text-danger
                    for error of errormessages
                      li.text-danger
                        =error
                  br

                .row
                  .col-4
                    .card
                      .card-header
                        .row
                          .col-8
                            h5
                              |Address/Routing
                          .col-4
                            .text-end
                              button.btn.btn-md.btn-success(data-bs-toggle='modal' data-bs-target=`#updateAddressModal`)
                                |Update
                      .card-body.vh-30
                        table#addressTable.table.table-hover
                          tr
                            td
                              h5
                                |Address:
                            td
                              =node.address
                          tr
                            td
                              h5
                                |Domain:
                            td
                              =node.domain
                          if node.direct
                            tr
                              td
                                h5
                                  |Direct:
                              td
                                |Yes
                          if !node.direct
                            tr
                              td
                                h5
                                  |Route To:
                              td
                                =node.route_to
                          tr
                            td
                              h5
                                |Status:
                            td
                              if node.status
                                if node.status == "NORMAL"
                                  |Normal
                                else if node.status == "CRASH"
                                  |Crash
                                else if node.status == "HOLD"
                                  |Hold
                                else
                                  |Normal
                              else
                                |Normal
                  .col-4
                    .card
                      .card-header
                        .row
                          .col-8
                            h5
                              |Connection
                          .col-4
                            .text-end
                              button.btn.btn-md.btn-success(data-bs-toggle='modal' data-bs-target=`#updateConnectionModal`)
                                |Update
                      .card-body.vh-30
                        table#routingTable.table.table-hover
                          tr
                            td
                              h5
                                |Type:
                            td
                              =node.connection_type
                          tr
                            td
                              h5
                                |Host:
                            td
                              =node.remote_host
                          tr
                            td
                              h5
                                |Port:
                            td
                              =node.remote_port
                  .col-4
                    .card
                      .card-header
                        .row
                          .col-8
                            h5
                              |Passwords
                          .col-4
                            .text-end
                              button.btn.btn-md.btn-success(data-bs-toggle='modal' data-bs-target=`#updatePasswordsModal`)
                                |Update
                      .card-body.vh-30
                        table#pwTable.table.table-hover
                          tr
                            td
                              h5
                                |Session
                            td
                              =node.session_password
                          tr
                            td
                              h5
                                |Packet
                            td
                              =node.packet_password
                          tr
                            td
                              h5
                                |Tic File
                            td
                              =node.tic_password
                          tr
                            td
                              h5
                                |AreaFix
                            td
                              =node.areafix_password
                .row
                  .col-12
                    br
                .row
                  .col-6
                    .card
                      .card-header
                        .row
                          .col-8
                            h5
                              |Areas Allowed for AreaFix
                          .col-4
                            .text-end
                              button.btn.btn-md.btn-success(data-bs-toggle='modal' data-bs-target=`#setAllowedAreas`)
                                |Update
                      .card-body.vh-30
                        if grouplist && grouplist.length > 0
                          for group of grouplist
                            if group.areas && group.areas.length > 0
                              - var count = 0
                              h6.text-info
                                =group.name
                              ul
                                for area of group.areas
                                  if node.areas_allowed && node.areas_allowed.includes(area.shortcode)
                                    - count ++
                                    li.text-success
                                      =area.name
                                if count < 1
                                  li.text-danger
                                    |None
                  .col-6
                    .card
                      .card-header
                        .row
                          .col-8
                            h5
                              |Areas Enabled
                          .col-4
                            .text-end
                              button.btn.btn-md.btn-success(data-bs-toggle='modal' data-bs-target=`#setEnabledAreas`)
                                |Update
                      .card-body.vh-30
                        if grouplist && grouplist.length > 0
                          for group of grouplist
                            if group.areas && group.areas.length > 0
                              - var count = 0
                              h6.text-info
                                =group.name
                              ul
                                for area of group.areas
                                  if node.areas_enabled && node.areas_enabled.includes(area.shortcode)
                                    - count ++
                                    li.text-success
                                      =area.name
                                if count < 1
                                  li.text-danger
                                    |None
                    


      #setAllowedAreas.modal.fade(tabindex='-1' aria-labelledby='' aria-hidden='true')
        .modal-dialog.modal-dialog-centered.modal-lg
          .modal-content
            .modal-header.bg-dark.text-white
              h3.modal-title
                  |Set Allowed Areas
              button.btn.btn-lg.btn-close(data-bs-dismiss="modal")
            .modal-body
              form(action=`/admin/nodes/${node.uuid}/updateallowedareas` method="POST" class="form-registration")
                .row
                  .col-1
                  .col-10
                    h4
                      |Set Areas manageable by AreaFix
                    hr
                    fieldset
                      for group of grouplist
                        if group.areas && group.areas.length > 0
                          h5
                            =group.name
                            |:
                          for area of group.areas
                            - var ischecked = false
                            if node.areas_allowed && node.areas_allowed.length > 0
                              if node.areas_allowed.includes(area.shortcode)
                                - ischecked = node.areas_allowed.includes(area.shortcode)
                            .form-check
                              input.form-check-input(id=`aa-${area.shortcode}` type='checkbox' name="allowedareas" value=area.shortcode checked=ischecked)
                              label(for=`aa-${area.shortcode}`)
                                =area.name
                          br
                .row
                  .col-1
                  .col-10
                    br
                    .text-end
                      input(
                        type="submit"
                        value="Submit"
                        class="btn btn-lg btn-success btn-block"
                        )

      #setEnabledAreas.modal.fade(tabindex='-1' aria-labelledby='' aria-hidden='true')
        .modal-dialog.modal-dialog-centered.modal-lg
          .modal-content
            .modal-header.bg-dark.text-white
              h3.modal-title
                  |Set Enabled Areas
              button.btn.btn-lg.btn-close(data-bs-dismiss="modal")
            .modal-body
              form(action=`/admin/nodes/${node.uuid}/updateenabledareas` method="POST" class="form-registration")
                .row
                  .col-1
                  .col-10
                    h4
                      |Set Areas to Toss
                    hr
                    fieldset
                      for group of grouplist
                        if group.areas && group.areas.length > 0
                          h5
                            =group.name
                            |:
                          for area of group.areas
                            - var ischecked = false
                            if node.areas_enabled && node.areas_enabled.length > 0
                              if node.areas_enabled.includes(area.shortcode)
                                - ischecked = node.areas_enabled.includes(area.shortcode)
                            .form-check
                              input.form-check-input(id=`ea-${area.shortcode}` type='checkbox' name="enabledareas" value=area.shortcode checked=ischecked)
                              label(for=`ea-${area.shortcode}`)
                                =area.name
                          br
                .row
                  .col-1
                  .col-10
                    br
                    .text-end
                      input(
                        type="submit"
                        value="Submit"
                        class="btn btn-lg btn-success btn-block"
                        )

      #updatePasswordsModal.modal.fade(tabindex='-1' aria-labelledby='' aria-hidden='true')
        .modal-dialog.modal-dialog-centered.modal-md
          .modal-content
            .modal-header.bg-dark.text-white
              h3.modal-title
                  |Update Passwords
              button.btn.btn-lg.btn-close(data-bs-dismiss="modal")
            .modal-body
              form(action=`/admin/nodes/${node.uuid}/updatepasswords` method="POST" class="form-registration")

                .row
                  .col-1
                  .col-10
                    label(for="sessionpw") Session:
                    input(
                      type="text"
                      id="sessionpw"
                      name="sessionpw"
                      class="form-control"
                      tabindex="1"
                      value=node.session_password
                      required
                    )
                    br
                    label(for="packetpw") Packet:
                    input(
                      type="text"
                      id="packetpw"
                      name="packetpw"
                      class="form-control"
                      tabindex="2"
                      value=node.packet_password
                    )
                    br
                    label(for="ticpw") Tic File:
                    input(
                      type="text"
                      id="ticpw"
                      name="ticpw"
                      class="form-control"
                      tabindex="3"
                      value=node.tic_password
                    )
                    br
                    label(for="areafixpw") AreaFix:
                    input(
                      type="text"
                      id="areafixpw"
                      name="areafixpw"
                      class="form-control"
                      tabindex="4"
                      value=node.areafix_password
                    )

                .row
                  .col-1
                  .col-10
                    br
                    .text-end
                      input(
                        type="submit"
                        value="Submit"
                        class="btn btn-lg btn-success btn-block"
                        tabindex="7"
                        )


      #updateAddressModal.modal.fade(tabindex='-1' aria-labelledby='' aria-hidden='true')
        .modal-dialog.modal-dialog-centered.modal-lg
          .modal-content
            .modal-header.bg-dark.text-white
              h3.modal-title
                  |Update Address
              button.btn.btn-lg.btn-close(data-bs-dismiss="modal")
            .modal-body
              form(action=`/admin/nodes/${node.uuid}/updateaddress` method="POST" class="form-registration")

                .row
                  .col-1
                  .col-5
                    label(for="name") Name:
                    input(
                      type="text"
                      id="name"
                      name="name"
                      class="form-control"
                      tabindex="1"
                      value=node.name
                      required
                    )
                    br
                    label(for="domain") Domain:
                    input(
                      type="text"
                      id="domain"
                      name="domain"
                      class="form-control"
                      tabindex="3"
                      value=node.domain
                      required
                    )
                    br
                    label(for="direct") Direct:
                    select#direct(name="direct" tabindex="5").form-select
                      if node.direct
                        option(selected="selected")
                          |Yes
                        option
                          |No
                      else
                        option
                          |Yes
                        option(selected="selected")
                          |No
                  .col-5
                    label(for="address") Address:
                    input(
                      type="text"
                      id="address"
                      name="address"
                      class="form-control"
                      tabindex="2"
                      value=node.address
                      required
                    )
                    br
                    label(for="status") Status:
                    select#status(name="status" tabindex="4").form-select
                      if !node.status
                        option(selected="selected")
                          |Normal
                        option
                          |Crash
                        option
                          |Hold
                      else
                        if node.status == "NORMAL"
                          option(selected="selected")
                            |Normal
                        else
                          option
                            |Normal
                        if node.status == "CRASH"
                          option(selected="selected")
                            |Crash
                        else
                          option
                            |Crash
                        if node.status == "HOLD"
                          option(selected="selected")
                            |Hold
                        else
                          option
                            |Hold

                      
                    br
                    label(for="routeto") Route To:
                    input(
                      type="text"
                      id="routeto"
                      name="routeto"
                      class="form-control"
                      tabindex="6"
                      value=node.route_to
                    )
                .row
                  .col-1
                  .col-10
                    br
                    .text-end
                      input(
                        type="submit"
                        value="Submit"
                        class="btn btn-lg btn-success btn-block"
                        tabindex="7"
                        )
  script.
    document.addEventListener('DOMContentLoaded', function() {
      var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
      var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl)
      })
    })