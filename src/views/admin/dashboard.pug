extends ../layouts/admin

block content  
  .container-fluid.main-wrapper
    if !currentuser
      - loginMode = 'guard'
      - loginRedirect = currentPath
      include ../partials/users/login.pug
    else if !sufficientAccess
      include ../partials/status/unauthorized.pug
    else
      if !ismobile
        .row
          .col-12
            br
            br
        .row
          .col-3
          .col-6              
            .card      
              .card-header.bg-secondary
                h2= title
              .card-body.bg-dark
                .row
                  .col-12
                    br
                .row
                  .col-4
                    .d-grid.gap-2
                      center
                        h3
                          |Messages
                      a.button.btn.btn-lg.btn-primary(href='/admin/msgGroups')
                        |Message Groups
                      a.button.btn.btn-lg.btn-primary(href='/admin/msgAreas')
                        |Message Areas
                  .col-4
                    .d-grid.gap-2
                      center
                        .h3
                          |Files
                      a.button.btn.btn-lg.btn-primary(href='/admin/fileGroups')
                        |File Groups
                      a.button.btn.btn-lg.btn-primary(href='/admin/fileAreas')
                        |File Areas
                  .col-4
                    .d-grid.gap-2
                      center
                        .h3
                          |Networking
                      a.button.btn.btn-lg.btn-primary(href='/admin/networks')
                        |Message Networks
                      a.button.btn.btn-lg.btn-primary(href='/admin/peers')
                        |Linked Nodes
                      a.button.btn.btn-lg.btn-primary(href='/admin/nodelists')
                        |Nodelists
                .row
                  .col-12
                    br
                    hr
                    br
                .row
                  .col-4
                    .d-grid.gap-2
                      center
                        .h3
                          |Admin Tools
                      a.button.btn.btn-lg.btn-primary(href='/admin/users')
                        |Users
                      a.button.btn.btn-lg.btn-primary(href='/admin/netmail')
                        |Netmail
                  .col-4
                    .d-grid.gap-2
                      center
                        .h3
                          |External
                      a.button.btn.btn-lg.btn-primary(href='/admin/doors')
                        |Door Games
                      a.button.btn.btn-lg.btn-primary(href='/admin/events')
                        |Jobs &amp; Maintenance
                      a.button.btn.btn-lg.btn-primary(href='/admin/import/msgbase')
                        |Import Message Base
                  .col-4
                    .d-grid.gap-2
                      center
                        .h3
                          |System
                      a.button.btn.btn-lg.btn-primary(href='/admin/menus')
                        |Menus    
                      a.button.btn.btn-lg.btn-primary(href='/admin/config')
                        |Config
