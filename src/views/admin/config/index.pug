extends ../../layouts/admin

block content
  .container-fluid.main-wrapper
    if !currentuser
      - loginMode = 'guard'
      - loginRedirect = currentPath
      include ../../partials/users/login.pug
    else if !sufficientAccess
      include ../../partials/status/unauthorized.pug
    else
      .px-4.pt-2
        include ../../partials/flash
      if !ismobile
        .row
          .col-12
            br
            br
        .row
          .col-1
          .col-10
            .card
              .card-header.bg-darkblue.text-white
                .row
                  .col-8
                    h2= title
                  .col-4
                    .text-end
                      form.d-inline.me-2(action='/admin/config/reload' method='POST')
                        button.button.btn.btn-sm.btn-warning(
                          type='submit'
                          title='Re-read the .env file and the database on every process. Applies a .env edit without restarting.'
                        )
                          i.bi.bi-arrow-clockwise.me-1
                          | Reload
                      a.button.btn.btn-sm.btn-info(href='/admin')
                        | Exit

              .card-body
                p.text-muted.mb-3
                  | Settings load from three tiers: defaults, then database overrides, then the 
                  code .env
                  |  file. The 
                  code .env
                  |  file wins, so keys set there cannot be changed on this page. It is read from disk rather than from the environment this process inherited, so editing it and pressing Reload applies the change without a restart.
                if envFilePath
                  p.text-muted.small.mb-3
                    | Reading 
                    code= envFilePath
                if envDivergence && envDivergence.length
                  .alert.alert-warning.mb-3
                    h5.alert-heading
                      i.bi.bi-exclamation-triangle-fill.me-2
                      | Stale environment detected
                    p.mb-2
                      | These key(s) differ between the 
                      code .env
                      |  file and the environment this process was started with. That normally means PM2 replayed a saved environment from 
                      code dump.pm2
                      | .
                    ul.mb-2
                      each d in envDivergence
                        li
                          code= d.key
                          if d.secret
                            |  (values hidden)
                          else
                            |  file: 
                            code= d.file
                            | , running: 
                            code= d.ambient
                          if d.bootstrap
                            span.badge.bg-danger.ms-2 bootstrap key, running value in use
                    p.mb-0.small
                      | Non-bootstrap keys are already using the 
                      code .env
                      |  value, so the system is behaving correctly. To clear the stale environment itself, run 
                      code pm2 delete all && pm2 start ecosystem.config.cjs && pm2 save

                .input-group.mb-3
                  span.input-group-text
                    i.bi.bi-search
                  input#configSearch.form-control(type='text' placeholder='Search settings by name or description...' autocomplete='off')
                  button#configSearchClear.btn.btn-outline-secondary(type='button')
                    i.bi.bi-x-lg

                .accordion#configAccordion
                  each cat in categories
                    - var catId = 'cat_' + cat
                    - var catTitle = cat.charAt(0).toUpperCase() + cat.slice(1)
                    - var catSettings = settings.filter(function(s) { return s.category === cat; })
                    .accordion-item
                      h2.accordion-header(id='heading_' + cat)
                        button.accordion-button.collapsed(
                          type='button'
                          data-bs-toggle='collapse'
                          data-bs-target='#' + catId
                          aria-expanded='false'
                          aria-controls=catId
                        )
                          strong= catTitle
                          span.badge.bg-secondary.ms-2= catSettings.length + ' settings'
                      .accordion-collapse.collapse(id=catId aria-labelledby='heading_' + cat data-bs-parent='#configAccordion')
                        .accordion-body
                          form(action='/admin/config' method='POST')
                            input(type='hidden' name='_category' value=cat)
                            each s in catSettings
                              .row.mb-3.align-items-start
                                .col-md-3
                                  label.form-label.fw-bold(for='cfg_' + s.key)
                                    code= s.key
                                  br
                                  //- Source badge
                                  if s.source === 'env'
                                    span.badge.bg-warning.text-dark(
                                      title='Set in the .env file, which takes precedence over the database. Edit .env and press Reload to change it.'
                                    ) Environment
                                  else if s.source === 'db'
                                    span.badge.bg-info Database
                                  else
                                    span.badge.bg-secondary Default
                                  if s.restart
                                    |
                                    span.badge.bg-danger Requires restart

                                .col-md-6
                                  if s.type === 'boolean'
                                    .form-check.form-switch
                                      if s.source === 'env'
                                        input.form-check-input(
                                          type='checkbox'
                                          id='cfg_' + s.key
                                          name='cfg_' + s.key
                                          value='true'
                                          checked=(s.value === 'true' || s.value === '1' || s.value === 'yes')
                                          disabled
                                        )
                                      else
                                        input.form-check-input(
                                          type='checkbox'
                                          id='cfg_' + s.key
                                          name='cfg_' + s.key
                                          value='true'
                                          checked=(s.value === 'true' || s.value === '1' || s.value === 'yes')
                                        )
                                      label.form-check-label(for='cfg_' + s.key)= s.value === 'true' || s.value === '1' || s.value === 'yes' ? 'Enabled' : 'Disabled'
                                  else if s.type === 'number'
                                    if s.source === 'env'
                                      input.form-control(
                                        type='number'
                                        id='cfg_' + s.key
                                        name='cfg_' + s.key
                                        value=s.value
                                        disabled
                                      )
                                    else
                                      input.form-control(
                                        type='number'
                                        id='cfg_' + s.key
                                        name='cfg_' + s.key
                                        value=s.value
                                      )
                                  else if s.options && s.options.length
                                    //- A fixed set of values: offer them rather
                                    //- than making the sysop guess the spelling
                                    //- from the description. The save route
                                    //- refuses anything outside the list too,
                                    //- since these read as free text wherever
                                    //- they are consumed and a typo falls back
                                    //- to a default rather than failing loudly.
                                    select.form-control(
                                      id='cfg_' + s.key
                                      name='cfg_' + s.key
                                      disabled=(s.source === 'env')
                                    )
                                      each opt in s.options
                                        option(value=opt.value selected=(String(s.value) === opt.value))= opt.label
                                    each opt in s.options
                                      if String(s.value) === opt.value && opt.hint
                                        small.form-text.fg-cyan.d-block= opt.hint
                                  else
                                    if s.source === 'env'
                                      input.form-control(
                                        type='text'
                                        id='cfg_' + s.key
                                        name='cfg_' + s.key
                                        value=s.value
                                        disabled
                                      )
                                    else
                                      input.form-control(
                                        type='text'
                                        id='cfg_' + s.key
                                        name='cfg_' + s.key
                                        value=s.value
                                      )
                                  small.form-text.text-muted= s.description
                                  if s.source === 'env'
                                    br
                                    small.text-warning
                                      i.bi.bi-lock.me-1
                                      | Overridden by environment variable

                                .col-md-3.text-end
                                  if s.source === 'db'
                                    button.btn.btn-sm.btn-outline-secondary(
                                      type='button'
                                      title='Reset to default: ' + s.defaultValue
                                      onclick='fetch("/admin/config/reset/' + s.key + '", {method:"POST",headers:{"Content-Type":"application/x-www-form-urlencoded"}}).then(function(){location.reload();})'
                                    )
                                      i.bi.bi-arrow-counterclockwise.me-1
                                      | Reset
                                  else
                                    small.text-muted= s.source === 'env' ? '' : 'Default: ' + s.defaultValue

                            .text-end.mt-2
                              button.btn.btn-success(type='submit')
                                i.bi.bi-check-lg.me-1
                                | Save #{catTitle} Settings

      script.
        (function() {
          var searchInput = document.getElementById('configSearch');
          var clearBtn = document.getElementById('configSearchClear');
          var accordion = document.getElementById('configAccordion');
          var debounceTimer = null;

          function doSearch() {
            var term = (searchInput.value || '').toLowerCase().trim();
            var rows = accordion.querySelectorAll('.row.mb-3');
            var visibleCats = new Set();

            for (var i = 0; i < rows.length; i++) {
              var row = rows[i];
              var keyEl = row.querySelector('code');
              var descEl = row.querySelector('.form-text');
              var key = keyEl ? keyEl.textContent.toLowerCase() : '';
              var desc = descEl ? descEl.textContent.toLowerCase() : '';

              if (!term || key.includes(term) || desc.includes(term)) {
                row.style.display = '';
                if (term) {
                  var accordionItem = row.closest('.accordion-item');
                  if (accordionItem) visibleCats.add(accordionItem);
                }
              } else {
                row.style.display = 'none';
              }
            }

            // Show/hide entire accordion sections
            var items = accordion.querySelectorAll('.accordion-item');
            for (var j = 0; j < items.length; j++) {
              var item = items[j];
              if (!term) {
                item.style.display = '';
                continue;
              }
              var hasVisible = false;
              var itemRows = item.querySelectorAll('.row.mb-3');
              for (var k = 0; k < itemRows.length; k++) {
                if (itemRows[k].style.display !== 'none') { hasVisible = true; break; }
              }
              item.style.display = hasVisible ? '' : 'none';

              // Auto-expand matching sections
              if (hasVisible && term) {
                var collapse = item.querySelector('.accordion-collapse');
                if (collapse && !collapse.classList.contains('show')) {
                  new bootstrap.Collapse(collapse, { toggle: true });
                }
              }
            }
          }

          searchInput.addEventListener('input', function() {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(doSearch, 200);
          });

          clearBtn.addEventListener('click', function() {
            searchInput.value = '';
            doSearch();
            searchInput.focus();
          });
        })();
