extends ../../layouts/admin

block content
  //- Is there something newer, may this system take it, and (from the Update
  //- button) take it. Also where the channel is switched.
  -
    var verdictClass = {
      current:   'secondary',
      available: 'success',
      blocked:   'warning',
      unknown:   'secondary'
    }
    var verdictLabel = {
      current:   'Up to date',
      available: 'Available',
      blocked:   'Blocked',
      unknown:   'Not resolved'
    }
    var blockerLabel = {
      migration:        'Migration',
      min_upgrade_from: 'Too old to upgrade directly',
      node_min:         'Node too old',
      not_newer:        'Not newer',
      withdrawn:        'Withdrawn'
    }
    var cls = function (v) { return verdictClass[v] || 'secondary' }
    var lbl = function (v) { return verdictLabel[v] || String(v || 'unknown') }

  .container-fluid
    br
    br
    .row
      .col-lg-11.col-12
        h2.mb-1
          i.bi.bi-arrow-up-circle.me-2
          | Software Update
        p.text-muted.small.mb-3
          | Whether a newer Canectic exists, whether this system can move to it, and
          | the update itself. Checking downloads nothing; only the Update button does.

        include ../../partials/flash

        if waitingForStable
          .alert.alert-info.small= waitingForStable

        //- What is running
        .card.bg-dark.border-secondary.mb-3
          .card-body
            .row
              .col-md-3.col-6.mb-2
                .text-muted.small Running
                .fs-5.fw-bold= running
              .col-md-3.col-6.mb-2
                .text-muted.small Channel
                if channelFromEnv
                  .fs-5= channel
                  .text-muted.small set in .env
                else
                  form.d-flex.gap-2.align-items-center(method='post' action='/admin/update/channel')
                    select.form-select.form-select-sm.w-auto(name='channel' aria-label='Update channel'
                      title='Stable is full releases. Development builds are cut between them and meant for live boards.')
                      each opt in channelOptions
                        option(value=opt.value selected=(opt.value === channel))= opt.label
                    button.btn.btn-sm.btn-outline-info(type='submit') Switch
              .col-md-3.col-6.mb-2
                .text-muted.small Node
                .fs-5= nodeVersion
              .col-md-3.col-6.mb-2
                .text-muted.small Daily check
                if enabled
                  span.badge.bg-success.fs-6 On
                else
                  span.badge.bg-secondary.fs-6 Off

            if !enabled
              .alert.alert-secondary.small.mt-3.mb-0
                | The daily check is off, so this system never reaches out on its own.
                | Turn on
                code.mx-1 update_check_enabled
                a(href='/admin/config') on the config page
                |  to have it look once a day and raise a notification, or press
                | Check now below, which asks straight away.

        //- Preflight. Here rather than in the updater because several of these
        //- are only answerable while the board is up: once the processes are
        //- stopped, nobody is online and nothing is in flight.
        if preflight && preflight.checks && preflight.checks.length
          .card.bg-dark.border-secondary.mb-3
            .card-header.d-flex.align-items-center
              strong Before you update
              span.badge.ms-auto(class=preflight.ok ? 'bg-success' : 'bg-danger')
                = preflight.ok ? 'Nothing blocking' : 'Blocked'
            .card-body.py-2
              ul.list-unstyled.mb-0
                each c in preflight.checks
                  li.small.py-1
                    if c.level === 'block'
                      i.bi.bi-x-circle-fill.text-danger.me-2
                    else if c.level === 'warn'
                      i.bi.bi-exclamation-triangle-fill.text-warning.me-2
                    else
                      i.bi.bi-check-circle.text-success.me-2
                    = c.summary
                    if c.detail
                      span.text-muted  (#{c.detail})

        //- The systemd unit that starts pm2 at boot (#21). Not an update
        //- blocker, but this is the page a sysop visits around a Node or OS
        //- change, which is when a pinned unit bites.
        if bootProblems && bootProblems.length
          .alert.alert-warning.small
            strong Starting at boot:
            ul.mb-1.mt-1
              each p in bootProblems
                li= p
            | Fix it from a shell, as the user the BBS runs as:
            code.ms-1 node src/tools/bootUnit.js --install

        //- Last update run, read from the state file rather than from a
        //- process: by the time anybody looks, whatever launched it has usually
        //- been replaced by it.
        if lastRun
          .card.bg-dark.border-secondary.mb-3
            .card-header.d-flex.align-items-center
              strong Last update
              span.badge.ms-auto(class=lastRun.status === 'complete' ? 'bg-success' : (lastRun.status === 'failed' ? 'bg-danger' : 'bg-info'))
                = lastRun.status
            .card-body.py-2.small
              div #{lastRun.from || '?'} to #{lastRun.to || '?'}, #{Math.round((lastRun.elapsedMs || 0) / 1000)}s
              if lastRun.error
                .text-danger.mt-1= lastRun.error
              each w in (lastRun.warnings || [])
                .text-warning.mt-1
                  i.bi.bi-exclamation-triangle.me-1
                  = w
              if lastRunNotices && lastRunNotices.length
                .mt-2
                  strong After updating
                  span.text-muted.ms-1 (the upgrade notes this update brought)
                  ul.mb-0.mt-1
                    each n in lastRunNotices
                      li(class=n.level === 'info' ? '' : 'text-warning')= n.text

        //- Disk held by the updater, so "I need that space back" has an answer.
        if disk && disk.total > 0
          p.text-muted.small
            | The updater is holding #{Math.round(disk.total / 1048576)} MB in
            code.mx-1 .canectic-update
            | : #{Math.round(disk.base.bytes / 1048576)} MB of cached release bases,
            | #{Math.round(disk.backup.bytes / 1048576)} MB of update backups,
            | #{Math.round(disk.staging.bytes / 1048576)} MB staged.
            | Deleting it costs the ability to roll back a past update and makes the next
            | development update re-download its base.

        //- Last check
        .d-flex.align-items-center.mb-2
          h4.mb-0 Last check
          .ms-auto
            form(method='post' action='/admin/update/check' style='display:inline')
              button.btn.btn-sm.btn-primary(type='submit')
                i.bi.bi-arrow-clockwise.me-1
                | Check now

        if !last
          .alert.alert-secondary
            | This system has never checked. Nothing has been sent anywhere.

        else
          p.text-muted.small
            | #{new Date(last.checked_at).toLocaleString()}
            |  (#{last.source === 'manual' ? 'asked for' : 'scheduled'})

          if last.error
            .alert.alert-danger
              strong Could not resolve the release index.
              br
              code= last.error
              br
              span.small
                | Fetching from
                code.mx-1= checkUrl
                | . Nothing published there yet is a normal answer while the
                | project has cut no releases.

          include ../../partials/update/withdrawnNotice
          if noticeRefused
            .alert.alert-warning
              | The update did not start: tick that you have read the upgrade notes shown for it, then press Update again.
              | If the page offers a different release now, check its notes first.
          if result && result.channels
            if result.checkedFor
              p.text-muted.small
                | The last check ran while this board was on #{result.checkedFor}. What it found is shown
                | against #{running}, the version running now; Check now refreshes it.
            .row.g-3
              each chan, name in result.channels
                .col-lg-6
                  .card.bg-dark.border-secondary.h-100
                    .card-header.d-flex.align-items-center
                      strong.text-capitalize= name
                      if name === channel
                        span.badge.bg-info.ms-2 your channel
                      span.badge.ms-auto(class='bg-' + cls(chan.verdict))= lbl(chan.verdict)
                    .card-body
                      if chan.verdict === 'current'
                        p.mb-0.text-muted
                          | Nothing newer than #{chan.current} on this channel.
                      else if chan.verdict === 'unknown'
                        p.mb-0.text-muted
                          | No index resolved for this channel.
                      else
                        p.mb-2
                          span.fs-5.fw-bold= chan.available
                          if chan.release && chan.release.codename
                            span.text-muted.ms-2= chan.release.codename
                          if chan.release && chan.release.released
                            span.text-muted.small.ms-2 released #{chan.release.released}

                        if chan.release
                          dl.row.small.mb-2
                            if chan.release.node_min
                              dt.col-5.text-muted Needs Node
                              dd.col-7= chan.release.node_min
                            if chan.release.min_upgrade_from
                              dt.col-5.text-muted Upgrades from
                              dd.col-7 #{chan.release.min_upgrade_from} or later
                            if chan.release.migrations && chan.release.migrations.length
                              dt.col-5.text-muted Migrations
                              dd.col-7= chan.release.migrations.join(', ')
                            if chan.release.delta
                              dt.col-5.text-muted Delta against
                              dd.col-7= chan.release.base

                        if name === channel && notices && notices.target === chan.available
                          include ../../partials/update/upgradeNotes

                        if chan.blockers && chan.blockers.length
                          .alert.alert-warning.small.mb-0
                            strong This system cannot take it yet:
                            ul.mb-0.mt-1
                              each b in chan.blockers
                                li
                                  strong #{blockerLabel[b.kind] || b.kind}:
                                  |  #{b.detail}
                        else if (name === channel && canApply)
                          .alert.alert-success.small.mb-2
                            | Nothing blocks this move.
                          form(method='post' action='/admin/update/apply'
                               onsubmit=`return confirm('Update to ${chan.available}?\n\nThis closes the board for maintenance. Connected callers and web users get ${Math.round((graceSeconds || 0) / 60)} minute(s) warning, and the update waits for binkp sessions and jobs to finish before it stops the BBS, replaces the files, migrates the database and starts it again. The board reopens once the update is verified; if it fails, it stays closed until you reopen it from the Maintenance page.\n\nThis page will be unavailable while the gateway restarts; come back to it to see what happened.')`)
                            input(type='hidden' name='version' value=chan.available)
                            //- The tick the apply route checks. Bound to the
                            //- exact notes shown, so it cannot carry over.
                            - var needAck = notices && notices.target === chan.available && notices.ackToken
                            if needAck
                              .form-check.small.mb-2
                                input.form-check-input#ackNotes(type='checkbox' name='ack' value=notices.ackToken required
                                  onchange="document.getElementById('updateButton').disabled = !this.checked")
                                label.form-check-label(for='ackNotes')
                                  if notices.verified
                                    | I have read the upgrade notes above
                                  else
                                    | I have read the release notes for #{chan.available}
                            button.btn.btn-warning.w-100#updateButton(type='submit' disabled=!!needAck)
                              i.bi.bi-arrow-up-circle.me-1
                              | Update to #{chan.available}
                          p.text-muted.small.mt-2.mb-0
                            | Or from a shell:
                            code.ms-1 node src/tools/update.js --handoff
                        else if runLive
                          .alert.alert-info.small.mb-0
                            | An update is in progress.
                            |
                            a.alert-link(href='/admin/update/progress') Follow it
                            |  (the page keeps going while the BBS is stopped).
                        else
                          .alert.alert-success.small.mb-0
                            | Nothing blocks this move, but something above has to be cleared first.
                            | From a shell:
                            code.ms-1 node src/tools/update.js --handoff

        //- History
        if history && history.length
          h4.mt-4 History
          p.text-muted.small
            | Every check, whether it found anything or not. A page showing only the
            | last result cannot tell a check that found nothing from a check that
            | never ran, and the second is the one worth seeing.
          .table-responsive
            table.table.table-sm.table-dark.table-striped
              thead
                tr
                  th When
                  th Source
                  th Running
                  th Verdict
                  th Found
                  th Notified
              tbody
                each h in history
                  tr
                    td.small= new Date(h.checked_at).toLocaleString()
                    td.small= h.source
                    td.small= h.current_version
                    td
                      span.badge(class='bg-' + cls(h.verdict))= lbl(h.verdict)
                      if h.error
                        i.bi.bi-exclamation-triangle.text-danger.ms-1(title=h.error)
                    td.small= h.available_version || '-'
                    td.small
                      if h.notified
                        i.bi.bi-bell-fill.text-info
    br
