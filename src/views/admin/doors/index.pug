extends ../../layouts/admin

block content
  .container-fluid.main-wrapper
    if !currentuser
      - loginMode = 'guard'
      - loginRedirect = currentPath
      include ../../partials/users/login.pug
    else if !sufficientAccess
      include ../../partials/status/unauthorized.pug
    else
      if !ismobile
        .row
          .col-12
            br
            br
        .row
          .col-1
          .col-10
            .card
              .card-header.bg-darkblue.text-white
                .row
                  .col-8
                    h2= title
                  .col-4
                    .text-end
                      a.button.btn.btn-sm.btn-info.me-2(href='/admin')
                        | Exit
                      button.btn.btn-sm.btn-success(data-bs-toggle='modal' data-bs-target='#newDoorModal')
                        | Add Door
              .card-body
                if errormessages && errormessages.length > 0
                  ul.text-danger
                    for error of errormessages
                      li.text-danger= error
                  br

                if doorlist && doorlist.length > 0
                  .row.mb-3.align-items-center
                    .col-md-6
                      .input-group.input-group-sm
                        span.input-group-text
                          i.bi.bi-search
                        input#doorSearch.form-control(type='search' placeholder='Filter by name, slug, command, or launch type...' autocomplete='off')
                        button.btn.btn-outline-secondary#doorSearchClear(type='button' title='Clear')
                          i.bi.bi-x-lg
                    .col-md-6.text-end.text-muted.small
                      span#doorSearchCount= doorlist.length + (doorlist.length === 1 ? ' door' : ' doors')
                  table#doorTable.table.table-hover
                    thead
                      tr
                        th(scope='col') Name
                        th(scope='col') Slug
                        th(scope='col') Launch Type
                        th(scope='col') Command / Script
                        th(scope='col') Max Nodes
                        th(scope='col') Status
                        th(scope='col' style='width:180px') Actions
                    tbody
                      for door of doorlist
                        tr(
                          data-id=door.id
                          data-slug=door.slug
                          data-name=door.name
                          data-cmd=door.cmd || ''
                          data-door_script=door.door_script || ''
                          data-door_dir=door.door_dir || ''
                          data-door_args=JSON.stringify(door.door_args || [])
                          data-launch_type=door.launch_type
                          data-dropfile_type=door.dropfile_type || ''
                          data-dropfile_dir=door.dropfile_dir || ''
                          data-db_subdir=door.db_subdir || ''
                          data-usereal_local=(door.usereal_local ? 'true' : 'false')
                          data-usereal_doorsession=(door.usereal_doorsession ? 'true' : 'false')
                          data-pause_on_exit=(door.pause_on_exit ? 'true' : 'false')
                          data-fixed_size=(door.fixed_size ? 'true' : 'false')
                          data-max_nodes=door.max_nodes
                          data-active=(door.active ? 'true' : 'false')
                          data-sort_order=door.sort_order
                          data-icon_url=door.icon_url || ''
                        )
                          td= door.name
                          td
                            code= door.slug
                          td
                            span.badge.bg-primary= launchTypeLabels[door.launch_type] || door.launch_type
                          td
                            if door.cmd
                              small= door.cmd
                            else if door.door_script
                              small.text-info= door.door_script
                            else
                              | -
                          td.text-center
                            if door.max_nodes === 0
                              span.text-muted ∞
                            else
                              = door.max_nodes
                          td
                            if door.active
                              span.badge.bg-success Active
                            else
                              span.badge.bg-danger Inactive
                            if offeredSlugs && offeredSlugs.includes(door.slug)
                              span.badge.bg-info.ms-1(title='Offered to BBSes on your door server through a collection') Door server
                          td
                            button.btn.btn-xs.btn-outline-warning.me-1.edit-door-btn(type='button' title='Edit')
                              i.bi.bi-pencil
                            form.d-inline.me-1(method='POST' action='/admin/doors/' + door.id + '/duplicate')
                              button.btn.btn-xs.btn-outline-info(type='submit' title='Duplicate (creates inactive copy)' onclick='return confirm("Duplicate this door? An inactive copy will be created.")')
                                i.bi.bi-files
                            button.btn.btn-xs.btn-outline-danger.delete-door-btn(type='button' title='Delete')
                              i.bi.bi-trash
                else
                  center
                    .h4 No Door Games Configured
                    p.text-muted Add your first door game to get started.

            //- Variable Reference (collapsible)
            .card.mt-3
              .card-header.bg-darkblue.text-white(style='cursor:pointer' data-bs-toggle='collapse' data-bs-target='#varRefPanel')
                .row
                  .col-10
                    h5.mb-0
                      i.bi.bi-code-square.me-2
                      | Variable Reference
                  .col-2.text-end
                    small.text-muted (click to expand)
              #varRefPanel.collapse
                .card-body
                  p.text-muted.mb-2 Use these tokens in Command, Door Directory, Dropfile Directory, and Door Arguments fields. They are replaced at runtime with live session data.
                  .row
                    .col-6
                      h6 Node / Session
                      table.table.table-sm.table-hover.mb-3
                        tbody
                          for v in configVars
                            if v.token === '%N' || v.token === '%#' || v.token === '%*' || v.token === '%I'
                              tr
                                td.text-nowrap: code= v.token
                                td.small= v.description
                      h6 User
                      table.table.table-sm.table-hover.mb-3
                        tbody
                          for v in configVars
                            if v.token === '%U' || v.token === '%A' || v.token === '%R' || v.token === '%1' || v.token === '%2' || v.token === '%3' || v.token === '%4' || v.token === '%$' || v.token === '%L'
                              tr
                                td.text-nowrap: code= v.token
                                td.small= v.description
                      h6 Terminal
                      table.table.table-sm.table-hover.mb-3
                        tbody
                          for v in configVars
                            if v.token === '%W' || v.token === '%H' || v.token === '%E' || v.token === '%Y'
                              tr
                                td.text-nowrap: code= v.token
                                td.small= v.description
                    .col-6
                      h6 Connection
                      table.table.table-sm.table-hover.mb-3
                        tbody
                          for v in configVars
                            if v.token === '%B' || v.token === '%T' || v.token === '%C' || v.token === '%P'
                              tr
                                td.text-nowrap: code= v.token
                                td.small= v.description
                      h6 Door Config
                      table.table.table-sm.table-hover.mb-3
                        tbody
                          for v in configVars
                            if v.token === '%D' || v.token === '%F' || v.token === '%S' || v.token === '%X' || v.token === '%G'
                              tr
                                td.text-nowrap: code= v.token
                                td.small= v.description
                      h6 System Directories
                      table.table.table-sm.table-hover.mb-3
                        tbody
                          for v in configVars
                            if v.token === '%!' || v.token === '%Z' || v.token === '%K' || v.token === '%J' || v.token === '%M'
                              tr
                                td.text-nowrap: code= v.token
                                td.small= v.description
                      h6 System Info / Misc
                      table.table.table-sm.table-hover
                        tbody
                          for v in configVars
                            if v.token === '%O' || v.token === '%Q' || v.token === '%V' || v.token === '%%'
                              tr
                                td.text-nowrap: code= v.token
                                td.small= v.description

    //- Hidden store for HTML fields per door (data attributes mangle HTML)
    each door of (doorlist || [])
      textarea.d-none(id='door_desc_' + door.id)= door.description || ''
      textarea.d-none(id='door_html_' + door.id)= door.long_desc_html || ''

    //- Door Info Modal
    #doorInfoModal.modal.fade(tabindex='-1' aria-hidden='true')
      .modal-dialog.modal-dialog-centered
        .modal-content
          .modal-header.bg-dark.text-white
            h3#doorInfoTitle.modal-title Door Info
            button.btn.btn-lg.btn-close.btn-close-white(data-bs-dismiss='modal')
          .modal-body
            table.table.table-sm
              tr
                th Slug
                td#diSlug
              tr
                th Launch Type
                td#diLaunchType
              tr
                th Command
                td#diCmd
              tr
                th Script
                td#diScript
              tr
                th Directory
                td#diDir
              tr
                th Dropfile
                td#diDropfile
              tr
                th Max Nodes
                td#diMaxNodes
              tr
                th Description
                td#diDescription

    //- New Door Modal
    #newDoorModal.modal.fade(tabindex='-1' aria-hidden='true')
      .modal-dialog.modal-dialog-centered(style='max-width:1100px')
        .modal-content
          .modal-header.bg-dark.text-white
            h3.modal-title Add Door Game
            button.btn.btn-lg.btn-close.btn-close-white(data-bs-dismiss='modal')
          .modal-body
            form#newDoorForm(action='/admin/doors/new' method='POST')
              ul.nav.nav-tabs.mb-3(role='tablist')
                li.nav-item(role='presentation')
                  button.nav-link.active#newConfigTab(data-bs-toggle='tab' data-bs-target='#newConfigPane' type='button' role='tab' aria-selected='true') Configuration
                li.nav-item(role='presentation')
                  button.nav-link#newDescTab(data-bs-toggle='tab' data-bs-target='#newDescPane' type='button' role='tab' aria-selected='false') Description
                li.nav-item(role='presentation')
                  button.nav-link#newExtTab(data-bs-toggle='tab' data-bs-target='#newExtPane' type='button' role='tab' aria-selected='false') Extended Info
                li.nav-item(role='presentation')
                  button.nav-link#newMediaTab(data-bs-toggle='tab' data-bs-target='#newMediaPane' type='button' role='tab' aria-selected='false') Media
                li.nav-item(role='presentation')
                  button.nav-link#newCollTab(data-bs-toggle='tab' data-bs-target='#newCollPane' type='button' role='tab' aria-selected='false') Collections
              .tab-content
                //- Tab 1: Configuration
                #newConfigPane.tab-pane.fade.show.active(role='tabpanel')
                  .row
                    //- LEFT COLUMN -- Identity + Executable
                    .col-6
                      h5 Identity
                      label.form-label Name:
                      input.form-control.mb-2(type='text' name='name' required placeholder='e.g. Legend of the Red Dragon')
                      .row
                        .col-6
                          label.form-label(data-bs-toggle='tooltip' title='Lowercase letters, numbers, hyphens, underscores only. Used to launch the door from menus.')
                            | Slug (unique ID)
                            i.bi.bi-info-circle.text-muted
                          input.form-control.mb-2(type='text' name='slug' required placeholder='e.g. lord' pattern='[a-z0-9_-]+')
                        .col-6
                          label.form-label Launch Type:
                          select.form-control.mb-2(name='launch_type')
                            for lt in launchTypes
                              option(value=lt)= launchTypeLabels[lt] || lt

                      h5 Executable
                      label.form-label(data-bs-toggle='tooltip' title='Working directory for the door process. Supports %X variables -- see reference below.')
                        | Door Directory
                        i.bi.bi-info-circle.text-muted
                      input.form-control.mb-2(type='text' name='door_dir' placeholder='e.g. %!/lord')
                      label.form-label(data-bs-toggle='tooltip' title='Shell command or batch file. Used by NativeShell, NativeCommand, Dosemu, DosemuPty. Supports %X variables.')
                        | Command
                        i.bi.bi-info-circle.text-muted
                      input.form-control.mb-2(type='text' name='cmd' placeholder='e.g. "c:\\bat\\lord.bat"')
                      label.form-label(data-bs-toggle='tooltip' title='JavaScript door entry point. Used only by the SyncJSDoor launch type.')
                        | JS Door Script
                        i.bi.bi-info-circle.text-muted
                      input.form-control.mb-2(type='text' name='door_script' placeholder='e.g. lord.js')
                      label.form-label(data-bs-toggle='tooltip' title='Space-separated arguments passed to the door process. Supports %X variables (e.g. %N for node number).')
                        | Door Arguments
                        i.bi.bi-info-circle.text-muted
                      input.form-control.mb-2(type='text' name='door_args' placeholder='e.g. -m RESET -n %N')

                    //- RIGHT COLUMN -- Dropfile + Options
                    .col-6
                      h5 Dropfile
                      .row
                        .col-6
                          label.form-label(data-bs-toggle='tooltip' title='Format of the drop file generated for the door (e.g. DOOR.SYS, DORINFO). Leave as None if not needed.')
                            | Dropfile Type
                            i.bi.bi-info-circle.text-muted
                          select.form-control.mb-2(name='dropfile_type')
                            option(value='') None
                            for dt in dropfileTypes
                              if dt
                                option(value=dt)= dropfileTypeLabels[dt] || dt
                        .col-6
                          label.form-label(data-bs-toggle='tooltip' title='Directory where the drop file is written. Supports %X variables.')
                            | Dropfile Directory
                            i.bi.bi-info-circle.text-muted
                          input.form-control.mb-2(type='text' name='dropfile_dir' placeholder='e.g. %M/doors/LOD')

                      h5.mt-3 Options
                      .row
                        .col-4
                          label.form-label(data-bs-toggle='tooltip' title='Maximum simultaneous users in this door. 0 = unlimited.')
                            | Max Nodes
                            i.bi.bi-info-circle.text-muted
                          input.form-control.mb-2(type='number' name='max_nodes' value='0' min='0')
                        .col-4
                          label.form-label Sort Order:
                          input.form-control.mb-2(type='number' name='sort_order' value='0')
                        .col-4
                          label.form-label Active:
                          select.form-control.mb-2(name='active')
                            option(value='true') Yes
                            option(value='false') No
                      p.small.text-muted.mb-2
                        | Offered to BBSes on your door server through its collections: see
                        a(href='/admin/doorCollections')  Door Collections
                        | .
                      .row
                        .col-4
                          label.form-label(data-bs-toggle='tooltip' title='Show "Press any key to continue" after the door process exits.')
                            | Pause on Exit
                            i.bi.bi-info-circle.text-muted
                          select.form-control.mb-2(name='pause_on_exit')
                            option(value='true') Yes
                            option(value='false') No
                        .col-4
                          label.form-label(data-bs-toggle='tooltip' title='Force 80x25 terminal size and center output on larger terminals. Use for doors that do not handle variable terminal sizes.')
                            | Fixed 80x25
                            i.bi.bi-info-circle.text-muted
                          select.form-control.mb-2(name='fixed_size')
                            option(value='false') No
                            option(value='true') Yes
                      .row
                        .col-4
                          label.form-label(data-bs-toggle='tooltip' title='Use real name instead of alias in drop files for local callers.')
                            | Real Names (Local)
                            i.bi.bi-info-circle.text-muted
                          select.form-control.mb-2(name='usereal_local')
                            option(value='false') No
                            option(value='true') Yes
                        .col-4
                          label.form-label(data-bs-toggle='tooltip' title='Use real name instead of alias in drop files for door session callers.')
                            | Real Names (Door)
                            i.bi.bi-info-circle.text-muted
                          select.form-control.mb-2(name='usereal_doorsession')
                            option(value='false') No
                            option(value='true') Yes
                      .row
                        .col-6
                          label.form-label(data-bs-toggle='tooltip' title='Subdirectory under door directory used for door-specific database files (e.g. LORD player data).')
                            | DB Subdir
                            i.bi.bi-info-circle.text-muted
                          input.form-control.mb-2(type='text' name='db_subdir' placeholder='e.g. DB')

                //- Tab 2: Description
                #newDescPane.tab-pane.fade(role='tabpanel')
                  textarea#new_description(name='description')

                //- Tab 3: Extended Info
                #newExtPane.tab-pane.fade(role='tabpanel')
                  textarea#new_long_desc_html(name='long_desc_html')

                //- Tab 3: Media
                #newMediaPane.tab-pane.fade(role='tabpanel')
                  label.form-label Icon/Image URL:
                  input#new_icon_url.form-control.mb-3(type='text' name='icon_url' placeholder='/images/doors/my-door.png')
                  .text-center
                    img#new_icon_preview.img-fluid(style='max-height:200px; display:none' alt='Preview')
                    p#new_icon_placeholder.text-muted Enter an image URL above to see a preview.

                //- Tab 4: Collections
                #newCollPane.tab-pane.fade(role='tabpanel')
                  if collections && collections.length > 0
                    p.text-muted Select collections this door belongs to:
                    each coll in collections
                      .form-check.mb-1
                        input.form-check-input(type='checkbox' name='collections' value=coll.id id='new_coll_' + coll.id)
                        label.form-check-label(for='new_coll_' + coll.id)= coll.name
                  else
                    p.text-muted No collections available. Create collections first.

              .row.mt-3
                .col-12
                  .text-end
                    input.btn.btn-lg.btn-success(type='submit' value='Create Door')

    //- Edit Door Modal
    #editDoorModal.modal.fade(tabindex='-1' aria-hidden='true')
      .modal-dialog.modal-dialog-centered(style='max-width:1100px')
        .modal-content
          .modal-header.bg-dark.text-white
            h3.modal-title Edit Door Game
            button.btn.btn-lg.btn-close.btn-close-white(data-bs-dismiss='modal')
          .modal-body
            form#editDoorForm(method='POST')
              ul.nav.nav-tabs.mb-3(role='tablist')
                li.nav-item(role='presentation')
                  button.nav-link.active#edConfigTab(data-bs-toggle='tab' data-bs-target='#edConfigPane' type='button' role='tab' aria-selected='true') Configuration
                li.nav-item(role='presentation')
                  button.nav-link#edDescTab(data-bs-toggle='tab' data-bs-target='#edDescPane' type='button' role='tab' aria-selected='false') Description
                li.nav-item(role='presentation')
                  button.nav-link#edExtTab(data-bs-toggle='tab' data-bs-target='#edExtPane' type='button' role='tab' aria-selected='false') Extended Info
                li.nav-item(role='presentation')
                  button.nav-link#edMediaTab(data-bs-toggle='tab' data-bs-target='#edMediaPane' type='button' role='tab' aria-selected='false') Media
                li.nav-item(role='presentation')
                  button.nav-link#edCollTab(data-bs-toggle='tab' data-bs-target='#edCollPane' type='button' role='tab' aria-selected='false') Collections
              .tab-content
                //- Tab 1: Configuration
                #edConfigPane.tab-pane.fade.show.active(role='tabpanel')
                  .row
                    //- LEFT COLUMN -- Identity + Executable
                    .col-6
                      h5 Identity
                      label.form-label Name:
                      input#ed_name.form-control.mb-2(type='text' name='name' required)
                      .row
                        .col-6
                          label.form-label(data-bs-toggle='tooltip' title='Lowercase letters, numbers, hyphens, underscores only.')
                            | Slug
                            i.bi.bi-info-circle.text-muted
                          input#ed_slug.form-control.mb-2(type='text' name='slug' required pattern='[a-z0-9_-]+')
                        .col-6
                          label.form-label Launch Type:
                          select#ed_launch_type.form-control.mb-2(name='launch_type')
                            for lt in launchTypes
                              option(value=lt)= launchTypeLabels[lt] || lt

                      h5 Executable
                      label.form-label(data-bs-toggle='tooltip' title='Working directory for the door process. Supports %X variables.')
                        | Door Directory
                        i.bi.bi-info-circle.text-muted
                      input#ed_door_dir.form-control.mb-2(type='text' name='door_dir')
                      label.form-label(data-bs-toggle='tooltip' title='Shell command or batch file. Used by NativeShell, NativeCommand, Dosemu, DosemuPty. Supports %X variables.')
                        | Command
                        i.bi.bi-info-circle.text-muted
                      input#ed_cmd.form-control.mb-2(type='text' name='cmd')
                      label.form-label(data-bs-toggle='tooltip' title='JavaScript door entry point. Used only by the SyncJSDoor launch type.')
                        | JS Door Script
                        i.bi.bi-info-circle.text-muted
                      input#ed_door_script.form-control.mb-2(type='text' name='door_script')
                      label.form-label(data-bs-toggle='tooltip' title='Space-separated arguments passed to the door process. Supports %X variables (e.g. %N for node number).')
                        | Door Arguments
                        i.bi.bi-info-circle.text-muted
                      input#ed_door_args.form-control.mb-2(type='text' name='door_args')

                    //- RIGHT COLUMN -- Dropfile + Options
                    .col-6
                      h5 Dropfile
                      .row
                        .col-6
                          label.form-label(data-bs-toggle='tooltip' title='Format of the drop file generated for the door. Leave as None if not needed.')
                            | Dropfile Type
                            i.bi.bi-info-circle.text-muted
                          select#ed_dropfile_type.form-control.mb-2(name='dropfile_type')
                            option(value='') None
                            for dt in dropfileTypes
                              if dt
                                option(value=dt)= dropfileTypeLabels[dt] || dt
                        .col-6
                          label.form-label(data-bs-toggle='tooltip' title='Directory where the drop file is written. Supports %X variables.')
                            | Dropfile Directory
                            i.bi.bi-info-circle.text-muted
                          input#ed_dropfile_dir.form-control.mb-2(type='text' name='dropfile_dir')

                      h5.mt-3 Options
                      .row
                        .col-4
                          label.form-label(data-bs-toggle='tooltip' title='Maximum simultaneous users in this door. 0 = unlimited.')
                            | Max Nodes
                            i.bi.bi-info-circle.text-muted
                          input#ed_max_nodes.form-control.mb-2(type='number' name='max_nodes' min='0')
                        .col-4
                          label.form-label Sort Order:
                          input#ed_sort_order.form-control.mb-2(type='number' name='sort_order')
                        .col-4
                          label.form-label Active:
                          select#ed_active.form-control.mb-2(name='active')
                            option(value='true') Yes
                            option(value='false') No
                      p.small.text-muted.mb-2
                        | Offered to BBSes on your door server through its collections: see
                        a(href='/admin/doorCollections')  Door Collections
                        | .
                      .row
                        .col-4
                          label.form-label(data-bs-toggle='tooltip' title='Show "Press any key to continue" after the door process exits.')
                            | Pause on Exit
                            i.bi.bi-info-circle.text-muted
                          select#ed_pause.form-control.mb-2(name='pause_on_exit')
                            option(value='true') Yes
                            option(value='false') No
                        .col-4
                          label.form-label(data-bs-toggle='tooltip' title='Force 80x25 terminal size and center output on larger terminals.')
                            | Fixed 80x25
                            i.bi.bi-info-circle.text-muted
                          select#ed_fixed_size.form-control.mb-2(name='fixed_size')
                            option(value='false') No
                            option(value='true') Yes
                      .row
                        .col-4
                          label.form-label(data-bs-toggle='tooltip' title='Use real name instead of alias in drop files for local callers.')
                            | Real Names (Local)
                            i.bi.bi-info-circle.text-muted
                          select#ed_usereal_local.form-control.mb-2(name='usereal_local')
                            option(value='false') No
                            option(value='true') Yes
                        .col-4
                          label.form-label(data-bs-toggle='tooltip' title='Use real name instead of alias in drop files for door session callers.')
                            | Real Names (Door)
                            i.bi.bi-info-circle.text-muted
                          select#ed_usereal_doorsession.form-control.mb-2(name='usereal_doorsession')
                            option(value='false') No
                            option(value='true') Yes
                      .row
                        .col-6
                          label.form-label(data-bs-toggle='tooltip' title='Subdirectory under door directory used for door-specific database files.')
                            | DB Subdir
                            i.bi.bi-info-circle.text-muted
                          input#ed_db_subdir.form-control.mb-2(type='text' name='db_subdir')

                //- Tab 2: Description
                #edDescPane.tab-pane.fade(role='tabpanel')
                  textarea#ed_description(name='description')

                //- Tab 3: Extended Info
                #edExtPane.tab-pane.fade(role='tabpanel')
                  textarea#ed_long_desc_html(name='long_desc_html')

                //- Tab 3: Media
                #edMediaPane.tab-pane.fade(role='tabpanel')
                  label.form-label Icon/Image URL:
                  input#ed_icon_url.form-control.mb-3(type='text' name='icon_url' placeholder='/images/doors/my-door.png')
                  .text-center
                    img#ed_icon_preview.img-fluid(style='max-height:200px; display:none' alt='Preview')
                    p#ed_icon_placeholder.text-muted Enter an image URL above to see a preview.

                //- Tab 4: Collections
                #edCollPane.tab-pane.fade(role='tabpanel')
                  if collections && collections.length > 0
                    p.text-muted Select collections this door belongs to:
                    each coll in collections
                      .form-check.mb-1
                        input.form-check-input.ed-coll-check(type='checkbox' name='collections' value=coll.id id='ed_coll_' + coll.id)
                        label.form-check-label(for='ed_coll_' + coll.id)= coll.name
                  else
                    p.text-muted No collections available. Create collections first.

              .row.mt-3
                .col-12
                  .text-end
                    input.btn.btn-lg.btn-success(type='submit' value='Save Changes')

    //- Delete Door Modal
    #deleteDoorModal.modal.fade(tabindex='-1' aria-hidden='true')
      .modal-dialog.modal-dialog-centered
        .modal-content
          .modal-header.bg-danger.text-white
            h3.modal-title Delete Door
            button.btn.btn-lg.btn-close.btn-close-white(data-bs-dismiss='modal')
          .modal-body
            p
              | Are you sure you want to delete 
              strong#deleteDoorName
              | ?
            form#deleteDoorForm(method='POST')
              .text-end
                button.btn.btn-secondary.me-2(type='button' data-bs-dismiss='modal') Cancel
                input.btn.btn-danger(type='submit' value='Delete Door')

  script.
    var _doorCollectionMap = !{JSON.stringify(doorCollectionMap)};
    document.addEventListener('DOMContentLoaded', function() {
      // Initialize Bootstrap tooltips
      document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function(el) {
        new bootstrap.Tooltip(el);
      });

      var editDoorModal   = new bootstrap.Modal(document.getElementById('editDoorModal'));
      var deleteDoorModal = new bootstrap.Modal(document.getElementById('deleteDoorModal'));

      // ---- TinyMCE shared config ----
      // ANSI 16-color palette — matches closestAnsiColor() in announcements.js
      var ansiColorMap = [
        '010101', 'Theme Default',
        'AA0000', 'Red',
        '00AA00', 'Green',
        'AA5500', 'Yellow (dark)',
        '0000AA', 'Blue',
        'AA00AA', 'Magenta',
        '00AAAA', 'Cyan',
        'AAAAAA', 'White (grey)',
        '000000', 'Black',
        'FF5555', 'Bright Red',
        '55FF55', 'Bright Green',
        'FFFF55', 'Bright Yellow',
        '5555FF', 'Bright Blue',
        'FF55FF', 'Bright Magenta',
        '55FFFF', 'Bright Cyan',
        'FFFFFF', 'Bright White',
        '555555', 'Bright Black'
      ];
      var mceBase = {
        license_key: 'gpl',
        menubar: false,
        plugins: 'lists link autolink',
        toolbar: 'bold italic underline strikethrough | forecolor backcolor | bullist numlist | link | removeformat',
        skin: 'oxide-dark',
        content_css: 'dark',
        content_style: 'span[style*="color: #010101"], span[style*="color: rgb(1, 1, 1)"] { color: inherit !important; }',
        color_map: ansiColorMap,
        color_cols: 9,
        custom_colors: false,
        branding: false,
        promotion: false,
        setup: function(editor) {
          editor.on('change', function() { editor.save(); });
        }
      };

      // Lazy-init TinyMCE per tab (hidden tabs break TinyMCE rendering)
      var mceInited = {};
      function lazyMce(tabId, selector, height) {
        document.getElementById(tabId).addEventListener('shown.bs.tab', function() {
          if (!mceInited[selector]) {
            tinymce.init(Object.assign({}, mceBase, { selector: selector, height: height }));
            mceInited[selector] = true;
          }
        });
      }
      lazyMce('newDescTab', '#new_description', 300);
      lazyMce('newExtTab',  '#new_long_desc_html', 400);
      lazyMce('edDescTab',  '#ed_description', 300);
      lazyMce('edExtTab',   '#ed_long_desc_html', 400);

      // ---- Image preview helpers ----
      function setupIconPreview(inputId, imgId, placeholderId) {
        var input = document.getElementById(inputId);
        var img   = document.getElementById(imgId);
        var ph    = document.getElementById(placeholderId);
        input.addEventListener('input', function() {
          var url = input.value.trim();
          if (url) {
            img.src = url;
            img.style.display = 'inline-block';
            ph.style.display  = 'none';
          } else {
            img.style.display = 'none';
            img.src = '';
            ph.style.display  = 'block';
          }
        });
        // Hide broken images gracefully
        img.addEventListener('error', function() {
          img.style.display = 'none';
          ph.textContent    = 'Image could not be loaded.';
          ph.style.display  = 'block';
        });
      }
      setupIconPreview('new_icon_url', 'new_icon_preview', 'new_icon_placeholder');
      setupIconPreview('ed_icon_url',  'ed_icon_preview',  'ed_icon_placeholder');

      // ---- Form submit: sync TinyMCE before POST ----
      document.getElementById('newDoorForm').addEventListener('submit', function() {
        var ed1 = tinymce.get('new_description');
        var ed2 = tinymce.get('new_long_desc_html');
        if (ed1) ed1.save();
        if (ed2) ed2.save();
      });
      document.getElementById('editDoorForm').addEventListener('submit', function() {
        var ed1 = tinymce.get('ed_description');
        var ed2 = tinymce.get('ed_long_desc_html');
        if (ed1) ed1.save();
        if (ed2) ed2.save();
      });

      // ---- Reset New Door modal tabs when closed ----
      document.getElementById('newDoorModal').addEventListener('hidden.bs.modal', function() {
        // Switch back to Configuration tab
        var configTab = document.getElementById('newConfigTab');
        var tab = bootstrap.Tab.getOrCreateInstance(configTab);
        tab.show();
      });

      // ---- Reset Edit Door modal tabs when closed ----
      document.getElementById('editDoorModal').addEventListener('hidden.bs.modal', function() {
        var configTab = document.getElementById('edConfigTab');
        var tab = bootstrap.Tab.getOrCreateInstance(configTab);
        tab.show();
      });

      // ---- Edit button ----
      document.querySelectorAll('.edit-door-btn').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.stopPropagation();
          var row = this.closest('tr');
          var d   = row.dataset;

          document.getElementById('editDoorForm').action      = '/admin/doors/' + d.id + '/update';
          document.getElementById('ed_name').value             = d.name;
          document.getElementById('ed_slug').value             = d.slug;
          document.getElementById('ed_launch_type').value      = d.launch_type;
          document.getElementById('ed_cmd').value              = d.cmd;
          document.getElementById('ed_door_script').value      = d.door_script;
          document.getElementById('ed_door_dir').value         = d.door_dir;
          document.getElementById('ed_dropfile_type').value    = d.dropfile_type;
          document.getElementById('ed_dropfile_dir').value     = d.dropfile_dir;
          document.getElementById('ed_db_subdir').value        = d.db_subdir;
          document.getElementById('ed_max_nodes').value        = d.max_nodes;
          document.getElementById('ed_sort_order').value       = d.sort_order;
          document.getElementById('ed_active').value           = d.active;
          document.getElementById('ed_pause').value            = d.pause_on_exit;
          document.getElementById('ed_fixed_size').value       = d.fixed_size;
          document.getElementById('ed_usereal_local').value    = d.usereal_local;
          document.getElementById('ed_usereal_doorsession').value = d.usereal_doorsession;

          // Door args: DB stores JSON, display as space-separated
          var args = [];
          try { args = JSON.parse(d.door_args || '[]'); } catch(_) {}
          document.getElementById('ed_door_args').value = Array.isArray(args) ? args.join(' ') : '';

          // Description tab fields - load from hidden textareas (HTML breaks data attributes)
          var descEl = document.getElementById('door_desc_' + d.id);
          var descContent = descEl ? descEl.value : '';
          var edDescEditor = tinymce.get('ed_description');
          if (edDescEditor) {
            edDescEditor.setContent(descContent);
          } else {
            document.getElementById('ed_description').value = descContent;
          }

          var hiddenEl = document.getElementById('door_html_' + d.id);
          var htmlContent = hiddenEl ? hiddenEl.value : '';
          var edEditor = tinymce.get('ed_long_desc_html');
          if (edEditor) {
            edEditor.setContent(htmlContent);
          } else {
            document.getElementById('ed_long_desc_html').value = htmlContent;
          }

          // Media tab fields
          var iconUrl = d.icon_url || '';
          document.getElementById('ed_icon_url').value = iconUrl;
          var edImg = document.getElementById('ed_icon_preview');
          var edPh  = document.getElementById('ed_icon_placeholder');
          if (iconUrl) {
            edImg.src = iconUrl;
            edImg.style.display = 'inline-block';
            edPh.style.display  = 'none';
          } else {
            edImg.style.display = 'none';
            edImg.src = '';
            edPh.textContent    = 'Enter an image URL above to see a preview.';
            edPh.style.display  = 'block';
          }

          // Collections tab: check boxes for this door's memberships
          var doorColls = _doorCollectionMap[d.id] || [];
          document.querySelectorAll('.ed-coll-check').forEach(function(cb) {
            cb.checked = doorColls.includes(parseInt(cb.value));
          });

          editDoorModal.show();
        });
      });

      // ---- Delete button ----
      document.querySelectorAll('.delete-door-btn').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.stopPropagation();
          var row = this.closest('tr');
          var d   = row.dataset;

          document.getElementById('deleteDoorName').textContent = d.name;
          document.getElementById('deleteDoorForm').action      = '/admin/doors/' + d.id + '/delete';
          deleteDoorModal.show();
        });
      });

      // ---- Row click: info modal ----
      document.querySelectorAll('#doorTable tbody tr').forEach(function(row) {
        row.style.cursor = 'pointer';
        row.addEventListener('click', function() {
          var d = this.dataset;
          document.getElementById('doorInfoTitle').textContent = d.name;
          document.getElementById('diSlug').textContent        = d.slug;
          document.getElementById('diLaunchType').textContent  = d.launch_type;
          document.getElementById('diCmd').textContent          = d.cmd || '-';
          document.getElementById('diScript').textContent       = d.door_script || '-';
          document.getElementById('diDir').textContent          = d.door_dir || '-';
          document.getElementById('diDropfile').textContent     = d.dropfile_type ? d.dropfile_type + ' > ' + d.dropfile_dir : '-';
          document.getElementById('diMaxNodes').textContent     = d.max_nodes === '0' ? 'Unlimited' : d.max_nodes;
          var descHidden = document.getElementById('door_desc_' + d.id);
          document.getElementById('diDescription').innerHTML    = (descHidden && descHidden.value.trim()) ? descHidden.value : '-';

          var infoModal = new bootstrap.Modal(document.getElementById('doorInfoModal'));
          infoModal.show();
        });
      });

      // ---- Live search filter ----
      var searchInput = document.getElementById('doorSearch');
      var searchClear = document.getElementById('doorSearchClear');
      var searchCount = document.getElementById('doorSearchCount');
      var doorRows = document.querySelectorAll('#doorTable tbody tr');
      var totalRows = doorRows.length;

      function applyDoorFilter() {
        if (!searchInput) return;
        var q = (searchInput.value || '').trim().toLowerCase();
        var visible = 0;
        doorRows.forEach(function(row) {
          if (!q) {
            row.style.display = '';
            visible++;
            return;
          }
          var d = row.dataset;
          var hay = (d.name + ' ' + d.slug + ' ' + d.cmd + ' ' + d.door_script + ' ' + d.launch_type).toLowerCase();
          if (hay.indexOf(q) !== -1) {
            row.style.display = '';
            visible++;
          } else {
            row.style.display = 'none';
          }
        });
        if (searchCount) {
          if (q) {
            searchCount.textContent = visible + ' of ' + totalRows + ' shown';
          } else {
            searchCount.textContent = totalRows + (totalRows === 1 ? ' door' : ' doors');
          }
        }
      }

      if (searchInput) {
        searchInput.addEventListener('input', applyDoorFilter);
      }
      if (searchClear) {
        searchClear.addEventListener('click', function() {
          if (!searchInput) return;
          searchInput.value = '';
          applyDoorFilter();
          searchInput.focus();
        });
      }
    });
