extends ../../layouts/admin

include ./_areaFormFields

block content
  .container-fluid.main-wrapper
    if !currentuser
      - loginMode = 'guard'
      - loginRedirect = currentPath
      include ../../partials/users/login.pug
    else if !sufficientAccess
      include ../../partials/status/unauthorized.pug
    else
      if !ismobile
        .row
          .col-12
            br
            br
        .row
          .col-1
          .col-10
            .card
              .card-header.bg-darkblue.text-white
                .row.align-items-center
                  .col-6
                    h2= title
                  .col-6
                    .text-end
                      button.btn.btn-success.me-2(data-bs-toggle='modal' data-bs-target='#newAreaModal')
                        | Add Area
                      a.button.btn.btn-info.me-2(href='/admin/msgGroups')
                        | Groups
                      a.button.btn.btn-danger(href='/admin')
                        | Exit
              .card-body
                if allAreas && allAreas.length > 0
                  br
                  table#areaTable.table.table-hover.table-sm(style='width:100%')
                    thead
                      tr
                        th(scope='col') Group
                        th(scope='col') Name
                        th(scope='col') Shortcode
                        th(scope='col') Description
                        th(scope='col') Network
                        th(scope='col') Tag
                        th(scope='col') Msg Count
                        th(scope='col') Latest
                    tbody
                      for area of allAreas
                        tr.area-row(
                          data-bs-id=area.id
                          data-bs-shortcode=area.shortcode
                          data-bs-name=area.name
                          data-bs-description=area.description
                          data-bs-groupshortcode=area.group_shortcode
                          data-bs-networkname=(area.network_name || '')
                          data-bs-networktag=(area.areatag || '')
                          data-bs-readsecurity=area.read_security
                          data-bs-postsecurity=area.post_security
                          data-bs-minage=area.min_age || 13
                          data-bs-maxage=area.max_age || 255
                          data-bs-maxagedays=(area.max_age_days === null || area.max_age_days === undefined) ? '' : area.max_age_days
                          data-bs-maxmessages=(area.max_messages === null || area.max_messages === undefined) ? '' : area.max_messages
                          data-bs-active=(area.active ? 'true' : 'false')
                          data-bs-threadmode=area.thread_mode || 'standard'
                          data-bs-postas=area.post_as || 'username'
                          data-bs-newscandefault=(area.newscan_default ? 'true' : 'false')
                          data-bs-qwkconfnumber=area.qwk_conf_number || ''
                          data-bs-msgcount=area.msg_count || 0
                          data-bs-lastfrom=area.last_from || ''
                          data-bs-lastmessage=area.last_message || ''
                          data-bs-readpermflags=JSON.stringify(area.read_perm_flags || [])
                          data-bs-readrestflags=JSON.stringify(area.read_rest_flags || [])
                          data-bs-postpermflags=JSON.stringify(area.post_perm_flags || [])
                          data-bs-postrestflags=JSON.stringify(area.post_rest_flags || [])
                        )
                          td= area.group_shortcode
                          td= area.name
                          td= area.shortcode
                          td= area.description
                          td
                            if area.network_name
                              span.badge.bg-info.text-dark= area.network_name
                            else
                              span.badge.bg-secondary Local
                          td
                            if area.areatag
                              = area.areatag
                          td.text-end
                            - var mcount = (area.msg_count || 0).toLocaleString()
                            = mcount
                          td
                            if area.last_message
                              .text-end
                                - var e1date = Date.parse(area.last_message)
                                - var edate = DateTime.fromMillis(e1date)
                                = edate.toFormat('MMMM dd, yyyy')
                            else
                              center
                                | N/A
                else
                  center
                    h4 No Areas Found

        //- Area Info Modal
        #areaInfoModal.modal.fade(tabindex='-1' aria-hidden='true')
          .modal-dialog.modal-dialog-centered.modal-lg
            .modal-content
              .modal-header.bg-dark.text-white
                h3.modal-title#areaInfoTitle
                .ms-auto.d-flex.gap-2
                  button.btn.btn-sm.btn-info#areaViewBtn View
                  button.btn.btn-sm.btn-warning#areaEditBtn Edit
                  button.btn.btn-sm.btn-secondary#areaMoveBtn Move
                  button.btn.btn-sm.btn-danger#areaDeleteBtn Delete
                  button.btn.btn-sm.btn-close(data-bs-dismiss='modal')
              .modal-body.bg-dark.text-white
                .row
                  .col-6
                    p
                      strong Shortcode:
                      |  
                      span#areaInfoShortcode
                    p
                      strong Group:
                      |  
                      span#areaInfoGroup
                    p
                      strong Network:
                      |  
                      span#areaInfoNetwork
                    p
                      strong Area Tag:
                      |  
                      span#areaInfoAreatag
                    p
                      strong Status:
                      |  
                      span#areaInfoActive
                    p
                      strong Thread Mode:
                      |  
                      span#areaInfoThreadMode
                    p
                      strong Post As:
                      |  
                      span#areaInfoPostAs
                  .col-6
                    p
                      strong Read Security:
                      |  
                      span#areaInfoReadSec
                    p
                      strong Post Security:
                      |  
                      span#areaInfoPostSec
                    p
                      strong Min Age:
                      |  
                      span#areaInfoMinAge
                    p
                      strong Max Age:
                      |  
                      span#areaInfoMaxAge
                    p
                      strong Messages:
                      |  
                      span#areaInfoMsgCount
                hr.border-secondary
                .row
                  .col-6
                    p
                      strong Read Perm Flags:
                      |  
                      span#areaInfoReadPermFlags
                    p
                      strong Post Perm Flags:
                      |  
                      span#areaInfoPostPermFlags
                  .col-6
                    p
                      strong Read Restrict Flags:
                      |  
                      span#areaInfoReadRestFlags
                    p
                      strong Post Restrict Flags:
                      |  
                      span#areaInfoPostRestFlags
                hr.border-secondary
                .row
                  .col-12
                    p#areaInfoDescription
                  .col-6
                    p
                      small Last From:
                      |  
                      span#areaInfoLastFrom
                  .col-6.text-end
                    p
                      small Last Message:
                      |  
                      span#areaInfoLastMessage

        //- Edit Area Modal
        #editAreaModal.modal.fade(tabindex='-1' aria-hidden='true')
          .modal-dialog.modal-dialog-centered.modal-lg
            .modal-content
              .modal-header.bg-dark.text-white
                h3.modal-title Edit Area
                button.btn.btn-lg.btn-close(data-bs-dismiss='modal')
              .modal-body
                form#editAreaForm(method='POST' class='form-registration')
                  input#ea_groupshortcode(type='hidden' name='groupshortcode')
                  +areaFormFields('ea_', 'edit')
                  .text-end.mt-3
                    input.btn.btn-lg.btn-warning(type='submit' value='Save Changes')

        //- Delete Area Modal
        #deleteAreaModal.modal.fade(tabindex='-1' aria-hidden='true')
          .modal-dialog.modal-dialog-centered
            .modal-content
              .modal-header.bg-danger.text-white
                h3.modal-title Delete Area
                button.btn.btn-lg.btn-close(data-bs-dismiss='modal')
              .modal-body.bg-dark.text-white
                .row
                  .col-1
                  .col-10
                    .alert.alert-danger
                      h5 ⚠ Warning
                      p
                        | This will permanently delete the area 
                        strong#deleteAreaName
                        | .
                    p This action cannot be undone.
                    br
                    label(for='da_delete_tables') Message &amp; Thread Tables:
                    select#da_delete_tables.form-control
                      option(value='false') Leave tables intact
                      option(value='true') Delete tables and all data
                    br
                    .alert.alert-warning#da_deleteTablesWarning(style='display:none')
                      | ⚠ This will permanently destroy all messages and threads in this area.
              .modal-footer.bg-dark
                form#deleteAreaForm(method='POST')
                  input(type='hidden' name='delete_tables' id='da_delete_tables_hidden' value='false')
                  button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cancel
                  |  
                  input(type='submit' value='Delete Area' class='btn btn-danger')

        //- Move Area Modal (shared partial)
        include ./_moveAreaModal

        //- New Area Modal (with group selector)
        #newAreaModal.modal.fade(tabindex='-1' aria-hidden='true')
          .modal-dialog.modal-dialog-centered.modal-lg
            .modal-content
              .modal-header.bg-dark.text-white
                h3.modal-title Add Message Area
                button.btn.btn-lg.btn-close(data-bs-dismiss='modal')
              .modal-body
                form#newAreaForm(method='POST' class='form-registration')
                  +areaFormFields('na_', 'new')
                  .text-end.mt-3
                    input.btn.btn-lg.btn-success(type='submit' value='Submit')

  script.
    document.addEventListener('DOMContentLoaded', function() {

      // Init DataTable
      var table = document.getElementById('areaTable');
      if (table) {
        $(table).DataTable({
          pageLength: 50,
          order: [[0, 'asc'], [1, 'asc']],
          pagingType: 'full_numbers',
          columnDefs: [
            { targets: 6, type: 'num' }
          ],
          drawCallback: function() {
            var $pag = $(this.api().table().container()).find('.dataTables_paginate');
            if ($pag.length === 0) return;

            var $prev  = $pag.find('.previous').detach();
            var $next  = $pag.find('.next').detach();
            var $nums  = $pag.find('span:first').children().detach();

            var $numRow = $('<div class="dt-page-numbers">').append($nums);
            var $navRow = $('<div class="dt-page-nav">').append($prev, $next);
            var $wrap   = $('<div class="dt-pagination-wrap">').append($numRow, $navRow);

            $pag.empty().append($wrap);
          }
        });
      }

      var areaInfoModal   = new bootstrap.Modal(document.getElementById('areaInfoModal'));
      var editAreaModal   = new bootstrap.Modal(document.getElementById('editAreaModal'));
      var deleteAreaModal = new bootstrap.Modal(document.getElementById('deleteAreaModal'));
      var moveAreaModal   = new bootstrap.Modal(document.getElementById('moveAreaModal'));
      var currentAreaShortcode = '';

      var allPerms  = !{JSON.stringify(availablePermissions)};
      var allRestrs = !{JSON.stringify(availableRestrictions)};
      // Full group list for the Move modal's target-group dropdown.
      // Rebuilt into the <select> on each Move click, minus the
      // current group, to avoid the cross-browser option.hidden
      // footgun. See _moveAreaModal.pug for the contract.
      var allGroupsForMove = !{JSON.stringify((grouplist || []).map(function(g) { return { shortcode: g.shortcode, name: g.name }; }))};

      function parseFlags(jsonstr) {
        try {
          var result = JSON.parse(jsonstr);
          return Array.isArray(result) ? result : [];
        } catch(e) { return []; }
      }

      function fmtFlags(jsonstr) {
        var arr = parseFlags(jsonstr);
        return arr.length > 0 ? arr.join(', ') : '—';
      }

      function renderAreaFlags(prefix, inputName, activeFlags, allFlags, badgeClass) {
        var badgeEl  = document.getElementById(prefix + '_badges');
        var inputEl  = document.getElementById(prefix + '_inputs');
        var selectEl = document.getElementById(prefix + '_select');
        var addBtn   = document.getElementById(prefix + '_add');

        badgeEl.innerHTML = '';
        activeFlags.forEach(function(flag) {
          var span = document.createElement('span');
          span.className = 'badge ' + badgeClass + ' me-1 mb-1';
          span.style.cursor = 'pointer';
          span.title = 'Click to remove';
          span.textContent = flag + ' ×';
          span.addEventListener('click', function() {
            var updated = activeFlags.filter(function(f) { return f !== flag; });
            renderAreaFlags(prefix, inputName, updated, allFlags, badgeClass);
          });
          badgeEl.appendChild(span);
        });

        inputEl.innerHTML = '';
        activeFlags.forEach(function(flag) {
          var inp = document.createElement('input');
          inp.type  = 'hidden';
          inp.name  = inputName;
          inp.value = flag;
          inputEl.appendChild(inp);
        });

        selectEl.innerHTML = '';
        var available = allFlags.filter(function(f) { return !activeFlags.includes(f); });
        if (available.length === 0) {
          var opt = document.createElement('option');
          opt.value = '';
          opt.textContent = '— none available —';
          opt.disabled = true;
          selectEl.appendChild(opt);
          selectEl.disabled = true;
          addBtn.disabled = true;
        } else {
          selectEl.disabled = false;
          addBtn.disabled = false;
          available.forEach(function(flag) {
            var opt = document.createElement('option');
            opt.value = flag;
            opt.textContent = flag;
            selectEl.appendChild(opt);
          });
        }
      }

      function wireAddBtn(prefix, inputName, allFlags, badgeClass) {
        document.getElementById(prefix + '_add').addEventListener('click', function() {
          var sel = document.getElementById(prefix + '_select');
          if (!sel.value) return;
          var current = Array.from(document.querySelectorAll('#' + prefix + '_inputs input')).map(function(i) { return i.value; });
          if (!current.includes(sel.value)) {
            current.push(sel.value);
            renderAreaFlags(prefix, inputName, current, allFlags, badgeClass);
          }
        });
      }

      wireAddBtn('ea_read_perm', 'read_perm_flags', allPerms, 'bg-success');
      wireAddBtn('ea_read_rest', 'read_rest_flags', allRestrs, 'bg-danger');
      wireAddBtn('ea_post_perm', 'post_perm_flags', allPerms, 'bg-success');
      wireAddBtn('ea_post_rest', 'post_rest_flags', allRestrs, 'bg-danger');
      wireAddBtn('na_read_perm', 'read_perm_flags', allPerms, 'bg-success');
      wireAddBtn('na_read_rest', 'read_rest_flags', allRestrs, 'bg-danger');
      wireAddBtn('na_post_perm', 'post_perm_flags', allPerms, 'bg-success');
      wireAddBtn('na_post_rest', 'post_rest_flags', allRestrs, 'bg-danger');

      // Initialize new area flags as empty
      renderAreaFlags('na_read_perm', 'read_perm_flags', [], allPerms, 'bg-success');
      renderAreaFlags('na_read_rest', 'read_rest_flags', [], allRestrs, 'bg-danger');
      renderAreaFlags('na_post_perm', 'post_perm_flags', [], allPerms, 'bg-success');
      renderAreaFlags('na_post_rest', 'post_rest_flags', [], allRestrs, 'bg-danger');

      // Row click — event delegation on tbody (survives DataTables redraws)
      var tableBody = document.querySelector('#areaTable tbody');
      if (tableBody) {
        tableBody.style.cursor = 'pointer';
        tableBody.addEventListener('click', function(e) {
          var row = e.target.closest('tr.area-row');
          if (!row) return;
          var d = row.dataset;
          currentAreaShortcode = d.bsShortcode;

          document.getElementById('areaInfoTitle').textContent       = d.bsName;
          document.getElementById('areaInfoShortcode').textContent   = d.bsShortcode;
          document.getElementById('areaInfoGroup').textContent       = d.bsGroupshortcode || '—';
          document.getElementById('areaInfoNetwork').textContent     = d.bsNetworkname  || '— Local —';
          document.getElementById('areaInfoAreatag').textContent     = d.bsNetworktag   || '—';
          document.getElementById('areaInfoActive').textContent      = d.bsActive === 'true' ? 'Active' : 'Inactive';
          document.getElementById('areaInfoThreadMode').textContent  = { standard: 'Standard (threaded)', no_threads: 'No Threads (flat)', subscribe_only: 'Subscribe Only' }[d.bsThreadmode] || 'Standard';
          document.getElementById('areaInfoPostAs').textContent      = { username: 'Username', realname: 'Real Name' }[d.bsPostas] || 'Username';
          document.getElementById('areaInfoReadSec').textContent     = d.bsReadsecurity;
          document.getElementById('areaInfoPostSec').textContent     = d.bsPostsecurity;
          document.getElementById('areaInfoMinAge').textContent      = d.bsMinage;
          document.getElementById('areaInfoMaxAge').textContent      = d.bsMaxage;
          document.getElementById('areaInfoMsgCount').textContent    = parseInt(d.bsMsgcount || 0).toLocaleString();
          document.getElementById('areaInfoReadPermFlags').textContent  = fmtFlags(d.bsReadpermflags);
          document.getElementById('areaInfoReadRestFlags').textContent  = fmtFlags(d.bsReadrestflags);
          document.getElementById('areaInfoPostPermFlags').textContent  = fmtFlags(d.bsPostpermflags);
          document.getElementById('areaInfoPostRestFlags').textContent  = fmtFlags(d.bsPostrestflags);
          document.getElementById('areaInfoDescription').textContent = d.bsDescription;
          document.getElementById('areaInfoLastFrom').textContent    = d.bsLastfrom || '—';
          document.getElementById('areaInfoLastMessage').textContent = d.bsLastmessage
            ? new Date(d.bsLastmessage).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
            : '—';

          areaInfoModal.show();
        });
      }

      // View
      document.getElementById('areaViewBtn').addEventListener('click', function() {
        if (currentAreaShortcode) window.location.href = '/admin/msgArea/' + currentAreaShortcode;
      });

      // Edit
      document.getElementById('areaEditBtn').addEventListener('click', function() {
        if (!currentAreaShortcode) return;
        var row = document.querySelector('tr[data-bs-shortcode="' + currentAreaShortcode + '"]');
        if (!row) return;
        var d = row.dataset;
        document.getElementById('editAreaForm').action     = '/admin/msgArea/' + currentAreaShortcode + '/update';
        document.getElementById('ea_groupshortcode').value = d.bsGroupshortcode || '';
        document.getElementById('ea_name').value           = d.bsName;
        document.getElementById('ea_description').value    = d.bsDescription;
        document.getElementById('ea_readsecurity').value   = d.bsReadsecurity;
        document.getElementById('ea_postsecurity').value   = d.bsPostsecurity;
        document.getElementById('ea_minage').value         = d.bsMinage;
        document.getElementById('ea_maxage').value         = d.bsMaxage;
        document.getElementById('ea_max_age_days').value   = d.bsMaxagedays || '';
        document.getElementById('ea_max_messages').value   = d.bsMaxmessages || '';
        document.getElementById('ea_active').value         = d.bsActive === 'true' ? 'true' : 'false';
        document.getElementById('ea_thread_mode').value    = d.bsThreadmode || 'standard';
        document.getElementById('ea_post_as').value        = d.bsPostas || 'username';
        document.getElementById('ea_newscan').value        = d.bsNewscandefault === 'true' ? 'true' : 'false';
        document.getElementById('ea_qwk_conf_number').value = d.bsQwkconfnumber || '';
        // Reset collision-check status when loading a row into the form
        var qwkStatus = document.getElementById('ea_qwk_conf_status');
        if (qwkStatus) { qwkStatus.style.display = 'none'; qwkStatus.textContent = ''; }

        renderAreaFlags('ea_read_perm', 'read_perm_flags', parseFlags(d.bsReadpermflags), allPerms, 'bg-success');
        renderAreaFlags('ea_read_rest', 'read_rest_flags', parseFlags(d.bsReadrestflags), allRestrs, 'bg-danger');
        renderAreaFlags('ea_post_perm', 'post_perm_flags', parseFlags(d.bsPostpermflags), allPerms, 'bg-success');
        renderAreaFlags('ea_post_rest', 'post_rest_flags', parseFlags(d.bsPostrestflags), allRestrs, 'bg-danger');

        areaInfoModal.hide();
        editAreaModal.show();
      });

      // Move
      document.getElementById('areaMoveBtn').addEventListener('click', function() {
        if (!currentAreaShortcode) return;
        var row = document.querySelector('tr[data-bs-shortcode="' + currentAreaShortcode + '"]');
        if (!row) return;
        var d = row.dataset;
        var currentGroup = d.bsGroupshortcode || '';

        // Populate the modal's read-only area + current group display
        document.getElementById('maArea').textContent         = d.bsName + ' (' + d.bsShortcode + ')';
        document.getElementById('maCurrentGroup').textContent = currentGroup || '(unknown)';

        // Rebuild the target-group dropdown from the authoritative
        // server-rendered list (allGroupsForMove), skipping the area's
        // current group. Clearing + re-populating is the portable
        // approach; option.hidden on <option> elements inside a
        // <select> has unreliable support across browsers (Safari in
        // particular), so we manipulate the DOM directly instead.
        var targetSelect = document.getElementById('ma_target_group');
        targetSelect.innerHTML = '';
        var placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = '— Select a target group —';
        targetSelect.appendChild(placeholder);
        for (var g of (allGroupsForMove || [])) {
          if (g.shortcode === currentGroup) continue;
          var opt = document.createElement('option');
          opt.value = g.shortcode;
          opt.textContent = g.name + ' (' + g.shortcode + ')';
          targetSelect.appendChild(opt);
        }
        targetSelect.value = '';

        // Reset the apply-defaults checkbox (unchecked per the design)
        document.getElementById('ma_apply_defaults').checked = false;

        // Wire the form action to the current area's move endpoint
        document.getElementById('moveAreaForm').action = '/admin/msgArea/' + currentAreaShortcode + '/move';

        areaInfoModal.hide();
        moveAreaModal.show();
      });

      // Delete
      document.getElementById('areaDeleteBtn').addEventListener('click', function() {
        if (!currentAreaShortcode) return;
        var row = document.querySelector('tr[data-bs-shortcode="' + currentAreaShortcode + '"]');
        if (!row) return;
        document.getElementById('deleteAreaName').textContent           = row.dataset.bsName;
        document.getElementById('deleteAreaForm').action                = '/admin/msgArea/' + currentAreaShortcode + '/delete';
        document.getElementById('da_delete_tables_hidden').value        = 'false';
        document.getElementById('da_delete_tables').value               = 'false';
        document.getElementById('da_deleteTablesWarning').style.display = 'none';
        areaInfoModal.hide();
        deleteAreaModal.show();
      });

      // Delete tables warning
      var daSelect  = document.getElementById('da_delete_tables');
      var daHidden  = document.getElementById('da_delete_tables_hidden');
      var daWarning = document.getElementById('da_deleteTablesWarning');
      if (daSelect) {
        daSelect.addEventListener('change', function() {
          daHidden.value = this.value;
          daWarning.style.display = this.value === 'true' ? 'block' : 'none';
        });
      }

      // New area — set form action from group select and fetch group defaults
      var newAreaForm = document.getElementById('newAreaForm');
      var groupSelect = document.getElementById('na_group');
      if (groupSelect && newAreaForm) {
        groupSelect.addEventListener('change', async function() {
          var sc = this.value;
          newAreaForm.action = sc ? '/admin/msgGroup/' + sc + '/newArea' : '';

          if (!sc) {
            // Reset to empty defaults
            document.getElementById('na_readsecurity').value = 50;
            document.getElementById('na_postsecurity').value = 60;
            renderAreaFlags('na_read_perm', 'read_perm_flags', [], allPerms, 'bg-success');
            renderAreaFlags('na_read_rest', 'read_rest_flags', [], allRestrs, 'bg-danger');
            renderAreaFlags('na_post_perm', 'post_perm_flags', [], allPerms, 'bg-success');
            renderAreaFlags('na_post_rest', 'post_rest_flags', [], allRestrs, 'bg-danger');
            return;
          }

          try {
            var resp = await fetch('/admin/msgGroup/' + sc + '/defaults');
            if (!resp.ok) return;
            var data = await resp.json();
            document.getElementById('na_readsecurity').value = data.read_security || 50;
            document.getElementById('na_postsecurity').value = data.post_security || 60;
            document.getElementById('na_post_as').value = data.post_as || 'username';
            document.getElementById('na_newscan').value = data.newscan_default ? 'true' : 'false';
            renderAreaFlags('na_read_perm', 'read_perm_flags', parseFlags(JSON.stringify(data.read_perm_flags)), allPerms, 'bg-success');
            renderAreaFlags('na_read_rest', 'read_rest_flags', parseFlags(JSON.stringify(data.read_rest_flags)), allRestrs, 'bg-danger');
            renderAreaFlags('na_post_perm', 'post_perm_flags', parseFlags(JSON.stringify(data.post_perm_flags)), allPerms, 'bg-success');
            renderAreaFlags('na_post_rest', 'post_rest_flags', parseFlags(JSON.stringify(data.post_rest_flags)), allRestrs, 'bg-danger');
          } catch(e) {
            console.error('Failed to fetch group defaults:', e);
          }
        });
      }

      // QWK conference number debounced AJAX collision check.
      // Called on input of #ea_qwk_conf_number -- queries the server for
      // whether that number is currently in use by another area or sits
      // inside the reserved 1-100 range, and shows inline feedback.
      // The UNIQUE constraint + model-side validation are still the
      // authoritative enforcement; this is purely UX polish.
      var qwkInput  = document.getElementById('ea_qwk_conf_number');
      var qwkStatus = document.getElementById('ea_qwk_conf_status');
      if (qwkInput && qwkStatus) {
        var qwkDebounce = null;
        qwkInput.addEventListener('input', function() {
          clearTimeout(qwkDebounce);
          qwkDebounce = setTimeout(function() {
            var v = parseInt(qwkInput.value, 10);
            if (isNaN(v)) {
              qwkStatus.style.display = 'none';
              qwkStatus.textContent = '';
              return;
            }
            if (v <= 100) {
              qwkStatus.style.display = '';
              qwkStatus.className = 'form-text text-danger';
              qwkStatus.textContent = 'Reserved: 1-100 are Canectic system conferences';
              return;
            }
            var excludeParam = currentAreaShortcode
              ? '&exclude=' + encodeURIComponent(currentAreaShortcode)
              : '';
            fetch('/admin/msgAreas/check-conf-number?n=' + v + excludeParam)
              .then(function(r) { return r.json(); })
              .then(function(d) {
                if (d && d.available) {
                  qwkStatus.style.display = '';
                  qwkStatus.className = 'form-text text-success';
                  qwkStatus.textContent = '\u2713 Available';
                } else if (d && d.conflictsWith) {
                  qwkStatus.style.display = '';
                  qwkStatus.className = 'form-text text-danger';
                  qwkStatus.textContent = 'In use by: ' + d.conflictsWith;
                }
              })
              .catch(function() {
                qwkStatus.style.display = 'none';
              });
          }, 300);
        });
      }

      // On every modal open, snap to the Main tab so the user isn't
      // left looking at whichever tab they were on last time. Bootstrap
      // otherwise preserves the nav-link.active state across open/close
      // cycles; this listener forces Main back into focus per open.
      function resetToMainTab(modalEl, prefix) {
        if (!modalEl) return;
        modalEl.addEventListener('show.bs.modal', function() {
          var trigger = modalEl.querySelector('.nav-link[data-bs-target="#' + prefix + 'tab_main"]');
          if (trigger && typeof bootstrap !== 'undefined' && bootstrap.Tab) {
            bootstrap.Tab.getOrCreateInstance(trigger).show();
          }
        });
      }
      resetToMainTab(document.getElementById('editAreaModal'), 'ea_');
      resetToMainTab(document.getElementById('newAreaModal'), 'na_');

    });
