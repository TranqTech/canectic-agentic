//- Shared field layout for the message area create/edit modals.
//-
//- Used from:
//-   src/views/admin/msgAreas/index.pug      — global areas table
//-   src/views/admin/msgGroups/view.pug      — per-group view
//-
//- Parameters:
//-   prefix  (string, required)  Element id prefix. Use 'ea_' for the edit
//-                               modal and 'na_' for the new-area modal so
//-                               the ids stay unique when both modals are
//-                               rendered into the same DOM.
//-   mode    (string, required)  'edit' or 'new'. Controls which fields
//-                               appear (shortcode, group selector, active
//-                               status, QWK conf number are mode-specific)
//-                               and how defaults are applied.
//-   opts    (object, optional)  Call-site overrides:
//-     hideGroupSelector (bool)  New-mode only. Hides the group dropdown
//-                               (Main tab) for callers that render the
//-                               modal inside a specific group context and
//-                               already scope the form action to that
//-                               group. `msgGroups/view.pug` uses this.
//-     defaults (object)         New-mode only. Seeds initial values for
//-                               read_security, post_security, min_age,
//-                               max_age, post_as, and newscan_default.
//-                               Omit a key to fall back to the hardcoded
//-                               safe default. The index view passes no
//-                               defaults; the group view passes the
//-                               parent msgGroup's settings.
//-
//- Field id preservation: every id emitted here (prefix + suffix) must
//- match the ids the population JS in both calling views uses. Changing
//- an id here without updating both callers' JS will silently break
//- form hydration. Suffixes currently required: name, description,
//- shortcode (new only), group (new only), active (edit only),
//- thread_mode, post_as, newscan, qwk_conf_number (edit only),
//- qwk_conf_status (edit only), readsecurity, postsecurity, minage,
//- maxage, network (new only), areatag (new only), and the four flag
//- widget suffix groups: {read_perm, read_rest, post_perm, post_rest}
//- each with _badges / _inputs / _select / _add.

mixin areaFormFields(prefix, mode, opts)
  - var options = opts || {}
  - var defaults = options.defaults || {}
  - var showGroupSelector = (mode === 'new') && !options.hideGroupSelector
  -
  - // Resolve initial values for new-mode fields. Edit mode relies on
  - // the calling view's JS to populate from row data after render, so
  - // these are only meaningful when mode === 'new'.
  - var initReadSec  = (defaults.read_security  !== undefined) ? defaults.read_security  : 50
  - var initPostSec  = (defaults.post_security  !== undefined) ? defaults.post_security  : 60
  - var initMinAge   = (defaults.min_age        !== undefined) ? defaults.min_age        : 13
  - var initMaxAge   = (defaults.max_age        !== undefined) ? defaults.max_age        : 255
  - var initPostAs   = defaults.post_as || 'username'
  - var initNewscan  = (defaults.newscan_default === true) ? 'true' : 'false'
  - var initMaxAgeDays  = (defaults.max_age_days  !== undefined && defaults.max_age_days  !== null) ? defaults.max_age_days  : ''
  - var initMaxMessages = (defaults.max_messages !== undefined && defaults.max_messages !== null) ? defaults.max_messages : ''

  //- ---- Tab nav ----
  ul.nav.nav-tabs.mb-3(role='tablist')
    li.nav-item(role='presentation')
      button.nav-link.active(type='button' role='tab' data-bs-toggle='tab' data-bs-target='#' + prefix + 'tab_main') Main
    li.nav-item(role='presentation')
      button.nav-link(type='button' role='tab' data-bs-toggle='tab' data-bs-target='#' + prefix + 'tab_access') Access
    li.nav-item(role='presentation')
      button.nav-link(type='button' role='tab' data-bs-toggle='tab' data-bs-target='#' + prefix + 'tab_network') Network
    li.nav-item(role='presentation')
      button.nav-link(type='button' role='tab' data-bs-toggle='tab' data-bs-target='#' + prefix + 'tab_retention') Retention

  .tab-content
    //- ================================================================
    //- MAIN tab — identity + behaviour (core settings)
    //- ================================================================
    .tab-pane.fade.show.active(id=prefix + 'tab_main' role='tabpanel')
      if showGroupSelector
        .mb-3
          label.form-label(for=prefix + 'group') Group
          select.form-select(id=prefix + 'group' name='groupshortcode' required)
            option(value='') — Select a group —
            if grouplist && grouplist.length > 0
              for group of grouplist
                option(value=group.shortcode)= group.name + ' (' + group.shortcode + ')'
      .row.mb-3
        if mode === 'new'
          .col-8
            label.form-label(for=prefix + 'name') Name
            input.form-control(type='text' id=prefix + 'name' name='name' required)
          .col-4
            label.form-label(for=prefix + 'shortcode') Short Code
            input.form-control(type='text' id=prefix + 'shortcode' name='shortcode' required)
        else
          .col-12
            label.form-label(for=prefix + 'name') Name
            input.form-control(type='text' id=prefix + 'name' name='name' required)
      .mb-3
        label.form-label(for=prefix + 'description') Description
        input.form-control(type='text' id=prefix + 'description' name='description' required)
      hr.border-secondary.my-3
      .row.mb-3
        if mode === 'edit'
          .col-6
            label.form-label(for=prefix + 'active') Status
            select.form-select(id=prefix + 'active' name='active')
              option(value='true') Active
              option(value='false') Inactive
          .col-6
            label.form-label(for=prefix + 'thread_mode') Thread Mode
            select.form-select(id=prefix + 'thread_mode' name='thread_mode')
              option(value='standard') Standard (threaded)
              option(value='no_threads') No Threads (flat)
              option(value='subscribe_only') Subscribe Only
        else
          .col-12
            label.form-label(for=prefix + 'thread_mode') Thread Mode
            select.form-select(id=prefix + 'thread_mode' name='thread_mode')
              option(value='standard' selected) Standard (threaded)
              option(value='no_threads') No Threads (flat)
              option(value='subscribe_only') Subscribe Only
      .row.mb-3
        .col-6
          label.form-label(for=prefix + 'post_as') Post As
          select.form-select(id=prefix + 'post_as' name='post_as')
            if mode === 'new'
              option(value='username' selected=(initPostAs === 'username')) Username
              option(value='realname' selected=(initPostAs === 'realname')) Real Name
            else
              option(value='username') Username
              option(value='realname') Real Name
        .col-6
          label.form-label(for=prefix + 'newscan') Newscan Default
          select.form-select(id=prefix + 'newscan' name='newscan_default')
            if mode === 'new'
              option(value='false' selected=(initNewscan === 'false')) No
              option(value='true' selected=(initNewscan === 'true')) Yes
            else
              option(value='false') No
              option(value='true') Yes
      if mode === 'edit'
        .mb-3
          label.form-label(for=prefix + 'qwk_conf_number') QWK Conference #
          input.form-control(type='number' id=prefix + 'qwk_conf_number' name='qwk_conf_number' min=101)
          small.form-text.text-muted Must be ≥ 101. Numbers 1-100 are reserved for Canectic system conferences (announcements, wall, bulletins).
          small.form-text(id=prefix + 'qwk_conf_status' style='display:none;')

    //- ================================================================
    //- ACCESS tab — security levels, age limits, permission/restriction flags
    //- ================================================================
    .tab-pane.fade(id=prefix + 'tab_access' role='tabpanel')
      .row.mb-3
        .col-6
          label.form-label(for=prefix + 'readsecurity') Read Security
          if mode === 'new'
            input.form-control(type='number' id=prefix + 'readsecurity' name='readsecurity' min=1 max=255 value=initReadSec required)
          else
            input.form-control(type='number' id=prefix + 'readsecurity' name='readsecurity' min=1 max=255 required)
        .col-6
          label.form-label(for=prefix + 'postsecurity') Post Security
          if mode === 'new'
            input.form-control(type='number' id=prefix + 'postsecurity' name='postsecurity' min=1 max=255 value=initPostSec required)
          else
            input.form-control(type='number' id=prefix + 'postsecurity' name='postsecurity' min=1 max=255 required)
      .row.mb-3
        .col-6
          label.form-label(for=prefix + 'minage') Min Age
          if mode === 'new'
            input.form-control(type='number' id=prefix + 'minage' name='minage' min=13 max=255 value=initMinAge)
          else
            input.form-control(type='number' id=prefix + 'minage' name='minage' min=13 max=255)
        .col-6
          label.form-label(for=prefix + 'maxage') Max Age
          if mode === 'new'
            input.form-control(type='number' id=prefix + 'maxage' name='maxage' min=13 max=255 value=initMaxAge)
          else
            input.form-control(type='number' id=prefix + 'maxage' name='maxage' min=13 max=255)
      hr.border-secondary.my-3
      .row
        .col-6
          div(id=prefix + 'read_perm_inputs')
          div(id=prefix + 'read_rest_inputs')
          label.form-label Read Permission Flags
          .border.rounded.p-2.mb-2.bg-light(id=prefix + 'read_perm_badges' style='min-height:2.2rem')
          .input-group.mb-3
            select.form-select(id=prefix + 'read_perm_select')
            button.btn.btn-success(type='button' id=prefix + 'read_perm_add') Add
          label.form-label Read Restriction Flags
          .border.rounded.p-2.mb-2.bg-light(id=prefix + 'read_rest_badges' style='min-height:2.2rem')
          .input-group
            select.form-select(id=prefix + 'read_rest_select')
            button.btn.btn-danger(type='button' id=prefix + 'read_rest_add') Add
        .col-6
          div(id=prefix + 'post_perm_inputs')
          div(id=prefix + 'post_rest_inputs')
          label.form-label Post Permission Flags
          .border.rounded.p-2.mb-2.bg-light(id=prefix + 'post_perm_badges' style='min-height:2.2rem')
          .input-group.mb-3
            select.form-select(id=prefix + 'post_perm_select')
            button.btn.btn-success(type='button' id=prefix + 'post_perm_add') Add
          label.form-label Post Restriction Flags
          .border.rounded.p-2.mb-2.bg-light(id=prefix + 'post_rest_badges' style='min-height:2.2rem')
          .input-group
            select.form-select(id=prefix + 'post_rest_select')
            button.btn.btn-danger(type='button' id=prefix + 'post_rest_add') Add

    //- ================================================================
    //- NETWORK tab — network mapping (create only; read-only on edit)
    //- ================================================================
    .tab-pane.fade(id=prefix + 'tab_network' role='tabpanel')
      if mode === 'new'
        .mb-3
          label.form-label(for=prefix + 'network') Network
          select.form-select(id=prefix + 'network' name='network_id')
            option(value='') — Local area, no network —
            if networklist && networklist.length > 0
              for net of networklist
                option(value=net.id)= net.name + ' (' + net.domain + ')'
        .mb-3
          label.form-label(for=prefix + 'areatag') Area Tag (if networked)
          input.form-control(type='text' id=prefix + 'areatag' name='areatag' placeholder='FIDONET.GENERAL')
        .alert.alert-info.small.mb-0
          | Select a network and provide the area tag if this area should echo over a message network. Leave both blank for a local-only area.
      else
        p.text-muted
          | Network mapping for an existing area is managed via the
          a(href='/admin/networks') Network Management
          |  page. Add or remove network subscriptions, change the area tag, or adjust peer distribution there.
        p.text-muted.small.mb-0
          em
            | Inline network editing for an area may be added in a future release.

    //- ================================================================
    //- RETENTION tab -- optional pruning limits
    //- ================================================================
    .tab-pane.fade(id=prefix + 'tab_retention' role='tabpanel')
      .alert.alert-secondary.small
        strong Both limits are off by default.
        |  Leave blank for no pruning, which is what every area does until you change it here.
        |  Pruning runs once a day and never removes a message that an enabled network peer has
        |  not received yet.
      .row.mb-3
        .col-6
          label.form-label(for=prefix + 'max_age_days') Max Age (days)
            |
            span.ms-1(data-bs-toggle='tooltip' title='Remove messages older than this many days, by the message date. Blank or 0 = no limit.') &#9432;
          if mode === 'new'
            input.form-control(type='number' id=prefix + 'max_age_days' name='max_age_days' min=0 value=initMaxAgeDays placeholder='no limit')
          else
            input.form-control(type='number' id=prefix + 'max_age_days' name='max_age_days' min=0 placeholder='no limit')
          small.form-text.text-muted Uses the message's own date, not when it arrived.
        .col-6
          label.form-label(for=prefix + 'max_messages') Max Messages
            |
            span.ms-1(data-bs-toggle='tooltip' title='Keep only the N newest messages. Blank or 0 = no limit.') &#9432;
          if mode === 'new'
            input.form-control(type='number' id=prefix + 'max_messages' name='max_messages' min=0 value=initMaxMessages placeholder='no limit')
          else
            input.form-control(type='number' id=prefix + 'max_messages' name='max_messages' min=0 placeholder='no limit')
          small.form-text.text-muted Oldest messages roll off first.
      .alert.alert-warning.small.mb-0
        strong Setting a limit on an imported area prunes immediately.
        |  A JAM or SMB import keeps its original message dates, so a base imported today can
        |  already be years old. Preview from the area list before saving a limit on imported mail.
