extends ../../layouts/admin

include ../msgAreas/_areaFormFields

block content
  .container-fluid.main-wrapper
    if !currentuser
      - loginMode = 'guard'
      - loginRedirect = currentPath
      include ../../partials/users/login.pug
    else if !sufficientAccess
      include ../../partials/status/unauthorized.pug
    else
      if !ismobile
        .row
          .col-12
            br
            br
        .row
          .col-1
          .col-8
            if !msgGroup
              .card
                .card-header.bg-darkblue.text-white
                  .row
                    .col-8
                      h2= title
                    .col-4
                      .text-end
                        a.button.btn.btn-sm.btn-info(href='/admin/msgGroups')
                          | Exit
                .card-body
                  br
                  h3 Data Not Found!
                  br
            else
              .card
                .card-header.bg-darkblue.text-white
                  .row
                    .col-8
                      h2= title
                    .col-4
                      .text-end
                        a.button.btn.btn-sm.btn-info(href='/admin/msgGroups')
                          | Exit
                .card-body
                  include ../../partials/flash
                  h4= msgGroup.description
                  .row
                    .col-6
                      h5
                        | Shortcode:  
                        = msgGroup.shortcode
                      h5
                        | Read Security: 
                        = msgGroup.read_security || '—'
                    .col-6
                      h5
                        | Post Security:
                        = msgGroup.post_security || '—'
                      h5
                        | Post As:
                        = msgGroup.post_as === 'realname' ? 'Real Name' : 'Username'
                      h5
                        | Thread Mode:
                        = threadModeLabel(msgGroup.thread_mode)
                      h5
                        | Character Set:
                        = charsetModeLabel(msgGroup.charset)
                      h5
                        | Newscan Default:
                        = msgGroup.newscan_default ? 'Yes' : 'No'
              .card
                .card-header.bg-darkblue.text-white
                  h4 Areas
                .card-body
                  .row
                    .col-1
                    .col-10
                      if arealist && arealist.length > 0
                        br
                        table#msgAreas.table.table-hover
                          thead
                            tr
                              th(style='width:30px')
                              th(scope='col') Name
                              th(scope='col') Shortcode
                              th(scope='col') Description
                              th(scope='col') Network / Tag
                              th(scope='col') Msg Count
                              th(scope='col') Latest
                          tbody#areaBody
                            for area of arealist
                              tr(
                                data-bs-id=area.id
                                data-bs-shortcode=area.shortcode
                                data-bs-name=area.name
                                data-bs-description=area.description
                                data-bs-networkname=(area.network_name || '')
                                data-bs-networktag=(area.areatag || '')
                                data-bs-readsecurity=area.read_security
                                data-bs-postsecurity=area.post_security
                                data-bs-minage=area.min_age || 13
                                data-bs-maxage=area.max_age || 255
                                data-bs-active=(area.active ? 'true' : 'false')
                                data-bs-threadmode=area.thread_mode || 'standard'
                                data-bs-postas=area.post_as || 'username'
                                data-bs-newscandefault=(area.newscan_default ? 'true' : 'false')
                                data-bs-qwkconfnumber=area.qwk_conf_number || ''
                                data-bs-msgcount=area.msg_count || 0
                                data-bs-lastfrom=area.last_from || ''
                                data-bs-lastmessage=area.last_message || ''
                                data-bs-readpermflags=JSON.stringify(area.read_perm_flags || [])
                                data-bs-readrestflags=JSON.stringify(area.read_rest_flags || [])
                                data-bs-postpermflags=JSON.stringify(area.post_perm_flags || [])
                                data-bs-postrestflags=JSON.stringify(area.post_rest_flags || [])
                                draggable='true'
                              )
                                td.grip(style='cursor:grab')
                                  i.bi.bi-grip-vertical
                                td= area.name
                                td= area.shortcode
                                td= area.description
                                td
                                  if area.network_name
                                    span.badge.bg-info.text-dark= area.network_name
                                    if area.areatag
                                      |  
                                      small.text-muted= area.areatag
                                  else
                                    span.badge.bg-secondary Local
                                td.text-end
                                  - var mcount = area.msg_count.toLocaleString()
                                  = mcount
                                td
                                  if area.last_message
                                    .text-end
                                      - var e1date = Date.parse(area.last_message)
                                      - var edate = DateTime.fromMillis(e1date)
                                      = edate.toFormat('MMMM dd, yyyy')
                                  else
                                    center
                                      | N/A
                        button.btn.btn-sm.btn-outline-primary.mt-2#saveAreaOrder
                          i.bi.bi-sort-numeric-down.me-1
                          | Save Order
                      else
                        center
                          h4 No Areas Found

          .col-2
            .row
              .col-12
                .card.bg-light
                  .card-header.bg-darkblue.text-white
                    .h6 Quick Actions
                  .card-body.bg-dark
                    .d-grid.gap-1
                      a.button.btn.btn-danger(href='/admin/msgGroups')
                        | Exit
                      if msgGroup
                        br
                        h6.text-white.mb-1 Group:
                        button.btn.btn-warning.w-100(data-bs-toggle='modal' data-bs-target='#editGroupModal')
                          | Edit Group
                        button.btn.btn-danger.w-100(data-bs-toggle='modal' data-bs-target='#deleteGroupModal')
                          | Delete Group
                        button.btn.btn-info.w-100.mt-1(data-bs-toggle='modal' data-bs-target='#pushDefaultsModal')
                          | Push Defaults to Areas
                        br
                        h6.text-white.mb-1 Areas:
                        button.btn.btn-success.w-100(data-bs-toggle='modal' data-bs-target='#newAreaModal')
                          | Add Area

        if msgGroup

          // Area Info Modal (dynamically populated on row click)
          #areaInfoModal.modal.fade(tabindex='-1' aria-labelledby='' aria-hidden='true')
            .modal-dialog.modal-dialog-centered.modal-lg
              .modal-content
                .modal-header.bg-dark.text-white
                  h3.modal-title#areaInfoTitle
                  .row.w-100
                    .col-12.text-end
                      button.btn.btn-sm.btn-info#areaViewBtn View
                      |  
                      button.btn.btn-sm.btn-warning#areaEditBtn Edit
                      |  
                      button.btn.btn-sm.btn-secondary#areaMoveBtn Move
                      |  
                      button.btn.btn-sm.btn-danger#areaDeleteBtn Delete
                      |  
                      button.btn.btn-sm.btn-close(data-bs-dismiss='modal')
                .modal-body.bg-dark.text-white
                  .row
                    .col-6
                      p
                        strong Shortcode:
                        |  
                        span#areaInfoShortcode
                      p
                        strong Network:
                        |  
                        span#areaInfoNetwork
                      p
                        strong Area Tag:
                        |  
                        span#areaInfoAreatag
                      p
                        strong Status:
                        |  
                        span#areaInfoActive
                      p
                        strong Thread Mode:
                        |  
                        span#areaInfoThreadMode
                      p
                        strong Post As:
                        |  
                        span#areaInfoPostAs
                    .col-6
                      p
                        strong Read Security:
                        |  
                        span#areaInfoReadSec
                      p
                        strong Post Security:
                        |  
                        span#areaInfoPostSec
                      p
                        strong Min Age:
                        |  
                        span#areaInfoMinAge
                      p
                        strong Max Age:
                        |  
                        span#areaInfoMaxAge
                      p
                        strong Messages:
                        |  
                        span#areaInfoMsgCount
                  hr.border-secondary
                  .row
                    .col-6
                      p
                        strong Read Perm Flags:
                        |  
                        span#areaInfoReadPermFlags
                      p
                        strong Post Perm Flags:
                        |  
                        span#areaInfoPostPermFlags
                    .col-6
                      p
                        strong Read Restrict Flags:
                        |  
                        span#areaInfoReadRestFlags
                      p
                        strong Post Restrict Flags:
                        |  
                        span#areaInfoPostRestFlags
                  hr.border-secondary
                  .row
                    .col-12
                      p#areaInfoDescription
                    .col-6
                      p
                        small Last From:
                        |  
                        span#areaInfoLastFrom
                    .col-6.text-end
                      p
                        small Last Message:
                        |  
                        span#areaInfoLastMessage

          // Edit Area Modal (dynamically populated)
          #editAreaModal.modal.fade(tabindex='-1' aria-labelledby='' aria-hidden='true')
            .modal-dialog.modal-dialog-centered.modal-lg
              .modal-content
                .modal-header.bg-dark.text-white
                  h3.modal-title Edit Area
                  button.btn.btn-lg.btn-close(data-bs-dismiss='modal')
                .modal-body
                  form#editAreaForm(method='POST' class='form-registration')
                    input(type='hidden' name='groupshortcode' value=msgGroup.shortcode)
                    +areaFormFields('ea_', 'edit')
                    .text-end.mt-3
                      input.btn.btn-lg.btn-warning(type='submit' value='Save Changes')

          // Delete Area Modal (dynamically populated)
          #deleteAreaModal.modal.fade(tabindex='-1' aria-labelledby='' aria-hidden='true')
            .modal-dialog.modal-dialog-centered
              .modal-content
                .modal-header.bg-danger.text-white
                  h3.modal-title Delete Area
                  button.btn.btn-lg.btn-close(data-bs-dismiss='modal')
                .modal-body.bg-dark.text-white
                  .row
                    .col-1
                    .col-10
                      .alert.alert-danger
                        h5 ⚠ Warning
                        p
                          | This will permanently delete the area 
                          strong#deleteAreaName
                          | .
                      p This action cannot be undone.
                      br
                      label(for='da_delete_tables') Message &amp; Thread Tables:
                      select#da_delete_tables.form-control
                        option(value='false') Leave tables intact
                        option(value='true') Delete tables and all data
                      br
                      .alert.alert-warning#da_deleteTablesWarning(style='display:none')
                        | ⚠ This will permanently destroy all messages and threads in this area.
                .modal-footer.bg-dark
                  form#deleteAreaForm(method='POST')
                    input(type='hidden' name='delete_tables' id='da_delete_tables_hidden' value='false')
                    button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cancel
                    |  
                    input(
                      type='submit'
                      value='Delete Area'
                      class='btn btn-danger'
                    )

          //- Move Area Modal (shared partial)
          include ../msgAreas/_moveAreaModal

          // New Area Modal
          #newAreaModal.modal.fade(tabindex='-1' aria-labelledby='' aria-hidden='true')
            .modal-dialog.modal-dialog-centered.modal-lg
              .modal-content
                .modal-header.bg-dark.text-white
                  h3.modal-title Add Message Area
                  button.btn.btn-lg.btn-close(data-bs-dismiss='modal')
                .modal-body
                  form(action=`/admin/msgGroup/${msgGroup.shortcode}/newArea` method='POST' class='form-registration')
                    //- Hide the group selector (we're already scoped to msgGroup
                    //- via the form action) and pre-fill new-area defaults from
                    //- the current group so sysops don't have to re-specify the
                    //- security/flags/post-as rules that the group already
                    //- represents. Flag widgets are populated by the flag
                    //- renderAreaFlags() JS further down with group defaults.
                    +areaFormFields('na_', 'new', {
                      hideGroupSelector: true,
                      defaults: {
                        read_security: msgGroup.read_security,
                        post_security: msgGroup.post_security,
                        post_as: msgGroup.post_as,
                        newscan_default: msgGroup.newscan_default,
                        max_age_days: msgGroup.max_age_days,
                        max_messages: msgGroup.max_messages
                      }
                    })
                    .text-end.mt-3
                      input.btn.btn-lg.btn-success(type='submit' value='Submit')

          // Edit Group Modal
          #editGroupModal.modal.fade(tabindex='-1' aria-labelledby='' aria-hidden='true')
            .modal-dialog.modal-dialog-centered.modal-lg
              .modal-content
                .modal-header.bg-dark.text-white
                  h3.modal-title Edit Group
                  button.btn.btn-lg.btn-close(data-bs-dismiss='modal')
                .modal-body
                  form(action=`/admin/msgGroup/${msgGroup.shortcode}/update` method='POST' class='form-registration')

                    //- ---- Tab nav ----
                    ul.nav.nav-tabs.mb-3(role='tablist')
                      li.nav-item(role='presentation')
                        button.nav-link.active(type='button' role='tab' data-bs-toggle='tab' data-bs-target='#eg_tab_main') Main
                      li.nav-item(role='presentation')
                        button.nav-link(type='button' role='tab' data-bs-toggle='tab' data-bs-target='#eg_tab_access') Access
                      li.nav-item(role='presentation')
                        button.nav-link(type='button' role='tab' data-bs-toggle='tab' data-bs-target='#eg_tab_network') Network

                    .tab-content
                      //- ========================================================
                      //- MAIN — identity and posting behaviour
                      //- ========================================================
                      .tab-pane.fade.show.active#eg_tab_main(role='tabpanel')
                        .mb-3
                          label.form-label(for='edit_name') Name:
                          input.form-control(type='text' id='edit_name' name='name' tabindex='1' value=msgGroup.name required)
                        .mb-3
                          label.form-label(for='edit_description') Description:
                          input.form-control(type='text' id='edit_description' name='description' tabindex='2' value=msgGroup.description required)
                        .row
                          .col-4
                            label.form-label(for='edit_post_as') Post As:
                            select#edit_post_as.form-select(name='post_as' tabindex='5')
                              option(value='username' selected=(msgGroup.post_as !== 'realname')) Username
                              option(value='realname' selected=(msgGroup.post_as === 'realname')) Real Name
                          .col-4
                            label.form-label(for='edit_charset') Character Set:
                            select#edit_charset.form-select(name='charset')
                              option(value='auto' selected=(msgGroup.charset !== 'cp437' && msgGroup.charset !== 'utf8')) Automatic
                              option(value='cp437' selected=(msgGroup.charset === 'cp437')) Always CP437
                              option(value='utf8' selected=(msgGroup.charset === 'utf8')) Always UTF-8
                          .col-4
                            label.form-label(for='edit_thread_mode') Thread Mode:
                            select#edit_thread_mode.form-select(name='thread_mode')
                              option(value='standard' selected=(msgGroup.thread_mode !== 'no_threads' && msgGroup.thread_mode !== 'subscribe_only')) Standard (threaded)
                              option(value='no_threads' selected=(msgGroup.thread_mode === 'no_threads')) No Threads (flat)
                              option(value='subscribe_only' selected=(msgGroup.thread_mode === 'subscribe_only')) Subscribe Only
                          .col-4
                            label.form-label(for='edit_newscan') Newscan Default:
                            select#edit_newscan.form-select(name='newscan_default')
                              option(value='false' selected=(!msgGroup.newscan_default)) No
                              option(value='true' selected=(!!msgGroup.newscan_default)) Yes
                          .col-4
                            label.form-label(for='edit_max_age_days') Max Age (days):
                            input#edit_max_age_days.form-control(type='number' name='max_age_days' min=0 placeholder='no limit' value=(msgGroup.max_age_days === null || msgGroup.max_age_days === undefined) ? '' : msgGroup.max_age_days)
                          .col-4
                            label.form-label(for='edit_max_messages') Max Messages:
                            input#edit_max_messages.form-control(type='number' name='max_messages' min=0 placeholder='no limit' value=(msgGroup.max_messages === null || msgGroup.max_messages === undefined) ? '' : msgGroup.max_messages)
                          .col-4
                            label.form-label(for='edit_active') Status:
                            select#edit_active.form-select(name='active')
                              option(value='true' selected=(msgGroup.active !== false)) Active
                              option(value='false' selected=(msgGroup.active === false)) Inactive

                      //- ========================================================
                      //- ACCESS — security levels and flag defaults for new areas
                      //- ========================================================
                      .tab-pane.fade#eg_tab_access(role='tabpanel')
                        .row.mb-3
                          .col-6
                            label.form-label(for='edit_readsecurity') Read Security:
                            input.form-control(type='number' id='edit_readsecurity' name='readsecurity' min=0 max=255 tabindex='3' value=msgGroup.read_security || 0)
                          .col-6
                            label.form-label(for='edit_postsecurity') Post Security:
                            input.form-control(type='number' id='edit_postsecurity' name='postsecurity' min=0 max=255 tabindex='4' value=msgGroup.post_security || 0)
                        .row
                          .col-6
                            #eg_read_perm_inputs
                            #eg_read_rest_inputs
                            label Read Perm Flags (default for areas):
                            .border.rounded.p-2.mb-2.bg-light#eg_read_perm_badges(style='min-height:2.2rem')
                            .input-group.mb-2
                              select#eg_read_perm_select.form-control
                              button.btn.btn-sm.btn-success#eg_read_perm_add(type='button') Add
                            label Read Restrict Flags:
                            .border.rounded.p-2.mb-2.bg-light#eg_read_rest_badges(style='min-height:2.2rem')
                            .input-group
                              select#eg_read_rest_select.form-control
                              button.btn.btn-sm.btn-danger#eg_read_rest_add(type='button') Add
                          .col-6
                            #eg_post_perm_inputs
                            #eg_post_rest_inputs
                            label Post Perm Flags (default for areas):
                            .border.rounded.p-2.mb-2.bg-light#eg_post_perm_badges(style='min-height:2.2rem')
                            .input-group.mb-2
                              select#eg_post_perm_select.form-control
                              button.btn.btn-sm.btn-success#eg_post_perm_add(type='button') Add
                            label Post Restrict Flags:
                            .border.rounded.p-2.mb-2.bg-light#eg_post_rest_badges(style='min-height:2.2rem')
                            .input-group
                              select#eg_post_rest_select.form-control
                              button.btn.btn-sm.btn-danger#eg_post_rest_add(type='button') Add

                      //- ========================================================
                      //- NETWORK — QWK conference numbering
                      //- ========================================================
                      .tab-pane.fade#eg_tab_network(role='tabpanel')
                        .mb-3
                          label.form-label(for='edit_qwk_conf_start') QWK Conference Start:
                          input.form-control(type='number' id='edit_qwk_conf_start' name='qwk_conf_start' min=101 value=msgGroup.qwk_conf_start || '')
                          .small.mt-1#edit_qwk_conf_start_status

                    .text-end.mt-3
                      input.btn.btn-lg.btn-warning(type='submit' value='Save Changes' tabindex='6')

          // Delete Group Modal
          #deleteGroupModal.modal.fade(tabindex='-1' aria-labelledby='' aria-hidden='true')
            .modal-dialog.modal-dialog-centered
              .modal-content
                .modal-header.bg-danger.text-white
                  h3.modal-title Delete Group
                  button.btn.btn-lg.btn-close(data-bs-dismiss='modal')
                .modal-body.bg-dark.text-white
                  .row
                    .col-1
                    .col-10
                      .alert.alert-danger
                        h5 ⚠ Warning
                        p
                          | This will permanently delete the group 
                          strong= msgGroup.name
                          |  and all of its message areas.
                      p This action cannot be undone. All areas belonging to this group will be removed.
                      br
                      label Message &amp; Thread Tables:
                      select#delete_tables.form-control
                        option(value='false') Leave tables intact
                        option(value='true') Delete tables and all data
                      br
                      .alert.alert-warning(id='deleteTablesWarning' style='display:none')
                        | ⚠ Selecting this option will permanently destroy all messages and threads in every area of this group.
                .modal-footer.bg-dark
                  form(action=`/admin/msgGroup/${msgGroup.shortcode}/delete` method='POST')
                    input(type='hidden' name='delete_tables' id='delete_tables_hidden' value='false')
                    button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cancel
                    |  
                    input(
                      type='submit'
                      value='Delete Group'
                      class='btn btn-danger'
                    )

          // Push Defaults Modal
          #pushDefaultsModal.modal.fade(tabindex='-1' aria-hidden='true')
            .modal-dialog.modal-dialog-centered
              .modal-content
                .modal-header.bg-info.text-white
                  h5.modal-title Push Group Defaults to Areas
                  button.btn-close(type='button' data-bs-dismiss='modal')
                .modal-body
                  p Push this group's default settings to all member areas. Select which settings to push:
                  form#pushDefaultsForm(action='/admin/msgGroup/' + msgGroup.shortcode + '/pushDefaults' method='POST')
                    .form-check.mb-2
                      input.form-check-input#push_security(type='checkbox' name='fields' value='security' checked)
                      label.form-check-label(for='push_security') Security Levels (Read: #{msgGroup.read_security}, Post: #{msgGroup.post_security})
                    .form-check.mb-2
                      input.form-check-input#push_flags(type='checkbox' name='fields' value='flags' checked)
                      label.form-check-label(for='push_flags') Permission & Restriction Flags
                    .form-check.mb-2
                      input.form-check-input#push_post_as(type='checkbox' name='fields' value='post_as' checked)
                      label.form-check-label(for='push_post_as') Post As (#{msgGroup.post_as || 'username'})
                    .form-check.mb-2
                      input.form-check-input#push_charset(type='checkbox' name='fields' value='charset')
                      label.form-check-label(for='push_charset') Outbound Character Set (#{charsetModeLabel(msgGroup.charset)})
                      .form-text.text-muted Unticked by default, since this replaces any per-area choice.
                    .form-check.mb-2
                      input.form-check-input#push_thread_mode(type='checkbox' name='fields' value='thread_mode')
                      label.form-check-label(for='push_thread_mode') Thread Mode (#{threadModeLabel(msgGroup.thread_mode)})
                      .form-text.text-muted Unticked by default, since this replaces any per-area choice.
                    .form-check.mb-2
                      input.form-check-input#push_newscan(type='checkbox' name='fields' value='newscan_default' checked)
                      label.form-check-label(for='push_newscan') Newscan Default (#{msgGroup.newscan_default ? 'Yes' : 'No'})
                    .form-check.mb-2
                      input.form-check-input#push_retention(type='checkbox' name='fields' value='retention')
                      label.form-check-label(for='push_retention')
                        | Retention (Max Age: #{msgGroup.max_age_days || 'none'}, Max Messages: #{msgGroup.max_messages || 'none'})
                      if !msgGroup.max_age_days && !msgGroup.max_messages
                        .form-text.text-warning
                          i.bi.bi-exclamation-triangle.me-1
                          | This group has no limits set, so pushing retention turns pruning OFF on every area in the group.
                      else
                        .form-text.text-muted Unticked by default, since this replaces any per-area limits.
                    .alert.alert-warning.mt-3
                      i.bi.bi-exclamation-triangle.me-1
                      | This will overwrite the selected settings on all areas in this group.
                .modal-footer
                  button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cancel
                  button.btn.btn-info(type='submit' form='pushDefaultsForm')
                    i.bi.bi-arrow-down-circle.me-1
                    | Push to Areas

    script.
      document.addEventListener('DOMContentLoaded', function() {

        // --- Drag-to-reorder areas ---
        var areaBody = document.getElementById('areaBody');
        if (areaBody) {
          var dragRow = null;
          areaBody.addEventListener('dragstart', function(e) {
            dragRow = e.target.closest('tr');
            if (dragRow) e.dataTransfer.effectAllowed = 'move';
          });
          areaBody.addEventListener('dragover', function(e) {
            e.preventDefault();
            var target = e.target.closest('tr');
            if (target && target !== dragRow) {
              var rect = target.getBoundingClientRect();
              if (e.clientY < rect.top + rect.height / 2) {
                areaBody.insertBefore(dragRow, target);
              } else {
                areaBody.insertBefore(dragRow, target.nextSibling);
              }
            }
          });
          areaBody.querySelectorAll('.grip').forEach(function(grip) {
            grip.addEventListener('click', function(e) { e.stopPropagation(); });
          });
        }
        var saveAreaBtn = document.getElementById('saveAreaOrder');
        if (saveAreaBtn) {
          saveAreaBtn.addEventListener('click', function() {
            var rows = document.querySelectorAll('#areaBody tr');
            var ids = [];
            rows.forEach(function(r) { ids.push(r.getAttribute('data-bs-id')); });
            fetch('/admin/msgAreas/reorder', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ ids: ids })
            }).then(function() { location.reload(); });
          });
        }

        const areaInfoModal   = new bootstrap.Modal(document.getElementById('areaInfoModal'));
        const editAreaModal   = new bootstrap.Modal(document.getElementById('editAreaModal'));
        const deleteAreaModal = new bootstrap.Modal(document.getElementById('deleteAreaModal'));
        const moveAreaModal   = new bootstrap.Modal(document.getElementById('moveAreaModal'));

        var currentAreaShortcode = '';

        const allPerms  = !{JSON.stringify(availablePermissions)};
        const allRestrs = !{JSON.stringify(availableRestrictions)};
        // Full group list for the Move modal's target-group dropdown.
        // Rebuilt into the <select> on each Move click, minus the
        // current group, to avoid the cross-browser option.hidden
        // footgun. See _moveAreaModal.pug for the contract.
        const allGroupsForMove = !{JSON.stringify((grouplist || []).map(function(g) { return { shortcode: g.shortcode, name: g.name }; }))};

        function parseFlags(jsonstr) {
          try {
            var result = JSON.parse(jsonstr);
            return Array.isArray(result) ? result : [];
          } catch(e) { return []; }
        }

        function fmtFlags(jsonstr) {
          var arr = parseFlags(jsonstr);
          return arr.length > 0 ? arr.join(', ') : '—';
        }

        // Renders badges + hidden inputs for a flag editor group.
        // prefix: element ID prefix (e.g. 'ea_read_perm', 'na_post_rest')
        // inputName: form field name (e.g. 'read_perm_flags')
        // activeFlags: current array of flag strings
        // allFlags: full available list (perms or restrs)
        // badgeClass: 'bg-success' for perms, 'bg-danger' for restrs
        function renderAreaFlags(prefix, inputName, activeFlags, allFlags, badgeClass) {
          var badgeEl  = document.getElementById(prefix + '_badges');
          var inputEl  = document.getElementById(prefix + '_inputs');
          var selectEl = document.getElementById(prefix + '_select');
          var addBtn   = document.getElementById(prefix + '_add');

          // Badges
          badgeEl.innerHTML = '';
          activeFlags.forEach(function(flag) {
            var span = document.createElement('span');
            span.className = 'badge ' + badgeClass + ' me-1 mb-1';
            span.style.cursor = 'pointer';
            span.title = 'Click to remove';
            span.textContent = flag + ' ×';
            span.addEventListener('click', function() {
              var updated = activeFlags.filter(function(f) { return f !== flag; });
              renderAreaFlags(prefix, inputName, updated, allFlags, badgeClass);
            });
            badgeEl.appendChild(span);
          });

          // Hidden inputs
          inputEl.innerHTML = '';
          activeFlags.forEach(function(flag) {
            var inp = document.createElement('input');
            inp.type  = 'hidden';
            inp.name  = inputName;
            inp.value = flag;
            inputEl.appendChild(inp);
          });

          // Select — only show flags not already active
          selectEl.innerHTML = '';
          var available = allFlags.filter(function(f) { return !activeFlags.includes(f); });
          if (available.length === 0) {
            var opt = document.createElement('option');
            opt.value = '';
            opt.textContent = '— none available —';
            opt.disabled = true;
            selectEl.appendChild(opt);
            selectEl.disabled = true;
            addBtn.disabled = true;
          } else {
            selectEl.disabled = false;
            addBtn.disabled = false;
            available.forEach(function(flag) {
              var opt = document.createElement('option');
              opt.value = flag;
              opt.textContent = flag;
              selectEl.appendChild(opt);
            });
          }
        }

        // Wire add buttons for a flag group
        function wireAddBtn(prefix, inputName, allFlags, badgeClass) {
          document.getElementById(prefix + '_add').addEventListener('click', function() {
            var sel = document.getElementById(prefix + '_select');
            if (!sel.value) return;
            var current = Array.from(document.querySelectorAll('#' + prefix + '_inputs input')).map(function(i) { return i.value; });
            if (!current.includes(sel.value)) {
              current.push(sel.value);
              renderAreaFlags(prefix, inputName, current, allFlags, badgeClass);
            }
          });
        }

        // Wire all edit-area flag add buttons
        // Wire edit-area flag add buttons (only exist when msgGroup is set)
        if (document.getElementById('ea_read_perm_add')) {
          wireAddBtn('ea_read_perm', 'read_perm_flags', allPerms, 'bg-success');
          wireAddBtn('ea_read_rest', 'read_rest_flags', allRestrs, 'bg-danger');
          wireAddBtn('ea_post_perm', 'post_perm_flags', allPerms, 'bg-success');
          wireAddBtn('ea_post_rest', 'post_rest_flags', allRestrs, 'bg-danger');
        }

        // Wire new-area flag add buttons
        if (document.getElementById('na_read_perm_add')) {
          wireAddBtn('na_read_perm', 'read_perm_flags', allPerms, 'bg-success');
          wireAddBtn('na_read_rest', 'read_rest_flags', allRestrs, 'bg-danger');
          wireAddBtn('na_post_perm', 'post_perm_flags', allPerms, 'bg-success');
          wireAddBtn('na_post_rest', 'post_rest_flags', allRestrs, 'bg-danger');
        }

        // Wire edit-group flag add buttons
        wireAddBtn('eg_read_perm', 'read_perm_flags', allPerms, 'bg-success');
        wireAddBtn('eg_read_rest', 'read_rest_flags', allRestrs, 'bg-danger');
        wireAddBtn('eg_post_perm', 'post_perm_flags', allPerms, 'bg-success');
        wireAddBtn('eg_post_rest', 'post_rest_flags', allRestrs, 'bg-danger');

        // Initialize edit-group flags from current group data
        var groupReadPermFlags = !{JSON.stringify(msgGroup ? (msgGroup.read_perm_flags || []) : [])};
        var groupReadRestFlags = !{JSON.stringify(msgGroup ? (msgGroup.read_rest_flags || []) : [])};
        var groupPostPermFlags = !{JSON.stringify(msgGroup ? (msgGroup.post_perm_flags || []) : [])};
        var groupPostRestFlags = !{JSON.stringify(msgGroup ? (msgGroup.post_rest_flags || []) : [])};

        // Wire edit-group flag add buttons (only exist when msgGroup is set)
        if (document.getElementById('eg_read_perm_add')) {
          wireAddBtn('eg_read_perm', 'read_perm_flags', allPerms, 'bg-success');
          wireAddBtn('eg_read_rest', 'read_rest_flags', allRestrs, 'bg-danger');
          wireAddBtn('eg_post_perm', 'post_perm_flags', allPerms, 'bg-success');
          wireAddBtn('eg_post_rest', 'post_rest_flags', allRestrs, 'bg-danger');

          renderAreaFlags('eg_read_perm', 'read_perm_flags', parseFlags(JSON.stringify(groupReadPermFlags)), allPerms, 'bg-success');
          renderAreaFlags('eg_read_rest', 'read_rest_flags', parseFlags(JSON.stringify(groupReadRestFlags)), allRestrs, 'bg-danger');
          renderAreaFlags('eg_post_perm', 'post_perm_flags', parseFlags(JSON.stringify(groupPostPermFlags)), allPerms, 'bg-success');
          renderAreaFlags('eg_post_rest', 'post_rest_flags', parseFlags(JSON.stringify(groupPostRestFlags)), allRestrs, 'bg-danger');
        }

        // Initialize new area flags from group defaults (only exist when msgGroup is set)
        if (document.getElementById('na_read_perm_add')) {
          renderAreaFlags('na_read_perm', 'read_perm_flags', parseFlags(JSON.stringify(groupReadPermFlags)), allPerms, 'bg-success');
          renderAreaFlags('na_read_rest', 'read_rest_flags', parseFlags(JSON.stringify(groupReadRestFlags)), allRestrs, 'bg-danger');
          renderAreaFlags('na_post_perm', 'post_perm_flags', parseFlags(JSON.stringify(groupPostPermFlags)), allPerms, 'bg-success');
          renderAreaFlags('na_post_rest', 'post_rest_flags', parseFlags(JSON.stringify(groupPostRestFlags)), allRestrs, 'bg-danger');
        }

        // Area table row click — populate and open info modal
        const table = document.getElementById('msgAreas');
        if (table) {
          table.querySelectorAll('tbody tr').forEach(row => {
            row.style.cursor = 'pointer';
            row.addEventListener('click', function() {
              const d = this.dataset;
              currentAreaShortcode = d.bsShortcode;

              document.getElementById('areaInfoTitle').textContent       = d.bsName;
              document.getElementById('areaInfoShortcode').textContent   = d.bsShortcode;
              document.getElementById('areaInfoNetwork').textContent     = d.bsNetworkname  || '— Local —';
              document.getElementById('areaInfoAreatag').textContent     = d.bsNetworktag   || '—';
              document.getElementById('areaInfoActive').textContent      = d.bsActive === 'true' ? 'Active' : 'Inactive';
              document.getElementById('areaInfoThreadMode').textContent   = { standard: 'Standard (threaded)', no_threads: 'No Threads (flat)', subscribe_only: 'Subscribe Only' }[d.bsThreadmode] || d.bsThreadmode || 'Standard';
              document.getElementById('areaInfoPostAs').textContent       = { username: 'Username', realname: 'Real Name' }[d.bsPostas] || d.bsPostas || 'Username';
              document.getElementById('areaInfoReadSec').textContent     = d.bsReadsecurity;
              document.getElementById('areaInfoPostSec').textContent     = d.bsPostsecurity;
              document.getElementById('areaInfoMinAge').textContent      = d.bsMinage;
              document.getElementById('areaInfoMaxAge').textContent      = d.bsMaxage;
              document.getElementById('areaInfoMsgCount').textContent    = parseInt(d.bsMsgcount || 0).toLocaleString();
              document.getElementById('areaInfoReadPermFlags').textContent  = fmtFlags(d.bsReadpermflags);
              document.getElementById('areaInfoReadRestFlags').textContent  = fmtFlags(d.bsReadrestflags);
              document.getElementById('areaInfoPostPermFlags').textContent  = fmtFlags(d.bsPostpermflags);
              document.getElementById('areaInfoPostRestFlags').textContent  = fmtFlags(d.bsPostrestflags);
              document.getElementById('areaInfoDescription').textContent = d.bsDescription;
              document.getElementById('areaInfoLastFrom').textContent    = d.bsLastfrom    || '—';
              document.getElementById('areaInfoLastMessage').textContent = d.bsLastmessage
                ? new Date(d.bsLastmessage).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
                : '—';

              areaInfoModal.show();
            });
          });
        }

        // View button
        document.getElementById('areaViewBtn').addEventListener('click', function() {
          if (currentAreaShortcode) window.location.href = `/admin/msgArea/${currentAreaShortcode}`;
        });

        // Edit button — populate edit modal
        document.getElementById('areaEditBtn').addEventListener('click', function() {
          if (!currentAreaShortcode) return;
          const row = document.querySelector(`tr[data-bs-shortcode="${currentAreaShortcode}"]`);
          if (!row) return;
          const d = row.dataset;

          document.getElementById('editAreaForm').action     = `/admin/msgArea/${currentAreaShortcode}/update`;
          document.getElementById('ea_name').value           = d.bsName;
          document.getElementById('ea_description').value    = d.bsDescription;
          document.getElementById('ea_readsecurity').value   = d.bsReadsecurity;
          document.getElementById('ea_postsecurity').value   = d.bsPostsecurity;
          document.getElementById('ea_minage').value         = d.bsMinage;
          document.getElementById('ea_maxage').value         = d.bsMaxage;
          document.getElementById('ea_active').value         = d.bsActive === 'true' ? 'true' : 'false';
          document.getElementById('ea_thread_mode').value    = d.bsThreadmode || 'standard';
          document.getElementById('ea_post_as').value        = d.bsPostas || 'username';
          document.getElementById('ea_newscan').value        = d.bsNewscandefault === 'true' ? 'true' : 'false';
          document.getElementById('ea_qwk_conf_number').value = d.bsQwkconfnumber || '';

          renderAreaFlags('ea_read_perm', 'read_perm_flags', parseFlags(d.bsReadpermflags), allPerms, 'bg-success');
          renderAreaFlags('ea_read_rest', 'read_rest_flags', parseFlags(d.bsReadrestflags), allRestrs, 'bg-danger');
          renderAreaFlags('ea_post_perm', 'post_perm_flags', parseFlags(d.bsPostpermflags), allPerms, 'bg-success');
          renderAreaFlags('ea_post_rest', 'post_rest_flags', parseFlags(d.bsPostrestflags), allRestrs, 'bg-danger');

          areaInfoModal.hide();
          editAreaModal.show();
        });

        // Move button -- opens the shared moveAreaModal, pre-populates
        // the area + current-group display, rebuilds the target-group
        // dropdown from allGroupsForMove minus the current group, and
        // wires the form action. See _moveAreaModal.pug for the
        // partial's contract.
        document.getElementById('areaMoveBtn').addEventListener('click', function() {
          if (!currentAreaShortcode) return;
          const row = document.querySelector(`tr[data-bs-shortcode="${currentAreaShortcode}"]`);
          if (!row) return;
          const d = row.dataset;
          // In the group view, the current group is always the page's
          // msgGroup shortcode. Fall back to the row's data-bs-
          // groupshortcode if present for safety. JSON-encode the
          // shortcode so any special characters (unlikely given
          // validation rules, but defensive) are properly quoted.
          const currentGroup = d.bsGroupshortcode || !{JSON.stringify(msgGroup ? msgGroup.shortcode : '')};

          document.getElementById('maArea').textContent         = d.bsName + ' (' + d.bsShortcode + ')';
          document.getElementById('maCurrentGroup').textContent = currentGroup || '(unknown)';

          // Rebuild the target-group dropdown from the authoritative
          // server-rendered list, skipping the current group.
          const targetSelect = document.getElementById('ma_target_group');
          targetSelect.innerHTML = '';
          const placeholder = document.createElement('option');
          placeholder.value = '';
          placeholder.textContent = '— Select a target group —';
          targetSelect.appendChild(placeholder);
          for (const g of (allGroupsForMove || [])) {
            if (g.shortcode === currentGroup) continue;
            const opt = document.createElement('option');
            opt.value = g.shortcode;
            opt.textContent = g.name + ' (' + g.shortcode + ')';
            targetSelect.appendChild(opt);
          }
          targetSelect.value = '';

          document.getElementById('ma_apply_defaults').checked = false;
          document.getElementById('moveAreaForm').action = `/admin/msgArea/${currentAreaShortcode}/move`;

          areaInfoModal.hide();
          moveAreaModal.show();
        });

        // Delete button
        document.getElementById('areaDeleteBtn').addEventListener('click', function() {
          if (!currentAreaShortcode) return;
          const row = document.querySelector(`tr[data-bs-shortcode="${currentAreaShortcode}"]`);
          if (!row) return;

          document.getElementById('deleteAreaName').textContent           = row.dataset.bsName;
          document.getElementById('deleteAreaForm').action                = `/admin/msgArea/${currentAreaShortcode}/delete`;
          document.getElementById('da_delete_tables_hidden').value        = 'false';
          document.getElementById('da_delete_tables').value               = 'false';
          document.getElementById('da_deleteTablesWarning').style.display = 'none';

          areaInfoModal.hide();
          deleteAreaModal.show();
        });

        // Delete area tables select warning
        const daSelect  = document.getElementById('da_delete_tables');
        const daHidden  = document.getElementById('da_delete_tables_hidden');
        const daWarning = document.getElementById('da_deleteTablesWarning');
        if (daSelect) {
          daSelect.addEventListener('change', function() {
            daHidden.value = this.value;
            daWarning.style.display = this.value === 'true' ? 'block' : 'none';
          });
        }

        // Delete group tables select warning
        const deleteSelect  = document.getElementById('delete_tables');
        const deleteHidden  = document.getElementById('delete_tables_hidden');
        const deleteWarning = document.getElementById('deleteTablesWarning');
        if (deleteSelect) {
          deleteSelect.addEventListener('change', function() {
            deleteHidden.value = this.value;
            deleteWarning.style.display = this.value === 'true' ? 'block' : 'none';
          });
        }

        // On every modal open, snap back to the Main tab. Bootstrap
        // otherwise preserves nav-link.active state across open/close
        // cycles and a user who was last viewing Access or Network would
        // reopen a different area into the wrong tab. Same pattern as
        // the global msgAreas/index.pug view.
        function resetToMainTab(modalEl, prefix) {
          if (!modalEl) return;
          modalEl.addEventListener('show.bs.modal', function() {
            var trigger = modalEl.querySelector('.nav-link[data-bs-target="#' + prefix + 'tab_main"]');
            if (trigger && typeof bootstrap !== 'undefined' && bootstrap.Tab) {
              bootstrap.Tab.getOrCreateInstance(trigger).show();
            }
          });
        }
        resetToMainTab(document.getElementById('editAreaModal'), 'ea_');
        resetToMainTab(document.getElementById('newAreaModal'), 'na_');

        // QWK conference number debounced AJAX collision check. Same
        // behaviour as the global msgAreas/index.pug view -- hits the
        // /admin/msgAreas/check-conf-number endpoint on input and shows
        // inline availability feedback. Authoritative enforcement is
        // still the DB UNIQUE constraint + model-side validation.
        var qwkInput  = document.getElementById('ea_qwk_conf_number');
        var qwkStatus = document.getElementById('ea_qwk_conf_status');
        if (qwkInput && qwkStatus) {
          var qwkDebounce = null;
          qwkInput.addEventListener('input', function() {
            clearTimeout(qwkDebounce);
            qwkDebounce = setTimeout(function() {
              var v = parseInt(qwkInput.value, 10);
              if (isNaN(v)) {
                qwkStatus.style.display = 'none';
                qwkStatus.textContent = '';
                return;
              }
              if (v <= 100) {
                qwkStatus.style.display = '';
                qwkStatus.className = 'form-text text-danger';
                qwkStatus.textContent = 'Reserved: 1-100 are Canectic system conferences';
                return;
              }
              var excludeParam = currentAreaShortcode
                ? '&exclude=' + encodeURIComponent(currentAreaShortcode)
                : '';
              fetch('/admin/msgAreas/check-conf-number?n=' + v + excludeParam)
                .then(function(r) { return r.json(); })
                .then(function(d) {
                  if (d && d.available) {
                    qwkStatus.style.display = '';
                    qwkStatus.className = 'form-text text-success';
                    qwkStatus.textContent = '\u2713 Available';
                  } else if (d && d.conflictsWith) {
                    qwkStatus.style.display = '';
                    qwkStatus.className = 'form-text text-danger';
                    qwkStatus.textContent = 'In use by: ' + d.conflictsWith;
                  }
                })
                .catch(function() {
                  qwkStatus.style.display = 'none';
                });
            }, 300);
          });
        }

        // Reset the QWK conference status indicator when the edit modal
        // opens so stale availability feedback from a previous area
        // doesn't stick around. The existing Edit button handler above
        // sets ea_qwk_conf_number.value directly -- we also need to
        // wipe the status span.
        var editAreaModalEl = document.getElementById('editAreaModal');
        if (editAreaModalEl && qwkStatus) {
          editAreaModalEl.addEventListener('show.bs.modal', function() {
            qwkStatus.style.display = 'none';
            qwkStatus.textContent = '';
          });
        }

        // Live validation of qwk_conf_start in the edit-group modal
        var egStartInput  = document.getElementById('edit_qwk_conf_start');
        var egStartStatus = document.getElementById('edit_qwk_conf_start_status');
        var egStartGroupId = !{JSON.stringify(msgGroup ? msgGroup.id : null)};
        if (egStartInput && egStartStatus) {
          var egStartTimer = null;
          egStartInput.addEventListener('input', function() {
            if (egStartTimer) clearTimeout(egStartTimer);
            var v = egStartInput.value;
            egStartStatus.textContent = '';
            egStartStatus.className = 'small mt-1';
            if (!v) return;
            egStartTimer = setTimeout(function() {
              var url = '/admin/msgGroups/check-conf-start?n=' + encodeURIComponent(v);
              if (egStartGroupId) url += '&exclude_group_id=' + encodeURIComponent(egStartGroupId);
              fetch(url)
                .then(function(r) { return r.json(); })
                .then(function(j) {
                  if (j.available) {
                    egStartStatus.textContent = '\u2713 available';
                    egStartStatus.className = 'small mt-1 text-success';
                  } else {
                    egStartStatus.textContent = '\u2717 ' + (j.message || j.reason || 'invalid');
                    egStartStatus.className = 'small mt-1 text-danger';
                  }
                })
                .catch(function() {});
            }, 350);
          });
        }

      });
