extends ../layouts/admin

block content  
  .container-fluid.main-wrapper
    if !ismobile
      .row
        .col-12
          br
          br
      .row
        .col-2
        .col-8              
          .card      
            .card-header.bg-darkblue.text-white
              .row
                .col-8
                  h2= title
                .col-4
                  .text-end
                    a.button.btn.btn-lg.btn-info(href='/admin')
                      |Exit
            .card-body
              if errormessages && errormessages.length > 0
                ul.text-danger
                  for error of errormessages
                    li.text-danger
                      =error
                br

              .text-end
                form.d-inline(action='/admin/msgGroups/recalculateAreaCounts' method='POST')
                  button.btn.btn-sm.btn-outline-warning.me-2(type='submit')
                    i.bi.bi-arrow-repeat
                    |  Recalculate Area Counts
                a.btn.btn-lg.btn-info.me-2(href='/admin/msgAreas')
                  | All Areas
                button.btn.btn-lg.btn-success(data-bs-toggle='modal' data-bs-target=`#newGroupModal`)
                  |Add Group
              if grouplist && grouplist.length > 0
                br
                table#msgGroups.table.table-hover
                  thead
                    tr
                      th(scope='col') Name
                      th(scope='col') Shortcode                      
                      th(scope='col') Description
                      th(scope='col') Area Count
                    tbody
                      for group of grouplist
                        tr(data-bs-shortcode=group.shortcode)
                          td
                            =group.name
                          td
                            =group.shortcode
                          td
                            =group.description
                          td                            
                            =group.area_count
              else
                center
                  .h4
                    |No Groups Found!

      #newGroupModal.modal.fade(tabindex='-1' aria-labelledby='' aria-hidden='true')
        .modal-dialog.modal-dialog-centered.modal-lg
          .modal-content
            .modal-header.bg-dark.text-white
              h3.modal-title
                  |Add New Group
              button.btn.btn-lg.btn-close(data-bs-dismiss="modal")
            .modal-body
              form(action=`/admin/msgGroup/new` method="POST" class="form-registration")
                .row
                  .col-1
                  .col-10
                    label(for="name") Name:
                    input(
                      type="text"
                      id="name"
                      name="name"
                      class="form-control"
                      required
                    )
                    br
                    label(for="description") Description:
                    input(
                      type="text"
                      id="description"
                      name="description"
                      class="form-control"
                      required
                    )
                    br
                .row
                  .col-1
                  .col-5
                    label(for="shortcode") Short Code:
                    input(
                      type="text"
                      id="shotcode"
                      name="shortcode"
                      class="form-control"
                      required
                    )
                  .col-5
                    label(for="ng_readsecurity") Default Read Security:
                    input(
                      type="number"
                      id="ng_readsecurity"
                      min=1
                      max=255
                      name="readsecurity"
                      class="form-control"
                      value=50
                    )
                    br
                    label(for="ng_postsecurity") Default Post Security:
                    input(
                      type="number"
                      id="ng_postsecurity"
                      min=1
                      max=255
                      name="postsecurity"
                      class="form-control"
                      value=50
                    )
                .row
                  .col-1
                  .col-5
                    #ng_read_perm_inputs
                    #ng_read_rest_inputs
                    br
                    label Read Perm Flags (default for areas):
                    .border.rounded.p-2.mb-2.bg-light#ng_read_perm_badges(style='min-height:2.2rem')
                    .input-group.mb-2
                      select#ng_read_perm_select.form-control
                      button.btn.btn-sm.btn-success#ng_read_perm_add(type='button') Add
                    label Read Restrict Flags:
                    .border.rounded.p-2.mb-2.bg-light#ng_read_rest_badges(style='min-height:2.2rem')
                    .input-group
                      select#ng_read_rest_select.form-control
                      button.btn.btn-sm.btn-danger#ng_read_rest_add(type='button') Add
                  .col-5
                    #ng_post_perm_inputs
                    #ng_post_rest_inputs
                    br
                    label Post Perm Flags (default for areas):
                    .border.rounded.p-2.mb-2.bg-light#ng_post_perm_badges(style='min-height:2.2rem')
                    .input-group.mb-2
                      select#ng_post_perm_select.form-control
                      button.btn.btn-sm.btn-success#ng_post_perm_add(type='button') Add
                    label Post Restrict Flags:
                    .border.rounded.p-2.mb-2.bg-light#ng_post_rest_badges(style='min-height:2.2rem')
                    .input-group
                      select#ng_post_rest_select.form-control
                      button.btn.btn-sm.btn-danger#ng_post_rest_add(type='button') Add
                .row
                  .col-1
                  .col-10
                    br
                    .text-end
                      input(
                        type="submit"
                        value="Submit"
                        class="btn btn-lg btn-success btn-block"
                        )
  script.
    // Add click event listener to table rows
    document.addEventListener('DOMContentLoaded', function() {
      const table = document.getElementById('msgGroups');

      if (table) {
        // Add click event to all tbody rows
        const rows = table.querySelectorAll('tbody tr');
        
        rows.forEach(row => {
          // Add pointer cursor to indicate clickable rows
          row.style.cursor = 'pointer';
          
          row.addEventListener('click', function() {
            const shortcode = this.getAttribute('data-bs-shortcode');
            
            if (shortcode) {
              // Navigate to the msgGroup page
              window.location.href = `/admin/msggroup/${shortcode}`;
            }
          });
        });
      }

      // --- Flag management for new group modal ---
      var allPerms  = !{JSON.stringify(availablePermissions)};
      var allRestrs = !{JSON.stringify(availableRestrictions)};

      function renderAreaFlags(prefix, inputName, activeFlags, allFlags, badgeClass) {
        var badgeEl  = document.getElementById(prefix + '_badges');
        var inputEl  = document.getElementById(prefix + '_inputs');
        var selectEl = document.getElementById(prefix + '_select');
        var addBtn   = document.getElementById(prefix + '_add');

        badgeEl.innerHTML = '';
        activeFlags.forEach(function(flag) {
          var span = document.createElement('span');
          span.className = 'badge ' + badgeClass + ' me-1 mb-1';
          span.style.cursor = 'pointer';
          span.title = 'Click to remove';
          span.textContent = flag + ' ×';
          span.addEventListener('click', function() {
            var updated = activeFlags.filter(function(f) { return f !== flag; });
            renderAreaFlags(prefix, inputName, updated, allFlags, badgeClass);
          });
          badgeEl.appendChild(span);
        });

        inputEl.innerHTML = '';
        activeFlags.forEach(function(flag) {
          var inp = document.createElement('input');
          inp.type  = 'hidden';
          inp.name  = inputName;
          inp.value = flag;
          inputEl.appendChild(inp);
        });

        selectEl.innerHTML = '';
        var available = allFlags.filter(function(f) { return !activeFlags.includes(f); });
        if (available.length === 0) {
          var opt = document.createElement('option');
          opt.value = '';
          opt.textContent = '— none available —';
          opt.disabled = true;
          selectEl.appendChild(opt);
          selectEl.disabled = true;
          addBtn.disabled = true;
        } else {
          selectEl.disabled = false;
          addBtn.disabled = false;
          available.forEach(function(flag) {
            var opt = document.createElement('option');
            opt.value = flag;
            opt.textContent = flag;
            selectEl.appendChild(opt);
          });
        }
      }

      function wireAddBtn(prefix, inputName, allFlags, badgeClass) {
        document.getElementById(prefix + '_add').addEventListener('click', function() {
          var sel = document.getElementById(prefix + '_select');
          if (!sel.value) return;
          var current = Array.from(document.querySelectorAll('#' + prefix + '_inputs input')).map(function(i) { return i.value; });
          if (!current.includes(sel.value)) {
            current.push(sel.value);
            renderAreaFlags(prefix, inputName, current, allFlags, badgeClass);
          }
        });
      }

      wireAddBtn('ng_read_perm', 'read_perm_flags', allPerms, 'bg-success');
      wireAddBtn('ng_read_rest', 'read_rest_flags', allRestrs, 'bg-danger');
      wireAddBtn('ng_post_perm', 'post_perm_flags', allPerms, 'bg-success');
      wireAddBtn('ng_post_rest', 'post_rest_flags', allRestrs, 'bg-danger');

      renderAreaFlags('ng_read_perm', 'read_perm_flags', [], allPerms, 'bg-success');
      renderAreaFlags('ng_read_rest', 'read_rest_flags', [], allRestrs, 'bg-danger');
      renderAreaFlags('ng_post_perm', 'post_perm_flags', [], allPerms, 'bg-success');
      renderAreaFlags('ng_post_rest', 'post_rest_flags', [], allRestrs, 'bg-danger');
    });