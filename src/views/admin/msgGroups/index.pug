extends ../../layouts/admin

block content  
  .container-fluid.main-wrapper
    if !ismobile
      .row
        .col-12
          br
          br
      .row
        .col-2
        .col-8              
          .card      
            .card-header.bg-darkblue.text-white
              .row
                .col-8
                  h2= title
                .col-4
                  .text-end
                    a.button.btn.btn-lg.btn-info(href='/admin')
                      |Exit
            .card-body
              if errormessages && errormessages.length > 0
                ul.text-danger
                  for error of errormessages
                    li.text-danger
                      =error
                br

              .text-end
                form.d-inline(action='/admin/msgGroups/recalculateAreaCounts' method='POST')
                  button.btn.btn-sm.btn-outline-warning.me-2(type='submit')
                    i.bi.bi-arrow-repeat
                    |  Recalculate Area Counts
                a.btn.btn-lg.btn-info.me-2(href='/admin/msgAreas')
                  | All Areas
                button.btn.btn-lg.btn-success(data-bs-toggle='modal' data-bs-target=`#newGroupModal`)
                  |Add Group
              if grouplist && grouplist.length > 0
                br
                table#msgGroups.table.table-hover
                  thead
                    tr
                      th(style='width:30px')
                      th(scope='col') Name
                      th(scope='col') Shortcode
                      th(scope='col') Description
                      th(scope='col') Area Count
                  tbody#groupBody
                    for group of grouplist
                      tr(data-bs-shortcode=group.shortcode data-id=group.id draggable='true')
                        td.grip(style='cursor:grab')
                          i.bi.bi-grip-vertical
                        td= group.name
                        td= group.shortcode
                        td= group.description
                        td= group.area_count
                button.btn.btn-sm.btn-outline-primary.mt-2#saveGroupOrder
                  i.bi.bi-sort-numeric-down.me-1
                  | Save Order
              else
                center
                  .h4
                    |No Groups Found!

      #newGroupModal.modal.fade(tabindex='-1' aria-labelledby='' aria-hidden='true')
        .modal-dialog.modal-dialog-centered.modal-lg
          .modal-content
            .modal-header.bg-dark.text-white
              h3.modal-title
                  |Add New Group
              button.btn.btn-lg.btn-close(data-bs-dismiss="modal")
            .modal-body
              form(action=`/admin/msgGroup/new` method="POST" class="form-registration")

                //- ---- Tab nav ----
                ul.nav.nav-tabs.mb-3(role='tablist')
                  li.nav-item(role='presentation')
                    button.nav-link.active(type='button' role='tab' data-bs-toggle='tab' data-bs-target='#ng_tab_main') Main
                  li.nav-item(role='presentation')
                    button.nav-link(type='button' role='tab' data-bs-toggle='tab' data-bs-target='#ng_tab_access') Access
                  li.nav-item(role='presentation')
                    button.nav-link(type='button' role='tab' data-bs-toggle='tab' data-bs-target='#ng_tab_network') Network

                .tab-content
                  //- ============================================================
                  //- MAIN — identity and posting behaviour
                  //- ============================================================
                  .tab-pane.fade.show.active#ng_tab_main(role='tabpanel')
                    .mb-3
                      label.form-label(for="name") Name:
                      input.form-control(type="text" id="name" name="name" required)
                    .mb-3
                      label.form-label(for="description") Description:
                      input.form-control(type="text" id="description" name="description" required)
                    .mb-3
                      label.form-label(for="shortcode") Short Code:
                      input.form-control(type="text" id="shortcode" name="shortcode" required)
                    .row
                      .col-6
                        label.form-label(for="ng_post_as") Post As:
                        select#ng_post_as.form-select(name='post_as')
                          option(value='username' selected) Username
                          option(value='realname') Real Name
                        .form-text.text-muted
                          | Whether messages carry the user's handle or their real name. New areas inherit this.
                      .col-6
                        label.form-label(for="ng_thread_mode") Thread Mode:
                        select#ng_thread_mode.form-select(name='thread_mode')
                          option(value='standard' selected) Standard (threaded)
                          option(value='no_threads') No Threads (flat)
                          option(value='subscribe_only') Subscribe Only
                        .form-text.text-muted
                          | How areas in this group read by default. New areas inherit this.
                      .col-6
                        label.form-label(for="ng_newscan") Newscan Default:
                        select#ng_newscan.form-select(name='newscan_default')
                          option(value='false' selected) No
                          option(value='true') Yes
                    .row.mt-3
                      .col-6
                        label.form-label(for='ng_max_age_days') Max Age (days):
                        input#ng_max_age_days.form-control(type='number' name='max_age_days' min=0 placeholder='no limit')
                        .form-text.text-muted
                          | Default for new areas. Blank = never prune, which is the default.
                      .col-6
                        label.form-label(for='ng_max_messages') Max Messages:
                        input#ng_max_messages.form-control(type='number' name='max_messages' min=0 placeholder='no limit')
                        .form-text.text-muted
                          | Default for new areas. Blank = never prune.

                  //- ============================================================
                  //- ACCESS — security levels and flag defaults for new areas
                  //- ============================================================
                  .tab-pane.fade#ng_tab_access(role='tabpanel')
                    .row.mb-3
                      .col-6
                        label.form-label(for="ng_readsecurity") Default Read Security:
                        input.form-control(type="number" id="ng_readsecurity" min=0 max=255 name="readsecurity" value=50)
                      .col-6
                        label.form-label(for="ng_postsecurity") Default Post Security:
                        input.form-control(type="number" id="ng_postsecurity" min=0 max=255 name="postsecurity" value=60)
                    .row
                      .col-6
                        #ng_read_perm_inputs
                        #ng_read_rest_inputs
                        label Read Permission Flags:
                        .border.rounded.p-2.mb-2.bg-light#ng_read_perm_badges(style='min-height:2.2rem')
                        .input-group.mb-2
                          select#ng_read_perm_select.form-control
                          button.btn.btn-sm.btn-success#ng_read_perm_add(type='button') Add
                        label Read Restriction Flags:
                        .border.rounded.p-2.mb-2.bg-light#ng_read_rest_badges(style='min-height:2.2rem')
                        .input-group
                          select#ng_read_rest_select.form-control
                          button.btn.btn-sm.btn-danger#ng_read_rest_add(type='button') Add
                      .col-6
                        #ng_post_perm_inputs
                        #ng_post_rest_inputs
                        label Post Permission Flags:
                        .border.rounded.p-2.mb-2.bg-light#ng_post_perm_badges(style='min-height:2.2rem')
                        .input-group.mb-2
                          select#ng_post_perm_select.form-control
                          button.btn.btn-sm.btn-success#ng_post_perm_add(type='button') Add
                        label Post Restriction Flags:
                        .border.rounded.p-2.mb-2.bg-light#ng_post_rest_badges(style='min-height:2.2rem')
                        .input-group
                          select#ng_post_rest_select.form-control
                          button.btn.btn-sm.btn-danger#ng_post_rest_add(type='button') Add

                  //- ============================================================
                  //- NETWORK — QWK conference numbering
                  //- ============================================================
                  .tab-pane.fade#ng_tab_network(role='tabpanel')
                    .mb-3
                      label.form-label(for="ng_qwk_conf_start") QWK Conference Start:
                      input.form-control(type="number" id="ng_qwk_conf_start" name="qwk_conf_start" min=101 value=nextConfStart || '')
                      .form-text.text-muted
                        | Start of this group's QWK conference number block. Areas in the group take consecutive offsets within the block. Numbers 1-100 are reserved for system conferences. Pre-filled with the next available block; edit only if you want a specific arrangement.
                      .small.mt-1#ng_qwk_conf_start_status

                .text-end.mt-3
                  input.btn.btn-lg.btn-success(type="submit" value="Submit")

  script.
    document.addEventListener('DOMContentLoaded', function() {
      var table = document.getElementById('msgGroups');
      if (table) {
        table.querySelectorAll('tbody tr').forEach(function(row) {
          row.style.cursor = 'pointer';
          row.addEventListener('click', function() {
            var shortcode = this.getAttribute('data-bs-shortcode');
            if (shortcode) window.location.href = '/admin/msggroup/' + shortcode;
          });
        });
      }

      // --- Drag-to-reorder groups ---
      var tbody = document.getElementById('groupBody');
      if (tbody) {
        var dragRow = null;
        tbody.addEventListener('dragstart', function(e) {
          dragRow = e.target.closest('tr');
          if (dragRow) e.dataTransfer.effectAllowed = 'move';
        });
        tbody.addEventListener('dragover', function(e) {
          e.preventDefault();
          var target = e.target.closest('tr');
          if (target && target !== dragRow) {
            var rect = target.getBoundingClientRect();
            if (e.clientY < rect.top + rect.height / 2) {
              tbody.insertBefore(dragRow, target);
            } else {
              tbody.insertBefore(dragRow, target.nextSibling);
            }
          }
        });
        // Prevent row click from firing during drag
        tbody.querySelectorAll('.grip').forEach(function(grip) {
          grip.addEventListener('click', function(e) { e.stopPropagation(); });
        });
      }
      var saveBtn = document.getElementById('saveGroupOrder');
      if (saveBtn) {
        saveBtn.addEventListener('click', function() {
          var rows = document.querySelectorAll('#groupBody tr');
          var ids = [];
          rows.forEach(function(r) { ids.push(r.getAttribute('data-id')); });
          fetch('/admin/msgGroups/reorder', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ids: ids })
          }).then(function() { location.reload(); });
        });
      }

      // --- Flag management for new group modal ---
      var allPerms  = !{JSON.stringify(availablePermissions || [])};
      var allRestrs = !{JSON.stringify(availableRestrictions || [])};

      function renderFlags(prefix, inputName, activeFlags, allFlags, badgeClass) {
        var badgeEl  = document.getElementById(prefix + '_badges');
        var inputEl  = document.getElementById(prefix + '_inputs');
        var selectEl = document.getElementById(prefix + '_select');
        var addBtn   = document.getElementById(prefix + '_add');
        if (!badgeEl || !inputEl || !selectEl || !addBtn) return;

        badgeEl.innerHTML = '';
        activeFlags.forEach(function(flag) {
          var span = document.createElement('span');
          span.className = 'badge ' + badgeClass + ' me-1 mb-1';
          span.style.cursor = 'pointer';
          span.title = 'Click to remove';
          span.textContent = flag + ' \u00d7';
          span.addEventListener('click', function() {
            renderFlags(prefix, inputName, activeFlags.filter(function(f) { return f !== flag; }), allFlags, badgeClass);
          });
          badgeEl.appendChild(span);
        });

        inputEl.innerHTML = '';
        activeFlags.forEach(function(flag) {
          var inp = document.createElement('input');
          inp.type = 'hidden'; inp.name = inputName; inp.value = flag;
          inputEl.appendChild(inp);
        });

        selectEl.innerHTML = '';
        var available = allFlags.filter(function(f) { return !activeFlags.includes(f); });
        if (available.length === 0) {
          var opt = document.createElement('option');
          opt.value = ''; opt.textContent = '-- none available --'; opt.disabled = true;
          selectEl.appendChild(opt);
          selectEl.disabled = true; addBtn.disabled = true;
        } else {
          selectEl.disabled = false; addBtn.disabled = false;
          available.forEach(function(flag) {
            var opt = document.createElement('option');
            opt.value = flag; opt.textContent = flag;
            selectEl.appendChild(opt);
          });
        }
      }

      function wireAddBtn(prefix, inputName, allFlags, badgeClass) {
        var btn = document.getElementById(prefix + '_add');
        if (!btn) return;
        btn.addEventListener('click', function() {
          var sel = document.getElementById(prefix + '_select');
          if (!sel || !sel.value) return;
          var current = Array.from(document.querySelectorAll('#' + prefix + '_inputs input')).map(function(i) { return i.value; });
          if (!current.includes(sel.value)) {
            current.push(sel.value);
            renderFlags(prefix, inputName, current, allFlags, badgeClass);
          }
        });
      }

      wireAddBtn('ng_read_perm', 'read_perm_flags', allPerms, 'bg-success');
      wireAddBtn('ng_read_rest', 'read_rest_flags', allRestrs, 'bg-danger');
      wireAddBtn('ng_post_perm', 'post_perm_flags', allPerms, 'bg-success');
      wireAddBtn('ng_post_rest', 'post_rest_flags', allRestrs, 'bg-danger');

      renderFlags('ng_read_perm', 'read_perm_flags', [], allPerms, 'bg-success');
      renderFlags('ng_read_rest', 'read_rest_flags', [], allRestrs, 'bg-danger');
      renderFlags('ng_post_perm', 'post_perm_flags', [], allPerms, 'bg-success');
      renderFlags('ng_post_rest', 'post_rest_flags', [], allRestrs, 'bg-danger');

      // Live validation of qwk_conf_start in the new-group modal
      var ngStartInput  = document.getElementById('ng_qwk_conf_start');
      var ngStartStatus = document.getElementById('ng_qwk_conf_start_status');
      if (ngStartInput && ngStartStatus) {
        var ngStartTimer = null;
        ngStartInput.addEventListener('input', function() {
          if (ngStartTimer) clearTimeout(ngStartTimer);
          var v = ngStartInput.value;
          ngStartStatus.textContent = '';
          ngStartStatus.className = 'small mt-1';
          if (!v) return;
          ngStartTimer = setTimeout(function() {
            fetch('/admin/msgGroups/check-conf-start?n=' + encodeURIComponent(v))
              .then(function(r) { return r.json(); })
              .then(function(j) {
                if (j.available) {
                  ngStartStatus.textContent = '✓ available';
                  ngStartStatus.className = 'small mt-1 text-success';
                } else {
                  ngStartStatus.textContent = '✗ ' + (j.message || j.reason || 'invalid');
                  ngStartStatus.className = 'small mt-1 text-danger';
                }
              })
              .catch(function() {});
          }, 350);
        });
      }
    });