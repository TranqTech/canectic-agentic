extends ../../layouts/admin

block content
  .container-fluid.main-wrapper
    if !ismobile
      .row
        .col-12
          br
          br
      .row
        .col-2
        .col-8
          .card
            .card-header.bg-darkblue.text-white
              .row
                .col-8
                  h2= title
                .col-4
                  .text-end
                    a.button.btn.btn-lg.btn-info(href='/admin')
                      |Exit
            .card-body
              if errormessages && errormessages.length > 0
                ul.text-danger
                  for error of errormessages
                    li.text-danger
                      =error
                br

              .text-end
                form.d-inline(action='/admin/fileGroups/recalculateAreaCounts' method='POST')
                  button.btn.btn-sm.btn-outline-warning.me-2(type='submit')
                    i.bi.bi-arrow-repeat
                    |  Recalculate Area Counts
                a.btn.btn-lg.btn-info.me-2(href='/admin/fileAreas')
                  | All Areas
                button.btn.btn-lg.btn-success(data-bs-toggle='modal' data-bs-target=`#newGroupModal`)
                  |Add Group
              if grouplist && grouplist.length > 0
                br
                table#fileGroups.table.table-hover
                  thead
                    tr
                      th(style='width:30px')
                      th(scope='col') Name
                      th(scope='col') Shortcode
                      th(scope='col') Description
                      th(scope='col') Area Count
                  tbody#fgBody
                    for group of grouplist
                      tr(data-bs-shortcode=group.shortcode data-id=group.id draggable='true')
                        td.grip(style='cursor:grab')
                          i.bi.bi-grip-vertical
                        td= group.name
                        td= group.shortcode
                        td= group.description
                        td= group.area_count
                button.btn.btn-sm.btn-outline-primary.mt-2#saveFgOrder
                  i.bi.bi-sort-numeric-down.me-1
                  | Save Order
              else
                center
                  .h4
                    |No Groups Found!

      #newGroupModal.modal.fade(tabindex='-1' aria-labelledby='' aria-hidden='true')
        .modal-dialog.modal-dialog-centered.modal-lg
          .modal-content
            .modal-header.bg-dark.text-white
              h3.modal-title
                  |Add New File Group
              button.btn.btn-lg.btn-close(data-bs-dismiss="modal")
            .modal-body
              form(action=`/admin/fileGroup/new` method="POST" class="form-registration")

                //- ---- Tab nav ----
                ul.nav.nav-tabs.mb-3(role='tablist')
                  li.nav-item(role='presentation')
                    button.nav-link.active(type='button' role='tab' data-bs-toggle='tab' data-bs-target='#ng_tab_main') Main
                  li.nav-item(role='presentation')
                    button.nav-link(type='button' role='tab' data-bs-toggle='tab' data-bs-target='#ng_tab_access') Access
                  li.nav-item(role='presentation')
                    button.nav-link(type='button' role='tab' data-bs-toggle='tab' data-bs-target='#ng_tab_retention') Retention

                .tab-content
                  //- ============================================================
                  //- MAIN — identity, storage location, scan behaviour
                  //- ============================================================
                  .tab-pane.fade.show.active#ng_tab_main(role='tabpanel')
                    .mb-3
                      label.form-label(for="name") Name:
                      input.form-control(type="text" id="name" name="name" required)
                    .mb-3
                      label.form-label(for="description") Description:
                      input.form-control(type="text" id="description" name="description" required)
                    .mb-3
                      label.form-label(for="shortcode") Short Code:
                      input.form-control(type="text" id="shortcode" name="shortcode" required)
                    .mb-3
                      label.form-label(for="base_dir") Base Directory (optional):
                      .input-group
                        input.form-control(type="text" id="base_dir" name="base_dir" placeholder="/path/to/files")
                        button.btn.btn-outline-secondary#checkDirBtn(type='button') Check
                      #dirStatus.small.mt-1
                    .mb-3
                      label.form-label(for="ng_newscan") Newscan Default:
                      select#ng_newscan.form-select(name='newscan_default')
                        option(value='true' selected) Yes
                        option(value='false') No

                  //- ============================================================
                  //- ACCESS — security levels and flag defaults for new areas
                  //- ============================================================
                  .tab-pane.fade#ng_tab_access(role='tabpanel')
                    .row.mb-3
                      .col-4
                        label.form-label(for="ng_browsesecurity") Default Browse Security:
                        input.form-control(type="number" id="ng_browsesecurity" min=0 max=255 name="browsesecurity" value=50)
                      .col-4
                        label.form-label(for="ng_readsecurity") Default Download Security:
                        input.form-control(type="number" id="ng_readsecurity" min=1 max=255 name="readsecurity" value=60)
                      .col-4
                        label.form-label(for="ng_postsecurity") Default Upload Security:
                        input.form-control(type="number" id="ng_postsecurity" min=1 max=255 name="postsecurity" value=100)
                    .row
                      .col-4
                        #ng_browse_perm_inputs
                        #ng_browse_rest_inputs
                        label Browse Perm Flags (default for areas):
                        .border.rounded.p-2.mb-2.bg-light#ng_browse_perm_badges(style='min-height:2.2rem')
                        .input-group.mb-2
                          select#ng_browse_perm_select.form-control
                          button.btn.btn-sm.btn-success#ng_browse_perm_add(type='button') Add
                        label Browse Restrict Flags:
                        .border.rounded.p-2.mb-2.bg-light#ng_browse_rest_badges(style='min-height:2.2rem')
                        .input-group
                          select#ng_browse_rest_select.form-control
                          button.btn.btn-sm.btn-danger#ng_browse_rest_add(type='button') Add
                      .col-4
                        #ng_read_perm_inputs
                        #ng_read_rest_inputs
                        label Download Perm Flags (default for areas):
                        .border.rounded.p-2.mb-2.bg-light#ng_read_perm_badges(style='min-height:2.2rem')
                        .input-group.mb-2
                          select#ng_read_perm_select.form-control
                          button.btn.btn-sm.btn-success#ng_read_perm_add(type='button') Add
                        label Download Restrict Flags:
                        .border.rounded.p-2.mb-2.bg-light#ng_read_rest_badges(style='min-height:2.2rem')
                        .input-group
                          select#ng_read_rest_select.form-control
                          button.btn.btn-sm.btn-danger#ng_read_rest_add(type='button') Add
                      .col-4
                        #ng_post_perm_inputs
                        #ng_post_rest_inputs
                        label Upload Perm Flags (default for areas):
                        .border.rounded.p-2.mb-2.bg-light#ng_post_perm_badges(style='min-height:2.2rem')
                        .input-group.mb-2
                          select#ng_post_perm_select.form-control
                          button.btn.btn-sm.btn-success#ng_post_perm_add(type='button') Add
                        label Upload Restrict Flags:
                        .border.rounded.p-2.mb-2.bg-light#ng_post_rest_badges(style='min-height:2.2rem')
                        .input-group
                          select#ng_post_rest_select.form-control
                          button.btn.btn-sm.btn-danger#ng_post_rest_add(type='button') Add

                  //- ============================================================
                  //- RETENTION — automatic pruning defaults for new areas
                  //- ============================================================
                  .tab-pane.fade#ng_tab_retention(role='tabpanel')
                    .row
                      .col-6
                        label.form-label(for="ng_max_age") Max Age (days):
                          |
                          span(data-bs-toggle='tooltip' title='Default for new areas. Auto-remove files older than this. 0 or blank = no limit.') ⓘ
                        input.form-control(type='number' id='ng_max_age' name='max_age_days' min=0)
                      .col-6
                        label.form-label(for="ng_max_files") Max Files:
                          |
                          span(data-bs-toggle='tooltip' title='Default for new areas. Keep only the N newest files. 0 or blank = no limit.') ⓘ
                        input.form-control(type='number' id='ng_max_files' name='max_files' min=0)
                    .form-text.text-muted.mt-2
                      | These are defaults copied onto new areas in this group. Leave blank for no limit.

                .text-end.mt-3
                  input.btn.btn-lg.btn-success(type="submit" value="Submit")

  script.
    document.addEventListener('DOMContentLoaded', function() {
      // Directory check/create for base_dir
      var checkBtn = document.getElementById('checkDirBtn');
      var dirInput = document.getElementById('base_dir');
      var dirStatus = document.getElementById('dirStatus');
      if (checkBtn && dirInput) {
        checkBtn.addEventListener('click', function() {
          var dir = dirInput.value.trim();
          if (!dir) { dirStatus.innerHTML = '<span class="text-muted">Enter a path to check.</span>'; return; }
          dirStatus.innerHTML = '<span class="text-muted">Checking...</span>';
          fetch('/admin/fileGroup/checkdir?dir=' + encodeURIComponent(dir))
            .then(function(r) { return r.json(); })
            .then(function(data) {
              if (data.exists) {
                dirStatus.innerHTML = '<span class="text-success"><i class="bi bi-check-circle me-1"></i>Directory exists: ' + data.path + '</span>';
              } else {
                dirStatus.innerHTML = '<span class="text-warning"><i class="bi bi-exclamation-triangle me-1"></i>Directory does not exist: ' + (data.path || dir) + '</span> ' +
                  '<button type="button" class="btn btn-sm btn-outline-success ms-2" id="createDirBtn"><i class="bi bi-folder-plus me-1"></i>Create</button>';
                document.getElementById('createDirBtn').addEventListener('click', function() {
                  fetch('/admin/fileGroup/mkdir', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ dir: dir })
                  })
                  .then(function(r) { return r.json(); })
                  .then(function(res) {
                    if (res.status) {
                      dirStatus.innerHTML = '<span class="text-success"><i class="bi bi-check-circle me-1"></i>Directory created: ' + res.path + '</span>';
                    } else {
                      dirStatus.innerHTML = '<span class="text-danger"><i class="bi bi-x-circle me-1"></i>Failed: ' + (res.error || 'Unknown error') + '</span>';
                    }
                  });
                });
              }
            })
            .catch(function(err) {
              dirStatus.innerHTML = '<span class="text-danger">Error: ' + err.message + '</span>';
            });
        });
      }

    // Add click event listener to table rows
    // (rest of existing DOMContentLoaded code follows)
      const table = document.getElementById('fileGroups');

      if (table) {
        // Add click event to all tbody rows
        const rows = table.querySelectorAll('tbody tr');

        rows.forEach(row => {
          // Add pointer cursor to indicate clickable rows
          row.style.cursor = 'pointer';

          row.addEventListener('click', function() {
            const shortcode = this.getAttribute('data-bs-shortcode');

            if (shortcode) {
              // Navigate to the fileGroup page
              window.location.href = `/admin/fileGroup/${shortcode}`;
            }
          });
        });
      }

      // --- Drag-to-reorder file groups ---
      var fgBody = document.getElementById('fgBody');
      if (fgBody) {
        var dragRow = null;
        fgBody.addEventListener('dragstart', function(e) {
          dragRow = e.target.closest('tr');
          if (dragRow) e.dataTransfer.effectAllowed = 'move';
        });
        fgBody.addEventListener('dragover', function(e) {
          e.preventDefault();
          var target = e.target.closest('tr');
          if (target && target !== dragRow) {
            var rect = target.getBoundingClientRect();
            if (e.clientY < rect.top + rect.height / 2) {
              fgBody.insertBefore(dragRow, target);
            } else {
              fgBody.insertBefore(dragRow, target.nextSibling);
            }
          }
        });
        fgBody.querySelectorAll('.grip').forEach(function(grip) {
          grip.addEventListener('click', function(e) { e.stopPropagation(); });
        });
      }
      var saveFgBtn = document.getElementById('saveFgOrder');
      if (saveFgBtn) {
        saveFgBtn.addEventListener('click', function() {
          var rows = document.querySelectorAll('#fgBody tr');
          var ids = [];
          rows.forEach(function(r) { ids.push(r.getAttribute('data-id')); });
          fetch('/admin/fileGroups/reorder', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ids: ids })
          }).then(function() { location.reload(); });
        });
      }

      // --- Flag management for new group modal ---
      var allPerms  = !{JSON.stringify(availablePermissions)};
      var allRestrs = !{JSON.stringify(availableRestrictions)};

      function renderAreaFlags(prefix, inputName, activeFlags, allFlags, badgeClass) {
        var badgeEl  = document.getElementById(prefix + '_badges');
        var inputEl  = document.getElementById(prefix + '_inputs');
        var selectEl = document.getElementById(prefix + '_select');
        var addBtn   = document.getElementById(prefix + '_add');

        badgeEl.innerHTML = '';
        activeFlags.forEach(function(flag) {
          var span = document.createElement('span');
          span.className = 'badge ' + badgeClass + ' me-1 mb-1';
          span.style.cursor = 'pointer';
          span.title = 'Click to remove';
          span.textContent = flag + ' ×';
          span.addEventListener('click', function() {
            var updated = activeFlags.filter(function(f) { return f !== flag; });
            renderAreaFlags(prefix, inputName, updated, allFlags, badgeClass);
          });
          badgeEl.appendChild(span);
        });

        inputEl.innerHTML = '';
        activeFlags.forEach(function(flag) {
          var inp = document.createElement('input');
          inp.type  = 'hidden';
          inp.name  = inputName;
          inp.value = flag;
          inputEl.appendChild(inp);
        });

        selectEl.innerHTML = '';
        var available = allFlags.filter(function(f) { return !activeFlags.includes(f); });
        if (available.length === 0) {
          var opt = document.createElement('option');
          opt.value = '';
          opt.textContent = '— none available —';
          opt.disabled = true;
          selectEl.appendChild(opt);
          selectEl.disabled = true;
          addBtn.disabled = true;
        } else {
          selectEl.disabled = false;
          addBtn.disabled = false;
          available.forEach(function(flag) {
            var opt = document.createElement('option');
            opt.value = flag;
            opt.textContent = flag;
            selectEl.appendChild(opt);
          });
        }
      }

      function wireAddBtn(prefix, inputName, allFlags, badgeClass) {
        document.getElementById(prefix + '_add').addEventListener('click', function() {
          var sel = document.getElementById(prefix + '_select');
          if (!sel.value) return;
          var current = Array.from(document.querySelectorAll('#' + prefix + '_inputs input')).map(function(i) { return i.value; });
          if (!current.includes(sel.value)) {
            current.push(sel.value);
            renderAreaFlags(prefix, inputName, current, allFlags, badgeClass);
          }
        });
      }

      wireAddBtn('ng_browse_perm', 'browse_perm_flags', allPerms, 'bg-success');
      wireAddBtn('ng_browse_rest', 'browse_rest_flags', allRestrs, 'bg-danger');
      wireAddBtn('ng_read_perm', 'read_perm_flags', allPerms, 'bg-success');
      wireAddBtn('ng_read_rest', 'read_rest_flags', allRestrs, 'bg-danger');
      wireAddBtn('ng_post_perm', 'post_perm_flags', allPerms, 'bg-success');
      wireAddBtn('ng_post_rest', 'post_rest_flags', allRestrs, 'bg-danger');

      renderAreaFlags('ng_browse_perm', 'browse_perm_flags', [], allPerms, 'bg-success');
      renderAreaFlags('ng_browse_rest', 'browse_rest_flags', [], allRestrs, 'bg-danger');
      renderAreaFlags('ng_read_perm', 'read_perm_flags', [], allPerms, 'bg-success');
      renderAreaFlags('ng_read_rest', 'read_rest_flags', [], allRestrs, 'bg-danger');
      renderAreaFlags('ng_post_perm', 'post_perm_flags', [], allPerms, 'bg-success');
      renderAreaFlags('ng_post_rest', 'post_rest_flags', [], allRestrs, 'bg-danger');
    });
