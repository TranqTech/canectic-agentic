extends ../../layouts/admin

block content
  .container-fluid.main-wrapper
    if !currentuser
      - loginMode = 'guard'
      - loginRedirect = currentPath
      include ../../partials/users/login.pug
    else if !sufficientAccess
      include ../../partials/status/unauthorized.pug
    else
      if !ismobile
        .row
          .col-12
            br
            br
        .row
          .col-1
          .col-8
            if !fileGroup
              .card
                .card-header.bg-darkblue.text-white
                  .row
                    .col-8
                      h2= title
                    .col-4
                      .text-end
                        a.button.btn.btn-sm.btn-info(href='/admin/fileGroups')
                          | Exit
                .card-body
                  br
                  h3 Data Not Found!
                  br
            else
              .card
                .card-header.bg-darkblue.text-white
                  .row
                    .col-8
                      h2= title
                    .col-4
                      .text-end
                        a.button.btn.btn-sm.btn-info(href='/admin/fileGroups')
                          | Exit
                .card-body
                  h4= fileGroup.description
                  .row
                    .col-6
                      h5
                        | Shortcode:
                        = fileGroup.shortcode
                      h5
                        | Browse Security:
                        = fileGroup.browse_security || '—'
                      h5
                        | Download Security:
                        = fileGroup.read_security || '—'
                      if fileGroup.base_dir
                        h5
                          | Base Directory:
                          = fileGroup.base_dir
                    .col-6
                      h5
                        | Upload Security:
                        = fileGroup.post_security || '—'
                      h5
                        | Newscan Default:
                        = fileGroup.newscan_default !== false ? 'Yes' : 'No'
              .card
                .card-header.bg-darkblue.text-white
                  h4 File Areas
                .card-body
                  .row
                    .col-1
                    .col-10
                      if arealist && arealist.length > 0
                        br
                        table#fileAreas.table.table-hover
                          thead
                            tr
                              th(style='width:30px')
                              th(scope='col') Name
                              th(scope='col') Shortcode
                              th(scope='col') Description
                              th(scope='col') Sub Dir
                              th(scope='col') File Count
                              th(scope='col') Total Size
                              th(scope='col') Latest
                              th(scope='col')
                          tbody#faBody
                            for area of arealist
                              tr(
                                data-bs-id=area.id
                                data-bs-shortcode=area.shortcode
                                data-bs-name=area.name
                                data-bs-description=area.description
                                data-bs-subdir=(area.sub_dir || '')
                                data-bs-browsesecurity=area.browse_security
                                data-bs-readsecurity=area.read_security
                                data-bs-postsecurity=area.post_security
                                data-bs-active=(area.active ? 'true' : 'false')
                                data-bs-newscandefault=(area.newscan_default ? 'true' : 'false')
                                data-bs-filecount=area.file_count || 0
                                data-bs-totalbytes=area.total_bytes || 0
                                data-bs-lastupload=area.last_upload || ''
                                data-bs-lastfilename=area.last_filename || ''
                                data-bs-lastuploader=area.last_uploader || ''
                                data-bs-browsepermflags=JSON.stringify(area.browse_perm_flags || [])
                                data-bs-browserestflags=JSON.stringify(area.browse_rest_flags || [])
                                data-bs-readpermflags=JSON.stringify(area.read_perm_flags || [])
                                data-bs-readrestflags=JSON.stringify(area.read_rest_flags || [])
                                data-bs-postpermflags=JSON.stringify(area.post_perm_flags || [])
                                data-bs-postrestflags=JSON.stringify(area.post_rest_flags || [])
                                draggable='true'
                              )
                                td.grip(style='cursor:grab')
                                  i.bi.bi-grip-vertical
                                td= area.name
                                td= area.shortcode
                                td= area.description
                                td= area.sub_dir || '—'
                                td.text-end
                                  - var fcount = (area.file_count || 0).toLocaleString()
                                  = fcount
                                td.text-end
                                  - var tbytes = area.total_bytes || 0
                                  if tbytes >= 1073741824
                                    = (tbytes / 1073741824).toFixed(1) + ' GB'
                                  else if tbytes >= 1048576
                                    = (tbytes / 1048576).toFixed(1) + ' MB'
                                  else if tbytes >= 1024
                                    = (tbytes / 1024).toFixed(1) + ' KB'
                                  else
                                    = tbytes + ' B'
                                td
                                  if area.last_upload
                                    .text-end
                                      - var e1date = Date.parse(area.last_upload)
                                      - var edate = DateTime.fromMillis(e1date)
                                      = edate.toFormat('MMMM dd, yyyy')
                                  else
                                    center
                                      | N/A
                                td.text-center
                                  a.btn.btn-sm.btn-outline-info(href=`/admin/fileArea/${area.shortcode}` onclick='event.stopPropagation()') Browse
                        button.btn.btn-sm.btn-outline-primary.mt-2#saveFaOrder
                          i.bi.bi-sort-numeric-down.me-1
                          | Save Order
                      else
                        center
                          h4 No Areas Found

          .col-2
            .row
              .col-12
                .card.bg-light
                  .card-header.bg-darkblue.text-white
                    .h6 Quick Actions
                  .card-body.bg-dark
                    .d-grid.gap-1
                      a.button.btn.btn-danger(href='/admin/fileGroups')
                        | Exit
                      if fileGroup
                        br
                        h6.text-white.mb-1 Group:
                        button.btn.btn-warning.w-100(data-bs-toggle='modal' data-bs-target='#editGroupModal')
                          | Edit Group
                        button.btn.btn-danger.w-100(data-bs-toggle='modal' data-bs-target='#deleteGroupModal')
                          | Delete Group
                        br
                        h6.text-white.mb-1 Areas:
                        button.btn.btn-success.w-100(data-bs-toggle='modal' data-bs-target='#newAreaModal')
                          | Add Area

        if fileGroup

          // Area Info Modal (dynamically populated on row click)
          #areaInfoModal.modal.fade(tabindex='-1' aria-labelledby='' aria-hidden='true')
            .modal-dialog.modal-dialog-centered.modal-lg
              .modal-content
                .modal-header.bg-dark.text-white
                  h3.modal-title#areaInfoTitle
                  .row.w-100
                    .col-12.text-end
                      button.btn.btn-sm.btn-warning#areaEditBtn Edit
                      |
                      button.btn.btn-sm.btn-danger#areaDeleteBtn Delete
                      |
                      button.btn.btn-sm.btn-close(data-bs-dismiss='modal')
                .modal-body.bg-dark.text-white
                  .row
                    .col-6
                      p
                        strong Shortcode:
                        |
                        span#areaInfoShortcode
                      p
                        strong Sub Directory:
                        |
                        span#areaInfoSubDir
                      p
                        strong Status:
                        |
                        span#areaInfoActive
                      p
                        strong Newscan Default:
                        |
                        span#areaInfoNewscan
                    .col-6
                      p
                        strong Browse Security:
                        |
                        span#areaInfoBrowseSec
                      p
                        strong Download Security:
                        |
                        span#areaInfoReadSec
                      p
                        strong Upload Security:
                        |
                        span#areaInfoPostSec
                      p
                        strong Files:
                        |
                        span#areaInfoFileCount
                      p
                        strong Total Size:
                        |
                        span#areaInfoTotalSize
                  hr.border-secondary
                  .row
                    .col-12
                      p
                        strong Browse Perm Flags:
                        |
                        span#areaInfoBrowsePermFlags
                      p
                        strong Browse Restrict Flags:
                        |
                        span#areaInfoBrowseRestFlags
                  hr.border-secondary
                  .row
                    .col-6
                      p
                        strong Download Perm Flags:
                        |
                        span#areaInfoReadPermFlags
                      p
                        strong Upload Perm Flags:
                        |
                        span#areaInfoPostPermFlags
                    .col-6
                      p
                        strong Download Restrict Flags:
                        |
                        span#areaInfoReadRestFlags
                      p
                        strong Upload Restrict Flags:
                        |
                        span#areaInfoPostRestFlags
                  hr.border-secondary
                  .row
                    .col-12
                      p#areaInfoDescription
                    .col-6
                      p
                        small Last Uploader:
                        |
                        span#areaInfoLastUploader
                      p
                        small Last File:
                        |
                        span#areaInfoLastFilename
                    .col-6.text-end
                      p
                        small Last Upload:
                        |
                        span#areaInfoLastUpload

          // Edit Area Modal (dynamically populated)
          #editAreaModal.modal.fade(tabindex='-1' aria-labelledby='' aria-hidden='true')
            .modal-dialog.modal-dialog-centered.modal-lg
              .modal-content
                .modal-header.bg-dark.text-white
                  h3.modal-title Edit File Area
                  button.btn.btn-lg.btn-close(data-bs-dismiss='modal')
                .modal-body
                  form#editAreaForm(method='POST' class='form-registration')
                    input(type='hidden' name='groupshortcode' value=fileGroup.shortcode)
                    .row
                      .col-1
                      .col-10
                        label(for='ea_name') Name:
                        input(
                          type='text'
                          id='ea_name'
                          name='name'
                          class='form-control'
                          tabindex='1'
                          required
                        )
                        br
                        label(for='ea_description') Description:
                        input(
                          type='text'
                          id='ea_description'
                          name='description'
                          class='form-control'
                          tabindex='2'
                          required
                        )
                        br
                    .row
                      .col-1
                      .col-5
                        label(for='ea_subdir') Sub Directory:
                        input(
                          type='text'
                          id='ea_subdir'
                          name='sub_dir'
                          class='form-control'
                          tabindex='3'
                        )
                        br
                        label(for='ea_newscan') Newscan Default:
                        select(
                          id='ea_newscan'
                          name='newscan_default'
                          class='form-control'
                          tabindex='4'
                        )
                          option(value='true') Yes
                          option(value='false') No
                      .col-5
                        label(for='ea_browsesecurity') Browse Security:
                        input(
                          type='number'
                          id='ea_browsesecurity'
                          name='browsesecurity'
                          class='form-control'
                          min=0
                          max=255
                          tabindex='5'
                          required
                        )
                        br
                        label(for='ea_readsecurity') Download Security:
                        input(
                          type='number'
                          id='ea_readsecurity'
                          name='readsecurity'
                          class='form-control'
                          min=1
                          max=255
                          tabindex='6'
                          required
                        )
                        br
                        label(for='ea_postsecurity') Upload Security:
                        input(
                          type='number'
                          id='ea_postsecurity'
                          name='postsecurity'
                          class='form-control'
                          min=1
                          max=255
                          tabindex='7'
                          required
                        )
                        br
                        label(for='ea_active') Status:
                        select(
                          id='ea_active'
                          name='active'
                          class='form-control'
                          tabindex='8'
                        )
                          option(value='true') Active
                          option(value='false') Inactive
                    .row
                      .col-1
                      .col-10
                        //- Hidden inputs for flags — managed by JS
                        #ea_browse_perm_inputs
                        #ea_browse_rest_inputs
                        label Browse Permission Flags:
                        .border.rounded.p-2.mb-2.bg-light#ea_browse_perm_badges(style='min-height:2.2rem')
                        .input-group.mb-2
                          select#ea_browse_perm_select.form-control
                          button.btn.btn-sm.btn-success#ea_browse_perm_add(type='button') Add
                        label Browse Restriction Flags:
                        .border.rounded.p-2.mb-2.bg-light#ea_browse_rest_badges(style='min-height:2.2rem')
                        .input-group
                          select#ea_browse_rest_select.form-control
                          button.btn.btn-sm.btn-danger#ea_browse_rest_add(type='button') Add
                    .row
                      .col-1
                      .col-5
                        #ea_read_perm_inputs
                        #ea_read_rest_inputs
                        label Download Permission Flags:
                        .border.rounded.p-2.mb-2.bg-light#ea_read_perm_badges(style='min-height:2.2rem')
                        .input-group.mb-2
                          select#ea_read_perm_select.form-control
                          button.btn.btn-sm.btn-success#ea_read_perm_add(type='button') Add
                        label Download Restriction Flags:
                        .border.rounded.p-2.mb-2.bg-light#ea_read_rest_badges(style='min-height:2.2rem')
                        .input-group
                          select#ea_read_rest_select.form-control
                          button.btn.btn-sm.btn-danger#ea_read_rest_add(type='button') Add
                      .col-5
                        #ea_post_perm_inputs
                        #ea_post_rest_inputs
                        label Upload Permission Flags:
                        .border.rounded.p-2.mb-2.bg-light#ea_post_perm_badges(style='min-height:2.2rem')
                        .input-group.mb-2
                          select#ea_post_perm_select.form-control
                          button.btn.btn-sm.btn-success#ea_post_perm_add(type='button') Add
                        label Upload Restriction Flags:
                        .border.rounded.p-2.mb-2.bg-light#ea_post_rest_badges(style='min-height:2.2rem')
                        .input-group
                          select#ea_post_rest_select.form-control
                          button.btn.btn-sm.btn-danger#ea_post_rest_add(type='button') Add
                    .row
                      .col-1
                      .col-10
                        br
                        .text-end
                          input(
                            type='submit'
                            value='Save Changes'
                            class='btn btn-lg btn-warning btn-block'
                            tabindex='9'
                          )

          // Delete Area Modal (dynamically populated)
          #deleteAreaModal.modal.fade(tabindex='-1' aria-labelledby='' aria-hidden='true')
            .modal-dialog.modal-dialog-centered
              .modal-content
                .modal-header.bg-danger.text-white
                  h3.modal-title Delete File Area
                  button.btn.btn-lg.btn-close(data-bs-dismiss='modal')
                .modal-body.bg-dark.text-white
                  .row
                    .col-1
                    .col-10
                      .alert.alert-danger
                        h5 Warning
                        p
                          | This will permanently delete the file area
                          strong#deleteAreaName
                          | .
                      p This action cannot be undone.
                      br
                      label(for='da_delete_files') Files on Disk:
                      select#da_delete_files.form-control
                        option(value='false') Leave files on disk
                        option(value='true') Delete files from disk
                      br
                      .alert.alert-warning#da_deleteFilesWarning(style='display:none')
                        | This will permanently remove all files in this area from disk.
                .modal-footer.bg-dark
                  form#deleteAreaForm(method='POST')
                    input(type='hidden' name='delete_files' id='da_delete_files_hidden' value='false')
                    button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cancel
                    |
                    input(
                      type='submit'
                      value='Delete Area'
                      class='btn btn-danger'
                    )

          // New Area Modal
          #newAreaModal.modal.fade(tabindex='-1' aria-labelledby='' aria-hidden='true')
            .modal-dialog.modal-dialog-centered.modal-lg
              .modal-content
                .modal-header.bg-dark.text-white
                  h3.modal-title Add File Area
                  button.btn.btn-lg.btn-close(data-bs-dismiss='modal')
                .modal-body
                  form(action=`/admin/fileGroup/${fileGroup.shortcode}/newArea` method='POST' class='form-registration')
                    .row
                      .col-1
                      .col-10
                        label(for='na_name') Name:
                        input(
                          type='text'
                          id='na_name'
                          name='name'
                          class='form-control'
                          required
                        )
                        br
                        label(for='na_description') Description:
                        input(
                          type='text'
                          id='na_description'
                          name='description'
                          class='form-control'
                          required
                        )
                        br
                    .row
                      .col-1
                      .col-5
                        label(for='na_shortcode') Short Code (Internal):
                        input(
                          type='text'
                          id='na_shortcode'
                          name='shortcode'
                          class='form-control'
                          required
                        )
                        br
                        label(for='na_subdir') Sub Directory:
                        input(
                          type='text'
                          id='na_subdir'
                          name='sub_dir'
                          class='form-control'
                          placeholder='games'
                        )
                        br
                        label(for='na_newscan') Newscan Default:
                        select#na_newscan(name='newscan_default').form-select
                          option(value='true' selected=(fileGroup.newscan_default !== false)) Yes
                          option(value='false' selected=(fileGroup.newscan_default === false)) No
                      .col-5
                        label(for='na_browsesecurity') Browse Security:
                        input(
                          type='number'
                          id='na_browsesecurity'
                          min=0
                          max=255
                          name='browsesecurity'
                          class='form-control'
                          value=(fileGroup.browse_security || 0)
                          required
                        )
                        br
                        label(for='na_readsecurity') Download Security:
                        input(
                          type='number'
                          id='na_readsecurity'
                          min=1
                          max=255
                          name='readsecurity'
                          class='form-control'
                          value=(fileGroup.read_security || 50)
                          required
                        )
                        br
                        label(for='na_postsecurity') Upload Security:
                        input(
                          type='number'
                          id='na_postsecurity'
                          min=1
                          max=255
                          name='postsecurity'
                          class='form-control'
                          value=(fileGroup.post_security != null ? fileGroup.post_security : 100)
                          required
                        )
                        br
                        label(for='na_active') Status:
                        select#na_active(name='active').form-select
                          option(value='true' selected) Active
                          option(value='false') Inactive
                    .row
                      .col-1
                      .col-10
                        #na_browse_perm_inputs
                        #na_browse_rest_inputs
                        label Browse Permission Flags:
                        .border.rounded.p-2.mb-2.bg-light#na_browse_perm_badges(style='min-height:2.2rem')
                        .input-group.mb-2
                          select#na_browse_perm_select.form-control
                          button.btn.btn-sm.btn-success#na_browse_perm_add(type='button') Add
                        label Browse Restriction Flags:
                        .border.rounded.p-2.mb-2.bg-light#na_browse_rest_badges(style='min-height:2.2rem')
                        .input-group
                          select#na_browse_rest_select.form-control
                          button.btn.btn-sm.btn-danger#na_browse_rest_add(type='button') Add
                    .row
                      .col-1
                      .col-5
                        #na_read_perm_inputs
                        #na_read_rest_inputs
                        label Download Permission Flags:
                        .border.rounded.p-2.mb-2.bg-light#na_read_perm_badges(style='min-height:2.2rem')
                        .input-group.mb-2
                          select#na_read_perm_select.form-control
                          button.btn.btn-sm.btn-success#na_read_perm_add(type='button') Add
                        label Download Restriction Flags:
                        .border.rounded.p-2.mb-2.bg-light#na_read_rest_badges(style='min-height:2.2rem')
                        .input-group
                          select#na_read_rest_select.form-control
                          button.btn.btn-sm.btn-danger#na_read_rest_add(type='button') Add
                      .col-5
                        #na_post_perm_inputs
                        #na_post_rest_inputs
                        label Upload Permission Flags:
                        .border.rounded.p-2.mb-2.bg-light#na_post_perm_badges(style='min-height:2.2rem')
                        .input-group.mb-2
                          select#na_post_perm_select.form-control
                          button.btn.btn-sm.btn-success#na_post_perm_add(type='button') Add
                        label Upload Restriction Flags:
                        .border.rounded.p-2.mb-2.bg-light#na_post_rest_badges(style='min-height:2.2rem')
                        .input-group
                          select#na_post_rest_select.form-control
                          button.btn.btn-sm.btn-danger#na_post_rest_add(type='button') Add
                    .row
                      .col-1
                      .col-10
                        br
                        .text-end
                          input(
                            type='submit'
                            value='Submit'
                            class='btn btn-lg btn-success btn-block'
                          )

          // Edit Group Modal
          #editGroupModal.modal.fade(tabindex='-1' aria-labelledby='' aria-hidden='true')
            .modal-dialog.modal-dialog-centered.modal-lg
              .modal-content
                .modal-header.bg-dark.text-white
                  h3.modal-title Edit Group
                  button.btn.btn-lg.btn-close(data-bs-dismiss='modal')
                .modal-body
                  form(action=`/admin/fileGroup/${fileGroup.shortcode}/update` method='POST' class='form-registration')
                    .row
                      .col-1
                      .col-10
                        label(for='edit_name') Name:
                        input(
                          type='text'
                          id='edit_name'
                          name='name'
                          class='form-control'
                          tabindex='1'
                          value=fileGroup.name
                          required
                        )
                        br
                        label(for='edit_description') Description:
                        input(
                          type='text'
                          id='edit_description'
                          name='description'
                          class='form-control'
                          tabindex='2'
                          value=fileGroup.description
                          required
                        )
                        br
                        label(for='edit_base_dir') Base Directory:
                        input(
                          type='text'
                          id='edit_base_dir'
                          name='base_dir'
                          class='form-control'
                          tabindex='3'
                          value=fileGroup.base_dir || ''
                        )
                        br
                    .row
                      .col-1
                      .col-5
                        label(for='edit_browsesecurity') Browse Security:
                        input(
                          type='number'
                          id='edit_browsesecurity'
                          name='browsesecurity'
                          class='form-control'
                          tabindex='4'
                          min=0
                          max=255
                          value=fileGroup.browse_security || 0
                        )
                        br
                        label(for='edit_readsecurity') Download Security:
                        input(
                          type='number'
                          id='edit_readsecurity'
                          name='readsecurity'
                          class='form-control'
                          tabindex='5'
                          min=0
                          max=255
                          value=fileGroup.read_security || 0
                        )
                        br
                        label(for='edit_postsecurity') Upload Security:
                        input(
                          type='number'
                          id='edit_postsecurity'
                          name='postsecurity'
                          class='form-control'
                          tabindex='6'
                          min=0
                          max=255
                          value=fileGroup.post_security || 0
                        )
                      .col-5
                        label(for='edit_active') Status:
                        select(
                          id='edit_active'
                          name='active'
                          class='form-control'
                          tabindex='7'
                        )
                          option(value='true'  selected=(fileGroup.active == true))  Active
                          option(value='false' selected=(fileGroup.active == false)) Inactive
                        br
                        label(for='edit_newscan') Newscan Default:
                        select(
                          id='edit_newscan'
                          name='newscan_default'
                          class='form-control'
                          tabindex='8'
                        )
                          option(value='true'  selected=(fileGroup.newscan_default !== false))  Yes
                          option(value='false' selected=(fileGroup.newscan_default === false)) No
                    .row
                      .col-1
                      .col-10
                        #eg_browse_perm_inputs
                        #eg_browse_rest_inputs
                        br
                        label Browse Perm Flags (default for areas):
                        .border.rounded.p-2.mb-2.bg-light#eg_browse_perm_badges(style='min-height:2.2rem')
                        .input-group.mb-2
                          select#eg_browse_perm_select.form-control
                          button.btn.btn-sm.btn-success#eg_browse_perm_add(type='button') Add
                        label Browse Restrict Flags:
                        .border.rounded.p-2.mb-2.bg-light#eg_browse_rest_badges(style='min-height:2.2rem')
                        .input-group
                          select#eg_browse_rest_select.form-control
                          button.btn.btn-sm.btn-danger#eg_browse_rest_add(type='button') Add
                    .row
                      .col-1
                      .col-5
                        #eg_read_perm_inputs
                        #eg_read_rest_inputs
                        br
                        label Download Perm Flags (default for areas):
                        .border.rounded.p-2.mb-2.bg-light#eg_read_perm_badges(style='min-height:2.2rem')
                        .input-group.mb-2
                          select#eg_read_perm_select.form-control
                          button.btn.btn-sm.btn-success#eg_read_perm_add(type='button') Add
                        label Download Restrict Flags:
                        .border.rounded.p-2.mb-2.bg-light#eg_read_rest_badges(style='min-height:2.2rem')
                        .input-group
                          select#eg_read_rest_select.form-control
                          button.btn.btn-sm.btn-danger#eg_read_rest_add(type='button') Add
                      .col-5
                        #eg_post_perm_inputs
                        #eg_post_rest_inputs
                        br
                        label Upload Perm Flags (default for areas):
                        .border.rounded.p-2.mb-2.bg-light#eg_post_perm_badges(style='min-height:2.2rem')
                        .input-group.mb-2
                          select#eg_post_perm_select.form-control
                          button.btn.btn-sm.btn-success#eg_post_perm_add(type='button') Add
                        label Upload Restrict Flags:
                        .border.rounded.p-2.mb-2.bg-light#eg_post_rest_badges(style='min-height:2.2rem')
                        .input-group
                          select#eg_post_rest_select.form-control
                          button.btn.btn-sm.btn-danger#eg_post_rest_add(type='button') Add
                    .row
                      .col-1
                      .col-10
                        br
                        .text-end
                          input(
                            type='submit'
                            value='Save Changes'
                            class='btn btn-lg btn-warning btn-block'
                            tabindex='8'
                          )

          // Delete Group Modal
          #deleteGroupModal.modal.fade(tabindex='-1' aria-labelledby='' aria-hidden='true')
            .modal-dialog.modal-dialog-centered
              .modal-content
                .modal-header.bg-danger.text-white
                  h3.modal-title Delete Group
                  button.btn.btn-lg.btn-close(data-bs-dismiss='modal')
                .modal-body.bg-dark.text-white
                  .row
                    .col-1
                    .col-10
                      .alert.alert-danger
                        h5 Warning
                        p
                          | This will permanently delete the group
                          strong= fileGroup.name
                          |  and all of its file areas.
                      p This action cannot be undone. All areas belonging to this group will be removed.
                      br
                      label Files on Disk:
                      select#delete_files.form-control
                        option(value='false') Leave files on disk
                        option(value='true') Delete files from disk
                      br
                      .alert.alert-warning(id='deleteFilesWarning' style='display:none')
                        | Selecting this option will permanently remove all files in every area of this group from disk.
                .modal-footer.bg-dark
                  form(action=`/admin/fileGroup/${fileGroup.shortcode}/delete` method='POST')
                    input(type='hidden' name='delete_files' id='delete_files_hidden' value='false')
                    button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cancel
                    |
                    input(
                      type='submit'
                      value='Delete Group'
                      class='btn btn-danger'
                    )

    script.
      document.addEventListener('DOMContentLoaded', function() {

        const areaInfoModal   = new bootstrap.Modal(document.getElementById('areaInfoModal'));
        const editAreaModal   = new bootstrap.Modal(document.getElementById('editAreaModal'));
        const deleteAreaModal = new bootstrap.Modal(document.getElementById('deleteAreaModal'));

        var currentAreaShortcode = '';

        const allPerms  = !{JSON.stringify(availablePermissions)};
        const allRestrs = !{JSON.stringify(availableRestrictions)};

        function parseFlags(jsonstr) {
          try {
            var result = JSON.parse(jsonstr);
            return Array.isArray(result) ? result : [];
          } catch(e) { return []; }
        }

        function fmtFlags(jsonstr) {
          var arr = parseFlags(jsonstr);
          return arr.length > 0 ? arr.join(', ') : '—';
        }

        function formatBytes(bytes) {
          var b = parseInt(bytes) || 0;
          if (b >= 1073741824) return (b / 1073741824).toFixed(1) + ' GB';
          if (b >= 1048576) return (b / 1048576).toFixed(1) + ' MB';
          if (b >= 1024) return (b / 1024).toFixed(1) + ' KB';
          return b + ' B';
        }

        // Renders badges + hidden inputs for a flag editor group.
        function renderAreaFlags(prefix, inputName, activeFlags, allFlags, badgeClass) {
          var badgeEl  = document.getElementById(prefix + '_badges');
          var inputEl  = document.getElementById(prefix + '_inputs');
          var selectEl = document.getElementById(prefix + '_select');
          var addBtn   = document.getElementById(prefix + '_add');

          // Badges
          badgeEl.innerHTML = '';
          activeFlags.forEach(function(flag) {
            var span = document.createElement('span');
            span.className = 'badge ' + badgeClass + ' me-1 mb-1';
            span.style.cursor = 'pointer';
            span.title = 'Click to remove';
            span.textContent = flag + ' ×';
            span.addEventListener('click', function() {
              var updated = activeFlags.filter(function(f) { return f !== flag; });
              renderAreaFlags(prefix, inputName, updated, allFlags, badgeClass);
            });
            badgeEl.appendChild(span);
          });

          // Hidden inputs
          inputEl.innerHTML = '';
          activeFlags.forEach(function(flag) {
            var inp = document.createElement('input');
            inp.type  = 'hidden';
            inp.name  = inputName;
            inp.value = flag;
            inputEl.appendChild(inp);
          });

          // Select — only show flags not already active
          selectEl.innerHTML = '';
          var available = allFlags.filter(function(f) { return !activeFlags.includes(f); });
          if (available.length === 0) {
            var opt = document.createElement('option');
            opt.value = '';
            opt.textContent = '— none available —';
            opt.disabled = true;
            selectEl.appendChild(opt);
            selectEl.disabled = true;
            addBtn.disabled = true;
          } else {
            selectEl.disabled = false;
            addBtn.disabled = false;
            available.forEach(function(flag) {
              var opt = document.createElement('option');
              opt.value = flag;
              opt.textContent = flag;
              selectEl.appendChild(opt);
            });
          }
        }

        // Wire add buttons for a flag group
        function wireAddBtn(prefix, inputName, allFlags, badgeClass) {
          document.getElementById(prefix + '_add').addEventListener('click', function() {
            var sel = document.getElementById(prefix + '_select');
            if (!sel.value) return;
            var current = Array.from(document.querySelectorAll('#' + prefix + '_inputs input')).map(function(i) { return i.value; });
            if (!current.includes(sel.value)) {
              current.push(sel.value);
              renderAreaFlags(prefix, inputName, current, allFlags, badgeClass);
            }
          });
        }

        // Wire edit-area flag add buttons (only exist when fileGroup is set)
        if (document.getElementById('ea_browse_perm_add')) {
          wireAddBtn('ea_browse_perm', 'browse_perm_flags', allPerms, 'bg-success');
          wireAddBtn('ea_browse_rest', 'browse_rest_flags', allRestrs, 'bg-danger');
          wireAddBtn('ea_read_perm', 'read_perm_flags', allPerms, 'bg-success');
          wireAddBtn('ea_read_rest', 'read_rest_flags', allRestrs, 'bg-danger');
          wireAddBtn('ea_post_perm', 'post_perm_flags', allPerms, 'bg-success');
          wireAddBtn('ea_post_rest', 'post_rest_flags', allRestrs, 'bg-danger');
        }

        // Wire new-area flag add buttons
        if (document.getElementById('na_browse_perm_add')) {
          wireAddBtn('na_browse_perm', 'browse_perm_flags', allPerms, 'bg-success');
          wireAddBtn('na_browse_rest', 'browse_rest_flags', allRestrs, 'bg-danger');
          wireAddBtn('na_read_perm', 'read_perm_flags', allPerms, 'bg-success');
          wireAddBtn('na_read_rest', 'read_rest_flags', allRestrs, 'bg-danger');
          wireAddBtn('na_post_perm', 'post_perm_flags', allPerms, 'bg-success');
          wireAddBtn('na_post_rest', 'post_rest_flags', allRestrs, 'bg-danger');
        }

        // Wire edit-group flag add buttons
        wireAddBtn('eg_browse_perm', 'browse_perm_flags', allPerms, 'bg-success');
        wireAddBtn('eg_browse_rest', 'browse_rest_flags', allRestrs, 'bg-danger');
        wireAddBtn('eg_read_perm', 'read_perm_flags', allPerms, 'bg-success');
        wireAddBtn('eg_read_rest', 'read_rest_flags', allRestrs, 'bg-danger');
        wireAddBtn('eg_post_perm', 'post_perm_flags', allPerms, 'bg-success');
        wireAddBtn('eg_post_rest', 'post_rest_flags', allRestrs, 'bg-danger');

        // Initialize edit-group flags from current group data
        var groupBrowsePermFlags = !{JSON.stringify(fileGroup ? (fileGroup.browse_perm_flags || []) : [])};
        var groupBrowseRestFlags = !{JSON.stringify(fileGroup ? (fileGroup.browse_rest_flags || []) : [])};
        var groupReadPermFlags = !{JSON.stringify(fileGroup ? (fileGroup.read_perm_flags || []) : [])};
        var groupReadRestFlags = !{JSON.stringify(fileGroup ? (fileGroup.read_rest_flags || []) : [])};
        var groupPostPermFlags = !{JSON.stringify(fileGroup ? (fileGroup.post_perm_flags || []) : [])};
        var groupPostRestFlags = !{JSON.stringify(fileGroup ? (fileGroup.post_rest_flags || []) : [])};

        // Wire edit-group flag add buttons (only exist when fileGroup is set)
        if (document.getElementById('eg_browse_perm_add')) {
          wireAddBtn('eg_browse_perm', 'browse_perm_flags', allPerms, 'bg-success');
          wireAddBtn('eg_browse_rest', 'browse_rest_flags', allRestrs, 'bg-danger');
          wireAddBtn('eg_read_perm', 'read_perm_flags', allPerms, 'bg-success');
          wireAddBtn('eg_read_rest', 'read_rest_flags', allRestrs, 'bg-danger');
          wireAddBtn('eg_post_perm', 'post_perm_flags', allPerms, 'bg-success');
          wireAddBtn('eg_post_rest', 'post_rest_flags', allRestrs, 'bg-danger');

          renderAreaFlags('eg_browse_perm', 'browse_perm_flags', parseFlags(JSON.stringify(groupBrowsePermFlags)), allPerms, 'bg-success');
          renderAreaFlags('eg_browse_rest', 'browse_rest_flags', parseFlags(JSON.stringify(groupBrowseRestFlags)), allRestrs, 'bg-danger');
          renderAreaFlags('eg_read_perm', 'read_perm_flags', parseFlags(JSON.stringify(groupReadPermFlags)), allPerms, 'bg-success');
          renderAreaFlags('eg_read_rest', 'read_rest_flags', parseFlags(JSON.stringify(groupReadRestFlags)), allRestrs, 'bg-danger');
          renderAreaFlags('eg_post_perm', 'post_perm_flags', parseFlags(JSON.stringify(groupPostPermFlags)), allPerms, 'bg-success');
          renderAreaFlags('eg_post_rest', 'post_rest_flags', parseFlags(JSON.stringify(groupPostRestFlags)), allRestrs, 'bg-danger');
        }

        // Initialize new area flags from group defaults (only exist when fileGroup is set)
        if (document.getElementById('na_browse_perm_add')) {
          renderAreaFlags('na_browse_perm', 'browse_perm_flags', parseFlags(JSON.stringify(groupBrowsePermFlags)), allPerms, 'bg-success');
          renderAreaFlags('na_browse_rest', 'browse_rest_flags', parseFlags(JSON.stringify(groupBrowseRestFlags)), allRestrs, 'bg-danger');
          renderAreaFlags('na_read_perm', 'read_perm_flags', parseFlags(JSON.stringify(groupReadPermFlags)), allPerms, 'bg-success');
          renderAreaFlags('na_read_rest', 'read_rest_flags', parseFlags(JSON.stringify(groupReadRestFlags)), allRestrs, 'bg-danger');
          renderAreaFlags('na_post_perm', 'post_perm_flags', parseFlags(JSON.stringify(groupPostPermFlags)), allPerms, 'bg-success');
          renderAreaFlags('na_post_rest', 'post_rest_flags', parseFlags(JSON.stringify(groupPostRestFlags)), allRestrs, 'bg-danger');
        }

        // --- Drag-to-reorder file areas ---
        var faBody = document.getElementById('faBody');
        if (faBody) {
          var dragRow = null;
          faBody.addEventListener('dragstart', function(e) {
            dragRow = e.target.closest('tr');
            if (dragRow) e.dataTransfer.effectAllowed = 'move';
          });
          faBody.addEventListener('dragover', function(e) {
            e.preventDefault();
            var target = e.target.closest('tr');
            if (target && target !== dragRow) {
              var rect = target.getBoundingClientRect();
              if (e.clientY < rect.top + rect.height / 2) {
                faBody.insertBefore(dragRow, target);
              } else {
                faBody.insertBefore(dragRow, target.nextSibling);
              }
            }
          });
          faBody.querySelectorAll('.grip').forEach(function(grip) {
            grip.addEventListener('click', function(e) { e.stopPropagation(); });
          });
        }
        var saveFaBtn = document.getElementById('saveFaOrder');
        if (saveFaBtn) {
          saveFaBtn.addEventListener('click', function() {
            var rows = document.querySelectorAll('#faBody tr');
            var ids = [];
            rows.forEach(function(r) { ids.push(r.getAttribute('data-bs-id')); });
            fetch('/admin/fileAreas/reorder', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ ids: ids })
            }).then(function() { location.reload(); });
          });
        }

        // Area table row click — populate and open info modal
        const table = document.getElementById('fileAreas');
        if (table) {
          table.querySelectorAll('tbody tr').forEach(row => {
            row.style.cursor = 'pointer';
            row.addEventListener('click', function() {
              const d = this.dataset;
              currentAreaShortcode = d.bsShortcode;

              document.getElementById('areaInfoTitle').textContent       = d.bsName;
              document.getElementById('areaInfoShortcode').textContent   = d.bsShortcode;
              document.getElementById('areaInfoSubDir').textContent      = d.bsSubdir || '—';
              document.getElementById('areaInfoActive').textContent      = d.bsActive === 'true' ? 'Active' : 'Inactive';
              document.getElementById('areaInfoNewscan').textContent     = d.bsNewscandefault === 'true' ? 'Yes' : 'No';
              document.getElementById('areaInfoBrowseSec').textContent   = d.bsBrowsesecurity;
              document.getElementById('areaInfoReadSec').textContent     = d.bsReadsecurity;
              document.getElementById('areaInfoPostSec').textContent     = d.bsPostsecurity;
              document.getElementById('areaInfoFileCount').textContent   = parseInt(d.bsFilecount || 0).toLocaleString();
              document.getElementById('areaInfoTotalSize').textContent   = formatBytes(d.bsTotalbytes);
              document.getElementById('areaInfoBrowsePermFlags').textContent = fmtFlags(d.bsBrowsepermflags);
              document.getElementById('areaInfoBrowseRestFlags').textContent = fmtFlags(d.bsBrowserestflags);
              document.getElementById('areaInfoReadPermFlags').textContent  = fmtFlags(d.bsReadpermflags);
              document.getElementById('areaInfoReadRestFlags').textContent  = fmtFlags(d.bsReadrestflags);
              document.getElementById('areaInfoPostPermFlags').textContent  = fmtFlags(d.bsPostpermflags);
              document.getElementById('areaInfoPostRestFlags').textContent  = fmtFlags(d.bsPostrestflags);
              document.getElementById('areaInfoDescription').textContent = d.bsDescription;
              document.getElementById('areaInfoLastUploader').textContent = d.bsLastuploader || '—';
              document.getElementById('areaInfoLastFilename').textContent = d.bsLastfilename || '—';
              document.getElementById('areaInfoLastUpload').textContent  = d.bsLastupload
                ? new Date(d.bsLastupload).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
                : '—';

              areaInfoModal.show();
            });
          });
        }

        // Edit button — populate edit modal
        document.getElementById('areaEditBtn').addEventListener('click', function() {
          if (!currentAreaShortcode) return;
          const row = document.querySelector(`tr[data-bs-shortcode="${currentAreaShortcode}"]`);
          if (!row) return;
          const d = row.dataset;

          document.getElementById('editAreaForm').action     = `/admin/fileArea/${currentAreaShortcode}/update`;
          document.getElementById('ea_name').value           = d.bsName;
          document.getElementById('ea_description').value    = d.bsDescription;
          document.getElementById('ea_subdir').value         = d.bsSubdir || '';
          document.getElementById('ea_browsesecurity').value = d.bsBrowsesecurity;
          document.getElementById('ea_readsecurity').value   = d.bsReadsecurity;
          document.getElementById('ea_postsecurity').value   = d.bsPostsecurity;
          document.getElementById('ea_active').value         = d.bsActive === 'true' ? 'true' : 'false';
          document.getElementById('ea_newscan').value        = d.bsNewscandefault === 'true' ? 'true' : 'false';

          renderAreaFlags('ea_browse_perm', 'browse_perm_flags', parseFlags(d.bsBrowsepermflags), allPerms, 'bg-success');
          renderAreaFlags('ea_browse_rest', 'browse_rest_flags', parseFlags(d.bsBrowserestflags), allRestrs, 'bg-danger');
          renderAreaFlags('ea_read_perm', 'read_perm_flags', parseFlags(d.bsReadpermflags), allPerms, 'bg-success');
          renderAreaFlags('ea_read_rest', 'read_rest_flags', parseFlags(d.bsReadrestflags), allRestrs, 'bg-danger');
          renderAreaFlags('ea_post_perm', 'post_perm_flags', parseFlags(d.bsPostpermflags), allPerms, 'bg-success');
          renderAreaFlags('ea_post_rest', 'post_rest_flags', parseFlags(d.bsPostrestflags), allRestrs, 'bg-danger');

          areaInfoModal.hide();
          editAreaModal.show();
        });

        // Delete button
        document.getElementById('areaDeleteBtn').addEventListener('click', function() {
          if (!currentAreaShortcode) return;
          var row = document.querySelector(`tr[data-bs-shortcode="${currentAreaShortcode}"]`);
          if (!row) return;

          document.getElementById('deleteAreaName').textContent           = row.dataset.bsName;
          document.getElementById('deleteAreaForm').action                = `/admin/fileArea/${currentAreaShortcode}/delete`;
          document.getElementById('da_delete_files_hidden').value        = 'false';
          document.getElementById('da_delete_files').value               = 'false';
          document.getElementById('da_deleteFilesWarning').style.display = 'none';

          areaInfoModal.hide();
          deleteAreaModal.show();
        });

        // Delete area files select warning
        const daSelect  = document.getElementById('da_delete_files');
        const daHidden  = document.getElementById('da_delete_files_hidden');
        const daWarning = document.getElementById('da_deleteFilesWarning');
        if (daSelect) {
          daSelect.addEventListener('change', function() {
            daHidden.value = this.value;
            daWarning.style.display = this.value === 'true' ? 'block' : 'none';
          });
        }

        // Delete group files select warning
        const deleteSelect  = document.getElementById('delete_files');
        const deleteHidden  = document.getElementById('delete_files_hidden');
        const deleteWarning = document.getElementById('deleteFilesWarning');
        if (deleteSelect) {
          deleteSelect.addEventListener('change', function() {
            deleteHidden.value = this.value;
            deleteWarning.style.display = this.value === 'true' ? 'block' : 'none';
          });
        }

      });
