.card.mb-3
  .card-body.text-center.py-4(style='background: #000')
    if artUrl
      img.img-fluid.mb-3(src=artUrl alt=boardname style='max-height: 300px; border-radius: 4px')
    else
      h1.fg-brightgreen.mb-3= boardname
    h3.fg-brightcyan Welcome, #{username}!
    p.fg-cyan Let's see what's been happening...
