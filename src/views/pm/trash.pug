extends ../layouts/user

block content
  .container-fluid.main-wrapper
    if !currentuser
      - loginMode = 'guard'
      - loginRedirect = currentPath
      include ../partials/users/login.pug
    else
      .row.mt-2
        .col-xl-8.offset-xl-2.col-lg-10.offset-lg-1.col-12
          include ../partials/flash
          .card
            .card-header.bg-darkblue.text-white
              .row.align-items-center
                .col-6
                  h5.mb-0
                    i.bi.bi-trash
                    |  Trash
                .col-6
                  .d-flex.justify-content-end.gap-1
                    a.btn.btn-sm.btn-outline-light(href='/pm/inbox')
                      i.bi.bi-arrow-left
                      |  Inbox
                    a.btn.btn-sm.btn-outline-secondary(href='/pm/sent')
                      i.bi.bi-send
                      |  Sent

            .card-body.p-0.bg-black
              if messages && messages.length > 0
                table.table.table-hover.mb-0(style='table-layout: fixed;')
                  thead.bg-dark
                    tr
                      th(scope='col' style='width: 20%') From
                      th(scope='col' style='width: 35%') Subject
                      th(scope='col' style='width: 12%') Transport
                      th(scope='col' style='width: 18%') Deleted
                      th(scope='col' style='width: 15%')
                  tbody
                    for msg of messages
                      tr
                        td.text-truncate
                          span.fg-yellow= msg.from_user
                        td.text-truncate= msg.subject || '(no subject)'
                        td
                          span.badge(class=(msg.transport_type === 'LOCAL' ? 'bg-secondary' : 'bg-info'))= msg.transport_type
                        td.small
                          if msg.deleted_at
                            - var ddate = Date.parse(msg.deleted_at)
                            - var dd = DateTime.fromMillis(ddate)
                            span.fg-yellow= dd.toFormat('MMM dd, yyyy HH:mm')
                        td.text-end
                          form.d-inline(action=`/pm/trash/${msg.uuid}/restore` method='POST')
                            button.btn.btn-xs.btn-outline-success(type='submit' title='Restore')
                              i.bi.bi-arrow-counterclockwise
                              |  Restore
              else
                .text-center.py-4
                  .text-muted
                    i.bi.bi-trash
                    |  Trash is empty
