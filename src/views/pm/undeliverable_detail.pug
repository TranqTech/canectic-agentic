extends ../layouts/user

block content
  .container-fluid.main-wrapper
    if !currentuser
      - loginMode = 'guard'
      - loginRedirect = currentPath
      include ../partials/users/login.pug
    else if !sufficientAccess
      include ../partials/status/unauthorized.pug
    else if !message
      .row.mt-2
        .col-xl-6.offset-xl-3.col-lg-10.col-12
          .card
            .card-header.bg-darkblue.text-white
              h5.mb-0= title
            .card-body
              h3 Message Not Found
    else
      .row.mt-2
        .col-xl-6.offset-xl-3.col-lg-10.offset-lg-1.col-12
          include ../partials/flash
          .card
            .card-header.bg-darkblue.text-white
              .row.align-items-center
                .col-8
                  h5.mb-0
                    i.bi.bi-exclamation-triangle
                    |  Review Undeliverable
                .col-4
                  .d-flex.justify-content-end
                    a.btn.btn-sm.btn-outline-light(href='/pm/undeliverable')
                      i.bi.bi-arrow-left
                      |  Queue

            .card-body.py-2.bg-dark.border-bottom.border-secondary
              .row
                .col-sm-6
                  .small
                    span.text-muted From: 
                    span.fg-yellow.fw-bold= message.from_user
                    if message.from_address && message.from_address !== message.from_user
                      span.fg-cyan.ms-1 (#{message.from_address})
                  .small
                    span.text-muted To: 
                    span.fg-green= message.to_user
                    if message.to_address && message.to_address !== message.to_user
                      span.fg-cyan.ms-1 (#{message.to_address})
                  .small
                    span.text-muted Subject: 
                    span.fg-yellow= message.subject || '(none)'
                .col-sm-6.text-sm-end
                  .small
                    span.text-muted Date: 
                    if message.system_time
                      - var mdate = Date.parse(message.system_time)
                      - var md = DateTime.fromMillis(mdate)
                      span.fg-yellow= md.toFormat('MMM dd, yyyy HH:mm')
                  .small
                    span.text-muted Transport: 
                    span.badge.bg-info= message.transport_type
                  .small
                    span.text-muted Reason: 
                    span.badge.bg-warning= message.reason

            .card-body.bg-black
              .messagebody.monospace.fg-brightgrey
                if message.body_html && message.body_html.trim()
                  != message.body_html
                else if message.body_text && message.body_text.trim()
                  pre(style='white-space: pre-wrap; margin: 0; font-family: inherit; font-size: inherit; color: inherit;')= message.body_text
                else
                  .text-muted (empty message)

            //- Review actions
            if !message.reviewed
              .card-footer.bg-dark
                h6.text-white.mb-3 Review Actions
                .row.g-2
                  .col-sm-6
                    form(action=`/pm/undeliverable/${message.uuid}/action` method='POST')
                      .input-group
                        input.form-control.bg-black.fg-green(
                          type='text'
                          name='deliver_to_username'
                          placeholder='Username to deliver to'
                        )
                        input(type='hidden' name='action' value='delivered')
                        button.btn.btn-success(type='submit')
                          i.bi.bi-check-lg
                          |  Deliver
                  .col-sm-3
                    form(action=`/pm/undeliverable/${message.uuid}/action` method='POST')
                      input(type='hidden' name='action' value='deleted')
                      button.btn.btn-outline-danger.w-100(type='submit')
                        i.bi.bi-trash
                        |  Discard
                  .col-sm-3
                    form(action=`/pm/undeliverable/${message.uuid}/action` method='POST')
                      input(type='hidden' name='action' value='returned')
                      button.btn.btn-outline-warning.w-100(type='submit')
                        i.bi.bi-reply
                        |  Return
            else
              .card-footer.bg-dark
                .small.text-muted
                  | Reviewed 
                  if message.reviewed_at
                    - var rdate = Date.parse(message.reviewed_at)
                    - var rd = DateTime.fromMillis(rdate)
                    = rd.toFormat('MMM dd, yyyy HH:mm')
                  |  — Action: 
                  span.badge.bg-success= message.action_taken
                  if message.delivered_to
                    |  to user ##{message.delivered_to}
