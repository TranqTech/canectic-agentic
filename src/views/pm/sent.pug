extends ../layouts/user

block content
  .container-fluid.main-wrapper
    if !currentuser
      - loginMode = 'guard'
      - loginRedirect = currentPath
      include ../partials/users/login.pug
    else
      .row.mt-2
        .col-xl-8.offset-xl-2.col-lg-10.offset-lg-1.col-12
          include ../partials/flash
          .card
            .card-header.bg-darkblue.text-white
              .row.align-items-center
                .col-6
                  h5.mb-0
                    i.bi.bi-send
                    |  Sent Messages
                .col-6
                  .d-flex.justify-content-end.gap-1
                    a.btn.btn-sm.btn-outline-light(href='/pm/inbox')
                      i.bi.bi-arrow-left
                      |  Inbox
                    a.btn.btn-sm.btn-outline-secondary(href='/pm/trash')
                      i.bi.bi-trash
                      |  Trash

            .card-body.p-0.bg-black
              if messages && messages.length > 0
                table.table.table-hover.mb-0(style='table-layout: fixed;')
                  thead.bg-dark
                    tr
                      th(scope='col' style='width: 20%') To
                      th(scope='col' style='width: 35%') Subject
                      th(scope='col' style='width: 12%') Transport
                      th(scope='col' style='width: 10%') Status
                      th(scope='col' style='width: 18%') Date
                      th(scope='col' style='width: 5%')
                  tbody
                    for msg of messages
                      tr.clickable-row(data-href=`/pm/sent/${msg.uuid}` style='cursor: pointer;')
                        td.text-truncate
                          span.fg-green= msg.to_user
                          if msg.to_address && msg.to_address !== msg.to_user
                            br
                            span.fg-cyan.small= msg.to_address
                        td.text-truncate= msg.subject || '(no subject)'
                        td
                          span.badge(class=(msg.transport_type === 'LOCAL' ? 'bg-secondary' : 'bg-info'))= msg.transport_type
                        td
                          if msg.sent
                            span.badge.bg-success Sent
                          else if msg.send_error
                            span.badge.bg-danger Error
                          else
                            span.badge.bg-warning Queued
                        td.small
                          if msg.system_time
                            - var mdate = Date.parse(msg.system_time)
                            - var md = DateTime.fromMillis(mdate)
                            span.fg-yellow= md.toFormat('MMM dd, yyyy HH:mm')
                        td.text-end
                          form.d-inline(action=`/pm/sent/${msg.uuid}/delete` method='POST')
                            button.btn.btn-xs.btn-outline-danger(type='submit' title='Delete' onclick='event.stopPropagation()')
                              i.bi.bi-trash
              else
                .text-center.py-4
                  .text-muted
                    i.bi.bi-send
                    |  No sent messages

  script.
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.clickable-row').forEach(function(row) {
        row.addEventListener('click', function() {
          var href = this.getAttribute('data-href');
          if (href) window.location.href = href;
        });
      });
    });
