# =============================================================================
# Canectic BBS — Environment Configuration
# =============================================================================
#
# Copy this file to .env in the project root and edit to match your setup.
# Only bootstrap variables belong here — most settings are managed through
# the Admin UI at /admin/config (stored in PostgreSQL, not .env).
#
# Three-tier config merge order (highest wins):
#   .env  >  PostgreSQL config_settings table  >  configDefaults.js
#
# See src/config/configDefaults.js for the full list of configurable keys.
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL (REQUIRED)
# ---------------------------------------------------------------------------
# The database must exist before first run. See INSTALL.md for setup.
dbuser=canectic
dbhost=localhost
dbname=canectic_bbs
dbpass=CHANGE_ME
dbport=5432

# ---------------------------------------------------------------------------
# Redis (REQUIRED)
# ---------------------------------------------------------------------------
# Default works for a local Redis install with no authentication.
redis_url=redis://localhost:6379
# REDIS_PASSWORD=             # Uncomment if your Redis requires auth
# REDIS_BULLMQ_DB=2           # Redis DB number for BullMQ job queues (default: 2)

# ---------------------------------------------------------------------------
# Process Mode
# ---------------------------------------------------------------------------
# "separate" (default) — gateway only; run worker/mail/mailer as separate PM2 processes
# "embedded" — all-in-one; runs IMAP, SMTP, mailer, and workers inside the gateway process
PROCESS_MODE=separate

# ---------------------------------------------------------------------------
# FTN Mailer
# ---------------------------------------------------------------------------
# Set to true to enable the binkp mailer process (requires peer connections configured)
MAILER_ENABLED=false

# ---------------------------------------------------------------------------
# Node.js
# ---------------------------------------------------------------------------
NODE_ENV=production
# NODE_OPTIONS=--experimental-vm-modules   # Required for Synchronet JS door shims

# ---------------------------------------------------------------------------
# Logging (bootstrap — loaded before appConfig)
# ---------------------------------------------------------------------------
# These must stay in .env due to circular import chains with appConfig.
# See LOGGING_SYSTEM.md for details.
loglevel=3                    # 0=critical, 1=important, 2=normal, 3=verbose, 4=debug, 5=trace
# logtoconsole=true           # Force console output in production
# logeverything=true           # Log all levels in development
# logfileindev=true            # Write log files in development mode

# ---------------------------------------------------------------------------
# Optional: Override defaults from configDefaults.js
# ---------------------------------------------------------------------------
# Any key from configDefaults.js can be set here to override the default.
# However, most are better managed through the Admin UI at /admin/config.
# These are common ones you might want to set at deploy time:
#
# boardname=My BBS             # BBS name (nav bar, origin lines, mailer handshake)
# SYSOP_USERNAME=MySysop       # Sysop username for PM system notifications
# webport=8080                 # HTTP server port
# terminalport=2023            # Terminal server port (auto-detects TCP vs Telnet)
# mail_domain=mybbs.example.com  # Domain for IMAP/SMTP addressing (required for mail servers)
# sitetld=example.com          # Cookie domain
# sitedomain=mybbs.example.com # Full domain for URL generation
